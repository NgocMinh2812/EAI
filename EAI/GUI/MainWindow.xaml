<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="EnglishAI - Hệ thống học tiếng Anh thông minh" 
        Icon="/Assets/app_icon.ico"
        WindowState="Maximized"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#0F766E"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="680"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />

        <!-- Sidebar item styles -->
        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveSidebarItemStyle" TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
            <Setter Property="Background" Value="{StaticResource BrandTealLight}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandTeal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Nền MainWindow màu xanh ngọc sáng hơn (Brand Teal phối Gradient) -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F766E" Offset="0"/>
                <GradientStop Color="#134E4A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Floating panel -->
        <Border Background="#F8FAFC" CornerRadius="20" Margin="24,15" BorderBrush="#14B8A6" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#042F2E"/>
            </Border.Effect>

            <Grid>
                <!-- Mask element để cắt bo góc tròn 100% cho toàn bộ nội dung bên trong -->
                <Border x:Name="MaskElement" Background="White" CornerRadius="20"/>

                <!-- Container áp dụng OpacityMask bo góc tròn -->
                <Border CornerRadius="20">
                    <Border.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=MaskElement}"/>
                    </Border.OpacityMask>

                    <!-- Khung làm việc chính chia 2 cột: Cột 0 là Menu Trái dùng chung, Cột 1 là Nội dung trang -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" x:Name="colSidebar"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================= MENU TRÁI DÙNG CHUNG (SHARED SIDEBAR) ================= -->
                        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Logo Thương Hiệu -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,24,20,20">
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Width="36" Height="36" CornerRadius="9" Padding="3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.1" Color="Black"/>
                                        </Border.Effect>
                                        <Image Source="/Assets/logo_icon.png" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="EnglishAI" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="Học tập thông minh" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Danh sách Chức năng Menu -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,4,0,10">
                                        <TextBlock Text="ĐIỀU HƯỚNG CHÍNH" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="20,10,16,8"/>
                                        
                                        <Button x:Name="btnNavTrangChu" Style="{StaticResource ActiveSidebarItemStyle}" Click="NavTrangChu_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Home" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Trang chủ" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnNavDanhGia" Style="{StaticResource SidebarItemStyle}" Click="NavDanhGia_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Target" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Đánh giá năng lực" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnNavHocTap" Style="{StaticResource SidebarItemStyle}" Click="NavHocTap_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="BookOpen" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Học tập" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnNavLuyenTap" Style="{StaticResource SidebarItemStyle}" Click="NavLuyenTap_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Pencil" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Luyện tập" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnNavThiThu" Style="{StaticResource SidebarItemStyle}" Click="NavThiThu_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Timer" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Thi thử" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnNavBaiViet" Style="{StaticResource SidebarItemStyle}" Click="NavBaiViet_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="FileEdit" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Bài viết AI" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Text="CÔNG CỤ HỖ TRỢ" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="20,18,16,8"/>

                                        <Button x:Name="btnNavTienDo" Style="{StaticResource SidebarItemStyle}" Click="NavTienDo_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="LineChart" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tiến độ học" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnNavAIChat" Style="{StaticResource SidebarItemStyle}" Click="NavAIChat_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Bot" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Trợ lý AI" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnNavHoSo" Style="{StaticResource SidebarItemStyle}" Click="NavHoSo_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="User" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Hồ sơ cá nhân" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Thông tin Học viên & Đăng xuất -->
                                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="14,14">
                                    <StackPanel>
                                        <!-- Thông tin tài khoản -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="{StaticResource BrandTealLight}" Width="36" Height="36" CornerRadius="18">
                                                <TextBlock x:Name="txtUserAvatar" Text="NA" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtUserName" Text="Nguyễn Văn A" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock x:Name="txtUserTarget" Text="IELTS Target 6.5" FontSize="11" Foreground="{StaticResource BrandTeal}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Nút quay lại trang Quản trị / Giảng viên (chỉ hiện khi có quyền) -->
                                        <Button x:Name="btnSwitchToAdmin" Visibility="Collapsed" Style="{StaticResource SidebarItemStyle}" Margin="0,4,0,0" Click="BtnSwitchToAdmin_Click" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal">
                                                <local:LucideIcon Kind="GraduationCap" Size="16" Foreground="{StaticResource BrandTeal}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="txtSwitchToAdmin" Text="Về trang Quản lý" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Nút Đăng xuất -->
                                        <Button Style="{StaticResource SidebarItemStyle}" Margin="0,4,0,0" Click="LogoutButton_Click" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal">
                                                <local:LucideIcon Kind="LogOut" Size="16" Foreground="#EF4444" Margin="0,0,8,0"/>
                                                <TextBlock Text="Đăng xuất" Foreground="#EF4444" FontWeight="Medium" FontSize="12.5"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ================= NỘI DUNG PHÍA PHẢI (MAIN CONTENT HOST) ================= -->
                        <Grid Grid.Column="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,16,0" Panel.ZIndex="100">
                                <!-- Nút Thu nhỏ xuống Taskbar (Minimize) -->
                                <Button Width="30" Height="30" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" ToolTip="Thu nhỏ xuống taskbar" Click="BtnMinimize_Click" Margin="0,0,4,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6" Width="30" Height="30">
                                                <local:LucideIcon Kind="Minus" Size="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Nút Phóng to / Thu nhỏ cửa sổ (Maximize / Restore Down - Nút vuông vuông) -->
                                <Button x:Name="btnMaximizeRestore" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Thu nhỏ màn hình" Click="BtnMaximizeRestore_Click" Margin="0,0,4,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6" Width="30" Height="30">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Icon ô vuông đơn (khi ở chế độ Normal để Phóng to) -->
                                        <Border x:Name="icoSquare" Width="11" Height="11" BorderBrush="#64748B" BorderThickness="1.5" CornerRadius="1" Visibility="Collapsed"/>
                                        <!-- Icon 2 ô vuông lồng nhau (khi ở chế độ Maximized để Thu nhỏ) -->
                                        <Grid x:Name="icoRestore" Width="13" Height="13" Visibility="Visible">
                                            <Border Width="8.5" Height="8.5" BorderBrush="#64748B" BorderThickness="1.3" CornerRadius="1" Margin="3.5,0,0,3.5" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            <Border Width="8.5" Height="8.5" Background="#F8FAFC" BorderBrush="#64748B" BorderThickness="1.3" CornerRadius="1" Margin="0,3.5,3.5,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Grid>
                                </Button>

                                <!-- Nút Đóng ứng dụng (Close) -->
                                <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Đóng ứng dụng" Click="BtnClose_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="#FEE2E2" CornerRadius="14" BorderBrush="#FECACA" BorderThickness="1">
                                                <TextBlock x:Name="t" Text="✕" FontSize="12.5" FontWeight="Bold" Foreground="#DC2626" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#DC2626"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="#B91C1C"/>
                                                    <Setter TargetName="t" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
