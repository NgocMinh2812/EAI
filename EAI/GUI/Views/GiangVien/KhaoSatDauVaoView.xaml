<Page x:Class="GUI.Views.GiangVien.KhaoSatDauVaoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Khảo sát đầu vào - Admin Dashboard"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Header Style -->
        <Style x:Key="ModernDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- Modern DataGrid Row Style -->
        <Style x:Key="ModernDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0FDF4"/>
                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern DataGrid Cell Style -->
        <Style x:Key="ModernDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- ================= 1. TOP HEADER ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Khảo sát Năng lực Đầu vào &amp; Phân loại Trình độ" FontWeight="Bold" FontSize="22" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock Text="Cấu hình hệ thống 6 bộ đề chẩn đoán A1 - C2, ma trận quy đổi CEFR / IELTS / TOEIC và theo dõi kết quả khảo sát của sinh viên" FontSize="13" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                            FontWeight="SemiBold" FontSize="13" Padding="16,10" Cursor="Hand" BorderThickness="0" Margin="0,0,10,0" Click="BtnSuaMaTran_Click"
                            ToolTip="Điều chỉnh ngưỡng phần trăm quy đổi sang khung CEFR / IELTS / TOEIC">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="SlidersHorizontal" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ma trận quy đổi" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                            FontWeight="SemiBold" FontSize="13" Padding="18,10" Cursor="Hand" BorderThickness="0" Click="BtnCapNhatBoDe_Click"
                            ToolTip="Mở trình soạn thảo và chọn lọc câu hỏi cho các bộ đề khảo sát">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="Settings" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                        <TextBlock Text="Soạn thảo bộ đề" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 2. KPI STATISTICS CARDS ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng lượt khảo sát -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <local:LucideIcon Kind="Users" Size="15" Foreground="#3B82F6" Margin="0,0,6,0"/>
                            <TextBlock Text="TỔNG LƯỢT KHẢO SÁT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiTotalAttempts" Text="0 lượt nộp" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Điểm trung bình -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <local:LucideIcon Kind="Award" Size="15" Foreground="#10B981" Margin="0,0,6,0"/>
                            <TextBlock Text="ĐIỂM TRUNG BÌNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiAvgScore" Text="0.0 / 10" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Tỷ lệ đạt chuẩn -->
                <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <local:LucideIcon Kind="Target" Size="15" Foreground="#F59E0B" Margin="0,0,6,0"/>
                            <TextBlock Text="TỶ LỆ ĐẠT (≥ 5.0)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiPassRate" Text="0%" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Hệ thống bộ đề -->
                <Border Grid.Column="6" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <local:LucideIcon Kind="BookOpen" Size="15" Foreground="#8B5CF6" Margin="0,0,6,0"/>
                            <TextBlock Text="HỆ THỐNG BỘ ĐỀ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <TextBlock Text="6 Bộ (A1 - C2)" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= 3. HỆ THỐNG 6 BỘ ĐỀ KHẢO SÁT A1 - C2 ================= -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Kind="Layers" Size="18" Foreground="{StaticResource AdminDarkGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hệ thống Bộ đề Khảo sát Năng lực Đầu vào (CEFR A1 - C2 &amp; Bộ đề Tổng hợp Toàn diện)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                            <TextBlock Text="Hệ thống bộ đề 20 câu đa dạng kỹ năng (Ngữ pháp, Từ vựng, Đọc hiểu, Nghe, Viết) được thiết kế riêng biệt để phân loại chính xác trình độ học viên" 
                                       FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" Background="#F1F5F9" BorderThickness="0" Padding="12,6" Cursor="Hand" Click="BtnRefreshSurveys_Click" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdRfSurveys" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon x:Name="icoRfSurveys" Kind="RefreshCw" Size="13" Foreground="{StaticResource TextDark}" Margin="0,0,5,0"
                                                              RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                                <local:LucideIcon.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </local:LucideIcon.RenderTransform>
                                            </local:LucideIcon>
                                            <TextBlock Text="Làm mới" FontSize="12" Foreground="{StaticResource TextDark}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="ButtonBase.Click">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="icoRfSurveys"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.7">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdRfSurveys" Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Danh sách 6 Cards cho 6 bộ đề -->
                    <ItemsControl x:Name="icSurveySets">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Badges (Cấp độ & Trạng thái) -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Border Background="{Binding BadgeBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding MaCapDo, StringFormat='CẤP ĐỘ {0}'}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                            </Border>

                                            <Border Background="{Binding StatusBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: Tiêu đề -->
                                        <TextBlock Grid.Row="1" Text="{Binding TenBaiKhaoSat}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" 
                                                   TextWrapping="Wrap" LineHeight="19" MinHeight="38" Margin="0,0,0,6"/>

                                        <!-- Row 2: Mô tả -->
                                        <TextBlock Grid.Row="2" Text="{Binding MoTa}" FontSize="12" Foreground="{StaticResource TextGray}" 
                                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                                        <!-- Row 3: Thông số kỹ thuật -->
                                        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <local:LucideIcon Kind="Clock" Size="13" Foreground="{StaticResource TextGray}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ThoiGianText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                                </StackPanel>

                                                <Rectangle Grid.Column="1" Width="1" Height="14" Fill="#E2E8F0"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <local:LucideIcon Kind="CheckCircle2" Size="13" Foreground="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TongSoCauText}" FontSize="11.5" FontWeight="Bold" Foreground="#047857"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 4: Hành động -->
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Nút Xem trước -->
                                            <Button Grid.Column="0" Content="Xem trước" Click="BtnXemTruocBoDe_Click"
                                                    Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                                    Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="11.5" Padding="8,6" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <!-- Nút Chỉnh sửa -->
                                            <Button Grid.Column="2" Content="Chỉnh sửa" Click="BtnChinhSuaBoDeCard_Click"
                                                    Background="#F0FDF4" BorderBrush="#A7F3D0" BorderThickness="1"
                                                    Foreground="#047857" FontWeight="Bold" FontSize="11.5" Padding="8,6" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= 4. CONVERSION MATRIX TABLE ================= -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ma trận Quy đổi Điểm sang Khung Năng lực Chuẩn (Dữ liệu SQL Server)" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Đồng bộ tự động từ bảng CauHinhQuyDoiKhaoSat phục vụ xếp lớp và đề xuất lộ trình" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ĐIỂM % ĐẠT ĐƯỢC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Grid.Column="1" Text="KHUNG CEFR" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Grid.Column="2" Text="QUY ĐỔI IELTS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Grid.Column="3" Text="QUY ĐỔI TOEIC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Grid.Column="4" Text="LỘ TRÌNH ĐỀ XUẤT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,0,0,10"/>

                    <StackPanel x:Name="pnlMatrixContainer"/>
                </StackPanel>
            </Border>

            <!-- ================= 5. BẢNG KẾT QUẢ KHẢO SÁT SINH VIÊN (MODERN TABLE) ================= -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel>
                    <!-- Header with Search & Filter -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="ClipboardCheck" Size="18" Foreground="{StaticResource AdminDarkGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kết quả Khảo sát Năng lực của Sinh viên" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                            <Border Background="#ECFDF5" CornerRadius="10" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtTotalStudentsCount" Text="0 lượt nộp" FontSize="11.5" FontWeight="Bold" Foreground="#047857"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Search box -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10,4" Width="280" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <local:LucideIcon Kind="Search" Size="14" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="txtSearchStudent" BorderThickness="0" Background="Transparent" FontSize="12.5" 
                                                 TextChanged="TxtSearchStudent_TextChanged" VerticalContentAlignment="Center"/>
                                        <TextBlock x:Name="txtSearchStudentPlaceholder" Text="Tìm kiếm sinh viên, email..." 
                                                   FontSize="12" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" 
                                                   IsHitTestVisible="False" Margin="2,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Level Filter Combo -->
                            <ComboBox x:Name="cboFilterLevel" Height="34" Width="120" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="CboFilterLevel_SelectionChanged">
                                <ComboBoxItem Content="Tất cả cấp độ" Tag="TatCa"/>
                                <ComboBoxItem Content="A1" Tag="A1"/>
                                <ComboBoxItem Content="A2" Tag="A2"/>
                                <ComboBoxItem Content="B1" Tag="B1"/>
                                <ComboBoxItem Content="B2" Tag="B2"/>
                                <ComboBoxItem Content="C1" Tag="C1"/>
                                <ComboBoxItem Content="C2" Tag="C2"/>
                                <ComboBoxItem Content="Tổng hợp A1-C2" Tag="TongHop"/>
                            </ComboBox>

                            <!-- Refresh Button -->
                            <Button Background="#F1F5F9" BorderThickness="0" Padding="12,6" Cursor="Hand" Click="BtnRefreshStudents_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdRfStudents" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon x:Name="icoRfStudents" Kind="RefreshCw" Size="13" Foreground="{StaticResource TextDark}" Margin="0,0,4,0"
                                                                  RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                                    <local:LucideIcon.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </local:LucideIcon.RenderTransform>
                                                </local:LucideIcon>
                                                <TextBlock Text="Làm mới" FontSize="12" Foreground="{StaticResource TextDark}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="ButtonBase.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="icoRfStudents"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.7">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdRfStudents" Property="Background" Value="#E2E8F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Student Results Modern DataGrid -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10">
                        <DataGrid x:Name="dgSinhVienKhaoSat" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="White" BorderThickness="0" MinHeight="220"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                  RowStyle="{StaticResource ModernDataGridRowStyle}"
                                  CellStyle="{StaticResource ModernDataGridCellStyle}">
                            <DataGrid.Columns>
                                <!-- Cột 1: Mã lượt -->
                                <DataGridTextColumn Header="MÃ" Binding="{Binding MaLuotKhaoSat}" Width="55"/>

                                <!-- Cột 2: Sinh viên (Avatar + Tên + Email) -->
                                <DataGridTemplateColumn Header="SINH VIÊN" Width="2.3*" MinWidth="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="34" Height="34" CornerRadius="17" Background="#E0F2FE" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="11.5" Foreground="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HoTen}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                                                    <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 3: Thời điểm nộp -->
                                <DataGridTemplateColumn Header="THỜI ĐIỂM NỘP" Width="1.5*" MinWidth="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Clock" Size="13" Foreground="{StaticResource TextGray}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ThoiDiemNopBaiHienThi}" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 4: Số câu đúng -->
                                <DataGridTemplateColumn Header="KẾT QUẢ ĐÚNG" Width="1.3*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding KetQuaTiLe}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 5: Điểm số -->
                                <DataGridTemplateColumn Header="ĐIỂM SỐ" Width="1*" MinWidth="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DiemHienThi}" FontWeight="Bold" FontSize="13" Foreground="{Binding ScoreColor}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 6: Khung CEFR -->
                                <DataGridTemplateColumn Header="KHUNG CEFR" Width="1.2*" MinWidth="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BadgeBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding MaCapDo, StringFormat='Cấp độ {0}'}" FontWeight="Bold" FontSize="11.5" Foreground="{Binding BadgeForeground}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 7: Quy đổi chuẩn -->
                                <DataGridTemplateColumn Header="QUY ĐỔI CHUẨN" Width="2.4*" MinWidth="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding QuyDoiIelts}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                                </Border>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding QuyDoiToeic}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 8: Thao tác -->
                                <DataGridTemplateColumn Header="THAO TÁC" Width="1.3*" MinWidth="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="BtnXemChiTietKhaoSat_Click" Background="#E0F2FE" Foreground="#0369A1" 
                                                    FontWeight="SemiBold" FontSize="11.5" Padding="12,5" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="Eye" Size="13" Foreground="#0369A1" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Xem chi tiết" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
