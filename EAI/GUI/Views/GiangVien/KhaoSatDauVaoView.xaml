<Page x:Class="GUI.Views.GiangVien.KhaoSatDauVaoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Khảo sát đầu vào - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Top Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Khảo sát Năng lực Đầu vào &amp; Phân loại Trình độ" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock Text="Bài kiểm tra chẩn đoán ngắn gọn, thuật toán tự động quy đổi sang khung năng lực CEFR A1 - C1, IELTS &amp; TOEIC" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="⚙️ Cập nhật bộ đề khảo sát" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="13" Padding="18,10" Cursor="Hand" BorderThickness="0" Click="BtnCapNhat_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Conversion Matrix Table -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel>
                    <TextBlock Text="Ma trận Quy đổi Điểm sang Khung Năng lực Chuẩn" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ĐIỂM % ĐẠT ĐƯỢC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Grid.Column="1" Text="KHUNG CEFR" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Grid.Column="2" Text="QUY ĐỔI IELTS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Grid.Column="3" Text="QUY ĐỔI TOEIC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Grid.Column="4" Text="LỘ TRÌNH ĐỀ XUẤT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,0,0,10"/>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="0% - 30%" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="A1 (Mất gốc)" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Grid.Column="2" Text="IELTS &lt; 3.0"/>
                        <TextBlock Grid.Column="3" Text="TOEIC 100 - 250"/>
                        <TextBlock Grid.Column="4" Text="Ngữ pháp nền tảng + 500 từ vựng cốt lõi"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="31% - 50%" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="A2 (Sơ cấp)" FontWeight="Bold" Foreground="#EA580C"/>
                        <TextBlock Grid.Column="2" Text="IELTS 3.5 - 4.5"/>
                        <TextBlock Grid.Column="3" Text="TOEIC 255 - 450"/>
                        <TextBlock Grid.Column="4" Text="Luyện phản xạ câu &amp; Nghe hiểu đơn giản"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="51% - 70%" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="B1 (Trung cấp)" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Grid.Column="2" Text="IELTS 5.0 - 6.0"/>
                        <TextBlock Grid.Column="3" Text="TOEIC 455 - 650"/>
                        <TextBlock Grid.Column="4" Text="Từ vựng học thuật B1 &amp; Cấu trúc câu ghép"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="71% - 85%" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="B2 (Trên trung cấp)" FontWeight="Bold" Foreground="#15803D"/>
                        <TextBlock Grid.Column="2" Text="IELTS 6.5 - 7.0"/>
                        <TextBlock Grid.Column="3" Text="TOEIC 655 - 800"/>
                        <TextBlock Grid.Column="4" Text="Viết luận Task 2 &amp; Skimming/Scanning đọc hiểu"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="86% - 100%" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="C1 (Nâng cao)" FontWeight="Bold" Foreground="#7E22CE"/>
                        <TextBlock Grid.Column="2" Text="IELTS 7.5 - 8.5+"/>
                        <TextBlock Grid.Column="3" Text="TOEIC 805 - 990"/>
                        <TextBlock Grid.Column="4" Text="Thành ngữ Collocations cao cấp &amp; Debate"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
