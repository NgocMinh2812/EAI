<Page x:Class="GUI.Views.GiangVien.AISinhDeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Tạo câu hỏi bằng AI &amp; Nhập tệp - Admin Dashboard"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- ================= TOP HEADER ================= -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Tạo câu hỏi bằng AI &amp; Nhập tệp" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                <TextBlock Text="Tạo câu hỏi trắc nghiệm tự động bằng AI và nhập dữ liệu tệp hàng loạt" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
            </StackPanel>

            <!-- Mode Switcher Tabs -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="tabAISinhDe" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="13" Padding="16,8" Cursor="Hand" BorderThickness="0" Margin="0,0,8,0" Click="TabAISinhDe_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Sparkles" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tạo câu hỏi bằng AI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="tabNhapTep" Content="Nhập tệp" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                        FontWeight="Medium" FontSize="13" Padding="16,8" Cursor="Hand" BorderThickness="0" Click="TabNhapTep_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- ================= VIEW 1: AI SINH ĐỀ ================= -->
            <Grid x:Name="pnlAISinhDe" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Generator Form -->
                <Border Grid.Column="0" Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <!-- Form Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#EA580C" Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0">
                                <TextBlock Text="★" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Yêu cầu tạo câu hỏi bằng AI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- AI Model -->
                        <TextBlock Text="MÔ HÌNH AI" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboModel" Height="36" SelectedIndex="0" Margin="0,0,0,14" Cursor="Hand">
                            <ComboBoxItem Content="Google Gemini (gemini-1.5-flash)"/>
                            <ComboBoxItem Content="Groq Cloud (llama-3.3-70b-versatile)"/>
                            <ComboBoxItem Content="xKiro AI Gateway (qwen/qwen-2.5-72b-instruct)"/>
                        </ComboBox>

                        <!-- Skill and Question Type -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="KỸ NĂNG MỤC TIÊU" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboSkill" Height="36" SelectedIndex="0" Cursor="Hand">
                                    <ComboBoxItem Content="Tự động theo chủ đề" Tag=""/>
                                    <ComboBoxItem Content="Đọc hiểu (Reading)" Tag="Doc"/>
                                    <ComboBoxItem Content="Nghe hiểu (Listening)" Tag="Nghe"/>
                                    <ComboBoxItem Content="Viết (Writing)" Tag="Viet"/>
                                    <ComboBoxItem Content="Nói (Speaking)" Tag="Noi"/>
                                    <ComboBoxItem Content="Ngữ pháp (Grammar)" Tag="NguPhap"/>
                                    <ComboBoxItem Content="Từ vựng (Vocabulary)" Tag="TuVung"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DẠNG CÂU HỎI" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboQuestionType" Height="36" SelectedIndex="0" Cursor="Hand">
                                    <ComboBoxItem Content="Tự động đa dạng theo kỹ năng" Tag=""/>
                                    <ComboBoxItem Content="Trắc nghiệm (Multiple Choice)" Tag="TracNghiem"/>
                                    <ComboBoxItem Content="Đúng / Sai (True / False)" Tag="DungSai"/>
                                    <ComboBoxItem Content="True / False / Not Given" Tag="TrueFalseNotGiven"/>
                                    <ComboBoxItem Content="Điền từ khuyết (Fill-in-blank)" Tag="DienKhuyet"/>
                                    <ComboBoxItem Content="Trả lời ngắn (Short Answer)" Tag="TraLoiNgan"/>
                                    <ComboBoxItem Content="Nối cặp (Matching)" Tag="NoiCap"/>
                                    <ComboBoxItem Content="Sắp xếp (Sequencing)" Tag="SapXep"/>
                                    <ComboBoxItem Content="Sửa lỗi sai (Error Correction)" Tag="SuaLoiSai"/>
                                    <ComboBoxItem Content="Viết lại câu (Transformation)" Tag="VietLaiCau"/>
                                    <ComboBoxItem Content="Viết tự luận (Essay / Paragraph)" Tag="TuLuan"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Level and Quantity -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CẤP ĐỘ" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboLevel" Height="36" SelectedIndex="2" Cursor="Hand">
                                    <ComboBoxItem Content="A1 — Cơ bản"/>
                                    <ComboBoxItem Content="A2 — Sơ cấp"/>
                                    <ComboBoxItem Content="B1 — Trung cấp"/>
                                    <ComboBoxItem Content="B2 — Trên trung cấp"/>
                                    <ComboBoxItem Content="C1 — Nâng cao"/>
                                    <ComboBoxItem Content="IELTS 6.5+"/>
                                    <ComboBoxItem Content="TOEIC 750+"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SỐ CÂU" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboCount" Height="36" SelectedIndex="0" Cursor="Hand">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="15"/>
                                    <ComboBoxItem Content="20"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Prompt / Topic -->
                        <TextBlock Text="PROMPT / CHỦ ĐỀ" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,18">
                            <TextBox x:Name="txtPrompt" Height="100" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                     Text="5 câu ngữ pháp Thì Hiện Tại Hoàn Thành, B1, kèm giải thích chi tiết..." FontSize="13" Foreground="{StaticResource TextDark}"/>
                        </Border>

                        <!-- Generation Progress State -->
                        <Border x:Name="pnlGeneratingProgress" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="RefreshCw" Size="14" Foreground="#B45309" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtGeneratingStatus" Text="Đang sinh bộ câu hỏi bằng AI..." FontWeight="SemiBold" FontSize="12.5" Foreground="#B45309"/>
                                    </StackPanel>
                                    <Button x:Name="btnCancelGeneration" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" Foreground="#DC2626"
                                            FontWeight="Bold" FontSize="11.5" Padding="8,4" HorizontalAlignment="Right" Cursor="Hand" Click="BtnCancelGeneration_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:LucideIcon Kind="X" Size="11" Foreground="#DC2626" Margin="0,0,4,0"/>
                                            <TextBlock Text="Hủy tạo"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#D97706" Background="#FDE68A" BorderThickness="0" Margin="0,2,0,5"/>
                                <TextBlock Text="Tiến trình đang gọi AI và lưu câu hỏi vào CSDL SQL Server." FontSize="11" Foreground="#78350F" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Generate Button -->
                        <Button x:Name="btnSinhCauHoi" Background="#D97706" Foreground="White" FontWeight="Bold" FontSize="13.5" 
                                Padding="16,10" Cursor="Hand" BorderThickness="0" Click="BtnSinhCauHoi_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <local:LucideIcon Kind="Zap" Size="15" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tạo câu hỏi bằng AI" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right Column: Verification List -->
                <Border Grid.Column="2" Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Kiểm duyệt câu hỏi do AI tạo &amp; Nhập tệp" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnRefreshQueue" Background="#F1F5F9" BorderThickness="0" Padding="8,4" Margin="0,0,8,0" Cursor="Hand" Click="BtnRefreshQueue_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Kind="RefreshCw" Size="12" Foreground="{StaticResource TextDark}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Làm mới" FontSize="11.5" Foreground="{StaticResource TextDark}"/>
                                    </StackPanel>
                                </Button>
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4">
                                    <TextBlock x:Name="txtPendingCount" Text="0 chờ duyệt" FontSize="11.5" FontWeight="SemiBold" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Empty State -->
                        <Border x:Name="pnlEmptyQueue" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="32" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#E2E8F0" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <local:LucideIcon Kind="CheckCircle2" Size="24" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Không có câu hỏi nào đang chờ duyệt" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Bạn có thể tạo câu hỏi mới bằng AI hoặc nhập tệp dữ liệu đề thi ở tab bên cạnh." FontSize="12.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Questions Container -->
                        <StackPanel x:Name="pnlQuestionsList"/>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= VIEW 2: NHẬP TỆP HÀNG LOẠT ================= -->
            <Grid x:Name="pnlNhapTep" Visibility="Collapsed">
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Bóc tách dữ liệu đề thi tự động từ file mẫu chuẩn" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                        <TextBlock Text="Hỗ trợ các định dạng file Excel (.xlsx), Word (.docx) hoặc JSON chuẩn hóa theo cấu trúc của EnglishAI." FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,20"/>

                        <!-- Drag and Drop Zone -->
                        <Border x:Name="dropZoneBorder" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="12" Padding="30" Margin="0,0,0,20" 
                                Cursor="Hand" MouseDown="BtnChonFile_Click" AllowDrop="True" DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#F1F5F9" Margin="0,0,0,10" HorizontalAlignment="Center">
                                    <local:LucideIcon Kind="FolderOpen" Size="28" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Kéo thả file đề thi vào đây hoặc bấm để chọn tệp từ máy tính" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Hỗ trợ định dạng .xlsx, .docx, .json • Tự động nhận diện cấu trúc đề thi" FontSize="12" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Download Template Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                                    FontWeight="Medium" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnDownloadTemplateExcel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:LucideIcon Kind="Download" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tải file Excel mẫu (.xlsx)"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                                    FontWeight="Medium" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnDownloadTemplateDocx_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:LucideIcon Kind="Download" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tải file Word mẫu (.docx)"/>
                                </StackPanel>
                            </Button>
                            <Button Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                                    FontWeight="Medium" Padding="14,8" BorderThickness="0" Cursor="Hand" Click="BtnDownloadTemplateJson_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:LucideIcon Kind="Download" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tải file JSON mẫu (.json)"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Parsing Progress Indicator -->
                        <Border x:Name="pnlParsingProgress" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <local:LucideIcon Kind="RefreshCw" Size="14" Foreground="#1D4ED8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtParsingStatus" Text="Đang bóc tách dữ liệu câu hỏi từ tệp tin..." FontWeight="SemiBold" FontSize="12.5" Foreground="#1D4ED8"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#2563EB" Background="#DBEAFE" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Preview Container After Parsing -->
                        <StackPanel x:Name="pnlParseResult" Visibility="Collapsed">
                            <TextBlock Text="Dữ liệu bóc tách được từ tệp tin:" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>
                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Result Summary -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <local:LucideIcon Kind="CheckCircle2" Size="16" Foreground="#15803D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtParseSummary" Text="Đã nhận diện 0 câu hỏi từ tệp tin" FontWeight="Bold" FontSize="13.5" Foreground="#15803D" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Error Alert if any -->
                                    <Border x:Name="pnlParseErrors" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Các dòng dữ liệu không hợp lệ:" FontWeight="Bold" FontSize="12" Foreground="#DC2626" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="txtParseErrorDetails" Text="" FontSize="11.5" Foreground="#991B1B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Preview Items DataGrid -->
                                    <DataGrid x:Name="dgPreviewParsedQuestions" AutoGenerateColumns="False" CanUserAddRows="False" 
                                              IsReadOnly="True" MaxHeight="280" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                              Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="0,0,0,16">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Binding="{Binding ThuTuHienThi}" Width="50"/>
                                            <DataGridTextColumn Header="Kỹ năng" Binding="{Binding KyNang}" Width="90"/>
                                            <DataGridTextColumn Header="Trình độ" Binding="{Binding TrinhDo}" Width="75"/>
                                            <DataGridTextColumn Header="Dạng câu hỏi" Binding="{Binding LoaiCauHoi}" Width="120"/>
                                            <DataGridTextColumn Header="Nội dung câu hỏi" Binding="{Binding NoiDungCauHoi}" Width="*"/>
                                            <DataGridTextColumn Header="Đáp án đúng" Binding="{Binding DapAnDungHienThi}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Save Actions -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnLuuVaoHangDoi" Background="#D97706" Foreground="White" 
                                                FontWeight="SemiBold" FontSize="13" Padding="18,9" Cursor="Hand" BorderThickness="0" Margin="0,0,10,0" Click="BtnLuuVaoHangDoi_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:LucideIcon Kind="Layers" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                                <TextBlock Text="Đưa vào Hàng đợi kiểm duyệt"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnLuuVaoNganHang" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                                FontWeight="SemiBold" FontSize="13" Padding="18,9" Cursor="Hand" BorderThickness="0" Click="BtnLuuVaoNganHang_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:LucideIcon Kind="Save" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                                <TextBlock Text="Lưu trực tiếp vào Ngân hàng câu hỏi"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
