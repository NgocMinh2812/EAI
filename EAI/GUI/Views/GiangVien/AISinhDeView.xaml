<Page x:Class="GUI.Views.GiangVien.AISinhDeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Tạo câu hỏi bằng AI &amp; Nhập tệp - Admin Dashboard"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickPromptBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút tải file mẫu bo góc đẹp (10px) -->
        <Style x:Key="DownloadTemplateBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Sửa trên thẻ câu hỏi chờ duyệt (Bo góc 8px) -->
        <Style x:Key="CardBtnSuaStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Từ chối trên thẻ câu hỏi chờ duyệt (Bo góc 8px) -->
        <Style x:Key="CardBtnTuChoiStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Phê duyệt trên thẻ câu hỏi chờ duyệt (Bo góc 8px) -->
        <Style x:Key="CardBtnDuyetStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AdminDarkGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER & TABS ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Tạo câu hỏi bằng AI &amp; Nhập tệp" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
            <TextBlock Text="Tạo câu hỏi trắc nghiệm tự động bằng AI và nhập dữ liệu tệp hàng loạt" FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,0,0,14"/>

            <!-- Mode Switcher Tabs -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="tabAISinhDe" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="13" Padding="16,8" Cursor="Hand" BorderThickness="0" Margin="0,0,8,0" Click="TabAISinhDe_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Sparkles" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tạo câu hỏi bằng AI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="tabNhapTep" Content="Nhập tệp" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                        FontWeight="Medium" FontSize="13" Padding="16,8" Cursor="Hand" BorderThickness="0" Click="TabNhapTep_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ================= VIEW 1: AI SINH ĐỀ (SPLIT-VIEW) ================= -->
        <Grid x:Name="pnlAISinhDe" Grid.Row="1" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Generator Form (Cuộn độc lập, ghim cố định không trôi) -->
            <Border Grid.Column="0" Style="{StaticResource AdminCardStyle}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
                    <StackPanel>
                        <!-- Form Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#EA580C" Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0">
                                <TextBlock Text="★" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Yêu cầu tạo câu hỏi bằng AI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- AI Model (Đồng bộ trực tiếp từ cấu hình Giám sát hệ thống) -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:LucideIcon Kind="Cpu" Size="16" Foreground="#15803D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="MÔ HÌNH HOẠT ĐỘNG:" FontSize="10" FontWeight="Bold" Foreground="#15803D" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="txtActiveAiModelInfo" Text="Google Gemini (Đang tải...)" FontSize="10.5" FontWeight="SemiBold" Foreground="#166534"/>
                                    </StackPanel>
                                    <TextBlock Text="Được đồng bộ và quản lý tập trung từ mục Giám sát hệ thống" FontSize="9.5" Foreground="#15803D"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Skill and Question Type -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="KỸ NĂNG MỤC TIÊU" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboSkill" Height="36" SelectedIndex="0" Cursor="Hand"
                                          ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ComboBoxItem Content="Tự động theo chủ đề" Tag=""/>
                                    <ComboBoxItem Content="Đọc hiểu (Reading)" Tag="Doc"/>
                                    <ComboBoxItem Content="Nghe hiểu (Listening)" Tag="Nghe"/>
                                    <ComboBoxItem Content="Viết (Writing)" Tag="Viet"/>
                                    <ComboBoxItem Content="Nói (Speaking)" Tag="Noi"/>
                                    <ComboBoxItem Content="Ngữ pháp (Grammar)" Tag="NguPhap"/>
                                    <ComboBoxItem Content="Từ vựng (Vocabulary)" Tag="TuVung"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DẠNG CÂU HỎI" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboQuestionType" Height="36" SelectedIndex="0" Cursor="Hand"
                                          ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ComboBoxItem Content="Tự động đa dạng" Tag="" ToolTip="Tự động đa dạng dạng câu hỏi theo kỹ năng"/>
                                    <ComboBoxItem Content="Trắc nghiệm (Multiple Choice)" Tag="TracNghiem"/>
                                    <ComboBoxItem Content="Đúng / Sai (True / False)" Tag="DungSai"/>
                                    <ComboBoxItem Content="True / False / Not Given" Tag="TrueFalseNotGiven"/>
                                    <ComboBoxItem Content="Điền từ khuyết (Fill-in-blank)" Tag="DienKhuyet"/>
                                    <ComboBoxItem Content="Trả lời ngắn (Short Answer)" Tag="TraLoiNgan"/>
                                    <ComboBoxItem Content="Sửa lỗi sai (Error Correction)" Tag="SuaLoiSai"/>
                                    <ComboBoxItem Content="Viết lại câu (Transformation)" Tag="VietLaiCau"/>
                                    <ComboBoxItem Content="Viết tự luận (Essay / Paragraph)" Tag="TuLuan"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Level and Quantity -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CẤP ĐỘ" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboLevel" Height="36" SelectedIndex="2" Cursor="Hand"
                                          ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ComboBoxItem Content="A1 — Cơ bản"/>
                                    <ComboBoxItem Content="A2 — Sơ cấp"/>
                                    <ComboBoxItem Content="B1 — Trung cấp"/>
                                    <ComboBoxItem Content="B2 — Trên trung cấp"/>
                                    <ComboBoxItem Content="C1 — Nâng cao"/>
                                    <ComboBoxItem Content="IELTS 6.5+"/>
                                    <ComboBoxItem Content="TOEIC 750+"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SỐ CÂU" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboCount" Height="36" SelectedIndex="0" Cursor="Hand"
                                          ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="15"/>
                                    <ComboBoxItem Content="20"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Nguồn học liệu: Chọn bài học có sẵn trong hệ thống hoặc nhập prompt tự do -->
                        <TextBlock Text="NGUỒN NỘI DUNG / BÀI HỌC CÓ SẴN (TÙY CHỌN)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboExistingLesson" Height="36" Margin="0,0,0,14" SelectionChanged="CboExistingLesson_SelectionChanged" Cursor="Hand"
                                  ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel">
                            <ComboBoxItem Content="-- Nhập chủ đề / yêu cầu tự do --" IsSelected="True"/>
                        </ComboBox>

                        <!-- Prompt / Topic -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="YÊU CẦU / CHỦ ĐỀ RA ĐỀ (*)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Xóa trắng" FontSize="11" Foreground="#64748B" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClearPrompt_Click"/>
                        </Grid>
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <TextBox x:Name="txtPrompt" Height="90" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                     Text="5 câu ngữ pháp Thì Hiện Tại Hoàn Thành, B1, kèm giải thích chi tiết..." FontSize="13" Foreground="{StaticResource TextDark}"/>
                        </Border>

                        <!-- Gợi ý chủ đề nhanh (Quick Prompt Suggestions) -->
                        <TextBlock Text="GỢI Ý CHỦ ĐỀ NHANH:" FontWeight="SemiBold" FontSize="10.5" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="✨ Thì Hiện tại hoàn thành" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" 
                                    Tag="Thì Hiện tại hoàn thành (Present Perfect Tense) - phân biệt với Quá khứ đơn, cách dùng Since/For và các trạng từ chỉ thời gian|NguPhap|B1|TracNghiem"/>
                            <Button Content="✨ Phỏng vấn &amp; IT" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" 
                                    Tag="Từ vựng tiếng Anh chuyên ngành Công nghệ thông tin và Phỏng vấn xin việc (Job Interview &amp; IT Vocabulary)|TuVung|B2|TracNghiem"/>
                            <Button Content="✨ Đọc hiểu: Trí tuệ AI" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" 
                                    Tag="Đoạn văn đọc hiểu về tác động của Trí tuệ nhân tạo (AI) trong giáo dục và công việc tương lai|Doc|B1|TrueFalseNotGiven"/>
                            <Button Content="✨ Nghe: Đặt phòng khách sạn" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" 
                                    Tag="Kịch bản hội thoại đặt phòng khách sạn và dịch vụ lữ hành (Hotel Reservation &amp; Travel Services)|Nghe|A2|TracNghiem"/>
                            <Button Content="✨ Viết lại câu công sở" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" 
                                    Tag="Viết lại câu sử dụng từ gợi ý và tìm sửa lỗi sai ngữ pháp câu ghép, câu phức|Viet|B2|VietLaiCau"/>
                        </WrapPanel>

                        <!-- Generation Progress State -->
                        <Border x:Name="pnlGeneratingProgress" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="RefreshCw" Size="14" Foreground="#B45309" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtGeneratingStatus" Text="Đang sinh bộ câu hỏi bằng AI..." FontWeight="SemiBold" FontSize="12.5" Foreground="#B45309"/>
                                    </StackPanel>
                                    <Button x:Name="btnCancelGeneration" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" Foreground="#DC2626"
                                            FontWeight="Bold" FontSize="11.5" Padding="8,4" HorizontalAlignment="Right" Cursor="Hand" Click="BtnCancelGeneration_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:LucideIcon Kind="X" Size="11" Foreground="#DC2626" Margin="0,0,4,0"/>
                                            <TextBlock Text="Hủy tạo"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#D97706" Background="#FDE68A" BorderThickness="0" Margin="0,2,0,5"/>
                                <TextBlock Text="Tiến trình đang gọi AI và lưu câu hỏi vào CSDL SQL Server." FontSize="11" Foreground="#78350F" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Generate Button -->
                        <Button x:Name="btnSinhCauHoi" Background="#D97706" Foreground="White" FontWeight="Bold" FontSize="13.5" 
                                Padding="16,10" Cursor="Hand" BorderThickness="0" Click="BtnSinhCauHoi_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <local:LucideIcon Kind="Zap" Size="15" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tạo câu hỏi bằng AI" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Column: Verification List (Ghim thanh công cụ trên đầu, danh sách câu hỏi cuộn riêng) -->
            <Border Grid.Column="2" Style="{StaticResource AdminCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Action Bar (Cố định ở trên đầu danh sách) -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Kiểm duyệt câu hỏi do AI tạo &amp; Nhập tệp" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Xem lại, sửa trực tiếp hoặc phê duyệt câu hỏi vào Ngân hàng câu hỏi" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Nút Phê duyệt tất cả (Bo góc 8px) -->
                                <Button x:Name="btnApproveAll" Background="{StaticResource AdminDarkGreen}" Foreground="White" BorderThickness="0"
                                        Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnApproveAll_Click" ToolTip="Phê duyệt toàn bộ các câu hỏi đang chờ vào Ngân hàng câu hỏi">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdApproveAll" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Check" Size="13" Foreground="White" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Duyệt tất cả" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdApproveAll" Property="Background" Value="#047857"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Nút Từ chối tất cả (Bo góc 8px) -->
                                <Button x:Name="btnRejectAll" Background="#FEE2E2" BorderThickness="0"
                                        Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnRejectAll_Click" ToolTip="Từ chối và dọn sạch toàn bộ hàng đợi kiểm duyệt">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdRejectAll" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="X" Size="12" Foreground="#DC2626" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Từ chối tất cả" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdRejectAll" Property="Background" Value="#FECACA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnRefreshQueue" Background="#F1F5F9" BorderThickness="0" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnRefreshQueue_Click" ToolTip="Tải lại danh sách hàng đợi">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdRfQ" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon x:Name="icoRfQueue" Kind="RefreshCw" Size="12" Foreground="{StaticResource TextDark}" Margin="0,0,4,0"
                                                                      RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                                        <local:LucideIcon.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </local:LucideIcon.RenderTransform>
                                                    </local:LucideIcon>
                                                    <TextBlock Text="Làm mới" FontSize="11.5" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <EventTrigger RoutedEvent="ButtonBase.Click">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="icoRfQueue"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:0.7">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdRfQ" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border Background="#FEF3C7" CornerRadius="8" Padding="9,5">
                                    <TextBlock x:Name="txtPendingCount" Text="0 chờ duyệt" FontSize="11.5" FontWeight="SemiBold" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Danh sách câu hỏi cuộn mượt mà độc lập, không kéo cột form -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                        <StackPanel>
                            <!-- Empty State -->
                            <Border x:Name="pnlEmptyQueue" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="32" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#E2E8F0" Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <local:LucideIcon Kind="CheckCircle2" Size="24" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Không có câu hỏi nào đang chờ duyệt" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Bạn có thể tạo câu hỏi mới bằng AI hoặc nhập tệp dữ liệu đề thi ở tab bên cạnh." FontSize="12.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Dynamic Questions Container -->
                            <StackPanel x:Name="pnlQuestionsList"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= VIEW 2: NHẬP TỆP HÀNG LOẠT ================= -->
        <ScrollViewer x:Name="pnlNhapTep" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Đọc nội dung tệp bằng AI &amp; Bóc tách câu hỏi tự động" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                        <TextBlock Text="AI tự động phân tích giáo trình, bài đọc, tài liệu ôn thi hoặc tệp mẫu (.docx, .txt, .pdf, .json - Tối đa 10MB) và trích xuất câu hỏi hoàn chỉnh kèm đáp án." FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,20"/>

                        <!-- Drag and Drop Zone -->
                        <Border x:Name="dropZoneBorder" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="12" Padding="30" Margin="0,0,0,20" 
                                Cursor="Hand" MouseDown="BtnChonFile_Click" AllowDrop="True" DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#F1F5F9" Margin="0,0,0,10" HorizontalAlignment="Center">
                                    <local:LucideIcon Kind="FolderOpen" Size="28" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Kéo thả file đề thi hoặc tài liệu vào đây hoặc bấm để chọn tệp từ máy tính" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Hỗ trợ .docx, .txt, .pdf, .json (Tối đa 10MB) • Tự động nhận diện cấu trúc đề thi hoặc dùng AI biên soạn từ bài đọc" FontSize="12" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Download Template Buttons (Bo góc 10px chuẩn hệ thống) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Style="{StaticResource DownloadTemplateBtnStyle}" Click="BtnDownloadTemplateTxt_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:LucideIcon Kind="FileText" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tải file Text mẫu (.txt)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DownloadTemplateBtnStyle}" Click="BtnDownloadTemplateDocx_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:LucideIcon Kind="Download" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tải file Word mẫu (.docx)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DownloadTemplateBtnStyle}" Margin="0" Click="BtnDownloadTemplateJson_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:LucideIcon Kind="Download" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tải file JSON mẫu (.json)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Parsing Progress Indicator -->
                        <Border x:Name="pnlParsingProgress" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <local:LucideIcon Kind="RefreshCw" Size="14" Foreground="#1D4ED8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtParsingStatus" Text="Đang đọc nội dung và dùng AI phân tích, bóc tách câu hỏi từ tệp tin..." FontWeight="SemiBold" FontSize="12.5" Foreground="#1D4ED8"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#2563EB" Background="#DBEAFE" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Preview Container After Parsing -->
                        <StackPanel x:Name="pnlParseResult" Visibility="Collapsed">
                            <!-- Header of preview with question summary & discard button -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="CheckCircle2" Size="18" Foreground="#15803D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtParseSummary" Text="Đã nhận diện 0 câu hỏi từ tệp tin" FontWeight="Bold" FontSize="14.5" Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Padding="12,6" Cursor="Hand" Click="BtnHuyBocTach_Click" ToolTip="Dọn dẹp và xóa kết quả này">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdQuickClear" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Trash2" Size="13" Foreground="#64748B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Xóa bảng này" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdQuickClear" Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Error Alert if any -->
                            <Border x:Name="pnlParseErrors" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Cảnh báo / Ghi chú định dạng:" FontWeight="Bold" FontSize="12" Foreground="#DC2626" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtParseErrorDetails" Text="" FontSize="11.5" Foreground="#991B1B" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Modern DataGrid Card Container -->
                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,16">
                                <DataGrid x:Name="dgPreviewParsedQuestions" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          IsReadOnly="True" MaxHeight="380" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0"
                                          ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          RowHeight="NaN" AlternatingRowBackground="#FAFAFA">
                                    <DataGrid.Resources>
                                        <!-- Header Style -->
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Padding" Value="12,10"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="Height" Value="40"/>
                                        </Style>

                                        <!-- Row Style -->
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0FDF4"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E0F2FE"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>

                                        <!-- Cell Style -->
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="8,10"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <!-- STT -->
                                        <DataGridTemplateColumn Header="STT" Width="55">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ThuTuHienThi}" FontWeight="Bold" FontSize="11.5" Foreground="#64748B"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Kỹ năng -->
                                        <DataGridTemplateColumn Header="Kỹ năng" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KyNangHienThi}" FontWeight="SemiBold" FontSize="11.5" Foreground="#1D4ED8"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Trình độ -->
                                        <DataGridTemplateColumn Header="Trình độ" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TrinhDo}" FontWeight="Bold" FontSize="11.5" Foreground="#B45309"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Dạng câu hỏi -->
                                        <DataGridTemplateColumn Header="Dạng câu hỏi" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F3E8FF" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LoaiCauHoiHienThi}" FontWeight="Medium" FontSize="11.5" Foreground="#6B21A8"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Nội dung câu hỏi -->
                                        <DataGridTemplateColumn Header="Nội dung câu hỏi" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding NoiDungCauHoi}" TextWrapping="Wrap" FontSize="12.5" Foreground="#0F172A" LineHeight="18" VerticalAlignment="Center" Margin="4,2"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Đáp án đúng -->
                                        <DataGridTemplateColumn Header="Đáp án đúng" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <local:LucideIcon Kind="Check" Size="13" Foreground="#15803D" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DapAnDungHienThi}" FontWeight="SemiBold" FontSize="11.5" Foreground="#15803D" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Save Actions (Bo góc 10px chuẩn hệ thống) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="btnLuuVaoHangDoi" Background="#D97706" Foreground="White" 
                                        FontWeight="SemiBold" FontSize="13" Padding="20,10" Cursor="Hand" BorderThickness="0" Margin="0,0,12,0" Click="BtnLuuVaoHangDoi_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdLuuQueue" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdLuuQueue" Property="Background" Value="#B45309"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bdLuuQueue" Property="Background" Value="#92400E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Kind="Layers" Size="15" Foreground="White" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đưa vào Hàng đợi kiểm duyệt" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" x:Name="btnLuuVaoNganHang" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                        FontWeight="SemiBold" FontSize="13" Padding="20,10" Cursor="Hand" BorderThickness="0" Margin="0,0,12,0" Click="BtnLuuVaoNganHang_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdLuuBank" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdLuuBank" Property="Background" Value="#0A382A"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bdLuuBank" Property="Background" Value="#06251C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Kind="Save" Size="15" Foreground="White" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Lưu trực tiếp vào Ngân hàng câu hỏi" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3" x:Name="btnHuyBocTach" Background="#F1F5F9" Foreground="#64748B" 
                                        FontWeight="SemiBold" FontSize="13" Padding="18,10" Cursor="Hand" BorderThickness="0" Click="BtnHuyBocTach_Click"
                                        ToolTip="Dọn dẹp và xóa toàn bộ kết quả bóc tách hiện tại">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdHuy" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdHuy" Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Kind="Trash2" Size="14" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Xóa kết quả này" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

        </Grid>
</Page>
