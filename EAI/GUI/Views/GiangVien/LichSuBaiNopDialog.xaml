<Window x:Class="GUI.Views.GiangVien.LichSuBaiNopDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        xmlns:conv="clr-namespace:GUI.ViewModels.Common"
        Title="Danh sách bài nộp" 
        Icon="pack://application:,,,/GUI;component/Assets/app_icon.ico"
        Height="560" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConverter"/>
        <conv:NotNullOrEmptyToVisibilityConverter x:Key="NotNullOrEmptyToVisConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="14" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtTitle" Text="Danh sách bài nộp" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Theo dõi điểm số, thời gian làm bài và kết quả của các học viên đã thi" FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnClose_Click" Background="#F1F5F9" BorderThickness="0" Width="32" Height="32" Cursor="Hand" ToolTip="Đóng">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="16"/>
                        </Style>
                    </Button.Resources>
                    <local:LucideIcon Kind="X" Size="16" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. Danh sách bài nộp -->
            <Grid Grid.Row="1">
                <!-- Khi danh sách rỗng -->
                <StackPanel x:Name="pnlEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📭" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Chưa có lượt nộp bài nào cho đề thi này" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Khi học viên bắt đầu làm và nộp bài, kết quả sẽ hiển thị tại đây." FontSize="12.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ListView danh sách lượt nộp -->
                <ListView x:Name="lstAttempts" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,14,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar / Initials -->
                                <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="20" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Thông tin học viên -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding HoTenNguoiDung}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding TenDangNhap, StringFormat='(@{0})'}" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NgayNopFormatted, StringFormat='📅 Nộp: {0}'}" FontSize="11.5" Foreground="{StaticResource TextGray}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding ThoiGianHienThi, StringFormat='⏱️ Thời gian: {0}'}" FontSize="11.5" Foreground="{StaticResource TextGray}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding SoCauDung, StringFormat='✓ Đúng {0}'}" FontSize="11.5" Foreground="#15803D" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding TongSoCau, StringFormat='/{0} câu'}" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Điểm số & Đạt / Không đạt -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DiemHienThi}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right" Margin="0,0,0,3"/>
                                    <Border Background="{Binding TrangThaiKetQuaBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TrangThaiKetQuaText}" FontSize="11" FontWeight="Bold" Foreground="{Binding TrangThaiKetQuaFg}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 3. Footer Button -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Đóng" Click="BtnClose_Click" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        Padding="22,9" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
