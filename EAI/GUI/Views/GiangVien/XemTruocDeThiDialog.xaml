<Window x:Class="GUI.Views.GiangVien.XemTruocDeThiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        xmlns:conv="clr-namespace:GUI.ViewModels.Common"
        Title="Xem trước đề thi" 
        Icon="pack://application:,,,/GUI;component/Assets/app_icon.ico"
        Height="650" Width="840"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConverter"/>
        <conv:NotNullOrEmptyToVisibilityConverter x:Key="NotNullOrEmptyToVisConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="14" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtTitle" Text="Xem trước đề thi" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextDark}"/>
                    <TextBlock x:Name="txtSubtitle" Text="Chi tiết nội dung câu hỏi và đáp án chuẩn" FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnClose_Click" Background="#F1F5F9" BorderThickness="0" Width="32" Height="32" Cursor="Hand" ToolTip="Đóng">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="16"/>
                        </Style>
                    </Button.Resources>
                    <local:LucideIcon Kind="X" Size="16" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. Danh sách câu hỏi -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                <ItemsControl x:Name="icQuestions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource AdminDarkGreen}" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ThuTuCauHoi, StringFormat='Câu {0}'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding KyNang}" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding MaTrinhDo}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                                            </Border>
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding DoKhoHienThi}" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Đoạn văn đọc nếu có -->
                                    <Border Background="#FEF9C3" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                            Visibility="{Binding DoanVanDoc, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                        <TextBlock Text="{Binding DoanVanDoc}" FontSize="12" TextWrapping="Wrap" Foreground="#92400E"/>
                                    </Border>

                                    <TextBlock Text="{Binding NoiDungCauHoi}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>

                                    <!-- Lựa chọn -->
                                    <ItemsControl ItemsSource="{Binding DanhSachLuaChon}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding KyHieuLuaChon, StringFormat='{}{0}.'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding NoiDungLuaChon}" FontSize="12" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                                    <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="4" Padding="6,2" Visibility="{Binding LaDapAnDung, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="✓ Đáp án đúng" FontSize="10.5" FontWeight="Bold" Foreground="#166534"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Lời giải -->
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="8" Margin="0,8,0,0"
                                            Visibility="{Binding GiaiThichDapAn, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                        <TextBlock Text="{Binding GiaiThichDapAn, StringFormat='💡 Giải thích: {0}'}" FontSize="11.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3. Footer Button -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Đóng" Click="BtnClose_Click" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        Padding="22,9" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
