<Window x:Class="GUI.Views.GiangVien.XemTruocDeThiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        xmlns:conv="clr-namespace:GUI.ViewModels.Common"
        Title="Xem trước đề thi" 
        Icon="pack://application:,,,/GUI;component/Assets/app_icon.ico"
        Height="700" Width="880"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConverter"/>
        <conv:NotNullOrEmptyToVisibilityConverter x:Key="NotNullOrEmptyToVisConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#475569" />
        <SolidColorBrush x:Key="BorderLight" Color="#CBD5E1" />
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="14" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.20" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtTitle" Text="Xem trước đề thi" FontWeight="Bold" FontSize="18.5" Foreground="{StaticResource TextDark}"/>
                    <TextBlock x:Name="txtSubtitle" Text="Chi tiết nội dung câu hỏi và đáp án chuẩn" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnClose_Click" Background="#F1F5F9" BorderThickness="0" Width="34" Height="34" Cursor="Hand" ToolTip="Đóng">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>
                    </Button.Resources>
                    <local:LucideIcon Kind="X" Size="16" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. Banner chế độ xem trước dành cho Giảng viên & Audio đề thi -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <!-- Banner giải thích chế độ Giảng viên xem trước -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <local:LucideIcon Kind="Info" Size="18" Foreground="#0F4C3A" Margin="0,2,10,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Chế độ xem trước dành cho Giảng viên / Quản trị viên" FontWeight="Bold" FontSize="13" Foreground="#0F4C3A"/>
                            <TextBlock Text="Hệ thống hiển thị trực quan toàn bộ Kịch bản bài nghe (Audio Script), Ngữ liệu và Đáp án chuẩn để tiện rà soát. Khi học viên làm bài thực tế, học viên sẽ nghe âm thanh theo quy tắc phát và không nhìn thấy kịch bản hay đáp án." 
                                       FontSize="12" Foreground="#1E293B" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Thanh thông tin Audio Đề thi nếu có đính kèm -->
                <Border x:Name="pnlExamAudio" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14,9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:LucideIcon Kind="Volume2" Size="18" Foreground="#0F4C3A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="File Audio Đề thi: " FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock x:Name="txtAudioFileName" Text="audio.mp3" FontSize="12" FontWeight="SemiBold" Foreground="#0F4C3A"/>
                            </StackPanel>
                            <TextBlock x:Name="txtAudioRule" Text="Quy tắc phát âm thanh" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="btnPlayAudio" Grid.Column="2" Content="▶ Nghe thử" Click="BtnTogglePlay_Click"
                                Background="#0F4C3A" Foreground="White" FontWeight="Bold" FontSize="12" Padding="14,6" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. Danh sách câu hỏi -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                <ItemsControl x:Name="icQuestions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header câu hỏi: số thứ tự & tags -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource AdminDarkGreen}" CornerRadius="5" Padding="8,4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ThuTuCauHoi, StringFormat='Câu {0}'}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding KyNang}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding MaTrinhDo}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                            </Border>
                                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="5" Padding="7,3">
                                                <TextBlock Text="{Binding DoKhoHienThi}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Kịch bản bài nghe / Đoạn văn đọc nếu có -->
                                    <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                                            Visibility="{Binding DoanVanDoc, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <local:LucideIcon Kind="FileText" Size="14" Foreground="#92400E" Margin="0,1,6,0"/>
                                                <TextBlock Text="🎧 Kịch bản bài nghe (Audio Script) / Ngữ liệu đọc tham chiếu [Xem trước]:" 
                                                           FontSize="11.5" FontWeight="Bold" Foreground="#92400E"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DoanVanDoc}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Foreground="#451A03"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Nội dung câu hỏi -->
                                    <TextBlock Text="{Binding NoiDungCauHoi}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextDark}" Margin="0,0,0,10" LineHeight="19"/>

                                    <!-- Danh sách các lựa chọn -->
                                    <ItemsControl ItemsSource="{Binding DanhSachLuaChon}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,3,0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding KyHieuLuaChon, StringFormat='{}{0}.'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding NoiDungLuaChon}" FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="5" Padding="8,3" Visibility="{Binding LaDapAnDung, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="✓ Đáp án đúng" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Lời giải & Giải thích -->
                                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                            Visibility="{Binding GiaiThichDapAn, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                        <TextBlock Text="{Binding GiaiThichDapAn, StringFormat='💡 Hướng dẫn &amp; Giải thích: {0}'}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" LineHeight="18"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4. Footer Button -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Đóng" Click="BtnClose_Click" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        Padding="26,10" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
