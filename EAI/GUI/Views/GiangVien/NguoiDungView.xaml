<Page x:Class="GUI.Views.GiangVien.NguoiDungView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý Người dùng - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- ================= TOP HEADER ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý Người dùng" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtStatsSummary" Text="7 tài khoản • 5 đang hoạt động" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="➕ Tạo tài khoản" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="13" Padding="18,10" Cursor="Hand" BorderThickness="0" Click="BtnTaoTaiKhoan_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ================= FILTER BAR ================= -->
            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Foreground="{StaticResource TextGray}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtSearchUser" Grid.Column="1" Text="Tìm theo tên hoặc email..." Foreground="{StaticResource TextGray}" 
                                 Background="Transparent" BorderThickness="0" FontSize="13" VerticalAlignment="Center" 
                                 GotFocus="TxtSearchUser_GotFocus" LostFocus="TxtSearchUser_LostFocus" TextChanged="TxtSearchUser_TextChanged"/>
                    </Grid>

                    <!-- Role Dropdown Filter -->
                    <ComboBox x:Name="cboRoleFilter" Grid.Column="1" Width="140" Height="32" SelectedIndex="0" SelectionChanged="CboRoleFilter_SelectionChanged" Cursor="Hand">
                        <ComboBoxItem Content="Tất cả vai trò"/>
                        <ComboBoxItem Content="Học viên"/>
                        <ComboBoxItem Content="Quản trị viên"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ================= USER LIST TABLE ================= -->
            <Border Style="{StaticResource AdminCardStyle}" Padding="0" ClipToBounds="True">
                <StackPanel>

                    <!-- Table Header -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="NGƯỜI DÙNG" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Grid.Column="1" Text="VAI TRÒ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Grid.Column="2" Text="TRÌNH ĐỘ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Grid.Column="3" Text="ĐĂNG NHẬP CUỐI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Grid.Column="4" Text="TRẠNG THÁI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Grid.Column="5" Text="THAO TÁC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Table Items List -->
                    <ItemsControl x:Name="icUserList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,12">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- User Profile (Avatar + Name + Email) -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding AvatarBg}" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="12.5" Foreground="{Binding AvatarFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextDark}"/>
                                                <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Vai trò -->
                                        <Border Grid.Column="1" Background="{Binding RoleBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding RoleFg}"/>
                                        </Border>

                                        <!-- Trình độ -->
                                        <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>

                                        <!-- Đăng nhập cuối -->
                                        <TextBlock Grid.Column="3" Text="{Binding LastLogin}" FontSize="12.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>

                                        <!-- Trạng thái -->
                                        <Border Grid.Column="4" Background="{Binding StatusBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StatusFg}"/>
                                        </Border>

                                        <!-- Thao tác -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" ToolTip="Chỉnh sửa thông tin" Click="BtnEditUser_Click" Tag="{Binding Id}">
                                                <TextBlock Text="✏️" FontSize="11"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="Khóa / Mở tài khoản" Click="BtnToggleStatus_Click" Tag="{Binding Id}">
                                                <TextBlock Text="{Binding LockIcon}" FontSize="11"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="Xóa người dùng" Click="BtnDeleteUser_Click" Tag="{Binding Id}">
                                                <TextBlock Text="🗑️" FontSize="11" Foreground="#EF4444"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Table Footer: Pagination & Filter Chips -->
                    <Border Background="#FAFBFB" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="txtCounter" Text="Hiển thị 7 / 7 tài khoản" FontSize="12" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Tất cả" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" Click="FilterStatus_All"/>
                                <Button Content="Hoạt động" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                        FontSize="11.5" FontWeight="Medium" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" Click="FilterStatus_Active"/>
                                <Button Content="Đã khóa" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                        FontSize="11.5" FontWeight="Medium" Padding="10,4" Cursor="Hand" Click="FilterStatus_Locked"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
