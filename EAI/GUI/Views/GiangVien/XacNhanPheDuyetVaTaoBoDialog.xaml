<Window x:Class="GUI.Views.GiangVien.XacNhanPheDuyetVaTaoBoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Xác nhận phê duyệt câu hỏi"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A"/>
        <SolidColorBrush x:Key="AdminMint" Color="#10B981"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextGray" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
    </Window.Resources>

    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Margin="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Dialog -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#ECFDF5" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <local:LucideIcon Kind="CheckCircle2" Size="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Xác nhận phê duyệt câu hỏi" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Phê duyệt câu hỏi vào Ngân hàng câu hỏi và tùy chọn gom nhóm thành Bộ câu hỏi" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnHuy_Click" Background="#F1F5F9" BorderThickness="0" Width="30" Height="30" Cursor="Hand" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <local:LucideIcon Kind="X" Size="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Thông tin tóm tắt số lượng -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#DCFCE7" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center">
                        <local:LucideIcon Kind="Layers" Size="18" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="SỐ LƯỢNG PHÊ DUYỆT:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtSoLuongPheDuyet" Text="15 câu hỏi" FontSize="12" FontWeight="Bold" Foreground="#15803D"/>
                        </StackPanel>
                        <TextBlock x:Name="txtChuDeYeuCau" Text="Chủ đề: Ngữ pháp đưa ra lời khuyên" FontSize="12" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Tùy chọn Bộ câu hỏi -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="TÙY CHỌN BỘ CÂU HỎI TRONG NGÂN HÀNG CÂU HỎI:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>

                <!-- Lựa chọn 1: Tạo Bộ câu hỏi mới -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <RadioButton x:Name="rbTaoBoMoi" GroupName="grpBoCauHoi" IsChecked="True" Checked="Radio_Checked" Cursor="Hand">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="FolderPlus" Size="15" Foreground="#0F4C3A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tạo một Bộ câu hỏi mới trong hệ thống" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Khung nhập tên và mô tả bộ mới -->
                        <StackPanel x:Name="pnlTaoBoMoi" Margin="24,10,0,0">
                            <TextBlock Text="TÊN BỘ CÂU HỎI (*)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTenBoMoi" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                     FontSize="13" Foreground="{StaticResource TextDark}" BorderBrush="{StaticResource BorderLight}" Margin="0,0,0,8"/>

                            <TextBlock Text="MÔ TẢ BỘ CÂU HỎI (TÙY CHỌN)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtMoTaBoMoi" Height="48" Padding="10,6" TextWrapping="Wrap" AcceptsReturn="True"
                                     FontSize="12" Foreground="{StaticResource TextDark}" BorderBrush="{StaticResource BorderLight}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Lựa chọn 2: Thêm vào Bộ câu hỏi đã có sẵn -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <RadioButton x:Name="rbThemVaoBoCoSan" GroupName="grpBoCauHoi" Checked="Radio_Checked" Cursor="Hand">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="FolderInput" Size="15" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thêm vào Bộ câu hỏi đã có sẵn" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Khung chọn bộ câu hỏi có sẵn -->
                        <StackPanel x:Name="pnlThemVaoBoCoSan" Margin="24,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="CHỌN BỘ CÂU HỎI ĐÍCH (*)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cboBoCauHoiCoSan" Height="36" Cursor="Hand"
                                      ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Lựa chọn 3: Chỉ lưu vào ngân hàng câu hỏi -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <RadioButton x:Name="rbChiLuuNganHang" GroupName="grpBoCauHoi" Checked="Radio_Checked" Cursor="Hand">
                        <RadioButton.Content>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <local:LucideIcon Kind="Database" Size="15" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chỉ lưu vào Ngân hàng câu hỏi chung" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>
                                <TextBlock Text="Các câu hỏi sẽ lưu độc lập vào kho ngân hàng, bạn có thể gán vào đề thi hoặc bộ câu hỏi sau." FontSize="11" Foreground="{StaticResource TextGray}" Margin="21,2,0,0"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                </Border>
            </StackPanel>

            <!-- 4. Footer Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Click="BtnHuy_Click" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                        FontWeight="SemiBold" FontSize="13" Padding="18,9" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                <Button x:Name="btnXacNhan" Click="BtnXacNhan_Click" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="13" Padding="20,9" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Kind="Check" Size="15" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Xác nhận phê duyệt" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

