<Window x:Class="GUI.Views.GiangVien.XacNhanPheDuyetVaTaoBoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Xác nhận phê duyệt câu hỏi"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A"/>
        <SolidColorBrush x:Key="AdminMint" Color="#10B981"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextGray" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>

        <!-- Nút Hủy bo góc -->
        <Style x:Key="DialogBtnCancel" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Xác nhận bo góc -->
        <Style x:Key="DialogBtnConfirm" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AdminDarkGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A382A"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#06251C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style TextBox bo góc -->
        <Style x:Key="DialogTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Đổ bóng nền phía sau -->
        <Border CornerRadius="16" Background="#0F172A">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.22" Color="#0F172A"/>
            </Border.Effect>
        </Border>

        <!-- Khung nội dung hộp thoại -->
        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="24" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Dialog -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#ECFDF5" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <local:LucideIcon Kind="CheckCircle2" Size="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Xác nhận phê duyệt câu hỏi" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Phê duyệt câu hỏi vào Ngân hàng câu hỏi và tùy chọn gom nhóm thành Bộ câu hỏi" FontSize="12.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Nút đóng tròn bo góc -->
                    <Button Grid.Column="1" Click="BtnHuy_Click" Background="#F1F5F9" BorderThickness="0" Width="32" Height="32" Cursor="Hand" VerticalAlignment="Top" ToolTip="Đóng">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                                    <local:LucideIcon x:Name="ico" Kind="X" Size="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                        <Setter TargetName="ico" Property="Foreground" Value="#DC2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 2. Thông tin tóm tắt số lượng -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#DCFCE7" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center">
                            <local:LucideIcon Kind="Layers" Size="18" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="SỐ LƯỢNG PHÊ DUYỆT:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtSoLuongPheDuyet" Text="15 câu hỏi" FontSize="12" FontWeight="Bold" Foreground="#15803D"/>
                            </StackPanel>
                            <!-- Text hiển thị đầy đủ không bị cắt -->
                            <TextBlock x:Name="txtChuDeYeuCau" Text="Chủ đề / Yêu cầu: Ngữ pháp đưa ra lời khuyên" FontSize="12" Foreground="{StaticResource TextDark}" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Tùy chọn Bộ câu hỏi -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="TÙY CHỌN BỘ CÂU HỎI TRONG NGÂN HÀNG CÂU HỎI:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>

                    <!-- Lựa chọn 1: Tạo Bộ câu hỏi mới -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <RadioButton x:Name="rbTaoBoMoi" GroupName="grpBoCauHoi" IsChecked="True" Checked="Radio_Checked" Cursor="Hand">
                                <RadioButton.Content>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="FolderPlus" Size="15" Foreground="#0F4C3A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tạo một Bộ câu hỏi mới trong hệ thống" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Khung nhập tên và mô tả bộ mới -->
                            <StackPanel x:Name="pnlTaoBoMoi" Margin="24,10,0,0">
                                <TextBlock Text="TÊN BỘ CÂU HỎI (*)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtTenBoMoi" Height="36" Padding="10,0" Style="{StaticResource DialogTextBox}"
                                         FontSize="13" Margin="0,0,0,8"/>

                                <TextBlock Text="MÔ TẢ BỘ CÂU HỎI (TÙY CHỌN)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtMoTaBoMoi" Height="48" Padding="10,6" TextWrapping="Wrap" AcceptsReturn="True"
                                         Style="{StaticResource DialogTextBox}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Lựa chọn 2: Thêm vào Bộ câu hỏi đã có sẵn -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <RadioButton x:Name="rbThemVaoBoCoSan" GroupName="grpBoCauHoi" Checked="Radio_Checked" Cursor="Hand">
                                <RadioButton.Content>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="FolderInput" Size="15" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thêm vào Bộ câu hỏi đã có sẵn" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Khung chọn bộ câu hỏi có sẵn -->
                            <StackPanel x:Name="pnlThemVaoBoCoSan" Margin="24,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="CHỌN BỘ CÂU HỎI ĐÍCH (*)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                                <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8">
                                    <ComboBox x:Name="cboBoCauHoiCoSan" Height="36" Cursor="Hand" BorderThickness="0" Background="Transparent"
                                              Padding="8,0" VerticalContentAlignment="Center"
                                              ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Lựa chọn 3: Chỉ lưu vào ngân hàng câu hỏi -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <RadioButton x:Name="rbChiLuuNganHang" GroupName="grpBoCauHoi" Checked="Radio_Checked" Cursor="Hand">
                            <RadioButton.Content>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Kind="Database" Size="15" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chỉ lưu vào Ngân hàng câu hỏi chung" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- Hiển thị đầy đủ không bị che khuất -->
                                    <TextBlock Text="Các câu hỏi sẽ lưu độc lập vào kho ngân hàng, bạn có thể gán vào đề thi hoặc bộ câu hỏi sau." 
                                               FontSize="11.5" Foreground="{StaticResource TextGray}" Margin="21,3,0,0" TextWrapping="Wrap" LineHeight="17"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                    </Border>
                </StackPanel>

                <!-- 4. Footer Actions (Nút bo góc mềm mại) -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" Click="BtnHuy_Click" Style="{StaticResource DialogBtnCancel}" Margin="0,0,12,0"/>

                    <Button x:Name="btnXacNhan" Click="BtnXacNhan_Click" Style="{StaticResource DialogBtnConfirm}">
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Kind="Check" Size="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xác nhận phê duyệt" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
