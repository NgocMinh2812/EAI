<Page x:Class="GUI.Views.GiangVien.NganHangCauHoiView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      xmlns:vm="clr-namespace:GUI.ViewModels.GiangVien"
      xmlns:conv="clr-namespace:GUI.ViewModels.Common"
      Title="Ngân hàng câu hỏi - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.DataContext>
        <vm:NganHangCauHoiViewModel />
    </Page.DataContext>

    <Page.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ngân hàng Câu hỏi &amp; Kiểm duyệt Đáp án (US-GV06)" FontWeight="Bold" FontSize="22" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                <TextBlock Text="Quản lý câu hỏi trắc nghiệm, đoạn văn đọc, nghe audio, giải thích chi tiết và kiểm duyệt chất lượng" FontSize="13" Foreground="{StaticResource TextGray}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ThemCauHoiMoiCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        Padding="16,9" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Plus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Thêm câu hỏi mới" FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Filter Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="30,8,10,8" VerticalContentAlignment="Center" FontSize="13"
                             BorderBrush="{StaticResource BorderLight}">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <local:LucideIcon Kind="Search" Size="14" Foreground="{StaticResource TextGray}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <ComboBox Grid.Column="2" SelectedValue="{Binding FilterKyNang}" SelectedValuePath="Tag"
                          Padding="8,6" VerticalContentAlignment="Center">
                    <ComboBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBoxItem Content="Tất cả kỹ năng" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Đọc hiểu" Tag="Doc"/>
                    <ComboBoxItem Content="Nghe hiểu" Tag="Nghe"/>
                    <ComboBoxItem Content="Ngữ pháp" Tag="NguPhap"/>
                    <ComboBoxItem Content="Từ vựng" Tag="TuVung"/>
                </ComboBox>

                <ComboBox Grid.Column="4" SelectedValue="{Binding FilterDoKho}" SelectedValuePath="Tag"
                          Padding="8,6" VerticalContentAlignment="Center">
                    <ComboBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBoxItem Content="Tất cả độ khó" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Dễ" Tag="De"/>
                    <ComboBoxItem Content="Trung bình" Tag="TrungBinh"/>
                    <ComboBoxItem Content="Khó" Tag="Kho"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 3. Main 2-Column Split -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH CÂU HỎI TRONG NGÂN HÀNG -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CÂU HỎI TRONG NGÂN HÀNG" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextGray}" Margin="4,0,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding DanhSachCauHoi}" SelectedItem="{Binding CurrentCauHoi, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bdItem" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bdItem" Property="Background" Value="#F0FDF4"/>
                                                    <Setter TargetName="bdItem" Property="BorderBrush" Value="#10B981"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding KyNang}" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding MaTrinhDo}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding NoiDungCauHoi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextWrapping="Wrap" MaxHeight="38"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: FORM NHẬP LIỆU & QUẢN LÝ ĐÁP ÁN -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CẤU HÌNH CHI TIẾT CÂU HỎI &amp; ĐÁP ÁN" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,0,14"/>

                        <!-- Loại câu hỏi & Độ khó & Cấp độ -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Loại câu hỏi" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding CurrentCauHoi.LoaiCauHoi}" SelectedValuePath="Tag" Padding="6">
                                    <ComboBoxItem Content="Trắc nghiệm (MCQ)" Tag="TracNghiem" IsSelected="True"/>
                                    <ComboBoxItem Content="Điền khuyết" Tag="DienKhuyet"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kỹ năng" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding CurrentCauHoi.KyNang}" SelectedValuePath="Tag" Padding="6">
                                    <ComboBoxItem Content="Đọc hiểu" Tag="Doc" IsSelected="True"/>
                                    <ComboBoxItem Content="Nghe hiểu" Tag="Nghe"/>
                                    <ComboBoxItem Content="Ngữ pháp" Tag="NguPhap"/>
                                    <ComboBoxItem Content="Từ vựng" Tag="TuVung"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Độ khó" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding CurrentCauHoi.DoKho}" SelectedValuePath="Tag" Padding="6">
                                    <ComboBoxItem Content="Dễ" Tag="De"/>
                                    <ComboBoxItem Content="Trung bình" Tag="TrungBinh" IsSelected="True"/>
                                    <ComboBoxItem Content="Khó" Tag="Kho"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Audio đính kèm -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding ChonAudioCommand}" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="8,4" Cursor="Hand" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Kind="Headphones" Size="13" Foreground="#10B981" Margin="0,0,5,0"/>
                                        <TextBlock Text="Chọn Audio" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Grid.Column="1" Text="{Binding CurrentCauHoi.AudioPath}" FontSize="11.5" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                <Button Grid.Column="2" Command="{Binding TogglePlayAudioCommand}" Background="#10B981" Foreground="White" BorderThickness="0" Padding="8,4" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Kind="Play" Size="12" Foreground="White" Margin="0,0,4,0"/>
                                        <TextBlock Text="Nghe thử" FontSize="11.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Đoạn văn đọc Reading Passage -->
                        <TextBlock Text="Đoạn văn đọc (Reading Passage - Tùy chọn)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentCauHoi.DoanVanDoc, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" Padding="8" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <!-- Nội dung câu hỏi -->
                        <TextBlock Text="Nội dung câu hỏi (*)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentCauHoi.NoiDungCauHoi, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" Padding="8" Margin="0,0,0,14" TextWrapping="Wrap" FontSize="13"/>

                        <!-- Danh sách phương án đáp án -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="PHƯƠNG ÁN LỰA CHỌN (CHỌN DUY NHẤT 1 ĐÁP ÁN ĐÚNG)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <Button Content="+ Thêm phương án" Command="{Binding ThemDapAnCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource AdminMint}" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="11.5"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DanhSachDapAn}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <RadioButton Grid.Column="0" GroupName="DapAnDungGroup" IsChecked="{Binding LaDapAnDung, Mode=TwoWay}"
                                                     Command="{Binding DataContext.ChonDapAnDungCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                     CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Đánh dấu đáp án đúng"/>

                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Width="26" Height="26" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KyHieuLuaChon}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBox Grid.Column="2" Text="{Binding NoiDungLuaChon, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="8,0,8,0" VerticalAlignment="Center"/>

                                        <Button Grid.Column="3" Content="✕" Command="{Binding DataContext.XoaDapAnCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Lời giải thích -->
                        <TextBlock Text="Lời giải thích chi tiết đáp án" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentCauHoi.GiaiThichDapAn, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" Padding="8" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <CheckBox Content="Đã kiểm duyệt chất lượng câu hỏi" IsChecked="{Binding CurrentCauHoi.DaKiemDuyet}" Margin="0,0,0,14" FontWeight="SemiBold"/>

                        <!-- Báo lỗi -->
                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14"
                                Visibility="{Binding ThongBaoLoi, Converter={StaticResource StringNotEmptyToVisConverter}}">
                            <TextBlock Text="{Binding ThongBaoLoi}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Lưu câu hỏi (Transaction an toàn)" Command="{Binding LuuCauHoiCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White" Padding="20,10" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
