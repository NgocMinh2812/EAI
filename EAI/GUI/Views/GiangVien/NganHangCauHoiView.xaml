<Page x:Class="GUI.Views.GiangVien.NganHangCauHoiView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ngân hàng câu hỏi - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ngân hàng Câu hỏi &amp; Quản lý Bộ đề Gốc" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                <TextBlock Text="Tổ chức câu hỏi theo từng tệp đề gốc (PDF / DOCX), xem trước văn bản đề thi và trích xuất câu hỏi tự động" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📥 Nạp đề từ file (.pdf, .docx)" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                        FontWeight="SemiBold" FontSize="12.5" Padding="14,9" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnImportExamFile_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="➕ Thêm câu hỏi thủ công" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="12.5" Padding="16,9" BorderThickness="0" Cursor="Hand" Click="BtnCreateManualQuestion_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2-Column Split: Source Exam Files on Left, Deep Question Inspector on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: SOURCE EXAM FILES ================= -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,10">
                        <TextBlock Text="CÁC BỘ ĐỀ NGUỒN ĐÃ BÓC TÁCH (4)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Exam File 1 -->
                            <Border x:Name="itemExam1" Background="#F0FDF4" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,14" Cursor="Hand" MouseDown="ExamFile1_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="PDF • IELTS Academic" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                                        </Border>
                                        <TextBlock Text="Đã duyệt" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Grid>
                                    <TextBlock Text="Cambridge_IELTS_18_Test1_Reading.pdf" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="40 câu hỏi • 3 Bài đọc • Dung lượng 1.8 MB" FontSize="11.5" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Exam File 2 -->
                            <Border x:Name="itemExam2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,14" Cursor="Hand" MouseDown="ExamFile2_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="DOCX • TOEIC Format" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </Border>
                                        <TextBlock Text="Đã duyệt" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Grid>
                                    <TextBlock Text="ETS_TOEIC_Part5_6_GrammarDrills.docx" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="50 câu hỏi • Part 5 &amp; 6 • Dung lượng 850 KB" FontSize="11.5" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Exam File 3 -->
                            <Border x:Name="itemExam3" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,14" Cursor="Hand" MouseDown="ExamFile3_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="PDF • VSTEP B2" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                                        </Border>
                                        <TextBlock Text="Chờ duyệt" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#EA580C"/>
                                    </Grid>
                                    <TextBlock Text="DeThi_VSTEP_B2_ChuanBoGDDT_2026.pdf" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="35 câu hỏi • Đọc hiểu B2 • Dung lượng 2.1 MB" FontSize="11.5" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Exam File 4 -->
                            <Border x:Name="itemExam4" Background="White" Padding="16,14" Cursor="Hand" MouseDown="ExamFile4_Click">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="DOCX • Business" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </Border>
                                        <TextBlock Text="Đã duyệt" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Grid>
                                    <TextBlock Text="Business_English_Contract_Vocab.docx" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="25 câu trắc nghiệm • Từ vựng hợp đồng • 640 KB" FontSize="11.5" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= RIGHT: DEEP QUESTION INSPECTOR ================= -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Inspector Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="txtInspectExamTitle" Text="Cambridge_IELTS_18_Test1_Reading.pdf" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtInspectExamMeta" Text="Bộ đề nguồn: IELTS Academic • 40 câu hỏi đã trích xuất thành công • AI đã phân tích lời giải" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📥 Tải đề gốc (.pdf)" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnDownloadExam_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="➕ Đưa vào Đề thi thử" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                        FontWeight="SemiBold" FontSize="11.5" Padding="12,6" BorderThickness="0" Cursor="Hand" Click="BtnAddAllToMockTest_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#135E48"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Questions List from Exam -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel x:Name="pnlExtractedQuestions">

                            <!-- Question 1 -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="Câu 1 • True / False / Not Given" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                            </Border>
                                            <TextBlock Text="Độ khó: B2" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Trích xuất từ: Paragraph 2, Dòng 8-12" FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="Roman concrete degrades at the same rate as 20th-century Portland cement." FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>

                                    <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="➔ ĐÁP ÁN ĐÚNG: FALSE" FontWeight="Bold" FontSize="12" Foreground="#166534" Margin="0,0,0,2"/>
                                            <TextBlock Text="Dẫn chứng trong văn bản: 'While modern concrete degrades within decades, Roman pozzolanic concrete demonstrated extraordinary self-healing properties...'" FontSize="11.5" Foreground="#15803D"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Question 2 -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="Câu 2 • Multiple Choice" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                            <TextBlock Text="Độ khó: B2" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Trích xuất từ: Paragraph 4, Dòng 19-24" FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="What chemical element triggers the self-healing process when water enters microcracks?" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>

                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <TextBlock Text="A) Silica" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                        <TextBlock Text="B) Calcium (Đáp án đúng ✓)" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                                        <TextBlock Text="C) Magnesium" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                        <TextBlock Text="D) Sodium" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                    </UniformGrid>

                                    <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="➔ GIẢI THÍCH CHI TIẾT CỦA AI:" FontWeight="Bold" FontSize="12" Foreground="#166534" Margin="0,0,0,2"/>
                                            <TextBlock Text="Canxi (Calcium) chứa trong các lime clasts phản ứng với nước mưa xâm nhập, kết tinh lại thành canxit (calcite) để bịt kín các vết nứt nẻ." FontSize="11.5" Foreground="#15803D"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Question 3 -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#F3E8FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="Câu 3 • Summary Completion (Điền từ)" FontSize="11" FontWeight="Bold" Foreground="#7E22CE"/>
                                            </Border>
                                            <TextBlock Text="Độ khó: C1" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Trích xuất từ: Paragraph 6, Dòng 35-40" FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="Complete the sentence with NO MORE THAN TWO WORDS: The ancient structures were able to withstand harsh ______ environments without collapsing." FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>

                                    <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="➔ ĐÁP ÁN ĐÚNG: 'marine'" FontWeight="Bold" FontSize="12" Foreground="#166534" Margin="0,0,0,2"/>
                                            <TextBlock Text="Dẫn chứng: '...often under harsh marine conditions.'" FontSize="11.5" Foreground="#15803D"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
