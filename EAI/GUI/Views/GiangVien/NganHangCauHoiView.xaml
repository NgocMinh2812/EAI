<Page x:Class="GUI.Views.GiangVien.NganHangCauHoiView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      xmlns:vm="clr-namespace:GUI.ViewModels.GiangVien"
      xmlns:conv="clr-namespace:GUI.ViewModels.Common"
      Title="Ngân hàng câu hỏi - Admin Dashboard"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Background="#F8FAFC">

    <Page.DataContext>
        <vm:NganHangCauHoiViewModel />
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <!-- Style Thanh trượt tua Audio Timeline -->
        <Style x:Key="ModernAudioSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <!-- Đường ray nền -->
                            <Border Height="4" Background="#E2E8F0" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#10B981" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="12" Height="12" Background="#10B981" BorderBrush="White" BorderThickness="2" CornerRadius="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#0F172A"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Ngân Hàng Câu Hỏi &amp; Quản Lý Bộ Câu Hỏi" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,3"/>
                <TextBlock Text="Quản lý bộ câu hỏi theo nguồn (AI, bài học, tài liệu, thủ công) và chi tiết kiểm duyệt nội dung câu hỏi" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LamMoiCommand}" Background="White" Foreground="{StaticResource TextDark}" 
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Padding="12,8" Cursor="Hand" Margin="0,0,10,0" ToolTip="Làm mới toàn bộ danh sách bộ và câu hỏi">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdRf" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon x:Name="icoRefreshTop" Kind="RefreshCw" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0"
                                                      RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                        <local:LucideIcon.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </local:LucideIcon.RenderTransform>
                                    </local:LucideIcon>
                                    <TextBlock Text="Làm mới" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="ButtonBase.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="icoRefreshTop"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.7">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdRf" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Command="{Binding TaoBoCauHoiMoiCommand}" Background="#0284C7" Foreground="White" 
                        Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Tạo một bộ câu hỏi trống mới">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="FolderPlus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tạo bộ câu hỏi mới" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Command="{Binding ThemCauHoiMoiCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        Padding="14,8" BorderThickness="0" Cursor="Hand" ToolTip="Tạo một câu hỏi trắc nghiệm mới">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Plus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Thêm câu hỏi mới" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Main 3-Column Split: BỘ CÂU HỎI | CÂU HỎI TRONG BỘ | CHI TIẾT & BIÊN TẬP -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- CỘT 1: DANH SÁCH BỘ CÂU HỎI (MASTER - Rộng rãi 270px) -->
                <ColumnDefinition Width="270" MinWidth="220" MaxWidth="400"/>
                <!-- Splitter 1 -->
                <ColumnDefinition Width="10"/>
                <!-- CỘT 2: DANH SÁCH CÂU HỎI TRONG BỘ (Rộng rãi 330px) -->
                <ColumnDefinition Width="330" MinWidth="270" MaxWidth="480"/>
                <!-- Splitter 2 -->
                <ColumnDefinition Width="10"/>
                <!-- CỘT 3: CHI TIẾT & BIÊN TẬP CÂU HỎI (DETAIL - Co giãn linh hoạt) -->
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT 1: BỘ CÂU HỎI (QUESTION SETS) ================= -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="12,12,3,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Count (Nguyên hàng với 2 cột bên cạnh) -->
                    <Grid Grid.Row="0" Margin="4,0,13,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BỘ CÂU HỎI" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Ngân hàng &amp; các bộ đề ôn tập" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DanhSachBoCauHoi.Count, StringFormat='{}{0} bộ'}" FontWeight="Bold" FontSize="11.5" Foreground="#15803D"/>
                        </Border>
                    </Grid>

                    <!-- Search & Filter sets -->
                    <StackPanel Grid.Row="1" Margin="0,0,9,10">
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="txtSearchBo" Text="{Binding TuKhoaTimKiemBo, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="28,7,8,7" VerticalContentAlignment="Center" FontSize="12"
                                     BorderBrush="{StaticResource BorderLight}">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <local:LucideIcon Kind="Search" Size="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tìm theo tên bộ câu hỏi..." FontSize="11.5" Foreground="{StaticResource TextGray}"
                                       VerticalAlignment="Center" Margin="28,0,8,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearchBo}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox SelectedValue="{Binding FilterNguonTaoBo}" SelectedValuePath="Tag" Padding="8,5" FontSize="12" MaxDropDownHeight="240">
                            <ComboBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Tất cả nguồn" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="AI • Danh mục &amp; Cấu trúc" Tag="AI_DanhMuc"/>
                            <ComboBoxItem Content="AI • Nội dung học tập" Tag="AI_BaiHoc"/>
                            <ComboBoxItem Content="Thủ công" Tag="ThuCong"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Sets ListBox -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding DanhSachBoCauHoi}" SelectedItem="{Binding SelectedBoCauHoi, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Padding="0,0,14,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="1,1,2,9"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bdSet" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10"
                                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bdSet" Property="Background" Value="#F0FDF4"/>
                                                    <Setter TargetName="bdSet" Property="BorderBrush" Value="#10B981"/>
                                                    <Setter TargetName="bdSet" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdSet" Property="BorderBrush" Value="#94A3B8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Source badge & Action buttons -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding NguonTaoHienThi}" FontSize="10" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Rename button -->
                                            <Button Command="{Binding DataContext.DoiTenBoCauHoiCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Đổi tên bộ câu hỏi" Margin="0,0,4,0">
                                                <local:LucideIcon Kind="Pencil" Size="11" Foreground="#64748B"/>
                                            </Button>

                                            <!-- Delete set button -->
                                            <Button Command="{Binding DataContext.XoaBoCauHoiCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Xóa bộ câu hỏi (giữ nguyên câu hỏi trong ngân hàng)">
                                                <local:LucideIcon Kind="Trash2" Size="11" Foreground="#EF4444"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Set Name -->
                                    <TextBlock Grid.Row="1" Text="{Binding TenBoCauHoi}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}" 
                                               TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                    <!-- Source Title & Question Count -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TenNguon}" FontSize="11" Foreground="{StaticResource TextGray}" 
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="{Binding SoLuongCauHoi, StringFormat='{}{0} câu'}" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ================= THANH KÉO GIÃN 1 (GIỮA CỘT 1 VÀ 2) ================= -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Width="10">
                            <Border x:Name="spl1" Width="2" HorizontalAlignment="Center" Background="#CBD5E1" CornerRadius="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="spl1" Property="Background" Value="{StaticResource AdminDarkGreen}"/>
                                <Setter TargetName="spl1" Property="Width" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================= CỘT 2: DANH SÁCH CÂU HỎI TRONG BỘ ================= -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="12,12,3,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="4,0,13,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding TieuDeBoHienTai}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Danh sách câu hỏi thành viên" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DanhSachCauHoi.Count, StringFormat='{}{0} câu'}" FontWeight="Bold" FontSize="11.5" Foreground="#2563EB"/>
                        </Border>
                    </Grid>

                    <!-- Filters toolbar -->
                    <StackPanel Grid.Row="1" Margin="0,0,9,10">
                        <!-- Search input -->
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="txtSearchCauHoi" Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="28,7,8,7" VerticalContentAlignment="Center" FontSize="12"
                                     BorderBrush="{StaticResource BorderLight}">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <local:LucideIcon Kind="Search" Size="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tìm kiếm nội dung câu hỏi..." FontSize="11.5" Foreground="{StaticResource TextGray}"
                                       VerticalAlignment="Center" Margin="28,0,8,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearchCauHoi}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Skill & Difficulty filters -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" SelectedValue="{Binding FilterKyNang}" SelectedValuePath="Tag" Padding="6,5" FontSize="11.5" MaxDropDownHeight="240">
                                <ComboBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Tất cả kỹ năng" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="Đọc hiểu" Tag="Doc"/>
                                <ComboBoxItem Content="Nghe hiểu" Tag="Nghe"/>
                                <ComboBoxItem Content="Ngữ pháp" Tag="NguPhap"/>
                                <ComboBoxItem Content="Từ vựng" Tag="TuVung"/>
                                <ComboBoxItem Content="Viết" Tag="Viet"/>
                                <ComboBoxItem Content="Nói (Speaking)" Tag="Noi"/>
                            </ComboBox>

                            <ComboBox Grid.Column="2" SelectedValue="{Binding FilterDoKho}" SelectedValuePath="Tag" Padding="6,5" FontSize="11.5" MaxDropDownHeight="240">
                                <ComboBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Tất cả độ khó" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="Dễ" Tag="De"/>
                                <ComboBoxItem Content="Trung bình" Tag="TrungBinh"/>
                                <ComboBoxItem Content="Khó" Tag="Kho"/>
                            </ComboBox>
                        </Grid>

                        <!-- Loading Indicator -->
                        <ProgressBar IsIndeterminate="True" Height="2.5" Margin="0,8,0,0"
                                     Foreground="{StaticResource AdminMint}" BorderThickness="0" Background="#F1F5F9"
                                     Visibility="{Binding IsLoadingQuestions, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>

                    <!-- Questions ListBox with High-Performance Virtualization -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding DanhSachCauHoi}" SelectedItem="{Binding SelectedCauHoiInList, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="5,5"
                             VirtualizingPanel.CacheLengthUnit="Item"
                             Padding="0,0,14,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="1,1,2,10"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bdItem" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10"
                                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bdItem" Property="Background" Value="#F0FDF4"/>
                                                    <Setter TargetName="bdItem" Property="BorderBrush" Value="#10B981"/>
                                                    <Setter TargetName="bdItem" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdItem" Property="BorderBrush" Value="#94A3B8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Tags & Remove action -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,5,0">
                                                <TextBlock Text="{Binding ThuTuCauHoi, StringFormat='{}#{0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                                            </Border>
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="5,1" Margin="0,0,5,0">
                                                <TextBlock Text="{Binding KyNangHienThi}" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </Border>
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="{Binding DoKhoHienThi}" FontSize="10" FontWeight="SemiBold" Foreground="#D97706"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Remove from Set button (if in a specific set) -->
                                        <Button Grid.Column="1" Command="{Binding DataContext.GoCauHoiKhoiBoCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsBoCuTheDuocChon, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisConverter}}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Gỡ câu hỏi khỏi bộ này (vẫn giữ trong ngân hàng)">
                                            <local:LucideIcon Kind="MinusCircle" Size="13" Foreground="#94A3B8"/>
                                        </Button>
                                    </Grid>

                                    <!-- Question snippet -->
                                    <TextBlock Grid.Row="1" Text="{Binding NoiDungCauHoi}" FontSize="12.5" Foreground="{StaticResource TextDark}" 
                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                    <!-- Bottom info: Options count -->
                                    <TextBlock Grid.Row="2" Text="{Binding DanhSachLuaChon.Count, StringFormat='{}{0} lựa chọn'}" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ================= THANH KÉO GIÃN 2 (GIỮA CỘT 2 VÀ 3) ================= -->
            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Width="10">
                            <Border x:Name="spl2" Width="2" HorizontalAlignment="Center" Background="#CBD5E1" CornerRadius="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="spl2" Property="Background" Value="{StaticResource AdminDarkGreen}"/>
                                <Setter TargetName="spl2" Property="Width" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================= CỘT 3: CHI TIẾT & BIÊN TẬP CÂU HỎI (DETAIL) ================= -->
            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar of Editor (Responsive: WrapPanel + Full width subtitle) -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hàng 1: Tiêu đề + Badge + Nút bấm thao tác căn phải -->
                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
                            <!-- Nút thao tác dạt sang phải -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Command="{Binding ThemCauHoiMoiCommand}"
                                        Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" Padding="8,5" Cursor="Hand" Margin="0,0,6,0" ToolTip="Tạo mới một câu hỏi">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Plus" Size="12.5" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Tạo câu hỏi mới" FontSize="11" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Command="{Binding XoaCauHoiVinhVienCommand}" CommandParameter="{Binding CurrentCauHoi}"
                                        Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="8,5" Cursor="Hand" ToolTip="Xóa câu hỏi khỏi toàn bộ hệ thống">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Trash2" Size="12.5" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Xóa câu hỏi" FontSize="11" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Tiêu đề và badge tự wrap mượt mà nếu không gian hẹp -->
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CHI TIẾT VÀ KIỂM DUYỆT CÂU HỎI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,8,2" VerticalAlignment="Center"/>
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="0,0,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentCauHoi.MaCauHoi}" Value="-1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="✨ Đang tạo câu hỏi mới" FontWeight="Bold" FontSize="10.5" Foreground="#B45309"/>
                                </Border>
                            </WrapPanel>
                        </DockPanel>

                        <!-- Hàng 2: Mô tả phụ - Chiếm toàn bộ chiều rộng và tự wrap, không bị che bởi các nút -->
                        <TextBlock Grid.Row="1" Text="Chỉnh sửa nội dung, gắn audio, đoạn văn đọc hiểu, đáp án đúng và lời giải chi tiết." 
                                   FontSize="11.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </Grid>

                    <!-- Main Editor Fields (Scrollable) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Margin="0,0,2,0">
                        <StackPanel>
                            <!-- Row 1: Kỹ năng, Độ khó, Trình độ CEFR, Loại câu hỏi (Bố cục 2 cột x 2 hàng giúp dropdown text dài không bao giờ bị cắt) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Hàng 1 - Cột 0: Kỹ năng -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Kỹ năng:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding CurrentCauHoi.KyNang, Mode=TwoWay}" SelectedValuePath="Tag" Padding="8,5" FontSize="12" MaxDropDownHeight="240">
                                        <ComboBoxItem Content="Đọc hiểu" Tag="Doc"/>
                                        <ComboBoxItem Content="Nghe hiểu" Tag="Nghe"/>
                                        <ComboBoxItem Content="Ngữ pháp" Tag="NguPhap"/>
                                        <ComboBoxItem Content="Từ vựng" Tag="TuVung"/>
                                        <ComboBoxItem Content="Viết" Tag="Viet"/>
                                        <ComboBoxItem Content="Nói (Speaking)" Tag="Noi"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Hàng 1 - Cột 2: Độ khó -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Độ khó:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding CurrentCauHoi.DoKho, Mode=TwoWay}" SelectedValuePath="Tag" Padding="8,5" FontSize="12" MaxDropDownHeight="240">
                                        <ComboBoxItem Content="Dễ" Tag="De"/>
                                        <ComboBoxItem Content="Trung bình" Tag="TrungBinh"/>
                                        <ComboBoxItem Content="Khó" Tag="Kho"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Hàng 2 - Cột 0: Trình độ CEFR -->
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="Trình độ CEFR:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding CurrentCauHoi.MaTrinhDo, Mode=TwoWay}" SelectedValuePath="Tag" Padding="8,5" FontSize="12" MaxDropDownHeight="240">
                                        <ComboBoxItem Content="A1" Tag="A1"/>
                                        <ComboBoxItem Content="A2" Tag="A2"/>
                                        <ComboBoxItem Content="B1" Tag="B1"/>
                                        <ComboBoxItem Content="B2" Tag="B2"/>
                                        <ComboBoxItem Content="C1" Tag="C1"/>
                                        <ComboBoxItem Content="C2" Tag="C2"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Hàng 2 - Cột 2: Loại câu hỏi (Rộng rãi, hiển thị trọn vẹn không bị cắt chữ) -->
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Loại câu hỏi:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding CurrentCauHoi.LoaiCauHoi, Mode=TwoWay}" SelectedValuePath="Tag" Padding="8,5" FontSize="12" MaxDropDownHeight="240">
                                        <ComboBoxItem Content="Trắc nghiệm (4 lựa chọn)" Tag="TracNghiem"/>
                                        <ComboBoxItem Content="Đúng / Sai (True / False)" Tag="DungSai"/>
                                        <ComboBoxItem Content="True / False / Not Given" Tag="TrueFalseNotGiven"/>
                                        <ComboBoxItem Content="Điền khuyết (Fill in the Blank)" Tag="DienKhuyet"/>
                                        <ComboBoxItem Content="Trả lời ngắn (Short Answer)" Tag="TraLoiNgan"/>
                                        <ComboBoxItem Content="Sửa lỗi sai (Error Correction)" Tag="SuaLoiSai"/>
                                        <ComboBoxItem Content="Viết lại câu (Transformation)" Tag="VietLaiCau"/>
                                        <ComboBoxItem Content="Nối cặp (Matching)" Tag="NoiCap"/>
                                        <ComboBoxItem Content="Sắp xếp câu (Ordering)" Tag="SapXep"/>
                                        <ComboBoxItem Content="Tự luận / Viết bài (Essay/Writing)" Tag="TuLuan"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Question Content -->
                            <TextBlock Text="Nội dung câu hỏi (*):" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CurrentCauHoi.NoiDungCauHoi, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                                     MaxLength="4000"
                                     Padding="10,8" FontSize="12.5" BorderBrush="{StaticResource BorderLight}" Margin="0,0,0,12">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Audio Attachment (Chỉ hiển thị khi là câu hỏi Nghe hiểu) -->
                            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.2" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                                    Visibility="{Binding CurrentCauHoi.IsKyNangNghe, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Headphones" Size="14" Foreground="#15803D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Đính kèm Audio (Câu hỏi Nghe hiểu):" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Command="{Binding ChonAudioCommand}" Background="White" BorderBrush="#86EFAC" BorderThickness="1" Padding="10,4" Cursor="Hand" ToolTip="Tải tệp âm thanh lên">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="Upload" Size="12" Foreground="#15803D" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Đổi file Audio" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Command="{Binding XoaAudioCommand}" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" Padding="8,4" Cursor="Hand" ToolTip="Gỡ tệp âm thanh" Margin="6,0,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="Trash2" Size="12" Foreground="#DC2626" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Gỡ Audio" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Thanh tiến trình Audio nhỏ gọn (Compact Seekable Audio Timeline) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Play/Pause Button -->
                                        <Button Grid.Column="0" Command="{Binding TogglePlayAudioCommand}"
                                                Background="#15803D" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand" Margin="0,0,10,0" ToolTip="Phát hoặc tạm dừng nghe thử">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <local:LucideIcon x:Name="icoPlay" Kind="Play" Size="13" Foreground="White" Margin="0,0,5,0"/>
                                                            <TextBlock x:Name="txtPlay" Text="Nghe thử" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                            <Setter TargetName="icoPlay" Property="Kind" Value="Pause"/>
                                                            <Setter TargetName="txtPlay" Property="Text" Value="Tạm dừng"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Timeline Slider -->
                                        <Border Grid.Column="1" Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                                                ToolTip="{Binding CurrentCauHoi.AudioPath, TargetNullValue='Chưa gán tệp âm thanh cho câu hỏi này'}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Thời gian đã phát -->
                                                <TextBlock Grid.Column="0" Text="{Binding AudioCurrentTimeText}" 
                                                           FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" 
                                                           VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Thời gian đã phát"/>

                                                <!-- Thanh kéo tua timeline audio -->
                                                <Slider x:Name="sldAudioTimeline" Grid.Column="1" 
                                                        Style="{StaticResource ModernAudioSliderStyle}"
                                                        Minimum="0" Maximum="{Binding AudioTotalSeconds}"
                                                        Value="{Binding AudioCurrentSeconds, Mode=TwoWay}"
                                                        IsMoveToPointEnabled="True"
                                                        VerticalAlignment="Center"
                                                        PreviewMouseDown="SldAudioTimeline_PreviewMouseDown"
                                                        PreviewMouseUp="SldAudioTimeline_PreviewMouseUp"
                                                        ToolTip="Kéo hoặc bấm vào thanh để tua audio"/>

                                                <!-- Tổng thời lượng -->
                                                <TextBlock Grid.Column="2" Text="{Binding AudioTotalTimeText}" 
                                                           FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" 
                                                           VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Tổng thời lượng audio"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Reading Passage / Context (Chỉ hiển thị khi không phải câu hỏi Nghe hiểu, đặc biệt là Đọc hiểu) -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding CurrentCauHoi.IsKyNangNghe, Converter={StaticResource InvBoolToVisConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <local:LucideIcon Kind="BookOpen" Size="13" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đoạn văn đọc hiểu / Ngữ cảnh / Lời thoại Audio:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding CurrentCauHoi.DoanVanDoc, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                                             MaxLength="10000"
                                             FontSize="11.5" Padding="8,6" Background="White" BorderBrush="#CBD5E1">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Border>

                            <!-- KHUNG ĐÁP ÁN: 1. CHO CÂU HỎI TRẮC NGHIỆM / LỰA CHỌN -->
                            <StackPanel Visibility="{Binding CurrentCauHoi.IsDangLuaChon, Converter={StaticResource BoolToVisConverter}}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Các phương án trả lời (chọn nút tròn để đánh dấu đáp án đúng):" 
                                               FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Command="{Binding ThemDapAnCommand}" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Padding="8,4" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:LucideIcon Kind="Plus" Size="11" Foreground="#334155" Margin="0,0,3,0"/>
                                                        <TextBlock Text="Thêm phương án" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DanhSachDapAn}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <RadioButton Grid.Column="0" IsChecked="{Binding LaDapAnDung, Mode=TwoWay}"
                                                                 Command="{Binding DataContext.ChonDapAnDungCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                 CommandParameter="{Binding}"
                                                                 GroupName="BankDapAnDungGroup" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                 ToolTip="Đánh dấu đáp án đúng"/>

                                                    <Border Grid.Column="1" Background="{StaticResource AdminDarkGreen}" CornerRadius="4" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KyHieuLuaChon}" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBox Grid.Column="2" Text="{Binding NoiDungLuaChon, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="1000"
                                                             FontSize="12" Padding="6,4" VerticalAlignment="Center" BorderBrush="#CBD5E1">
                                                        <TextBox.Resources>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </TextBox.Resources>
                                                    </TextBox>

                                                    <Button Grid.Column="3" Command="{Binding DataContext.XoaDapAnCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <local:LucideIcon Kind="X" Size="13" Foreground="#94A3B8"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- KHUNG ĐÁP ÁN: 2. CHO CÂU HỎI NHẬP VĂN BẢN (Điền khuyết, Trả lời ngắn, Viết lại câu, Sửa lỗi sai) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                                    Visibility="{Binding CurrentCauHoi.IsDangNhapVanBan, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <local:LucideIcon Kind="CheckCircle" Size="13" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đáp án chính xác &amp; Các biến thể được chấp nhận (*):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding DanhSachDapAn[0].NoiDungLuaChon, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="1000"
                                             FontSize="12.5" Padding="8,6" Background="White" BorderBrush="#CBD5E1">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBlock Text="💡 Mẹo: Nhập từ hoặc cụm từ đáp án chuẩn. Bạn có thể phân tách nhiều đáp án tương đương hợp lệ bằng dấu gạch đứng '|' (Ví dụ: memory|a memory hoặc went|has gone)." 
                                               FontSize="11" Foreground="#0284C7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- KHUNG ĐÁP ÁN: 3. CHO CÂU HỎI TỰ LUẬN / VIẾT BÀI (TuLuan) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                                    Visibility="{Binding CurrentCauHoi.IsDangTuLuan, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <local:LucideIcon Kind="FileText" Size="13" Foreground="#6366F1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tiêu chí chấm điểm (Rubric) &amp; Hướng dẫn bài mẫu (*):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding DanhSachDapAn[0].NoiDungLuaChon, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="75" VerticalScrollBarVisibility="Auto"
                                             MaxLength="2000"
                                             FontSize="12" Padding="8,6" Background="White" BorderBrush="#CBD5E1">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBlock Text="💡 Ghi rõ số từ tối thiểu (ví dụ: >= 150 từ cho bài luận hoặc >= 50 từ cho đoạn văn) và các tiêu chí đánh giá (Task Response, Coherence &amp; Cohesion, Lexical Resource, Grammar)." 
                                               FontSize="11" Foreground="#6366F1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Detailed Explanation -->
                            <TextBlock Text="Lời giải thích chi tiết &amp; dẫn chứng:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CurrentCauHoi.GiaiThichDapAn, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto"
                                     MaxLength="3000"
                                     Padding="8,6" FontSize="12" BorderBrush="{StaticResource BorderLight}" Margin="0,0,0,12">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Nguồn học liệu & Dẫn chứng tài liệu -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📚 Căn cứ &amp; Nguồn trích dẫn học liệu:" FontSize="11.5" FontWeight="Bold" Foreground="#334155"/>
                                            <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                    Visibility="{Binding CurrentCauHoi.MaDinhDanhSeed, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                                <TextBlock Text="{Binding CurrentCauHoi.MaDinhDanhSeed}" FontSize="10.5" FontWeight="Bold" Foreground="#4F46E5"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding CurrentCauHoi.LoaiNguonHienThi}" FontSize="10" FontWeight="SemiBold" Foreground="#047857"/>
                                        </Border>
                                    </Grid>

                                    <!-- Bài học liên kết trong hệ thống -->
                                    <Grid Margin="0,0,0,5" Visibility="{Binding CurrentCauHoi.TenBaiHoc, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bài học:" FontSize="11" FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                            <TextBlock Text="{Binding CurrentCauHoi.TenBaiHoc}" FontSize="11" FontWeight="SemiBold" Foreground="#065F46" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>

                                    <!-- Tệp tin nguồn -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="File nguồn:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding CurrentCauHoi.TepTinNguon, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="255"
                                                 FontSize="11.5" Padding="6,3" BorderBrush="#CBD5E1" Background="#FFFFFF">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>

                                    <!-- Đoạn văn dẫn chứng trích xuất -->
                                    <TextBlock Text="Đoạn văn trích dẫn từ bài học / tài liệu:" FontSize="11" Foreground="#64748B" Margin="0,4,0,2"/>
                                    <TextBox Text="{Binding CurrentCauHoi.DoanVanDanChung, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="48" VerticalScrollBarVisibility="Auto"
                                             MaxLength="3000"
                                             FontSize="11" Padding="6,4" BorderBrush="#CBD5E1" Background="#FFFFFF">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Border>

                            <!-- Checkbox Verified -->
                            <CheckBox Content="Đã kiểm duyệt chất lượng nội dung câu hỏi" IsChecked="{Binding CurrentCauHoi.DaKiemDuyet, Mode=TwoWay}"
                                      FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer / Save status & button -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status / Message banner -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding ThongBaoLoi}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Visibility="{Binding ThongBaoLoi, Converter={StaticResource StringNotEmptyToVisConverter}}"/>
                            <TextBlock Text="{Binding ThongBaoThanhCong}" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Visibility="{Binding ThongBaoThanhCong, Converter={StaticResource StringNotEmptyToVisConverter}}"/>
                        </StackPanel>

                        <!-- Save button & Notification pill -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Thông báo text nhỏ khi lưu thành công -->
                            <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0"
                                    Visibility="{Binding HienThongBaoLuuNho, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="CheckCircle2" Size="14" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ThongBaoLuuNho}" Foreground="#047857" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding LuuCauHoiCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White"
                                    Padding="20,9" BorderThickness="0" Cursor="Hand" ToolTip="Lưu thay đổi câu hỏi vào hệ thống">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Check" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                                <TextBlock Text="Lưu thay đổi câu hỏi" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
