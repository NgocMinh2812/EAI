<Window x:Class="GUI.Views.GiangVien.DiChuyenThuMucDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Di Chuyển File / Bài Học" 
        Icon="pack://application:,,,/GUI;component/Assets/app_icon.ico"
        Height="440" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.3" Color="#2563EB"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <!-- Lớp đổ bóng độc lập phía sau -->
        <Border CornerRadius="18" Background="#0F172A">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#0F172A"/>
            </Border.Effect>
        </Border>

        <!-- Khung nội dung hộp thoại (Không có Effect -> Render Vector & ClearType sắc nét 100%) -->
        <Border CornerRadius="18" BorderBrush="#93C5FD" BorderThickness="1.5" Background="#F8FAFC" ClipToBounds="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ocean Blue / Indigo Header Banner -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="22,18,20,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0"/>
                        <GradientStop Color="#1E3A8A" Offset="0.5"/>
                        <GradientStop Color="#2563EB" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#26FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                        <local:LucideIcon Kind="FolderOpen" Size="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Di Chuyển File / Bài Học" FontWeight="Bold" FontSize="17" Foreground="White"/>
                        <TextBlock Text="Chọn thư mục đích trong cây phân cấp để chuyển học liệu sang" FontSize="12" Foreground="#BFDBFE" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="28" Height="28" Background="Transparent" BorderThickness="0" 
                            Cursor="Hand" VerticalAlignment="Center" ToolTip="Đóng cửa sổ" Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#FEE2E2" CornerRadius="14" BorderBrush="#FECACA" BorderThickness="1">
                                    <TextBlock x:Name="t" Text="✕" FontSize="13" FontWeight="Bold" Foreground="#DC2626" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#DC2626"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#B91C1C"/>
                                        <Setter TargetName="t" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Form Body -->
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="0,0,16,16" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- Tệp tin đang thao tác -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#EFF6FF" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="FileText" Size="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtLessonTitle" Text="Tên bài học / đề thi" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Vị trí hiện tại: " FontSize="11.5" Foreground="#64748B"/>
                                        <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1" Margin="4,0,0,0">
                                            <TextBlock x:Name="txtCurrentFolder" Text="📁 Thư mục hiện tại" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Chọn thư mục đích -->
                        <TextBlock Text="Chuyển đến thư mục đích *" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboTargetFolder" Height="38" Margin="0,0,0,8"
                                  DisplayMemberPath="TenHienThi" SelectedValuePath="MaChuDe"
                                  FontSize="13" VerticalContentAlignment="Center"/>

                        <TextBlock Text="💡 Gợi ý: Sau khi di chuyển, thư mục cũ sẽ không còn chứa bài học này, giúp bạn có thể xóa thư mục cũ mà không bị báo lỗi ràng buộc trực thuộc." 
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="#64748B" LineHeight="17" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Bottom Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Hủy bỏ" Style="{StaticResource CancelBtnStyle}" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ConfirmBtnStyle}" Click="BtnConfirm_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:LucideIcon Kind="FolderOpen" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="Xác nhận di chuyển" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
