<Page x:Class="GUI.Views.GiangVien.DeThiLuyenTapView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      xmlns:vm="clr-namespace:GUI.ViewModels.GiangVien"
      xmlns:conv="clr-namespace:GUI.ViewModels.Common"
      Title="Đề thi &amp; Luyện tập - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.DataContext>
        <vm:DeThiLuyenTapViewModel />
    </Page.DataContext>

    <Page.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>
        <conv:PublishStatusTextConverter x:Key="PublishStatusTextConverter"/>
        <conv:PublishStatusBackgroundConverter x:Key="PublishStatusBgConverter"/>
        <conv:PublishStatusForegroundConverter x:Key="PublishStatusFgConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Quản lý Đề thi &amp; Gói Luyện tập (US-GV07)" FontWeight="Bold" FontSize="22" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                <TextBlock Text="Cấu hình Mock Test chuẩn hóa, ghép câu hỏi từ ngân hàng đề, tự động tính tổng số câu và tổng điểm" FontSize="13" Foreground="{StaticResource TextGray}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ThemDeThiMoiCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        Padding="16,9" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Plus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tạo đề thi mới" FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Main 2-Column Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: FORM CẤU HÌNH ĐỀ THI & TÓM TẮT -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="THIẾT LẬP THÔNG SỐ ĐỀ THI" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,0,14"/>

                        <TextBlock Text="Tên đề thi (*)" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentDeThi.TenBaiTapDeThi, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,14" FontSize="13"/>

                        <!-- Hình thức & Thời gian -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hình thức thi" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding CurrentDeThi.LoaiHinh}" SelectedValuePath="Tag" Padding="8,6">
                                    <ComboBoxItem Content="Thi thử Mock Test (Tính giờ)" Tag="ThiThu" IsSelected="True"/>
                                    <ComboBoxItem Content="Luyện tập tự do" Tag="LuyenTap"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thời gian làm (phút)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CurrentDeThi.ThoiGianLamBaiPhut, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Điểm đạt & Điểm tổng -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Điểm đạt (Pass)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CurrentDeThi.DiemDat, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tổng thang điểm (Tự động)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TongDiemDeThi, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" Padding="8" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Xáo trộn thứ tự câu hỏi khi phát đề" IsChecked="{Binding CurrentDeThi.XaoTronCauHoi}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <CheckBox Content="Phát hành ngay cho học viên thi" IsChecked="{Binding CurrentDeThi.DaPhatHanh}" Margin="0,0,0,16" FontWeight="SemiBold"/>

                        <!-- Thống kê Card tóm tắt -->
                        <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TỔNG HỢP CẤU TRÚC ĐỀ THI:" FontWeight="Bold" FontSize="11" Foreground="#15803D" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TongSoCauDaChon, StringFormat='Số lượng câu hỏi đã gán: {0} câu'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding TongDiemDeThi, StringFormat='Tổng thang điểm: {0} điểm'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>

                        <!-- Báo lỗi -->
                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14"
                                Visibility="{Binding ThongBaoLoi, Converter={StaticResource StringNotEmptyToVisConverter}}">
                            <TextBlock Text="{Binding ThongBaoLoi}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <Button Content="Lưu &amp; Xuất bản Đề thi" Command="{Binding LuuDeThiCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White" Padding="20,10" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CỘT PHẢI: CHỌN CÂU HỎI TỪ NGÂN HÀNG ĐỀ -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CHỌN CÂU HỎI TỪ NGÂN HÀNG ĐƯA VÀO ĐỀ" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Text="Tích chọn câu hỏi và tùy chỉnh điểm số cho từng câu" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Chọn tất cả" Command="{Binding ChonTatCaCauHoiCommand}" Background="Transparent" Foreground="{StaticResource AdminMint}" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"/>
                            <Button Content="Bỏ chọn" Command="{Binding BoChonTatCaCommand}" Background="Transparent" Foreground="{StaticResource TextGray}" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding NgânHangCauHoiChon}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              Command="{Binding DataContext.CapNhatLuaChonCauHoiCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CauHoi.KyNang}" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CauHoi.MaTrinhDo}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CauHoi.NoiDungCauHoi}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" Foreground="{StaticResource TextDark}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Điểm:" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding Diem, UpdateSourceTrigger=PropertyChanged}" Width="45" Padding="4" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
