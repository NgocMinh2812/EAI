<Page x:Class="GUI.Views.GiangVien.DeThiLuyenTapView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      xmlns:vm="clr-namespace:GUI.ViewModels.GiangVien"
      xmlns:conv="clr-namespace:GUI.ViewModels.Common"
      Title="Quản lý Đề thi &amp; Gói Luyện tập"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.DataContext>
        <vm:DeThiLuyenTapViewModel />
    </Page.DataContext>

    <Page.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConverter"/>
        <conv:NotNullOrEmptyToVisibilityConverter x:Key="NotNullOrEmptyToVisConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <!-- Button Style for Card Actions -->
        <Style x:Key="ActionIconBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- ========================================================================= -->
        <!-- MAIN CONTENT CONTAINER (Switch between List Mode and Edit Mode)           -->
        <!-- ========================================================================= -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================================================================== -->
            <!-- 1. GIAO DIỆN CHÍNH: DANH SÁCH ĐỀ THI (IsDanhSachMode = True)           -->
            <!-- ===================================================================== -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsDanhSachMode, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- KPI Statistics Cards -->
                    <RowDefinition Height="Auto"/> <!-- Filter Bar -->
                    <RowDefinition Height="*"/>    <!-- Exam Cards / Table List -->
                </Grid.RowDefinitions>

                <!-- 1.1 Top Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quản lý Đề thi &amp; Gói Luyện tập" FontWeight="Bold" FontSize="22" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                        <TextBlock Text="Soạn thảo Mock Test, xuất bản đề thi cho học viên, bảo toàn nội dung snapshot và theo dõi lịch sử kết quả" FontSize="13" Foreground="{StaticResource TextGray}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding LamMoiDanhSachCommand}" Background="White" Foreground="{StaticResource TextGray}" 
                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="12,9" Cursor="Hand" Margin="0,0,10,0" ToolTip="Làm mới danh sách đề thi từ cơ sở dữ liệu">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon x:Name="icoRefresh" Kind="RefreshCw" Size="14" Foreground="{StaticResource TextGray}" Margin="0,0,6,0"
                                                              RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                                <local:LucideIcon.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </local:LucideIcon.RenderTransform>
                                            </local:LucideIcon>
                                            <TextBlock Text="Làm mới" FontSize="12.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="ButtonBase.Click">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="icoRefresh"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.7">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Command="{Binding ThemDeThiMoiCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                Padding="16,9" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Plus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tạo đề thi mới" FontSize="12.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 1.2 KPI Statistics Cards Row -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Tổng đề -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="TỔNG SỐ ĐỀ THI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TongSoDeThi}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Bao gồm cả đề thi &amp; gói luyện" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Đã xuất bản -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="ĐANG XUẤT BẢN" FontSize="11" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SoDeDaXuatBan}" FontSize="24" FontWeight="Bold" Foreground="#15803D"/>
                            <TextBlock Text="Học viên đang được làm bài" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Bản nháp -->
                    <Border Grid.Column="4" Background="White" BorderBrush="#FEF3C7" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="BẢN NHÁP / ĐANG SOẠN" FontSize="11" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SoDeBanNhap}" FontSize="24" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="Chưa công khai cho học viên" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Tổng lượt thi -->
                    <Border Grid.Column="6" Background="White" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="LƯỢT THI ĐÃ NỘP" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TongLuotHocVienThi}" FontSize="24" FontWeight="Bold" Foreground="#1D4ED8"/>
                            <TextBlock Text="Tổng các bài làm đã hoàn thành" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 1.3 Filter Bar -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tìm kiếm tên đề -->
                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding SearchExamKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="12.5" BorderBrush="{StaticResource BorderLight}">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock Text="🔍 Tìm theo tên đề thi, mô tả..." VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{StaticResource TextGray}" IsHitTestVisible="False"
                                       Visibility="{Binding SearchExamKeyword, Converter={StaticResource NullOrEmptyToVisConverter}}"/>
                        </Grid>

                        <!-- Lọc Trình độ -->
                        <ComboBox Grid.Column="2" SelectedValue="{Binding FilterExamLevel}" SelectedValuePath="Tag" Padding="10,7">
                            <ComboBoxItem Content="Tất cả trình độ" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="Cơ bản (A1 - A2)" Tag="Basic"/>
                            <ComboBoxItem Content="Trung cấp (B1 - B2)" Tag="Intermediate"/>
                            <ComboBoxItem Content="Nâng cao (C1 - C2)" Tag="Advanced"/>
                            <ComboBoxItem Content="Chuẩn A1" Tag="A1"/>
                            <ComboBoxItem Content="Chuẩn A2" Tag="A2"/>
                            <ComboBoxItem Content="Chuẩn B1" Tag="B1"/>
                            <ComboBoxItem Content="Chuẩn B2" Tag="B2"/>
                            <ComboBoxItem Content="Chuẩn C1" Tag="C1"/>
                            <ComboBoxItem Content="Chuẩn C2" Tag="C2"/>
                        </ComboBox>

                        <!-- Lọc Trạng thái -->
                        <ComboBox Grid.Column="4" SelectedValue="{Binding FilterExamStatus}" SelectedValuePath="Tag" Padding="10,7">
                            <ComboBoxItem Content="Tất cả trạng thái" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="Đã xuất bản (Công khai)" Tag="DaXuatBan"/>
                            <ComboBoxItem Content="Bản nháp (Đang soạn)" Tag="BanNhap"/>
                            <ComboBoxItem Content="Đã đóng (Ngừng thi)" Tag="DaDong"/>
                        </ComboBox>

                        <!-- Lọc Hình thức -->
                        <ComboBox Grid.Column="6" SelectedValue="{Binding FilterExamType}" SelectedValuePath="Tag" Padding="10,7">
                            <ComboBoxItem Content="Tất cả hình thức" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="Thi thử (Mock Test)" Tag="ThiThu"/>
                            <ComboBoxItem Content="Luyện tập tự do" Tag="LuyenTap"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- 1.4 Danh sách Đề thi (List View) -->
                <Border Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0">
                    <Grid>
                        <!-- Khi danh sách rỗng -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40"
                                    Visibility="{Binding DanhSachDeThiLoc, Converter={StaticResource NullOrEmptyToVisConverter}}">
                            <TextBlock Text="📝" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Không tìm thấy đề thi phù hợp với bộ lọc" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hãy thử xóa từ khóa tìm kiếm hoặc nhấn 'Tạo đề thi mới' bên trên." FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button Content="Tạo đề thi mới ngay" Command="{Binding ThemDeThiMoiCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White" Padding="16,8" FontWeight="Bold" HorizontalAlignment="Center" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Danh sách đề -->
                        <ListView ItemsSource="{Binding DanhSachDeThiLoc}" BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="False"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  Padding="0,0,16,0"
                                  Visibility="{Binding DanhSachDeThiLoc, Converter={StaticResource NotNullOrEmptyToVisConverter}}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cột 1: Icon & Badge Trạng thái -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="115" Margin="0,0,14,0">
                                            <Border Background="{Binding TrangThaiBadgeBg}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding TrangThaiHienThi}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding TrangThaiBadgeFg}"/>
                                            </Border>
                                            <TextBlock Text="{Binding LoaiHinhHienThi}" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Cột 2: Nội dung Đề thi -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Tiêu đề & Badges phân loại: Sử dụng Grid để tiêu đề co giãn chuẩn xác, tự động xuống dòng tối đa 2 dòng hoặc Ellipsis, không bao giờ tràn lề hay đè vào nút thao tác -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TenBaiTapDeThi}" FontWeight="Bold" FontSize="14.5" 
                                                           Foreground="{StaticResource TextDark}" 
                                                           TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding TenBaiTapDeThi}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding LevelTag, FallbackValue='Chuẩn B2'}" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                    </Border>
                                                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding HasBlueprint, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding TenCauTrucDeThi, StringFormat='📐 {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Metadata tóm tắt -->
                                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                <TextBlock Text="{Binding ThoiGianHienThi, StringFormat='⏱️ {0}'}" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding SoCauHienThi, StringFormat='📋 {0}'}" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding TongDiem, StringFormat='🎯 Thang điểm: {0} pts'}" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding DiemDat, StringFormat='🏆 Đạt: {0} pts'}" FontSize="12" Foreground="#15803D" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding SoLuotDaThi, StringFormat='👥 {0} lượt làm bài'}" FontSize="12" Foreground="#1D4ED8" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding NgayTaoFormatted, StringFormat='📅 Tạo: {0}'}" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding MoTa}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding MoTa}"/>
                                        </StackPanel>

                                        <!-- Cột 3: Nút Thao tác (Chia 2 hàng gọn gàng, giảm 260px bề ngang, các nút luôn hiển thị đầy đủ và không bao giờ che text) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <!-- Hàng 1: Thao tác chỉnh sửa, xem trước, xuất bản / đóng đề -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                                <!-- Chỉnh sửa -->
                                                <Button ToolTip="Chỉnh sửa đề thi" Command="{Binding DataContext.ChonSuaDeThiCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource ActionIconBtn}" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:LucideIcon Kind="Edit3" Size="13" Foreground="#0F172A" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Sửa" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Xem trước -->
                                                <Button ToolTip="Xem trước nội dung đề" Command="{Binding DataContext.XemTruocDeThiCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource ActionIconBtn}" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:LucideIcon Kind="Eye" Size="13" Foreground="#0F172A" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Xem trước" FontSize="11.5"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Xuất bản (nếu chưa xuất bản) -->
                                                <Button ToolTip="Xuất bản cho học viên làm bài" 
                                                        Command="{Binding DataContext.XuatBanDeThiCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                        CommandParameter="{Binding}" 
                                                        Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisConverter}}"
                                                        Background="#DCFCE7" Foreground="#15803D" BorderThickness="0" Padding="8,6" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                             <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <local:LucideIcon Kind="Send" Size="13" Foreground="#15803D" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="Xuất bản" FontSize="11.5" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Đóng đề (nếu đã xuất bản) -->
                                                <Button ToolTip="Đóng đề thi (ngừng cho làm)" 
                                                        Command="{Binding DataContext.DongDeThiCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                        CommandParameter="{Binding}" 
                                                        Visibility="{Binding IsPublished, Converter={StaticResource BoolToVisConverter}}"
                                                        Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Padding="8,6" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <local:LucideIcon Kind="Pause" Size="13" Foreground="#64748B" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="Đóng đề" FontSize="11.5"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>

                                            <!-- Hàng 2: Nhân bản, Lượt thi, Xóa -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <!-- Nhân bản -->
                                                <Button ToolTip="Nhân bản đề thi thành bản nháp mới" Command="{Binding DataContext.NhanBanDeThiCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource ActionIconBtn}" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:LucideIcon Kind="Copy" Size="13" Foreground="#0F172A" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Nhân bản" FontSize="11.5"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Xem lịch sử thi -->
                                                <Button ToolTip="Xem danh sách bài nộp của học viên" Command="{Binding DataContext.XemLichSuDeThiCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource ActionIconBtn}" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:LucideIcon Kind="Users" Size="13" Foreground="#1D4ED8" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding SoLuotDaThi, StringFormat='Lượt thi ({0})'}" FontSize="11.5" Foreground="#1D4ED8"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Xóa -->
                                                <Button ToolTip="Xóa đề thi" Command="{Binding DataContext.XoaDeThiCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource ActionIconBtn}">
                                                    <local:LucideIcon Kind="Trash2" Size="13" Foreground="#DC2626"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- 2. GIAO DIỆN CHỈNH SỬA / CẤU HÌNH ĐỀ THI (IsChinhSuaMode = True)        -->
            <!-- ===================================================================== -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsChinhSuaMode, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 2.1 Header Editor -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nút quay lại (icon tròn tinh tế, không đẩy lệch tiêu đề) -->
                    <Button Grid.Column="0" Command="{Binding QuayLaiDanhSachCommand}" 
                            ToolTip="Quay lại danh sách đề thi"
                            Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            Width="36" Height="36" Cursor="Hand" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                        <local:LucideIcon Kind="ArrowLeft" Size="18" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Soạn thảo &amp; Cấu hình Đề thi" FontWeight="Bold" FontSize="19" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Cấu hình thông số và chọn lọc câu hỏi từ ngân hàng đề kèm chụp snapshot bảo toàn nội dung" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Lưu Bản nháp" Command="{Binding LuuBanNhapCommand}" Background="White" Foreground="{StaticResource TextDark}" 
                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="16,9" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Lưu &amp; Xuất bản ngay" Command="{Binding LuuVaXuatBanCommand}" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                Padding="18,9" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2.2 Main Split (Left: Config Form | Right: Question Picker) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: FORM CẤU HÌNH THÔNG SỐ ĐỀ THI -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <StackPanel>
                                <!-- KHUNG CHỌN CẤU TRÚC ĐỀ THI CHUẨN HÓA (EXAM BLUEPRINTS) -->
                                <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📐 Cấu trúc đề thi chuẩn hóa:" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E"/>
                                            </StackPanel>
                                            
                                            <!-- Nút Tạo đề nhanh tự động -->
                                            <Button Grid.Column="1" Command="{Binding TuDongChonCauHoiTheoCauTrucCommand}"
                                                    Background="#0D9488" Foreground="White" BorderThickness="0"
                                                    Padding="10,4" Cursor="Hand" Margin="0,0,6,0"
                                                    ToolTip="Tự động lọc và chọn đúng số lượng câu hỏi khớp 100% với từng phần của cấu trúc chuẩn">
                                                <Button.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <local:LucideIcon Kind="Zap" Size="13" Foreground="White" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Tự động chọn câu" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="2" Command="{Binding ApDungThongSoCauTrucCommand}"
                                                    Background="White" BorderBrush="#0F766E" BorderThickness="1" Foreground="#0F766E"
                                                    Padding="10,4" Cursor="Hand" ToolTip="Áp dụng thời gian, số câu và thang điểm chuẩn của cấu trúc này">
                                                <Button.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <local:LucideIcon Kind="Check" Size="13" Foreground="#0F766E" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Áp dụng chuẩn" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- ComboBox chọn cấu trúc chuẩn -->
                                        <ComboBox ItemsSource="{Binding DanhSachCauTrucDeThi}"
                                                  SelectedItem="{Binding SelectedCauTrucDeThi}"
                                                  DisplayMemberPath="TenHienThi"
                                                  Height="36" Padding="8,6" FontSize="12.5" Margin="0,0,0,8">
                                            <ComboBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </ComboBox.Resources>
                                        </ComboBox>

                                        <!-- Thẻ trạng thái & tiến độ ràng buộc cấu trúc (Live Blueprint Validation) -->
                                        <Border Background="{Binding MauNenTrangThaiCauTruc}" 
                                                BorderBrush="{Binding MauVienTrangThaiCauTruc}" 
                                                BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,8"
                                                Visibility="{Binding HasSelectedBlueprint, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <local:LucideIcon Kind="{Binding IconTrangThaiCauTruc}" Size="14" Foreground="{Binding MauChuTrangThaiCauTruc}" Margin="0,1,6,0" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ThongBaoTrangThaiCauTruc}" FontSize="11" FontWeight="SemiBold" 
                                                           Foreground="{Binding MauChuTrangThaiCauTruc}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>

                                        <!-- Chi tiết các phần thi theo cấu trúc -->
                                        <Border Background="White" BorderBrush="#CCFBF1" BorderThickness="1" CornerRadius="6" Padding="10,8"
                                                Visibility="{Binding CoCacPhanThi, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="📋 Phân bổ các phần thi theo cấu trúc này:" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding DanhSachPhanThiHienTai}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding TenPhan}" FontSize="11.5" Foreground="#334155" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="4" Padding="5,2" Margin="6,0,6,0">
                                                                    <TextBlock Text="{Binding KyNang}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="2" FontSize="11" Foreground="#64748B" VerticalAlignment="Center">
                                                                    <Run Text="{Binding SoLuongCau}"/> <Run Text="câu"/> (<Run Text="{Binding ThoiGianPhut}"/> <Run Text="p"/>)
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="THÔNG SỐ ĐỀ THI" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,0,12"/>

                                <TextBlock Text="Tên đề thi (*)" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <TextBox Text="{Binding CurrentDeThi.TenBaiTapDeThi, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" 
                                             Padding="12,8" VerticalContentAlignment="Center" Height="38" FontSize="13"
                                             BorderBrush="{StaticResource BorderLight}">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBlock Text="Nhập tên đề thi (VD: Kiểm tra giữa kỳ B2, Thi thử Mock Test 01)..." 
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{StaticResource TextGray}" FontSize="12.5" IsHitTestVisible="False"
                                               Visibility="{Binding CurrentDeThi.TenBaiTapDeThi, Converter={StaticResource NullOrEmptyToVisConverter}}"/>
                                </Grid>

                                <TextBlock Text="Mô tả / Hướng dẫn làm bài" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <TextBox Text="{Binding CurrentDeThi.MoTa, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" 
                                             Padding="10,8" Height="68" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12.5"
                                             BorderBrush="{StaticResource BorderLight}">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBlock Text="Nhập tóm tắt mô tả hoặc hướng dẫn quy chế làm bài cho học viên..." 
                                               VerticalAlignment="Top" Margin="10,10,0,0"
                                               Foreground="{StaticResource TextGray}" FontSize="12" IsHitTestVisible="False"
                                               Visibility="{Binding CurrentDeThi.MoTa, Converter={StaticResource NullOrEmptyToVisConverter}}"/>
                                </Grid>

                                <!-- Hình thức & Thời gian -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Hình thức thi" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding CurrentDeThi.LoaiHinh}" SelectedValuePath="Tag" Height="36" Padding="8,6">
                                            <ComboBoxItem Content="Thi thử Mock Test (Tính giờ)" Tag="ThiThu"/>
                                            <ComboBoxItem Content="Luyện tập tự do" Tag="LuyenTap"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Thời gian làm (phút, 0=vô hạn)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentDeThi.ThoiGianLamBaiPhut, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput" MaxLength="4" 
                                                 Padding="10,6" VerticalContentAlignment="Center" Height="36" FontSize="12.5"
                                                 BorderBrush="{StaticResource BorderLight}">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Điểm đạt & Điểm tổng -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Điểm đạt (Pass)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentDeThi.DiemDat, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="DecimalOnly_PreviewTextInput" MaxLength="5" 
                                                 Padding="10,6" VerticalContentAlignment="Center" Height="36" FontSize="12.5"
                                                 BorderBrush="{StaticResource BorderLight}">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tổng điểm (Tự động)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding TongDiemDeThi, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" 
                                                 Padding="10,6" VerticalContentAlignment="Center" Height="36" FontSize="12.5" FontWeight="Bold"
                                                 BorderBrush="{StaticResource BorderLight}">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Giới hạn lượt làm & Trình độ -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số lượt làm tối đa (0=vô hạn)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CurrentDeThi.SoLuotLamToiDa, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput" MaxLength="3" 
                                                 Padding="10,6" VerticalContentAlignment="Center" Height="36" FontSize="12.5"
                                                 BorderBrush="{StaticResource BorderLight}">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Khung trình độ áp dụng" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding CurrentDeThi.MaCapDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Height="36" Padding="8,6">
                                            <ComboBoxItem Content="A1"/>
                                            <ComboBoxItem Content="A2"/>
                                            <ComboBoxItem Content="B1"/>
                                            <ComboBoxItem Content="B2"/>
                                            <ComboBoxItem Content="C1"/>
                                            <ComboBoxItem Content="C2"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Tệp đính kèm Audio Đề thi & Quy tắc phát -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="AUDIO ĐỀ THI &amp; QUY TẮC PHÁT (LISTENING)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,0,8"/>

                                        <!-- Nút đính kèm audio và tên file -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Command="{Binding ChonAudioDeThiCommand}" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="10,6" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="Headphones" Size="13" Foreground="#10B981" Margin="0,0,5,0"/>
                                                                <TextBlock Text="Đính kèm Audio" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <TextBlock Grid.Column="1" Text="{Binding CurrentDeThi.TenFileAudioHienThi}"
                                                       FontSize="11.5" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,8,0"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding CurrentDeThi.HasAudio, Converter={StaticResource BoolToVisConverter}}">
                                                <Button Command="{Binding TogglePlayAudioDeThiCommand}" Background="#10B981" Foreground="White" BorderThickness="0" Padding="8,4" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <local:LucideIcon Kind="Play" Size="11" Foreground="White" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="Nghe thử" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Command="{Binding XoaAudioDeThiCommand}" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="6,4" Cursor="Hand" ToolTip="Gỡ tệp âm thanh này">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                <local:LucideIcon Kind="X" Size="12" Foreground="#DC2626"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Thông báo quy tắc số lần phát audio theo hình thức thi -->
                                        <Border Background="{Binding CurrentDeThi.QuyTacAudioBg}" BorderBrush="{Binding CurrentDeThi.QuyTacAudioBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentDeThi.QuyTacAudioIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CurrentDeThi.QuyTacAudioText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CurrentDeThi.QuyTacAudioFg}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Tùy chọn đề thi -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="QUY TẮC &amp; HIỂN THỊ KẾT QUẢ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Xáo trộn thứ tự câu hỏi khi phát đề" IsChecked="{Binding CurrentDeThi.XaoTronCauHoi}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                        <CheckBox Content="Cho phép xem đáp án đúng sau khi nộp" IsChecked="{Binding CurrentDeThi.ChoXemDapAn}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                        <CheckBox Content="Cho phép xem lời giải chi tiết sau khi nộp" IsChecked="{Binding CurrentDeThi.ChoXemLoiGiai}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Thống kê Card tóm tắt -->
                                <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="CẤU TRÚC ĐỀ THI DỰ KIẾN:" FontWeight="Bold" FontSize="11" Foreground="#15803D" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding TongSoCauDaChon, StringFormat='• Số lượng câu hỏi đã gán: {0} câu'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding TongDiemDeThi, StringFormat='• Tổng thang điểm: {0} điểm'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Trạng thái bảo toàn: Tự động chụp Snapshot câu hỏi và đáp án khi lưu" FontSize="11.5" Foreground="#15803D"/>
                                    </StackPanel>
                                </Border>

                                <!-- Báo lỗi nếu có -->
                                <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14"
                                        Visibility="{Binding ThongBaoLoi, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                    <TextBlock Text="{Binding ThongBaoLoi}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- CỘT PHẢI: CHỌN CÂU HỎI TỪ NGÂN HÀNG ĐỀ -->
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title & Select All -->
                                <RowDefinition Height="Auto"/> <!-- Filters -->
                                <RowDefinition Height="*"/>    <!-- Question List -->
                            </Grid.RowDefinitions>

                            <!-- 2.2.1 Header Picker -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CHỌN CÂU HỎI TỪ NGÂN HÀNG ĐỀ" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Nhấn trực tiếp vào câu hỏi để chọn/bỏ chọn nhanh &amp; xem đáp án" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Checkbox / Toggle xem lại câu đã chọn -->
                                    <CheckBox IsChecked="{Binding IsShowOnlySelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Cursor="Hand" Margin="0,0,14,0">
                                        <CheckBox.Content>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Chỉ hiện câu đã chọn" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                                <Border Background="{Binding MauNenTrangThaiCauTruc}" BorderBrush="{Binding MauVienTrangThaiCauTruc}" BorderThickness="1" CornerRadius="9" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ChuoiTienDoCauChon}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding MauChuTrangThaiCauTruc}"/>
                                                </Border>
                                            </StackPanel>
                                        </CheckBox.Content>
                                    </CheckBox>

                                    <Button Content="Chọn tất cả" Command="{Binding ChonTatCaCauHoiCommand}" Background="Transparent" Foreground="{StaticResource AdminMint}" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"/>
                                    <Button Content="Bỏ chọn" Command="{Binding BoChonTatCaCommand}" Background="Transparent" Foreground="{StaticResource TextGray}" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2.2.2 Filters Row -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Hàng 1: Nguồn câu hỏi & Tìm kiếm -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nguồn -->
                                    <ComboBox Grid.Column="0" 
                                              ItemsSource="{Binding DanhSachNguonCauHoi}"
                                              SelectedItem="{Binding SelectedNguonCauHoi}"
                                              DisplayMemberPath="DisplayText"
                                              Height="36" Padding="8,6" FontSize="12"
                                              Validation.ErrorTemplate="{x:Null}"/>

                                    <!-- Ô tìm kiếm câu hỏi -->
                                    <Grid Grid.Column="2">
                                        <TextBox Text="{Binding SearchQuestionKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                                 Height="36" Padding="32,6,10,6" VerticalContentAlignment="Center" FontSize="12"
                                                 BorderBrush="{StaticResource BorderLight}">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <local:LucideIcon Kind="Search" Size="14" Foreground="{StaticResource TextGray}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tìm kiếm câu hỏi theo từ khóa..." VerticalAlignment="Center" Margin="32,0,10,0"
                                                   Foreground="{StaticResource TextGray}" FontSize="12" IsHitTestVisible="False"
                                                   Visibility="{Binding SearchQuestionKeyword, Converter={StaticResource NullOrEmptyToVisConverter}}"/>
                                    </Grid>
                                </Grid>

                                <!-- Hàng 2: Kỹ năng & Độ khó -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kỹ năng -->
                                    <ComboBox Grid.Column="0" SelectedValue="{Binding FilterSkill}" SelectedValuePath="Tag" Padding="6,4" FontSize="11.5">
                                        <ComboBoxItem Content="Tất cả kỹ năng" Tag="All" IsSelected="True"/>
                                        <ComboBoxItem Content="Đọc hiểu (Reading)" Tag="Doc"/>
                                        <ComboBoxItem Content="Nghe hiểu (Listening)" Tag="Nghe"/>
                                        <ComboBoxItem Content="Ngữ pháp (Grammar)" Tag="NguPhap"/>
                                        <ComboBoxItem Content="Từ vựng (Vocab)" Tag="TuVung"/>
                                        <ComboBoxItem Content="Viết (Writing)" Tag="Viet"/>
                                        <ComboBoxItem Content="Nói (Speaking)" Tag="Noi"/>
                                    </ComboBox>

                                    <!-- Cấp độ -->
                                    <ComboBox Grid.Column="2" SelectedValue="{Binding FilterQuestionLevel}" SelectedValuePath="Tag" Padding="6,4" FontSize="11.5">
                                        <ComboBoxItem Content="Tất cả cấp độ" Tag="All" IsSelected="True"/>
                                        <ComboBoxItem Content="A1" Tag="A1"/>
                                        <ComboBoxItem Content="A2" Tag="A2"/>
                                        <ComboBoxItem Content="B1" Tag="B1"/>
                                        <ComboBoxItem Content="B2" Tag="B2"/>
                                        <ComboBoxItem Content="C1" Tag="C1"/>
                                    </ComboBox>

                                    <!-- Độ khó -->
                                    <ComboBox Grid.Column="4" SelectedValue="{Binding FilterDifficulty}" SelectedValuePath="Tag" Padding="6,4" FontSize="11.5">
                                        <ComboBoxItem Content="Tất cả độ khó" Tag="All" IsSelected="True"/>
                                        <ComboBoxItem Content="Dễ" Tag="De"/>
                                        <ComboBoxItem Content="Trung bình" Tag="TrungBinh"/>
                                        <ComboBoxItem Content="Khó" Tag="Kho"/>
                                    </ComboBox>
                                </Grid>
                            </Grid>

                            <!-- 2.2.3 Questions List with High-Performance Virtualization -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Loading Indicator khi nạp câu hỏi -->
                                <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="2.5" Margin="0,0,0,4"
                                             Foreground="{StaticResource AdminMint}" BorderThickness="0" Background="#F1F5F9"
                                             Visibility="{Binding IsLoadingQuestions, Converter={StaticResource BoolToVisConverter}}"/>

                                <!-- Empty state nếu không có câu hỏi -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30"
                                            Visibility="{Binding NgânHangCauHoiChon.Count, Converter={StaticResource NullOrEmptyToVisConverter}}">
                                    <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Không tìm thấy câu hỏi phù hợp với bộ lọc" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Vui lòng nới lỏng bộ lọc hoặc tạo thêm câu hỏi trong Ngân hàng câu hỏi." FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <ListBox Grid.Row="1" ItemsSource="{Binding NgânHangCauHoiChon}" BorderThickness="0" Background="Transparent" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         VirtualizingPanel.CacheLength="5,5"
                                         VirtualizingPanel.CacheLengthUnit="Item"
                                         Padding="0,0,14,6"
                                         Visibility="{Binding NgânHangCauHoiChon.Count, Converter={StaticResource NotNullOrEmptyToVisConverter}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Card bao bọc toàn bộ câu hỏi (Đổi màu viền và nền khi được chọn) -->
                                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="#0F766E"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Checkbox chọn câu (Phóng to nhẹ 1.2x để dễ nhìn) -->
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand">
                                                        <CheckBox.LayoutTransform>
                                                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                                        </CheckBox.LayoutTransform>
                                                    </CheckBox>

                                                    <!-- Vùng Nội dung câu hỏi -->
                                                    <Grid Grid.Column="1" Background="Transparent">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <!-- Click vào vùng thông tin này để chọn/bỏ chọn câu hỏi nhanh -->
                                                            <Border Background="Transparent" Cursor="Hand">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" 
                                                                                  Command="{Binding DataContext.ToggleChonCauHoiCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                                                  CommandParameter="{Binding}"/>
                                                                </Border.InputBindings>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding CauHoi.KyNangHienThi, FallbackValue='Kỹ năng'}" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                                        </Border>
                                                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding CauHoi.MaTrinhDo}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                                                                        </Border>
                                                                        <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding CauHoi.DoKhoHienThi}" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"/>
                                                                        </Border>
                                                                        <!-- Badge Có Audio nghe -->
                                                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0"
                                                                                Visibility="{Binding CauHoi.DuongDanAudio, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                                                            <TextBlock Text="🎧 Có Audio" FontSize="9.5" FontWeight="Bold" Foreground="#047857"/>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <!-- Tiêu đề & Nội dung đầy đủ không bị cắt -->
                                                                    <TextBlock Text="{Binding CauHoi.NoiDungCauHoi}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextDark}" LineHeight="18" Margin="0,0,0,4"/>

                                                                    <!-- Xem trước Đoạn trích bài đọc / Kịch bản nghe nếu có -->
                                                                    <Border Background="#FEF9C3" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="5" Padding="7,4" Margin="0,2,0,4"
                                                                            Visibility="{Binding CauHoi.DoanVanDoc, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                                                        <TextBlock Text="{Binding CauHoi.DoanVanDoc, StringFormat='📖 Kịch bản / Ngữ liệu: {0}'}" 
                                                                                   FontSize="11.5" Foreground="#78350F" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Nút xem / thu gọn đáp án (Hiển thị nút nhỏ gọn theo đúng Ảnh 2) -->
                                                            <Button Command="{Binding DataContext.ToggleXemDapAnCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                                    CommandParameter="{Binding}"
                                                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,3.5" Cursor="Hand" Margin="0,3,0,0" HorizontalAlignment="Left">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bdToggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bdToggle" Property="Background" Value="#F8FAFC"/>
                                                                                <Setter TargetName="bdToggle" Property="BorderBrush" Value="#94A3B8"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Content">
                                                                            <Setter.Value>
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="👁️" FontSize="11" Margin="0,0,4,0"/>
                                                                                    <TextBlock Text="Xem đáp án" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                                                                </StackPanel>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAnswersExpanded}" Value="True">
                                                                                <Setter Property="Content">
                                                                                    <Setter.Value>
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <TextBlock Text="🔼" FontSize="10" Margin="0,0,4,0"/>
                                                                                            <TextBlock Text="Thu gọn đáp án" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                                                                        </StackPanel>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                            <!-- VÙNG XEM TRƯỚC ĐÁP ÁN (Expands when clicked or toggled) -->
                                                            <Border Margin="0,8,0,0" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                                                    Visibility="{Binding IsAnswersExpanded, Converter={StaticResource BoolToVisConverter}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="ĐÁP ÁN &amp; LỜI GIẢI:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>

                                                                    <!-- Danh sách lựa chọn A, B, C, D (cho trắc nghiệm, đúng/sai, v.v.) -->
                                                                    <ItemsControl ItemsSource="{Binding CauHoi.DanhSachLuaChon}"
                                                                                  Visibility="{Binding CauHoi.IsDangLuaChon, Converter={StaticResource BoolToVisConverter}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Margin="0,2,0,2" Padding="8,5" CornerRadius="6" BorderThickness="1">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background" Value="White"/>
                                                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding LaDapAnDung}" Value="True">
                                                                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                                            <Border.Style>
                                                                                                <Style TargetType="Border">
                                                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding LaDapAnDung}" Value="True">
                                                                                                            <Setter Property="Background" Value="#10B981"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Border.Style>
                                                                                            <TextBlock Text="{Binding KyHieuLuaChon}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Foreground" Value="#475569"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding LaDapAnDung}" Value="True">
                                                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </Border>

                                                                                        <TextBlock Grid.Column="1" Text="{Binding NoiDungLuaChon}" FontSize="12" Foreground="{StaticResource TextDark}" 
                                                                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                                                        <Border Grid.Column="2" Background="#10B981" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                                Visibility="{Binding LaDapAnDung, Converter={StaticResource BoolToVisConverter}}">
                                                                                            <TextBlock Text="✓ Đáp án đúng" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- Đáp án chuẩn dạng nhập văn bản nếu không phải trắc nghiệm -->
                                                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4"
                                                                            Visibility="{Binding CauHoi.IsDangLuaChon, Converter={StaticResource InverseBoolToVisConverter}}">
                                                                        <TextBlock Text="{Binding CauHoi.DapAnDungText, StringFormat='✓ Đáp án đúng: {0}'}" 
                                                                                   FontSize="12" FontWeight="SemiBold" Foreground="#047857" TextWrapping="Wrap"/>
                                                                    </Border>

                                                                    <!-- Lời giải thích nếu có -->
                                                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,4,0,0"
                                                                            Visibility="{Binding CauHoi.GiaiThichDapAn, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="💡 Lời giải thích &amp; Dẫn chứng:" FontSize="10.5" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,2"/>
                                                                            <TextBlock Text="{Binding CauHoi.GiaiThichDapAn}" FontSize="11.5" Foreground="#78350F" TextWrapping="Wrap"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Điểm số & Thứ tự -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="Điểm:" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBox Text="{Binding Diem, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="28" Padding="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0">
                                                            <TextBox.Resources>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </TextBox.Resources>
                                                        </TextBox>

                                                        <!-- Nút di chuyển lên / xuống -->
                                                        <Button ToolTip="Di chuyển lên" Command="{Binding DataContext.DiChuyenCauLenCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Background="#F1F5F9" BorderThickness="0" Padding="5,3" Cursor="Hand" Margin="0,0,2,0">
                                                            <local:LucideIcon Kind="ArrowUp" Size="11" Foreground="#475569"/>
                                                        </Button>
                                                        <Button ToolTip="Di chuyển xuống" Command="{Binding DataContext.DiChuyenCauXuongCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Background="#F1F5F9" BorderThickness="0" Padding="5,3" Cursor="Hand">
                                                            <local:LucideIcon Kind="ArrowDown" Size="11" Foreground="#475569"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
