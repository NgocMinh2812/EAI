<Page x:Class="GUI.Views.GiangVien.DeThiLuyenTapView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Đề thi &amp; Luyện tập - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Top Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý Đề thi &amp; Gói Luyện tập" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock Text="Cấu hình Mock Test theo format chuẩn quốc tế (chia Section, đếm ngược, khóa tab) và bài luyện tập tự do" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="➕ Tạo đề thi mới" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="13" Padding="18,10" Cursor="Hand" BorderThickness="0" Click="BtnTaoDeThi_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Test 1: IELTS Mock Test #1 -->
            <Border Style="{StaticResource AdminCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="IELTS ACADEMIC" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                            </Border>
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="Mock Test Mode" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <TextBlock Text="Mã đề: DE-001" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="IELTS Academic Full Mini Test #01 — Reading &amp; Listening" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                        <TextBlock Text="Cấu trúc: 4 Section • 40 câu hỏi • Thời gian làm bài: 60 phút • Kích hoạt chế độ toàn màn hình và cảnh báo chuyển tab" FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="⏱️ 60 phút" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="🔒 Chống chuyển tab: BẬT" FontSize="11.5" FontWeight="SemiBold" Foreground="#047857"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="🤖 Chấm AI: Tự động" FontSize="11.5" FontWeight="SemiBold" Foreground="#6366F1"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="⚙️ Cấu hình đề thi" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                FontWeight="SemiBold" FontSize="12.5" Padding="14,8" Cursor="Hand" Margin="0,0,0,8"/>
                        <Button Content="📊 Xem thống kê nộp bài (38 học viên)" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                FontWeight="Medium" FontSize="12" Padding="14,6" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Test 2: TOEIC Format -->
            <Border Style="{StaticResource AdminCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="TOEIC 450+" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </Border>
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="Luyện tập tự do" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <TextBlock Text="Mã đề: DE-002" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="TOEIC Reading Comprehension Diagnostic Test" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                        <TextBlock Text="Cấu trúc: 3 Parts • 50 câu hỏi • Không giới hạn thời gian, hỗ trợ tra từ vựng và giải thích tức thì từng câu" FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="⏱️ Tự do" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="💡 Giải thích tức thì: BẬT" FontSize="11.5" FontWeight="SemiBold" Foreground="#047857"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="⚙️ Cấu hình đề thi" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                FontWeight="SemiBold" FontSize="12.5" Padding="14,8" Cursor="Hand" Margin="0,0,0,8"/>
                        <Button Content="📊 Xem thống kê nộp bài (56 học viên)" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                FontWeight="Medium" FontSize="12" Padding="14,6" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
