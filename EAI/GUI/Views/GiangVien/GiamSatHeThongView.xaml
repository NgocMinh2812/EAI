<Page x:Class="GUI.Views.GiangVien.GiamSatHeThongView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      xmlns:converters="clr-namespace:GUI.ViewModels.Common"
      Title="Giám sát hệ thống &amp; Quản trị AI"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      Background="#F8FAFC">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <converters:HealthToForegroundConverter x:Key="HealthFgConverter"/>
        <converters:HealthToBackgroundConverter x:Key="HealthBgConverter"/>
        <converters:HealthToVietnameseTextConverter x:Key="HealthTextConverter"/>
        <converters:BooleanToConfiguredTextConverter x:Key="ConfiguredTextConverter"/>
        <converters:BooleanToConfiguredBackgroundConverter x:Key="ConfiguredBgConverter"/>
        <converters:BooleanToConfiguredForegroundConverter x:Key="ConfiguredFgConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#475569" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#CBD5E1" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpinningRefreshIconStyle" TargetType="{x:Type local:LucideIcon}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinStory">
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                    From="0" To="360" Duration="0:0:1"
                                    RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinStory"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F4C3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#135D47"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A5C4D"/>
                    <Setter Property="Opacity" Value="0.85"/>
                    <Setter Property="Cursor" Value="Wait"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryTestButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F4C3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#135D47"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nút Khởi động Ollama (Emerald) -->
        <Style x:Key="OllamaStartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Wait"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nút Tắt Ollama (Crimson) -->
        <Style x:Key="OllamaStopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Wait"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Top Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Giám sát Hệ thống &amp; Quản trị Đa mô hình AI" FontWeight="Bold" FontSize="21" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock Text="Theo dõi tình trạng kết nối AI Providers, quản lý mô hình LLM và cấu hình API Key dùng chung (apiminh.json)" FontSize="13" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Badge -->
                    <Border Background="{Binding SystemHealthBadgeBg}" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding SystemHealthBadgeColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SystemHealthText}" FontWeight="Bold" FontSize="12.5" Foreground="{Binding SystemHealthBadgeColor}"/>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <StackPanel Orientation="Vertical">
                        <Button Style="{StaticResource RefreshButtonStyle}" 
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBoolConverter}}"
                                ToolTip="Làm mới trạng thái kết nối, độ trễ và số liệu giám sát">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:LucideIcon Style="{StaticResource SpinningRefreshIconStyle}" Kind="RefreshCw" Size="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Làm mới"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                    <Setter Property="Text" Value="Đang làm mới..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Height="2" Foreground="#0F4C3A" Background="Transparent" BorderThickness="0"
                                     Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisConverter}}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- BANNER NGUỒN CẤU HÌNH API KEY (apiminh.json) -->
            <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1.5" CornerRadius="12" Padding="18,14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#CCFBF1" CornerRadius="10" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                        <local:LucideIcon Kind="Key" Size="20" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Nguồn API Key hoạt động: " FontSize="13" FontWeight="SemiBold" Foreground="#0F766E"/>
                            <TextBlock Text="{Binding ConfigSourceName}" FontSize="13" FontWeight="Bold" Foreground="#042F2E"/>
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="✓ Đang kích hoạt" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Toàn bộ các phân hệ AI hệ thống: Gia sư Trợ lý AI, Chấm bài viết AI, Tạo câu hỏi bằng AI &amp; Bóc tách đề thi đều kết nối cấu hình tập trung qua AIConfigurationService." 
                                   FontSize="12" Foreground="#475569"/>
                    </StackPanel>

                    <!-- Thống kê lượt dùng AI theo phân hệ -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Trợ lý AI" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="{Binding AiTutorUsageText}" FontSize="13" FontWeight="Bold" Foreground="#0F766E"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Bài viết AI" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="{Binding AiWritingUsageText}" FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <StackPanel>
                                <TextBlock Text="Tạo câu hỏi AI" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="{Binding AiQuestionGenUsageText}" FontSize="13" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4 Metric Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource AdminCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <local:LucideIcon Kind="Activity" Size="14" Foreground="{StaticResource TextGray}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yêu cầu AI phiên này" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRequestsText}" FontWeight="Bold" FontSize="26" Foreground="{StaticResource TextDark}" Margin="0,4,0,2"/>
                        <TextBlock Text="Ghi nhận từ khởi động" FontSize="11.5" Foreground="#15803D" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AdminCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <local:LucideIcon Kind="Clock" Size="14" Foreground="{StaticResource TextGray}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Độ trễ AI trung bình" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AverageLatencyText}" FontWeight="Bold" FontSize="26" Foreground="{StaticResource TextDark}" Margin="0,4,0,2"/>
                        <TextBlock Text="Đo lường thời gian phản hồi thực" FontSize="11.5" Foreground="#15803D" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AdminCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <local:LucideIcon Kind="Database" Size="14" Foreground="{StaticResource TextGray}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cơ sở dữ liệu SQL" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DatabaseStatusText}" FontWeight="Bold" FontSize="22" Foreground="#15803D" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding DatabaseLatencyText}" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AdminCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <local:LucideIcon Kind="AlertTriangle" Size="14" Foreground="{StaticResource TextGray}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tỷ lệ lỗi (Error Rate)" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorRateText}" FontWeight="Bold" FontSize="26" Foreground="#0284C7" Margin="0,4,0,2"/>
                        <TextBlock Text="Theo dõi hạn mức &amp; quá tải" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- SECTION 1: AI PROVIDERS CONNECTIVITY & API KEY STATUS -->
            <TextBlock Text="TÌNH TRẠNG KẾT NỐI VÀ API KEY CÁC NHÀ CUNG CẤP AI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>
            <UniformGrid Columns="4" Margin="0,0,0,20">

                <!-- 1. GOOGLE GEMINI CARD -->
                <Border Style="{StaticResource AdminCardStyle}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="8" Width="36" Height="36" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Sparkles" Size="18" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="Google Gemini" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Mô hình từ Google" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" ToolTip="Mô hình chính thức từ Google"/>
                            </StackPanel>

                            <!-- Health Badge -->
                            <Border Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0"
                                    Background="{Binding GeminiStatus.Health, Converter={StaticResource HealthBgConverter}}"
                                    CornerRadius="6" Padding="7,3">
                                <TextBlock Text="{Binding GeminiStatus.Health, Converter={StaticResource HealthTextConverter}}" 
                                           Foreground="{Binding GeminiStatus.Health, Converter={StaticResource HealthFgConverter}}" 
                                           FontWeight="Bold" FontSize="10.5"/>
                            </Border>
                        </Grid>

                        <!-- Config status -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{Binding GeminiStatus.IsConfigured, Converter={StaticResource ConfiguredBgConverter}}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding GeminiStatus.IsConfigured, Converter={StaticResource ConfiguredTextConverter}}"
                                               Foreground="{Binding GeminiStatus.IsConfigured, Converter={StaticResource ConfiguredFgConverter}}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding GeminiMaskedKey, StringFormat='Key: {0}'}" FontSize="11" Foreground="#334155" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GeminiStatus.Message}" FontSize="12" Foreground="{StaticResource TextDark}" FontWeight="Medium" TextWrapping="Wrap" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding GeminiStatus.ActiveModel, StringFormat='Mô hình ưu tiên: {0}'}" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>

                        <!-- Action -->
                        <Button Grid.Row="3" Style="{StaticResource SecondaryTestButtonStyle}" Command="{Binding TestGeminiCommand}" IsEnabled="{Binding CanTestConnection}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <local:LucideIcon Kind="Activity" Size="12" Foreground="#334155" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kiểm tra kết nối Gemini" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. GROQ CLOUD CARD -->
                <Border Style="{StaticResource AdminCardStyle}" Margin="3,0,3,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFF7ED" CornerRadius="8" Width="36" Height="36" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Zap" Size="18" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="Groq Cloud" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Inference siêu tốc" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" ToolTip="Inference siêu tốc (Llama &amp; Qwen)"/>
                            </StackPanel>

                            <!-- Health Badge -->
                            <Border Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0"
                                    Background="{Binding GroqStatus.Health, Converter={StaticResource HealthBgConverter}}"
                                    CornerRadius="6" Padding="7,3">
                                <TextBlock Text="{Binding GroqStatus.Health, Converter={StaticResource HealthTextConverter}}" 
                                           Foreground="{Binding GroqStatus.Health, Converter={StaticResource HealthFgConverter}}" 
                                           FontWeight="Bold" FontSize="10.5"/>
                            </Border>
                        </Grid>

                        <!-- Config status -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{Binding GroqStatus.IsConfigured, Converter={StaticResource ConfiguredBgConverter}}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding GroqStatus.IsConfigured, Converter={StaticResource ConfiguredTextConverter}}"
                                               Foreground="{Binding GroqStatus.IsConfigured, Converter={StaticResource ConfiguredFgConverter}}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding GroqMaskedKey, StringFormat='Key: {0}'}" FontSize="11" Foreground="#334155" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GroqStatus.Message}" FontSize="12" Foreground="{StaticResource TextDark}" FontWeight="Medium" TextWrapping="Wrap" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding GroqStatus.ActiveModel, StringFormat='Mô hình ưu tiên: {0}'}" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>

                        <!-- Action -->
                        <Button Grid.Row="3" Style="{StaticResource SecondaryTestButtonStyle}" Command="{Binding TestGroqCommand}" IsEnabled="{Binding CanTestConnection}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <local:LucideIcon Kind="Activity" Size="12" Foreground="#334155" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kiểm tra kết nối Groq" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. XKIO GATEWAY CARD -->
                <Border Style="{StaticResource AdminCardStyle}" Margin="3,0,3,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Width="36" Height="36" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Server" Size="18" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="xKiro AI Gateway" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Cổng AI Gateway" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" ToolTip="Cổng AI Gateway (api.xkiro.com)"/>
                            </StackPanel>

                            <!-- Health Badge -->
                            <Border Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0"
                                    Background="{Binding XkioStatus.Health, Converter={StaticResource HealthBgConverter}}"
                                    CornerRadius="6" Padding="7,3">
                                <TextBlock Text="{Binding XkioStatus.Health, Converter={StaticResource HealthTextConverter}}" 
                                           Foreground="{Binding XkioStatus.Health, Converter={StaticResource HealthFgConverter}}" 
                                           FontWeight="Bold" FontSize="10.5"/>
                            </Border>
                        </Grid>

                        <!-- Config status -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{Binding XkioStatus.IsConfigured, Converter={StaticResource ConfiguredBgConverter}}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding XkioStatus.IsConfigured, Converter={StaticResource ConfiguredTextConverter}}"
                                               Foreground="{Binding XkioStatus.IsConfigured, Converter={StaticResource ConfiguredFgConverter}}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding XkioMaskedKey, StringFormat='Key: {0}'}" FontSize="11" Foreground="#334155" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding XkioStatus.Message}" FontSize="12" Foreground="{StaticResource TextDark}" FontWeight="Medium" TextWrapping="Wrap" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding XkioStatus.ActiveModel, StringFormat='Mô hình ưu tiên: {0}'}" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>

                        <!-- Action -->
                        <Button Grid.Row="3" Style="{StaticResource SecondaryTestButtonStyle}" Command="{Binding TestXkioCommand}" IsEnabled="{Binding CanTestConnection}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <local:LucideIcon Kind="Activity" Size="12" Foreground="#334155" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kiểm tra kết nối xKiro" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 4. OLLAMA LOCAL (OFFLINE) CARD -->
                <Border Style="{StaticResource AdminCardStyle}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#ECFDF5" CornerRadius="8" Width="36" Height="36" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Cpu" Size="18" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="Ollama Local" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Offline không cần mạng" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" ToolTip="Offline 100% không cần mạng Internet"/>
                            </StackPanel>

                            <!-- Dynamic Operational Health Badge -->
                            <Border Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0"
                                    Background="{Binding OllamaStatusBadgeBg}"
                                    CornerRadius="6" Padding="7,3">
                                <TextBlock Text="{Binding OllamaOperationalStatus}" 
                                           Foreground="{Binding OllamaStatusBadgeFg}" 
                                           FontWeight="Bold" FontSize="10.5"/>
                            </Border>
                        </Grid>

                        <!-- Config status & RAM Monitor -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="Localhost" Foreground="#15803D" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding OllamaBaseUrl, StringFormat='Cổng: {0}'}" FontSize="11" Foreground="#334155" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- RAM Usage Indicator Strip -->
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,5" Margin="0,3,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="Activity" Size="12" Foreground="#334155" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bộ nhớ RAM:" FontSize="11.5" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding OllamaRamUsageText}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding OllamaStatus.Message}" FontSize="12" Foreground="{StaticResource TextDark}" FontWeight="Medium" TextWrapping="Wrap" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding OllamaStatus.ActiveModel, StringFormat='Mô hình ưu tiên: {0}'}" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>

                        <!-- Action Controls Area -->
                        <StackPanel Grid.Row="3">
                            <!-- When Ollama is STOPPED: Show Start Button -->
                            <Grid Visibility="{Binding IsOllamaRunning, Converter={StaticResource InverseBoolToVisConverter}}">
                                <Button Style="{StaticResource OllamaStartButtonStyle}" 
                                        Command="{Binding StartOllamaCommand}" 
                                        IsEnabled="{Binding CanControlOllama}"
                                        ToolTip="Khởi chạy máy chủ Ollama chạy nền (ollama serve)">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <local:LucideIcon Kind="Play" Size="13" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bật máy chủ Ollama" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- When Ollama is RUNNING: Show Stop Button and Free RAM Button -->
                            <Grid Visibility="{Binding IsOllamaRunning, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nút Tắt máy chủ -->
                                <Button Grid.Column="0" Style="{StaticResource OllamaStopButtonStyle}" 
                                        Command="{Binding StopOllamaCommand}" 
                                        IsEnabled="{Binding CanControlOllama}"
                                        ToolTip="Dừng hoàn toàn tiến trình Ollama và giải phóng 100% RAM">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <local:LucideIcon Kind="Square" Size="12" Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tắt máy chủ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nút Giải phóng RAM -->
                                <Button Grid.Column="2" Style="{StaticResource SecondaryTestButtonStyle}" 
                                        Command="{Binding ReleaseOllamaRamCommand}" 
                                        IsEnabled="{Binding CanControlOllama}"
                                        ToolTip="Hạ tải các mô hình AI đang chiếm RAM về 0 MB mà không cần tắt máy chủ">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <local:LucideIcon Kind="Trash2" Size="12" Foreground="#D97706" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Giải phóng RAM" Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Nút Kiểm tra kết nối Ollama (luôn hiển thị ở dưới) -->
                            <Button Style="{StaticResource SecondaryTestButtonStyle}" 
                                    Command="{Binding TestOllamaCommand}" 
                                    IsEnabled="{Binding CanTestConnection}"
                                    Margin="0,6,0,0"
                                    ToolTip="Gửi tín hiệu kiểm tra kết nối tới cổng http://localhost:11434">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <local:LucideIcon Kind="Activity" Size="12" Foreground="#334155" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kiểm tra kết nối Ollama" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Progress indicator when Busy -->
                            <ProgressBar IsIndeterminate="True" Height="2" Foreground="#059669" Background="Transparent" BorderThickness="0"
                                         Visibility="{Binding IsOllamaBusy, Converter={StaticResource BoolToVisConverter}}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- SECTION 2: AI ROUTING & MODEL SWITCHING -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ĐIỀU PHỐI &amp; CHUYỂN ĐỔI MÔ HÌNH AI HỆ THỐNG" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                        
                        <!-- Catalog Status & Sync Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CatalogStatusMessage}" FontSize="11.5" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryTestButtonStyle}" Command="{Binding ReloadCatalogCommand}" IsEnabled="{Binding CanTestConnection}" ToolTip="Tải lại danh sách mô hình trực tiếp từ API của nhà cung cấp">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="RefreshCw" Size="12" Foreground="#334155" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đồng bộ danh mục" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nhà cung cấp hoạt động -->
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Nhà cung cấp AI đang hoạt động (Active Provider)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}" Height="38" Padding="10,6" FontSize="13" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Mô hình chính -->
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Mô hình LLM được lựa chọn (Active Model)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                <ProgressBar IsIndeterminate="True" Height="2" HorizontalAlignment="Right" Width="80" VerticalAlignment="Center"
                                             Visibility="{Binding IsLoadingModels, Converter={StaticResource BoolToVisConverter}}"/>
                            </Grid>
                            <ComboBox ItemsSource="{Binding AvailableModelInfos}" 
                                      SelectedIndex="{Binding SelectedModelIndex, Mode=TwoWay}" 
                                      Height="38" Padding="10,2" FontSize="13" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding AccessTier, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding AccessTier}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Visibility="{Binding DefaultModel, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="#DCFCE7" CornerRadius="4" Padding="5,2">
                                                <TextBlock Text="Mặc định" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Nhóm nút hành động cấu hình mô hình -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <!-- Nút Test Connection -->
                            <Button Style="{StaticResource SecondaryTestButtonStyle}" Command="{Binding TestCurrentModelCommand}" IsEnabled="{Binding CanTestConnection}" Height="38" Padding="12,0" Margin="0,0,8,0" ToolTip="Gửi request thực tế kiểm tra mô hình đang chọn">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Zap" Size="14" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kiểm tra kết nối" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Khôi phục mặc định -->
                            <Button Style="{StaticResource SecondaryTestButtonStyle}" Command="{Binding RestoreDefaultModelCommand}" Height="38" Padding="10,0" Margin="0,0,8,0" ToolTip="Khôi phục mô hình mặc định của nhà cung cấp này">
                                <local:LucideIcon Kind="RotateCcw" Size="14" Foreground="#475569" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Nút Lưu cấu hình mô hình -->
                            <Button Style="{StaticResource SaveButtonStyle}" Command="{Binding SaveModelConfigCommand}" Height="38" Padding="16,0" ToolTip="Lưu và áp dụng cấu hình mô hình AI cho toàn bộ hệ thống">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Save" Size="15" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lưu cấu hình" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tự động Fallback -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <CheckBox IsChecked="{Binding IsFallbackEnabled}" VerticalContentAlignment="Center">
                            <TextBlock Text="Tự động chuyển đổi nhà cung cấp dự phòng khi lỗi / hết hạn mức (Quota)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                        </CheckBox>
                    </StackPanel>

                    <!-- Banner phản hồi khi lưu cấu hình thành công -->
                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding IsSaveNotificationVisible, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <local:LucideIcon Kind="CheckCircle" Size="16" Foreground="#15803D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SaveNotificationMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding DismissSaveNotificationCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" ToolTip="Đóng thông báo">
                                <local:LucideIcon Kind="X" Size="14" Foreground="#15803D"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Kind="CheckCircle" Size="14" Foreground="#15803D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mọi tác vụ AI trong hệ thống (Gia sư Trợ lý AI, Chấm bài viết AI, Tạo bài học, Tạo câu hỏi) sẽ tự động đồng bộ theo nhà cung cấp và mô hình đã chọn ở trên." FontSize="12" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 3: REALTIME TELEMETRY REQUEST STREAM -->
            <Border Style="{StaticResource AdminCardStyle}" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <TextBlock Text="Nhật ký lệnh gọi AI thời gian thực (Realtime Request Stream)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LastRefreshTime}" FontSize="12" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Items List -->
                    <ItemsControl ItemsSource="{Binding RequestLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,12">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Badge Status -->
                                        <Border Grid.Column="0" Background="{Binding StatusBadgeBg}" CornerRadius="4" Padding="8,3" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeFg}"/>
                                        </Border>

                                        <!-- Detail -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding ActionName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,8,0"/>
                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsFallback, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Dự phòng (Fallback)" FontSize="10.5" FontWeight="Bold" Foreground="#B45309"/>
                                                </Border>
                                                <TextBlock Text="{Binding PromptPreview}" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Provider, StringFormat='Nhà cung cấp: {0}'}" FontSize="11.5" Foreground="#475569" Margin="0,0,10,0"/>
                                                <TextBlock Text="•" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Model, StringFormat='Mô hình: {0}'}" FontSize="11.5" Foreground="#475569" Margin="0,0,10,0"/>
                                                <TextBlock Text="•" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding LatencyMs, StringFormat='Độ trễ: {0}ms'}" FontSize="11.5" Foreground="#0284C7" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#DC2626" Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding Success, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                        </StackPanel>

                                        <!-- Time -->
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" FontSize="12" Foreground="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State placeholder when no request logs -->
                    <Border Padding="36,28" Visibility="{Binding IsRequestLogsEmpty, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#F1F5F9" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <local:LucideIcon Kind="Activity" Size="20" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chưa có yêu cầu AI nào được ghi nhận trong phiên làm việc hiện tại" FontWeight="SemiBold" FontSize="13" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Các cuộc hội thoại Trợ lý AI, Chấm bài viết hoặc Sinh câu hỏi sẽ tự động hiển thị thời gian thực tại đây." FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
