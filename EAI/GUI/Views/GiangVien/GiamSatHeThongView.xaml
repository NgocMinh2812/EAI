<Page x:Class="GUI.Views.GiangVien.GiamSatHeThongView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Giám sát hệ thống - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Top Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Giám sát Hệ thống &amp; Hiệu năng AI API" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock Text="Theo dõi độ trễ API AI, lưu lượng câu hỏi sinh tự động, trạng thái kết nối cơ sở dữ liệu và tải hệ thống" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Hệ thống hoạt động ổn định (99.98%)" FontWeight="Bold" FontSize="12.5" Foreground="#15803D"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4 Metric Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource AdminCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Yêu cầu AI hôm nay" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Text="4,820" FontWeight="Bold" FontSize="26" Foreground="{StaticResource TextDark}" Margin="0,6,0,2"/>
                        <TextBlock Text="+12% so với hôm qua" FontSize="11.5" Foreground="#15803D" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AdminCardStyle}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Độ trễ trung bình" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Text="420 ms" FontWeight="Bold" FontSize="26" Foreground="{StaticResource TextDark}" Margin="0,6,0,2"/>
                        <TextBlock Text="Tối ưu NLP &lt; 500ms" FontSize="11.5" Foreground="#15803D" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AdminCardStyle}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Trạng thái Database" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Text="Kết nối tốt" FontWeight="Bold" FontSize="26" Foreground="#15803D" Margin="0,6,0,2"/>
                        <TextBlock Text="Truy vấn trung bình: 12ms" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AdminCardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Tỷ lệ sinh lỗi (Errors)" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        <TextBlock Text="0.02%" FontWeight="Bold" FontSize="26" Foreground="#0284C7" Margin="0,6,0,2"/>
                        <TextBlock Text="1 / 4,820 requests" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- API Calls Log Table -->
            <Border Style="{StaticResource AdminCardStyle}" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,12">
                        <TextBlock Text="Nhật ký lệnh gọi AI gần nhất (Realtime API Stream)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                    </Border>

                    <!-- Log 1 -->
                    <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,12,0">
                                <TextBlock Text="POST 200 OK" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="AI Question Generation — Prompt: '5 câu ngữ pháp B1 Present Perfect...'" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Model: gpt-4o • Tokens: 842 in / 390 out • Thời gian phản hồi: 520ms" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="14:22:15" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Log 2 -->
                    <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,12,0">
                                <TextBlock Text="POST 200 OK" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="AI Essay Grading — IELTS Task 2 Writing Evaluation &amp; Rubric Scoring" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Model: claude-3-5-sonnet • Tokens: 1,420 in / 680 out • Thời gian phản hồi: 890ms" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="14:20:42" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Log 3 -->
                    <Border Padding="20,12">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,12,0">
                                <TextBlock Text="POST 200 OK" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tutor Chatbot — Contextual grammar explanation and vocabulary collocation" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Model: gemini-1.5-pro • Tokens: 620 in / 210 out • Thời gian phản hồi: 310ms" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="14:18:05" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
