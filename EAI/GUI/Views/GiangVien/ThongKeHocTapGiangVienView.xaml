<Page x:Class="GUI.Views.GiangVien.ThongKeHocTapGiangVienView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Thống kê học tập - Admin Dashboard"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.02" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Header Style -->
        <Style x:Key="ModernDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- Modern DataGrid Row Style -->
        <Style x:Key="ModernDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0FDF4"/>
                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern DataGrid Cell Style -->
        <Style x:Key="ModernDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- ================= 1. TOP HEADER & EXPORT ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Thống kê &amp; Giám sát Kết quả Học tập" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock Text="Báo cáo giám sát tiến độ thi thử, phổ điểm bài làm, phân tích kỹ năng và danh sách nộp bài của sinh viên" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                            FontWeight="SemiBold" FontSize="12.5" Padding="14,9" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0" Click="BtnLamMoi_Click" ToolTip="Làm mới lại toàn bộ số liệu báo cáo">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="RefreshCw" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                            FontWeight="SemiBold" FontSize="12.5" Padding="16,9" Cursor="Hand" BorderThickness="0" Click="BtnXuatExcel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="Download" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                        <TextBlock Text="Xuất Báo cáo Excel (.xlsx)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 2. FILTER TOOLBAR ================= -->
            <Border Style="{StaticResource AdminCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Time Filter Quick Tabs -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="KHOẢNG THỜI GIAN:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <Button x:Name="btnFilterHomNay" Content="Hôm nay" Click="BtnFilterHomNay_Click" 
                                Background="#F1F5F9" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="12" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="btnFilter7Ngay" Content="7 ngày qua" Click="BtnFilter7Ngay_Click" 
                                Background="{StaticResource AdminDarkGreen}" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="btnFilter30Ngay" Content="30 ngày qua" Click="BtnFilter30Ngay_Click" 
                                Background="#F1F5F9" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="12" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="btnFilterTatCa" Content="Tất cả thời gian" Click="BtnFilterTatCa_Click" 
                                Background="#F1F5F9" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="12" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Row 2: Exam Dropdown, Mode, Search & Apply -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Đề thi Dropdown -->
                        <ComboBox x:Name="cboDeThi" Grid.Column="0" Height="36" Cursor="Hand" VerticalContentAlignment="Center" FontSize="12">
                            <ComboBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>

                        <!-- Hình thức thi -->
                        <ComboBox x:Name="cboHinhThuc" Grid.Column="2" Height="36" Cursor="Hand" SelectedIndex="0" VerticalContentAlignment="Center" FontSize="12">
                            <ComboBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Tất cả hình thức" Tag="TatCa"/>
                            <ComboBoxItem Content="Thi thử" Tag="ThiThu"/>
                            <ComboBoxItem Content="Luyện tập" Tag="LuyenTap"/>
                        </ComboBox>

                        <!-- Tìm kiếm sinh viên / bài thi có Placeholder Watermark -->
                        <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:LucideIcon Kind="Search" Size="14" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="12.5" 
                                             MaxLength="100" VerticalContentAlignment="Center" 
                                             TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"/>
                                    <TextBlock x:Name="txtSearchPlaceholder" Text="Tìm theo họ tên, tài khoản, bài thi..." 
                                               FontSize="12" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" 
                                               IsHitTestVisible="False" Margin="2,0,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Nút Lọc dữ liệu bo góc -->
                        <Button Grid.Column="6" Click="BtnApDungLoc_Click" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                FontWeight="Bold" FontSize="12.5" Padding="18,0" Height="36" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Search" Size="13" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="Áp dụng bộ lọc" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= 3. 6 KPI SUMMARY CARDS ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng lượt thi -->
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#EFF6FF" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Layers" Size="14" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TỔNG LƯỢT THI" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiTongLuot" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Bao gồm cả chưa nộp" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Lượt đã nộp -->
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#ECFDF5" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="CheckCircle2" Size="14" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ĐÃ HOÀN THÀNH" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiDaNop" Text="0" FontSize="20" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="Đã nộp bài chính thức" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Điểm trung bình -->
                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#FEF3C7" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Award" Size="14" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ĐIỂM TRUNG BÌNH" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiDiemTB" Text="0.0" FontSize="20" FontWeight="Bold" Foreground="#B45309"/>
                        <TextBlock Text="Thang điểm 10.0" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Thời gian TB -->
                <Border Grid.Column="6" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#F3E8FF" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Clock" Size="14" Foreground="#7E22CE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="THỜI GIAN TB" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiThoiGianTB" Text="0.0" FontSize="20" FontWeight="Bold" Foreground="#6B21A8"/>
                        <TextBlock Text="Phút / lượt làm bài" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 5: Tỷ lệ hoàn thành -->
                <Border Grid.Column="8" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#FEE2E2" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Percent" Size="14" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TỶ LỆ NỘP BÀI" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiTyLeHoanThanh" Text="0.0%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Tỷ lệ nộp trên số lượt" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 6: Học viên tham gia -->
                <Border Grid.Column="10" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#CCFBF1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Users" Size="14" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="HỌC VIÊN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiHocVien" Text="0" FontSize="20" FontWeight="Bold" Foreground="#0F766E"/>
                        <TextBlock Text="Số học viên duy nhất" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= 4. VISUAL CHARTS & ANALYTICS WIDGETS ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Widget 1: Phân bố điểm số (Histogram) -->
                <Border Grid.Column="0" Style="{StaticResource AdminCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Phân bố Điểm số Sinh viên" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Dựa trên các bài thi đã nộp" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="pnlChartPhanBoDiem"/>
                    </StackPanel>
                </Border>

                <!-- Widget 2: Hiệu suất & Điểm TB theo Kỹ năng -->
                <Border Grid.Column="2" Style="{StaticResource AdminCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Hiệu suất Năng lực theo Kỹ năng" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Điểm trung bình &amp; Tỷ lệ đúng" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="pnlChartKyNang"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Widget 3: Xu hướng lượt nộp theo ngày -->
                <Border Grid.Column="0" Style="{StaticResource AdminCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Xu hướng Nộp bài theo Ngày" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Số lượt hoàn thành theo mốc thời gian" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="pnlChartXuHuongNgay"/>
                    </StackPanel>
                </Border>

                <!-- Widget 4: Tỷ lệ hoàn thành theo Đề thi -->
                <Border Grid.Column="2" Style="{StaticResource AdminCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Hoàn thành theo Bài tập &amp; Đề thi" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Top các kỳ thi có sinh viên tham gia" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="pnlChartKyThi"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= 5. RECENT SUBMISSIONS TABLE (MODERN DESIGN LIKE KHAOSAT) ================= -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="ClipboardList" Size="18" Foreground="{StaticResource AdminDarkGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Danh sách Lượt làm bài &amp; Nộp bài của Sinh viên" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                            <Border Background="#ECFDF5" CornerRadius="10" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtSubmissionsCount" Text="0 lượt nộp" FontSize="11.5" FontWeight="Bold" Foreground="#047857"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Modern DataGrid Container -->
                    <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <!-- Empty State khi chưa có dữ liệu nộp bài -->
                            <StackPanel x:Name="pnlEmptySubmissions" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,45" Visibility="Collapsed">
                                <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Chưa có dữ liệu bài nộp trong khoảng thời gian này" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Các lượt làm bài của sinh viên sẽ tự động xuất hiện tại đây sau khi sinh viên hoàn thành hoặc nộp bài." FontSize="12" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <DataGrid x:Name="dgDanhSachBaiNop" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                      Background="White" BorderThickness="0" MinHeight="220"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      MouseDoubleClick="DgDanhSachBaiNop_MouseDoubleClick"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                      RowStyle="{StaticResource ModernDataGridRowStyle}"
                                      CellStyle="{StaticResource ModernDataGridCellStyle}">
                                <DataGrid.Columns>
                                    <!-- Cột 1: Mã lượt -->
                                    <DataGridTextColumn Header="MÃ" Binding="{Binding MaLuotLamBai}" Width="55"/>

                                    <!-- Cột 2: Sinh viên (Avatar + Tên + Username) -->
                                    <DataGridTemplateColumn Header="SINH VIÊN" Width="2.2*" MinWidth="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="#E0F2FE" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="11.5" Foreground="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HoTenNguoiDung}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                                                        <TextBlock Text="{Binding TenDangNhap, StringFormat='@{0}'}" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột 3: Bài thi / Luyện tập -->
                                    <DataGridTemplateColumn Header="BÀI THI / ĐỀ THI" Width="2.8*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TenBaiTapDeThi}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}" 
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột 4: Hình thức -->
                                    <DataGridTemplateColumn Header="HÌNH THỨC" Width="1.1*" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding HinhThucBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding HinhThucHienThi}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding HinhThucFg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột 5: Bắt đầu lúc -->
                                    <DataGridTemplateColumn Header="BẮT ĐẦU LÚC" Width="1.4*" MinWidth="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Clock" Size="13" Foreground="{StaticResource TextGray}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ThoiDiemBatDauHienThi}" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột 6: Thời gian làm bài -->
                                    <DataGridTemplateColumn Header="THỜI GIAN" Width="1.1*" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding ThoiGianLamPhutHienThi, StringFormat='{}{0} phút'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột 7: Số câu đúng -->
                                    <DataGridTemplateColumn Header="KẾT QUẢ ĐÚNG" Width="1.2*" MinWidth="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#ECFDF5" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding SoCauDungTrenTong, StringFormat='{}{0} câu'}" FontWeight="SemiBold" FontSize="11.5" Foreground="#047857"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột 8: Điểm số -->
                                    <DataGridTemplateColumn Header="ĐIỂM SỐ" Width="1*" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DiemSo, StringFormat='{}{0:0.0}'}" FontWeight="Bold" FontSize="13.5" Foreground="{Binding ScoreColor}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột 9: Trạng thái -->
                                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.2*" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding TrangThaiBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding TrangThaiHienThi}" FontWeight="Bold" FontSize="11" Foreground="{Binding TrangThaiFg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột 10: Thao tác -->
                                    <DataGridTemplateColumn Header="THAO TÁC" Width="1.1*" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Click="BtnXemChiTietBaiLam_Click" Tag="{Binding MaLuotLamBai}" 
                                                        Background="#F1F5F9" Foreground="{StaticResource AdminDarkGreen}" 
                                                        FontWeight="SemiBold" FontSize="11.5" Padding="8,4" Cursor="Hand" BorderThickness="0"
                                                        ToolTip="Xem toàn bộ các câu hỏi và câu trả lời của sinh viên">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <local:LucideIcon Kind="Eye" Size="12" Foreground="{StaticResource AdminDarkGreen}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Chi tiết" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Table Footer: Pagination Controls (US-GV03 chuẩn hóa) -->
                        <Border Grid.Row="1" x:Name="pnlSubPagination" Background="#FAFBFB" Padding="20,12" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" x:Name="txtSubCounter" Text="Hiển thị 1 - 10 / 18 lượt làm bài" FontSize="12.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnPrevSubPage" Content="◀ Trước" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                            Foreground="{StaticResource TextDark}" FontSize="12" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnPrevSubPage_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,8,0">
                                        <TextBlock x:Name="txtSubPageInfo" Text="Trang 1 / 1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AdminDarkGreen}" VerticalAlignment="Center"/>
                                    </Border>

                                    <Button x:Name="btnNextSubPage" Content="Sau ▶" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                            Foreground="{StaticResource TextDark}" FontSize="12" FontWeight="SemiBold" Padding="14,6" Cursor="Hand" Click="BtnNextSubPage_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
