<Page x:Class="GUI.Views.GiangVien.ThongKeHocTapGiangVienView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Thống kê học tập - Admin Dashboard"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.02" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- ================= 1. TOP HEADER & EXPORT ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Thống kê &amp; Giám sát Kết quả Học tập" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock Text="Báo cáo giám sát tiến độ thi thử, phổ điểm bài làm, phân tích kỹ năng và danh sách nộp bài của sinh viên" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <Button Grid.Column="1" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="13" Padding="18,10" Cursor="Hand" BorderThickness="0" Click="BtnXuatExcel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Download" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Xuất Báo cáo Excel (.xlsx)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ================= 2. FILTER TOOLBAR ================= -->
            <Border Style="{StaticResource AdminCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Time Filter Quick Tabs -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="KHOẢNG THỜI GIAN:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="btnFilterHomNay" Content="Hôm nay" Click="BtnFilterHomNay_Click" 
                                Background="#F1F5F9" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="12" Padding="12,5" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0"/>
                        <Button x:Name="btnFilter7Ngay" Content="7 ngày qua" Click="BtnFilter7Ngay_Click" 
                                Background="{StaticResource AdminDarkGreen}" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="12,5" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0"/>
                        <Button x:Name="btnFilter30Ngay" Content="30 ngày qua" Click="BtnFilter30Ngay_Click" 
                                Background="#F1F5F9" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="12" Padding="12,5" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0"/>
                        <Button x:Name="btnFilterTatCa" Content="Tất cả thời gian" Click="BtnFilterTatCa_Click" 
                                Background="#F1F5F9" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="12" Padding="12,5" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Row 2: Exam Dropdown, Mode, Search & Apply -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Đề thi Dropdown -->
                        <ComboBox x:Name="cboDeThi" Grid.Column="0" Height="36" Cursor="Hand" VerticalContentAlignment="Center"/>

                        <!-- Hình thức thi -->
                        <ComboBox x:Name="cboHinhThuc" Grid.Column="2" Height="36" Cursor="Hand" SelectedIndex="0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Tất cả hình thức" Tag="TatCa"/>
                            <ComboBoxItem Content="Thi thử" Tag="ThiThu"/>
                            <ComboBoxItem Content="Luyện tập" Tag="LuyenTap"/>
                        </ComboBox>

                        <!-- Tìm kiếm sinh viên / bài thi -->
                        <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:LucideIcon Kind="Search" Size="14" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="12.5" 
                                         VerticalContentAlignment="Center" ToolTip="Tìm kiếm theo họ tên, tài khoản..."/>
                            </Grid>
                        </Border>

                        <!-- Nút Lọc dữ liệu -->
                        <Button Grid.Column="6" Content="Áp dụng bộ lọc" Click="BtnApDungLoc_Click" Background="#0F4C3A" Foreground="White" 
                                FontWeight="Bold" FontSize="12.5" Padding="16,0" Height="36" Cursor="Hand" BorderThickness="0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= 3. 6 KPI SUMMARY CARDS ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng lượt thi -->
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#EFF6FF" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Layers" Size="14" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TỔNG LƯỢT THI" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiTongLuot" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Bao gồm cả chưa nộp" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Lượt đã nộp -->
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#ECFDF5" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="CheckCircle2" Size="14" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ĐÃ HOÀN THÀNH" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiDaNop" Text="0" FontSize="20" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="Đã nộp bài chính thức" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Điểm trung bình -->
                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#FEF3C7" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Award" Size="14" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ĐIỂM TRUNG BÌNH" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiDiemTB" Text="0.0" FontSize="20" FontWeight="Bold" Foreground="#B45309"/>
                        <TextBlock Text="Thang điểm 10.0" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Thời gian TB -->
                <Border Grid.Column="6" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#F3E8FF" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Clock" Size="14" Foreground="#7E22CE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="THỜI GIAN TB" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiThoiGianTB" Text="0.0" FontSize="20" FontWeight="Bold" Foreground="#6B21A8"/>
                        <TextBlock Text="Phút / lượt làm bài" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 5: Tỷ lệ hoàn thành -->
                <Border Grid.Column="8" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#FEE2E2" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Percent" Size="14" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TỶ LỆ NỘP BÀI" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiTyLeHoanThanh" Text="0.0%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Tỷ lệ nộp trên số lượt" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 6: Học viên tham gia -->
                <Border Grid.Column="10" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#CCFBF1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <local:LucideIcon Kind="Users" Size="14" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="HỌC VIÊN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtKpiHocVien" Text="0" FontSize="20" FontWeight="Bold" Foreground="#0F766E"/>
                        <TextBlock Text="Số học viên duy nhất" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= 4. VISUAL CHARTS & ANALYTICS WIDGETS ================= -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Widget 1: Phân bố điểm số (Histogram) -->
                <Border Grid.Column="0" Style="{StaticResource AdminCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Phân bố Điểm số Sinh viên" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Dựa trên các bài thi đã nộp" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="pnlChartPhanBoDiem"/>
                    </StackPanel>
                </Border>

                <!-- Widget 2: Hiệu suất & Điểm TB theo Kỹ năng -->
                <Border Grid.Column="2" Style="{StaticResource AdminCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Hiệu suất Năng lực theo Kỹ năng" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Điểm trung bình &amp; Tỷ lệ đúng" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="pnlChartKyNang"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Widget 3: Xu hướng lượt nộp theo ngày -->
                <Border Grid.Column="0" Style="{StaticResource AdminCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Xu hướng Nộp bài theo Ngày" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Số lượt hoàn thành theo mốc thời gian" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="pnlChartXuHuongNgay"/>
                    </StackPanel>
                </Border>

                <!-- Widget 4: Tỷ lệ hoàn thành theo Đề thi -->
                <Border Grid.Column="2" Style="{StaticResource AdminCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Hoàn thành theo Bài tập &amp; Đề thi" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Top các kỳ thi có sinh viên tham gia" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="pnlChartKyThi"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= 5. RECENT SUBMISSIONS TABLE ================= -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Danh sách Lượt làm bài &amp; Nộp bài của Sinh viên" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}"/>
                            <Border Background="#ECFDF5" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock x:Name="txtSubmissionsCount" Text="0 lượt nộp" FontSize="11.5" FontWeight="Bold" Foreground="#065F46"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="dgDanhSachBaiNop" AutoGenerateColumns="False" CanUserAddRows="False" 
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" MinHeight="220" MaxHeight="450">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã lượt" Binding="{Binding MaLuotLamBai}" Width="65"/>
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding HoTenNguoiDung}" Width="150"/>
                            <DataGridTextColumn Header="Tài khoản" Binding="{Binding TenDangNhap}" Width="105"/>
                            <DataGridTextColumn Header="Bài thi / Luyện tập" Binding="{Binding TenBaiTapDeThi}" Width="*"/>
                            <DataGridTextColumn Header="Hình thức" Binding="{Binding HinhThucHienThi}" Width="90"/>
                            <DataGridTextColumn Header="Bắt đầu lúc" Binding="{Binding ThoiDiemBatDau, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="130"/>
                            <DataGridTextColumn Header="Thời gian (phút)" Binding="{Binding ThoiGianLamPhutHienThi}" Width="105"/>
                            <DataGridTextColumn Header="Số câu đúng" Binding="{Binding SoCauDungTrenTong}" Width="90"/>
                            <DataGridTextColumn Header="Điểm số" Binding="{Binding DiemSo, StringFormat=\{0:0.0\}}" Width="75"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiHienThi}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
