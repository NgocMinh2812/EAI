<Window x:Class="GUI.Views.GiangVien.TaoFlashcardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Thẻ ghi nhớ Flashcard" 
        Icon="pack://application:,,,/GUI;component/Assets/app_icon.ico"
        Height="670" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F766E"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F766E"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Multi-line TextBox Style -->
        <Style x:Key="MultiLineTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F766E"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F766E"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style inheriting Application Theme -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <!-- IPA Helper Character Button Style -->
        <Style x:Key="IpaCharBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Shadow -->
    <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Tab Navigation -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Content Body -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="15,15,0,0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="10" Width="40" Height="40" Margin="0,0,14,0">
                        <local:LucideIcon Kind="Sparkles" Size="20" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Thẻ ghi nhớ Flashcard &amp; Từ vựng" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Tạo từ vựng mới &amp; Ôn tập phương pháp ghi nhớ lặp lại Spaced Repetition" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                    <local:LucideIcon Kind="X" Size="16" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ================= TAB NAVIGATION ================= -->
            <Border Grid.Row="1" Background="White" Padding="20,12,20,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Segmented Control Pill -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnTabTaoMoi" Content="+ Tạo Flashcard mới" FontSize="12.5" FontWeight="SemiBold" 
                                    Padding="14,6" Cursor="Hand" BorderThickness="0" Background="#0F766E" Foreground="White" Click="BtnTabTaoMoi_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnTabOnTap" Content="🎴 Thẻ ôn tập Flashcard" FontSize="12.5" FontWeight="SemiBold" 
                                    Padding="14,6" Cursor="Hand" BorderThickness="0" Background="Transparent" Foreground="#64748B" Click="BtnTabOnTap_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= CONTENT BODY ================= -->
            <Grid Grid.Row="2" Margin="20,14,20,18">

                <!-- ################# TAB 1: TẠO FLASHCARD MỚI ################# -->
                <ScrollViewer x:Name="pnlTaoMoi" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Margin="0,0,16,0">
                        <!-- Từ vựng tiếng Anh -->
                        <TextBlock Text="TỪ VỰNG TIẾNG ANH (*)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtTu" Style="{StaticResource ModernTextBox}" FontSize="14" FontWeight="SemiBold" 
                                     ToolTip="Nhập từ vựng tiếng Anh cần tạo flashcard (ví dụ: perseverance, resilient...)"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Height="38" Padding="12,0" Background="#F0FDF4" BorderBrush="#86EFAC" 
                                    BorderThickness="1" Cursor="Hand" Click="BtnDocThuTu_Click" ToolTip="Nghe AI phát âm chuẩn giọng bản xứ">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Volume2" Size="15" Foreground="#15803D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Phát âm AI" FontSize="12.5" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#DCFCE7"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4ADE80"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Cặp: Loại từ & Trình độ -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LOẠI TỪ" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboLoaiTu" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Danh từ (noun)" IsSelected="True"/>
                                    <ComboBoxItem Content="Động từ (verb)"/>
                                    <ComboBoxItem Content="Tính từ (adjective)"/>
                                    <ComboBoxItem Content="Trạng từ (adverb)"/>
                                    <ComboBoxItem Content="Cụm từ (phrase)"/>
                                    <ComboBoxItem Content="Thành ngữ (idiom)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TRÌNH ĐỘ CEFR" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboTrinhDo" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="A1 — Căn bản"/>
                                    <ComboBoxItem Content="A2 — Sơ cấp"/>
                                    <ComboBoxItem Content="B1 — Trung cấp"/>
                                    <ComboBoxItem Content="B2 — Trên trung cấp" IsSelected="True"/>
                                    <ComboBoxItem Content="C1 — Cao cấp"/>
                                    <ComboBoxItem Content="C2 — Thành thạo"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Phiên âm IPA -->
                        <TextBlock Text="PHIÊN ÂM QUỐC TẾ (IPA)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtPhienAm" Style="{StaticResource ModernTextBox}" Margin="0,0,0,6" 
                                 ToolTip="Ví dụ: /ˌpɜː.sɪˈvɪə.rəns/ hoặc /rɪˈzɪl.jənt/"/>
                        <!-- IPA Quick Insert Buttons -->
                        <WrapPanel Margin="0,0,0,12">
                            <TextBlock Text="Gõ nhanh ký tự: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,4"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ə" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ɪ" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ʊ" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="æ" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ʌ" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ɑː" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ɔː" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ɜː" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="θ" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ð" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ʃ" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ʒ" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ŋ" Click="BtnIpaChar_Click"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ˈ" Click="BtnIpaChar_Click" ToolTip="Trọng âm chính"/>
                            <Button Style="{StaticResource IpaCharBtnStyle}" Content="ˌ" Click="BtnIpaChar_Click" ToolTip="Trọng âm phụ"/>
                        </WrapPanel>

                        <!-- Nghĩa tiếng Việt -->
                        <TextBlock Text="NGHĨA TIẾNG VIỆT (*)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNghia" Style="{StaticResource MultiLineTextBox}" Height="54" Margin="0,0,0,12" 
                                 ToolTip="Nhập giải nghĩa tiếng Việt chi tiết của từ"/>

                        <!-- Câu ví dụ minh họa -->
                        <TextBlock Text="CÂU VÍ DỤ MINH HỌA (ENGLISH)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtCauViDu" Style="{StaticResource MultiLineTextBox}" Height="54" Margin="0,0,0,12" 
                                 ToolTip="Ví dụ: Learning English requires perseverance and daily practice."/>

                        <!-- Chủ đề -->
                        <TextBlock Text="CHỦ ĐỀ TỪ VỰNG" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboChuDe" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16"/>

                        <!-- Status Alert Text -->
                        <TextBlock x:Name="txtStatus" FontSize="12" Foreground="#DC2626" Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap"/>

                        <!-- Action Buttons -->
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Hủy bỏ" FontSize="13" FontWeight="SemiBold" Foreground="#475569" 
                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20,9" Cursor="Hand" Click="BtnClose_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Content="💾 Lưu &amp; Thêm vào Flashcard" FontSize="13" FontWeight="Bold" Foreground="White" 
                                    Background="#0F766E" BorderThickness="0" Padding="24,9" Cursor="Hand" Click="BtnLuuFlashcard_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0B5B55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ################# TAB 2: ÔN TẬP THẺ FLASHCARD ################# -->
                <Grid x:Name="pnlOnTap" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Filter & Stats Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Flip Card Area -->
                        <RowDefinition Height="*"/>
                        <!-- Row 2: Controls & Grading Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Filter & Progress -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="#F1F5F9" BorderThickness="1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Lọc cấp độ: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" x:Name="cboLocTrinhDo" Style="{StaticResource ModernComboBox}" Width="130" Height="32" FontSize="12" VerticalAlignment="Center">
                                <ComboBoxItem Content="Tất cả cấp độ" IsSelected="True"/>
                                <ComboBoxItem Content="A1"/>
                                <ComboBoxItem Content="A2"/>
                                <ComboBoxItem Content="B1"/>
                                <ComboBoxItem Content="B2"/>
                                <ComboBoxItem Content="C1"/>
                            </ComboBox>

                            <TextBlock Grid.Column="2" x:Name="txtTienDoOnTap" Text="Thẻ 1 / 13" FontSize="13" FontWeight="Bold" 
                                       Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border Grid.Column="3" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" 
                                    CornerRadius="8" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Check" Size="13" Foreground="#15803D" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtDaThuocCount" Text="Đã thuộc: 0/13" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Flashcard Interactive Box -->
                    <Border Grid.Row="1" x:Name="bdCard" Margin="0,4,0,12" CornerRadius="16" Cursor="Hand" MouseLeftButtonUp="BdCard_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.10" Color="#0F172A"/>
                        </Border.Effect>

                        <Grid>
                            <!-- ============= MẶT TRƯỚC (FRONT) ============= -->
                            <Border x:Name="pnlMatTruoc" CornerRadius="16" BorderBrush="#86EFAC" BorderThickness="1.5" Visibility="Visible" Padding="28,20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F0FDF4" Offset="0"/>
                                        <GradientStop Color="#DCFCE7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Topic Badge -->
                                    <Border Grid.Row="0" HorizontalAlignment="Center" Background="White" CornerRadius="12" Padding="12,4" BorderBrush="#BBF7D0" BorderThickness="1">
                                        <TextBlock x:Name="txtCardBadge" Text="VOCABULARY • B2" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>

                                    <!-- Middle: Big Word & IPA -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtMatTruocTu" Text="perseverance" FontSize="34" FontWeight="Bold" Foreground="#0F172A" 
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtMatTruocIPA" Text="/ˌpɜː.sɪˈvɪə.rəns/" FontSize="16" FontStyle="Italic" Foreground="#047857" 
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- Speaker Audio Button -->
                                    <Button Grid.Row="2" HorizontalAlignment="Center" Width="44" Height="44" Background="White" BorderBrush="#86EFAC" 
                                            BorderThickness="1.5" Cursor="Hand" Click="BtnPhatAmMatTruoc_Click" ToolTip="Nghe phát âm từ vựng này" Margin="0,0,0,10">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                                                    <local:LucideIcon Kind="Volume2" Size="20" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#DCFCE7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Bottom Hint -->
                                    <TextBlock Grid.Row="3" Text="👆 Nhấp vào thẻ hoặc bấm nút Lật thẻ để xem nghĩa &amp; ví dụ" FontSize="11.5" Foreground="#64748B" 
                                               HorizontalAlignment="Center" FontStyle="Italic"/>
                                </Grid>
                            </Border>

                            <!-- ============= MẶT SAU (BACK) ============= -->
                            <Border x:Name="pnlMatSau" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1.5" Visibility="Collapsed" Padding="28,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#F8FAFC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Word & POS -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock x:Name="txtMatSauTu" Text="perseverance" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,8,0"/>
                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                            <TextBlock x:Name="txtMatSauLoaiTu" Text="danh từ" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Middle: Meaning & Example -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtMatSauNghia" Text="Sự kiên trì, bền chí trong việc thực hiện mục tiêu." FontSize="16" FontWeight="SemiBold" 
                                                   Foreground="#0F766E" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <TextBlock x:Name="txtMatSauViDu" Text="&quot;Learning English requires perseverance and daily practice.&quot;" 
                                                       FontSize="13" FontStyle="Italic" Foreground="#334155" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </Border>

                                        <TextBlock x:Name="txtMatSauThongKe" Text="Đã ôn tập: 0 lần • Đúng: 0 lần" FontSize="11" Foreground="#94A3B8" 
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <!-- Bottom Hint -->
                                    <TextBlock Grid.Row="2" Text="👆 Nhấp vào thẻ để quay lại mặt trước" FontSize="11.5" Foreground="#64748B" 
                                               HorizontalAlignment="Center" FontStyle="Italic"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bottom Bar: Navigation & Spaced Repetition Buttons -->
                    <Grid Grid.Row="2" Margin="0,4,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Controls: Prev, Flip, Next -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="◀ Từ trước" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" 
                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,7" Cursor="Hand" Click="BtnCardPrev_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="1" HorizontalAlignment="Center" Content="🔄 Lật mặt thẻ" FontSize="13" FontWeight="Bold" Foreground="#0F766E" 
                                    Background="#E6FFFA" BorderBrush="#86EFAC" BorderThickness="1" Padding="20,7" Cursor="Hand" Click="BtnCardFlip_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#CCFBF1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Content="Từ tiếp theo ▶" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" 
                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,7" Cursor="Hand" Click="BtnCardNext_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Spaced Repetition Grading: Chưa nhớ / Đã thuộc -->
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Height="44" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" 
                                    Cursor="Hand" Click="BtnChuaNho_Click" ToolTip="Chưa nhớ - Xếp lịch ôn lại sớm">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="RotateCcw" Size="16" Foreground="#B91C1C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Chưa nhớ (Ôn lại)" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#F87171"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Height="44" Background="#0F766E" BorderBrush="#0F766E" BorderThickness="1" 
                                    Cursor="Hand" Click="BtnDaThuoc_Click" ToolTip="Đã ghi nhớ thành thạo từ này">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Check" Size="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Đã thuộc từ này" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0B5B55"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B5B55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>

