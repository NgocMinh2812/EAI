<Window x:Class="GUI.Views.GiangVien.UploadTaiLieuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Tải lên Học liệu &amp; Đề thi" 
        Icon="pack://application:,,,/GUI;component/Assets/app_icon.ico"
        Height="680" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F766E"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F766E"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B5B55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <!-- Lớp đổ bóng độc lập phía sau -->
        <Border CornerRadius="18" Background="#042F2E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#042F2E"/>
            </Border.Effect>
        </Border>

        <!-- Khung nội dung hộp thoại (Không có Effect -> Render Vector & ClearType sắc nét 100%) -->
        <Border CornerRadius="18" BorderBrush="#5EEAD4" BorderThickness="1.5" Background="#F2F9F7" ClipToBounds="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Emerald Teal Header Banner -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="22,16,20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#042F2E" Offset="0.0"/>
                        <GradientStop Color="#0F4C3A" Offset="0.45"/>
                        <GradientStop Color="#0F766E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#26FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                        <local:LucideIcon Kind="Upload" Size="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tải lên Tệp Đề thi &amp; Học liệu Mới" FontWeight="Bold" FontSize="17" Foreground="White"/>
                        <TextBlock Text="Hỗ trợ tự động bóc tách nội dung từ tệp .pdf, .docx, .txt để lưu vào CSDL" FontSize="12" Foreground="#CCFBF1" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="28" Height="28" Background="Transparent" BorderThickness="0" 
                            Cursor="Hand" VerticalAlignment="Center" ToolTip="Đóng cửa sổ" Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#FEE2E2" CornerRadius="14" BorderBrush="#FECACA" BorderThickness="1">
                                    <TextBlock x:Name="t" Text="✕" FontSize="13" FontWeight="Bold" Foreground="#DC2626" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#DC2626"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#B91C1C"/>
                                        <Setter TargetName="t" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Soft Mint Form Body -->
            <Border Grid.Row="1" Background="#F2F9F7" CornerRadius="0,0,16,16" Padding="22,14,22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable Form Inputs -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- VÙNG CHỌN TỆP HỌC LIỆU (CHỈ CHẤP NHẬN .DOCX, .PDF, .TXT) -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                                    AllowDrop="True" Drop="PnlFile_Drop" DragOver="PnlFile_DragOver">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" x:Name="pnlFileIconBadge" Width="38" Height="38" CornerRadius="8" Background="#E0F2FE" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <local:LucideIcon x:Name="icoFileTypeDisplay" Kind="FileText" Size="18" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtFileNameDisplay" Text="Chưa chọn tệp (.docx, .pdf, .txt)" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="txtFileSizeDisplay" Text="Hỗ trợ tài liệu Word (.docx), PDF (.pdf) hoặc Văn bản thuần (.txt)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Background="#0F766E" Foreground="White" 
                                            FontWeight="SemiBold" FontSize="12" Padding="14,7" BorderThickness="0" Cursor="Hand" Click="BtnBrowseFile_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <local:LucideIcon Kind="FolderOpen" Size="13" Foreground="White" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Chọn tệp..." FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Tiêu đề học liệu -->
                            <TextBlock Text="Tiêu đề bài học / Đề thi *" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTieuDe" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>

                            <!-- Danh mục chủ đề -->
                            <TextBlock Text="Thuộc Danh mục &amp; Chủ đề *" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cboChuDe" Height="36" Margin="0,0,0,10" DisplayMemberPath="TenHienThi" SelectedValuePath="MaChuDe"/>

                            <!-- Trình độ & Kỹ năng (2 cột song song) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <!-- Trình độ -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Trình độ mục tiêu" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cboTrinhDo" Height="36" DisplayMemberPath="TenHienThi" SelectedValuePath="MaCapDo"/>
                                </StackPanel>

                                <!-- Phân loại kỹ năng -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kỹ năng phân loại" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cboLoaiBaiHoc" Height="36" SelectedIndex="0" SelectionChanged="CboLoaiBaiHoc_SelectionChanged">
                                        <ComboBoxItem Content="Đọc hiểu (Reading)" Tag="Doc"/>
                                        <ComboBoxItem Content="Ngữ pháp (Grammar)" Tag="NguPhap"/>
                                        <ComboBoxItem Content="Từ vựng (Vocabulary)" Tag="TuVung"/>
                                        <ComboBoxItem Content="Luyện nghe (Listening)" Tag="Nghe"/>
                                        <ComboBoxItem Content="Viết luận (Writing)" Tag="Viet"/>
                                        <ComboBoxItem Content="Luyện nói (Speaking)" Tag="Noi"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Thời gian ước tính -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Ước tính (p)" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtThoiGian" Text="25" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- VÙNG ĐÍNH KÈM AUDIO DÀNH CHO KỸ NĂNG NGHE (ĐỒNG BỘ NỘI DUNG HỌC TẬP) -->
                            <Border x:Name="pnlAudioSection" Visibility="Collapsed"
                                    Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" 
                                    Padding="14,10" Margin="0,0,0,10"
                                    AllowDrop="True" Drop="PnlAudio_Drop" DragOver="PnlFile_DragOver">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tiêu đề Audio Section -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Headphones" Size="15" Foreground="#15803D" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tệp âm thanh bài nghe (Audio Listening) *" FontWeight="Bold" FontSize="12.5" Foreground="#166534"/>
                                            <TextBlock Text="(Bắt buộc đối với bài nghe)" FontSize="11" Foreground="#15803D" FontStyle="Italic" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Nội dung chọn tệp Audio -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#DCFCE7" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Music" Size="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="txtAudioNameDisplay" Text="Chưa chọn tệp audio (.mp3, .wav, .m4a)" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="txtAudioSizeDisplay" Text="Nhấn nút bên phải để chọn tệp âm thanh đồng bộ" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="btnBrowseAudio" Background="#16A34A" Foreground="White" 
                                                    FontWeight="SemiBold" FontSize="12" Padding="12,6" BorderThickness="0" Cursor="Hand" Click="BtnBrowseAudio_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="Upload" Size="13" Foreground="White" Margin="0,0,5,0"/>
                                                                <TextBlock Text="Chọn Audio..." FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button x:Name="btnRemoveAudio" Visibility="Collapsed" Background="#FEE2E2" Foreground="#DC2626" 
                                                    FontWeight="SemiBold" FontSize="12" Padding="8,6" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" Click="BtnRemoveAudio_Click" ToolTip="Gỡ bỏ tệp audio">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                            <local:LucideIcon Kind="Trash2" Size="13" Foreground="#DC2626"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Tóm tắt ngắn -->
                            <TextBlock Text="Tóm tắt nội dung bài học" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTomTat" Height="48" Padding="10,6" FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto" BorderBrush="#CBD5E1" Margin="0,0,0,10">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="bd" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <!-- Nội dung bài học bóc tách từ file -->
                            <TextBlock Text="Nội dung bóc tách từ tài liệu (Xem trước &amp; Chỉnh sửa)" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNoiDung" Height="135" Padding="10,8" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto" BorderBrush="#CBD5E1" Margin="0,0,0,4">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="bd" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Buttons -->
                    <Border Grid.Row="1" BorderBrush="#D1E7DD" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy bỏ" Style="{StaticResource CancelBtnStyle}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                            <Button Style="{StaticResource SaveBtnStyle}" Click="BtnSave_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Save" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Lưu học liệu vào CSDL" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
