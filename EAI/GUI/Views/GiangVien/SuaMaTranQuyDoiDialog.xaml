<Window x:Class="GUI.Views.GiangVien.SuaMaTranQuyDoiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Cấu hình Ma trận Quy đổi Năng lực CEFR / IELTS / TOEIC"
        Height="670" Width="1060"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A"/>
        <SolidColorBrush x:Key="AdminTeal" Color="#0D9488"/>
        <SolidColorBrush x:Key="AdminMint" Color="#10B981"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextGray" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>

        <!-- Header Style cho DataGrid -->
        <Style x:Key="MatrixGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- Cell Style cho DataGrid -->
        <Style x:Key="MatrixGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row Style cho DataGrid -->
        <Style x:Key="MatrixGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0FDF4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Margin="14" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.30" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Header Bar -->
                <RowDefinition Height="Auto"/> <!-- 1. Info Banner -->
                <RowDefinition Height="*"/>    <!-- 2. DataGrid Form -->
                <RowDefinition Height="Auto"/> <!-- 3. Footer Bar -->
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- 0. TOP HEADER BAR                                                         -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon tròn -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <local:LucideIcon Kind="SlidersHorizontal" Size="20" Foreground="{StaticResource AdminDarkGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Tiêu đề & Mô tả -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                        <TextBlock Text="Cấu hình Ma trận Quy đổi Khung Năng lực CEFR / IELTS / TOEIC" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                        <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Chuẩn hóa Quốc tế &amp; Adaptive Testing" FontSize="11" FontWeight="Bold" Foreground="#0F766E"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Thiết lập ngưỡng điểm số và quy đổi tương đương được đồng bộ trực tiếp vào SQL Server để tự động phân lớp cho sinh viên." FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <!-- Nút Đóng X -->
                <Button Grid.Column="2" Click="BtnDong_Click" Background="#F1F5F9" BorderThickness="0" Width="34" Height="34" Cursor="Hand" VerticalAlignment="Center" ToolTip="Đóng cửa sổ">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>
                    </Button.Resources>
                    <local:LucideIcon Kind="X" Size="16" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 1. INFO BANNER                                                            -->
            <!-- ========================================================================= -->
            <Border Grid.Row="1" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="💡" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Quy tắc thuật toán phân tầng thích ứng:" FontWeight="Bold" FontSize="12" Foreground="#0F766E" Margin="0,0,0,2"/>
                        <TextBlock Text="• Khoảng điểm % (Từ % đến %) của 5 cấp độ phải liên tục từ 0% đến 100% (Giá trị Từ % phải nhỏ hơn hoặc bằng Đến %).&#x0a;• Sau khi học viên hoàn thành bài khảo sát, hệ thống sẽ đối chiếu % điểm số đạt được với ma trận này để tự động cấp chứng chỉ năng lực và đề xuất bài học." 
                                   FontSize="11.5" Foreground="#334155" LineHeight="17" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- 2. EDITABLE MODERN DATAGRID                                               -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
                <DataGrid x:Name="dgMaTran" AutoGenerateColumns="False" CanUserAddRows="False" 
                          CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                          Background="White" BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource MatrixGridHeaderStyle}"
                          RowStyle="{StaticResource MatrixGridRowStyle}"
                          CellStyle="{StaticResource MatrixGridCellStyle}">
                    <DataGrid.Columns>
                        <!-- Cột 1: Cấp độ CEFR (Badge màu sắc) -->
                        <DataGridTemplateColumn Header="CẤP ĐỘ" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BadgeBg}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding MaCapDo}" FontWeight="Bold" FontSize="12.5" Foreground="{Binding BadgeFg}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột 2: Tên hiển thị -->
                        <DataGridTemplateColumn Header="TÊN HIỂN THỊ TRÌNH ĐỘ" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding TenHienThi, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                             Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12"
                                             Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột 3: Ngưỡng điểm % (Min - Max) -->
                        <DataGridTemplateColumn Header="KHOẢNG ĐIỂM (%)" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Min -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox Text="{Binding DiemPhanTramMin, UpdateSourceTrigger=PropertyChanged}" 
                                                         PreviewTextInput="NumberOnly_PreviewTextInput" MaxLength="3"
                                                         Width="38" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                                         FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}"
                                                         BorderThickness="1" BorderBrush="#CBD5E1" Background="White">
                                                    <TextBox.Resources>
                                                        <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style>
                                                    </TextBox.Resources>
                                                </TextBox>
                                                <TextBlock Text="%" FontSize="10.5" Foreground="{StaticResource TextGray}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Phân cách -->
                                            <TextBlock Grid.Column="1" Text="➔" FontSize="11" Foreground="{StaticResource TextGray}" Margin="4,0" VerticalAlignment="Center"/>

                                            <!-- Max -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox Text="{Binding DiemPhanTramMax, UpdateSourceTrigger=PropertyChanged}" 
                                                         PreviewTextInput="NumberOnly_PreviewTextInput" MaxLength="3"
                                                         Width="38" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                                         FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}"
                                                         BorderThickness="1" BorderBrush="#CBD5E1" Background="White">
                                                    <TextBox.Resources>
                                                        <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="4"/></Style>
                                                    </TextBox.Resources>
                                                </TextBox>
                                                <TextBlock Text="%" FontSize="10.5" Foreground="{StaticResource TextGray}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột 4: Quy đổi IELTS -->
                        <DataGridTemplateColumn Header="QUY ĐỔI IELTS" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding QuyDoiIelts, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                                             Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12"
                                             Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột 5: Quy đổi TOEIC -->
                        <DataGridTemplateColumn Header="QUY ĐỔI TOEIC" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding QuyDoiToeic, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                                             Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12"
                                             Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột 6: Lộ trình đề xuất -->
                        <DataGridTemplateColumn Header="LỘ TRÌNH ĐỀ XUẤT CHO HỌC VIÊN" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding LoTrinhDeXuat, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                                             Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12"
                                             Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ========================================================================= -->
            <!-- 3. FOOTER ACTIONS                                                         -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="3">
                <!-- Nút khôi phục mặc định -->
                <Button Click="BtnKhoiPhucMacDinh_Click" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="12.5" Padding="14,9" Cursor="Hand" HorizontalAlignment="Left"
                        ToolTip="Khôi phục các ngưỡng điểm và quy đổi theo chuẩn CEFR mặc định">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:LucideIcon Kind="RefreshCw" Size="13" Foreground="{StaticResource TextDark}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Khôi phục chuẩn CEFR mặc định" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Nút Lưu & Hủy -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" Click="BtnDong_Click" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                            FontWeight="SemiBold" FontSize="12.5" Padding="18,9" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button Click="BtnLuu_Click" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                            FontWeight="Bold" FontSize="13" Padding="20,9" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="Check" Size="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu ma trận quy đổi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
