<Window x:Class="GUI.Views.GiangVien.QuanLyAudioTranscriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Studio Âm thanh &amp; Lời thoại bài học — EnglishAI"
        Width="980" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- Tab Header Style -->
        <Style x:Key="ModernTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,16,0" Cursor="Hand" Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0F766E"/>
                                <Setter Property="Foreground" Value="#0F766E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button -->
        <Style x:Key="PrimaryActionBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#115E59"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Tab Container -->
            <RowDefinition Height="*"/>
            <!-- Footer action bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E6F7F3" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                            <TextBlock Text="🎧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="txtLessonTitle" Text="Bài học: [Tên bài học]" FontSize="16.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="txtAudioFileInfo" Text="File âm thanh bài học: Chưa có file đính kèm" FontSize="13" Foreground="#475569" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <TextBlock x:Name="txtProviderStatus" Text="✨ Trợ lý giọng đọc tiếng Anh bản xứ chuẩn IPA" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F766E"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="20,12,20,0">
            <!-- TAB 1: SPEECH-TO-TEXT -->
            <TabItem Header="🎙️ Trích xuất chữ từ bài nghe có sẵn" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <!-- Audio Player Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Transcript Area -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Settings & Save -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Player Header Box -->
                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Play / Pause button -->
                            <Button x:Name="btnPlayAudio" Grid.Column="0" Content="▶️ Nghe file âm thanh" Style="{StaticResource PrimaryActionBtn}" Click="BtnPlayAudio_Click" Margin="0,0,14,0"/>

                            <!-- Progress & Timeline slider -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtSttCurrentTime" Grid.Column="0" Text="00:00" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                <Slider x:Name="sldSttTimeline" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" 
                                        PreviewMouseDown="SldSttTimeline_PreviewMouseDown" PreviewMouseUp="SldSttTimeline_PreviewMouseUp"/>
                                <TextBlock x:Name="txtSttTotalTime" Grid.Column="2" Text="00:00" FontSize="12" Foreground="#475569" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <!-- STT Trigger Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                                <Button x:Name="btnGenerateStt" Content="🎙️ Nhận diện lời bài nghe" Style="{StaticResource PrimaryActionBtn}" Click="BtnGenerateStt_Click"/>
                                <Button x:Name="btnRefreshStt" Content="🔄 Nhận diện lại từ đầu" Style="{StaticResource SecondaryActionBtn}" Click="BtnRefreshStt_Click" Margin="8,0,0,0" ToolTip="Nhận diện lại bài nghe"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Transcript Content (Main Area) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Full Transcript Editor -->
                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="📝 Toàn bộ nội dung bài nghe (Bấm để chỉnh sửa chữ):" FontWeight="SemiBold" FontSize="13.5" Foreground="#1E293B"/>
                                    <Border x:Name="bdrTranscriptStatus" Background="#FEF3C7" CornerRadius="4" Padding="7,3" Margin="10,0,0,0">
                                        <TextBlock x:Name="txtTranscriptStatus" Text="Bản nháp đang xem lại" FontSize="11.5" FontWeight="SemiBold" Foreground="#92400E"/>
                                    </Border>
                                </StackPanel>

                                <TextBox x:Name="txtFullTranscript" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Auto" FontSize="14" FontWeight="Normal"
                                         Foreground="#1E293B" Padding="12,10" BorderBrush="#CBD5E1"/>
                            </Grid>
                        </Border>

                        <!-- Right Column: Segments with Timestamps -->
                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="⏱️ Từng câu đàm thoại &amp; Thời điểm phát trong bài:" FontWeight="SemiBold" FontSize="13.5" Foreground="#1E293B" Margin="0,0,0,8"/>

                                <ListBox x:Name="lstSegments" Grid.Row="1" BorderThickness="0" Background="Transparent" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseDoubleClick="LstSegments_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                        <Border Background="#EEF2FF" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                                        </Border>
                                                        <TextBlock Text="Nhấn đúp chuột để nghe đoạn này" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding Text}" FontSize="13" Foreground="#1E293B" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Controls: Approval & Visibility Settings -->
                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="chkAllowStudentView" Content="Cho phép học viên vừa nghe vừa xem bản chép lời khi học bài" 
                                          IsChecked="True" FontWeight="Medium" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="btnMarkApproved" Content="💾 Phê duyệt &amp; Áp dụng cho bài học" Style="{StaticResource PrimaryActionBtn}" Click="BtnMarkApproved_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: TEXT-TO-SPEECH (TTS) -->
            <TabItem Header="🔊 Tạo bài nghe mới bằng giọng đọc AI" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <!-- Controls for Voice & Mode -->
                        <RowDefinition Height="Auto"/>
                        <!-- Script Editor -->
                        <RowDefinition Height="*"/>
                        <!-- Output Preview & Save -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Voice and Settings Bar -->
                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Row 1: Mode Selector & Sample Script -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mode selection -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Hình thức bài nghe:" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="cboAudioMode" Width="330" Height="34" FontSize="13" SelectedIndex="1" SelectionChanged="CboAudioMode_SelectionChanged">
                                        <ComboBoxItem Content="📖 Một người đọc (Đoạn văn, thuyết trình)" Tag="Solo"/>
                                        <ComboBoxItem Content="👥 Hội thoại 2 người (Đối thoại thường ngày)" Tag="Dialogue2"/>
                                        <ComboBoxItem Content="🗣️ Hội thoại 3 người (Thảo luận nhóm, lớp học)" Tag="Dialogue3"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Helper button to fill sample text -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="btnFillSampleScript" Content="✨ Điền mẫu kịch bản" 
                                            Style="{StaticResource SecondaryActionBtn}" 
                                            Padding="14,6" FontSize="12.5" Cursor="Hand"
                                            Click="BtnFillSampleScript_Click" 
                                            ToolTip="Điền đoạn hội thoại mẫu chuẩn tiếng Anh để tham khảo cách trình bày"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Solo Mode Config -->
                            <Border x:Name="pnlSoloConfig" Background="#F8FAFC" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Chọn giọng đọc chính:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="cboSingleVoice" Width="330" Height="34" FontSize="13" SelectedIndex="0">
                                        <ComboBoxItem Content="Diana (Nữ - Truyền cảm, chuẩn Mỹ)" Tag="diana"/>
                                        <ComboBoxItem Content="Daniel (Nam - Trầm ấm, bản xứ)" Tag="daniel"/>
                                        <ComboBoxItem Content="Autumn (Nữ - Tự nhiên, sáng rõ)" Tag="autumn"/>
                                        <ComboBoxItem Content="Austin (Nam - Trẻ trung, năng động)" Tag="austin"/>
                                        <ComboBoxItem Content="Hannah (Nữ - Học thuật, chỉn chu)" Tag="hannah"/>
                                        <ComboBoxItem Content="Troy (Nam - Thuyết trình chuyên gia)" Tag="troy"/>
                                    </ComboBox>
                                    <TextBlock Text="💡 Phù hợp cho bài đọc hiểu, phát biểu hoặc giải thích lý thuyết" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Row 3: Multi-Speaker Config (2 or 3 persons) -->
                            <Border x:Name="pnlDialogueConfig" Background="#F0FDFA" CornerRadius="8" Padding="16,12" BorderBrush="#CCFBF1" BorderThickness="1" Visibility="Visible">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cấu hình nhân vật &amp; Giọng đọc tương ứng:" FontWeight="SemiBold" FontSize="13" Foreground="#0F766E" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="💡 Gõ đúng Tên: ở đầu mỗi câu trong kịch bản bên dưới" FontSize="12" Foreground="#0F766E" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition x:Name="colSpeaker3" Width="0"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Speaker 1 -->
                                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,10" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="👤 Nhân vật 1 (Người thứ nhất)" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Tên:" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="txtSpeaker1Name" Grid.Column="1" Text="Sarah" Height="30" FontSize="13" FontWeight="Medium" Foreground="#0F172A" Padding="6,3" BorderBrush="#CBD5E1"/>
                                                </Grid>
                                                <ComboBox x:Name="cboSpeaker1Voice" Height="30" FontSize="12.5" SelectedIndex="0">
                                                    <ComboBoxItem Content="Diana (Nữ - Truyền cảm)" Tag="diana"/>
                                                    <ComboBoxItem Content="Autumn (Nữ - Tự nhiên)" Tag="autumn"/>
                                                    <ComboBoxItem Content="Hannah (Nữ - Chỉn chu)" Tag="hannah"/>
                                                    <ComboBoxItem Content="Daniel (Nam - Trầm ấm)" Tag="daniel"/>
                                                    <ComboBoxItem Content="Austin (Nam - Trẻ trung)" Tag="austin"/>
                                                    <ComboBoxItem Content="Troy (Nam - Thuyết trình)" Tag="troy"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <!-- Speaker 2 -->
                                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,10" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="👤 Nhân vật 2 (Người thứ hai)" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Tên:" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="txtSpeaker2Name" Grid.Column="1" Text="Mark" Height="30" FontSize="13" FontWeight="Medium" Foreground="#0F172A" Padding="6,3" BorderBrush="#CBD5E1"/>
                                                </Grid>
                                                <ComboBox x:Name="cboSpeaker2Voice" Height="30" FontSize="12.5" SelectedIndex="3">
                                                    <ComboBoxItem Content="Daniel (Nam - Trầm ấm)" Tag="daniel"/>
                                                    <ComboBoxItem Content="Austin (Nam - Trẻ trung)" Tag="austin"/>
                                                    <ComboBoxItem Content="Troy (Nam - Thuyết trình)" Tag="troy"/>
                                                    <ComboBoxItem Content="Diana (Nữ - Truyền cảm)" Tag="diana"/>
                                                    <ComboBoxItem Content="Autumn (Nữ - Tự nhiên)" Tag="autumn"/>
                                                    <ComboBoxItem Content="Hannah (Nữ - Chỉn chu)" Tag="hannah"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <!-- Speaker 3 (Visible only in 3-person mode) -->
                                        <Border x:Name="bdrSpeaker3" Grid.Column="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,10" Margin="6,0,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="👤 Nhân vật 3 (Người thứ ba)" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Tên:" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="txtSpeaker3Name" Grid.Column="1" Text="David" Height="30" FontSize="13" FontWeight="Medium" Foreground="#0F172A" Padding="6,3" BorderBrush="#CBD5E1"/>
                                                </Grid>
                                                <ComboBox x:Name="cboSpeaker3Voice" Height="30" FontSize="12.5" SelectedIndex="1">
                                                    <ComboBoxItem Content="Diana (Nữ - Truyền cảm)" Tag="diana"/>
                                                    <ComboBoxItem Content="Austin (Nam - Trẻ trung)" Tag="austin"/>
                                                    <ComboBoxItem Content="Autumn (Nữ - Tự nhiên)" Tag="autumn"/>
                                                    <ComboBoxItem Content="Hannah (Nữ - Chỉn chu)" Tag="hannah"/>
                                                    <ComboBoxItem Content="Daniel (Nam - Trầm ấm)" Tag="daniel"/>
                                                    <ComboBoxItem Content="Troy (Nam - Thuyết trình)" Tag="troy"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Script Input Area -->
                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📄 Nhập nội dung bài nghe tiếng Anh (Kịch bản):" FontWeight="SemiBold" FontSize="13.5" Foreground="#1E293B"/>
                                <TextBlock x:Name="txtCharCount" Grid.Column="1" Text="0 ký tự" FontSize="12.5" Foreground="#475569"/>
                            </Grid>

                            <TextBox x:Name="txtTtsScript" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" FontSize="14" FontWeight="Normal"
                                     Foreground="#1E293B" Padding="14,12" BorderBrush="#CBD5E1" TextChanged="TxtTtsScript_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Output & Save Bar -->
                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Audio preview player if generated -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnGenerateTts" Content="🎧 Bắt đầu tạo file âm thanh" Style="{StaticResource PrimaryActionBtn}" Click="BtnGenerateTts_Click" Margin="0,0,12,0"/>
                                <Button x:Name="btnPreviewTts" Content="▶️ Nghe thử bài vừa tạo" Style="{StaticResource SecondaryActionBtn}" Click="BtnPreviewTts_Click" IsEnabled="False" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtTtsStatus" Text="Sẵn sàng tạo bài nghe mới..." FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Save to Lesson -->
                            <Button x:Name="btnSaveTtsToLesson" Grid.Column="1" Content="💾 Lưu file nghe vào bài học" 
                                    Style="{StaticResource PrimaryActionBtn}" Background="#1D4ED8" Click="BtnSaveTtsToLesson_Click" IsEnabled="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Footer Close button -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="txtGlobalMessage" Text="" FontSize="13" FontWeight="Medium" Foreground="#15803D" VerticalAlignment="Center"/>
                <Button Content="Đóng cửa sổ" Style="{StaticResource SecondaryActionBtn}" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
