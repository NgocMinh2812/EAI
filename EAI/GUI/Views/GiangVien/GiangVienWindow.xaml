<Window x:Class="GUI.Views.GiangVien.GiangVienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TiếngAnhAI - Admin &amp; Giảng viên Dashboard"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">

    <Window.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminGreenHover" Color="#135E48" />
        <SolidColorBrush x:Key="AdminLightGreen" Color="#E6F4EA" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="TextLightGray" Color="#94A3B8" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <!-- Nav Item Button Style -->
        <Style x:Key="AdminNavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Item Button Style -->
        <Style x:Key="AdminActiveNavItemStyle" TargetType="Button" BasedOn="{StaticResource AdminNavItemStyle}">
            <Setter Property="Background" Value="{StaticResource AdminDarkGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource AdminDarkGreen}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Section Text -->
        <Style x:Key="NavSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLightGray}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="18,12,18,4"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" MaxWidth="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="18,0">
                    <Grid VerticalAlignment="Center" Height="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Star Logo Icon -->
                        <Border Grid.Column="0" Background="{StaticResource AdminDarkGreen}" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock Text="★" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TiếngAnhAI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock x:Name="txtBrandSubtitle" Text="Admin Dashboard" FontSize="10.5" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="«" Background="Transparent" Foreground="{StaticResource TextGray}" 
                                BorderThickness="0" FontSize="14" Cursor="Hand" Padding="4" ToolTip="Thu gọn menu">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Navigation Menu (Scrollable) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10">

                        <!-- CHÍNH -->
                        <TextBlock Text="CHÍNH" Style="{StaticResource NavSectionHeader}"/>
                        <Button x:Name="btnNavTongQuan" Style="{StaticResource AdminActiveNavItemStyle}" Click="NavTongQuan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng quan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- QUẢN LÝ -->
                        <TextBlock Text="QUẢN LÝ" Style="{StaticResource NavSectionHeader}"/>
                        <Button x:Name="btnNavNguoiDung" Style="{StaticResource AdminNavItemStyle}" Click="NavNguoiDung_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Người dùng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnNavDanhMuc" Style="{StaticResource AdminNavItemStyle}" Click="NavDanhMuc_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Danh mục &amp; Cấu trúc" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnNavNoiDung" Style="{StaticResource AdminNavItemStyle}" Click="NavNoiDung_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📖" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Nội dung học tập" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnNavNganHang" Style="{StaticResource AdminNavItemStyle}" Click="NavNganHang_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❓" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ngân hàng câu hỏi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnNavDeThi" Style="{StaticResource AdminNavItemStyle}" Click="NavDeThi_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đề thi &amp; Luyện tập" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnNavKhaoSat" Style="{StaticResource AdminNavItemStyle}" Click="NavKhaoSat_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Khảo sát đầu vào" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- TRÍ TUỆ AI -->
                        <TextBlock Text="TRÍ TUỆ AI" Style="{StaticResource NavSectionHeader}"/>
                        <Button x:Name="btnNavAISinhDe" Style="{StaticResource AdminNavItemStyle}" Click="NavAISinhDe_Click">
                            <Grid Width="180">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="⭐" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AI sinh đề" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="#EA580C" CornerRadius="8" Padding="5,1">
                                    <TextBlock Text="AI" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- HỆ THỐNG -->
                        <TextBlock x:Name="headerHeThong" Text="HỆ THỐNG" Style="{StaticResource NavSectionHeader}"/>
                        <Button x:Name="btnNavGiamSat" Style="{StaticResource AdminNavItemStyle}" Click="NavGiamSat_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Giám sát hệ thống" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ĐIỀU HƯỚNG HỌC VIÊN -->
                        <TextBlock Text="CHUYỂN ĐỔI GIAO DIỆN" Style="{StaticResource NavSectionHeader}"/>
                        <Button x:Name="btnNavToStudentHome" Style="{StaticResource AdminNavItemStyle}" Click="NavToStudentHome_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Trang chủ Học viên" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AdminDarkGreen}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer User Profile -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Circle -->
                        <Border Grid.Column="0" Background="{StaticResource AdminDarkGreen}" Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0">
                            <TextBlock x:Name="txtAvatarInitials" Text="HT" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtCurrentUserName" Text="Hoàng Văn Tùng" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                            <TextBlock x:Name="txtCurrentUserRole" Text="Quản trị viên" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>

                        <!-- Logout Button -->
                        <Button Grid.Column="2" Content="🚪" Background="Transparent" Foreground="#EF4444" 
                                BorderThickness="0" FontSize="14" Cursor="Hand" ToolTip="Đăng xuất" Click="BtnLogout_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN RIGHT REGION ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="9" Width="360" Height="36" VerticalAlignment="Center" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="txtGlobalSearch" Grid.Column="1" Text="Tìm kiếm người dùng, bài học, câu hỏi..." 
                                     Foreground="{StaticResource TextGray}" Background="Transparent" BorderThickness="0" 
                                     VerticalAlignment="Center" FontSize="12.5"/>
                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="⌘ F" FontSize="10.5" Foreground="{StaticResource TextGray}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Breadcrumbs in Center -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                        <TextBlock Text="Admin" Foreground="{StaticResource TextGray}" FontSize="13"/>
                        <TextBlock Text="  ›  " Foreground="{StaticResource TextLightGray}" FontSize="13"/>
                        <TextBlock x:Name="txtBreadcrumb" Text="Tổng quan" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                    </StackPanel>

                    <!-- Right Quick Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Trợ lý AI Button -->
                        <Button Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" 
                                BorderThickness="1" Padding="12,6" Margin="0,0,12,0" Cursor="Hand" Click="TopNavTroLyAI_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="★" Foreground="{StaticResource AdminMint}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Trợ lý AI" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Notification Bell (Circular button with modern hover & notification tooltip) -->
                        <Button Width="36" Height="36" Margin="0,0,14,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bellBorder" Background="Transparent" CornerRadius="18" Width="36" Height="36">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔔" FontSize="15" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!-- Notification badge dot -->
                                            <Border Background="#EF4444" Width="8" Height="8" CornerRadius="4" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bellBorder" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bellBorder" Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip>
                                <ToolTip Background="#0F172A" Foreground="White" BorderThickness="0" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="🔔 Thông báo hệ thống (3 mới)" FontWeight="Bold" FontSize="12.5" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 2 bài nộp Đề thi IELTS từ học viên cần chấm điểm" FontSize="11.5" Foreground="#CBD5E1" Margin="0,2"/>
                                        <TextBlock Text="• AI vừa bóc tách hoàn tất 48 câu hỏi TOEIC" FontSize="11.5" Foreground="#CBD5E1" Margin="0,2"/>
                                        <TextBlock Text="• Cập nhật phiên bản hệ thống 2026.1 thành công" FontSize="11" Foreground="#94A3B8" Margin="0,2"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <!-- Avatar Badge -->
                        <Border Background="{StaticResource AdminDarkGreen}" Width="34" Height="34" CornerRadius="17" Margin="0,0,14,0">
                            <TextBlock x:Name="txtTopAvatar" Text="HT" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Custom Window Controls (Minimize & Close) -->
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderLight}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <Button Width="32" Height="32" Margin="0,0,4,0" Cursor="Hand" ToolTip="Thu nhỏ" Click="BtnMinimize_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="minBorder" Background="Transparent" CornerRadius="6" Width="32" Height="32">
                                        <TextBlock Text="—" FontSize="12" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="minBorder" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="32" Height="32" Cursor="Hand" ToolTip="Đóng ứng dụng" Click="BtnCloseWindow_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="closeBorder" Background="Transparent" CornerRadius="6" Width="32" Height="32">
                                        <TextBlock Text="✕" FontSize="13" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="closeBorder" Property="Background" Value="#FEE2E2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Frame -->
            <Frame x:Name="AdminMainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
