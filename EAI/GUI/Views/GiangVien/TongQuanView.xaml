<Page x:Class="GUI.Views.GiangVien.TongQuanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Tổng quan - Admin Dashboard"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineEditButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AdminDarkGreen}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <Grid MaxWidth="1360">
            <Grid.ColumnDefinitions>
                <!-- Column 1: Từ vựng & Tài nguyên -->
                <ColumnDefinition Width="295"/>
                <ColumnDefinition Width="18"/>
                <!-- Column 2: Nội dung & Đề thi -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <!-- Column 3: Thống kê & Thao tác nhanh -->
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT 1: TỪ VỰNG & TÀI NGUYÊN ================= -->
            <StackPanel Grid.Column="0">

                <!-- Card: Từ vựng hôm nay & Flashcard -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="TỪ VỰNG HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Text="Xem tất cả" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource AdminDarkGreen}" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonUp="BtnXemTatCaTuVung_Click" ToolTip="Mở bộ thẻ Flashcard ôn tập"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtTuVungWord" Text="perseverance" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Width="28" Height="28" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" 
                                    Cursor="Hand" Click="BtnPhatAmTuVungHomNay_Click" ToolTip="Nghe phát âm từ vựng hôm nay">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <local:LucideIcon Kind="Volume2" Size="14" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#DCFCE7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="txtTuVungPhienAm" Text="/ˌpɜː.sɪˈvɪə.rəns/" Foreground="{StaticResource TextGray}" FontSize="12.5" Margin="0,0,8,0"/>
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1">
                                <TextBlock x:Name="txtTuVungLoaiTu" Text="danh từ" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="txtTuVungNghia" Text="Sự kiên trì, bền chí trong việc thực hiện mục tiêu dù gặp nhiều khó khăn và thử thách trên đường đi." 
                                   Foreground="{StaticResource TextDark}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"/>

                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <TextBlock x:Name="txtTuVungCauViDu" Text="&quot;Learning English requires perseverance and daily practice.&quot;" 
                                       FontStyle="Italic" FontSize="12" Foreground="{StaticResource TextGray}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Plant graphic illustration / Spaced Repetition Hint -->
                        <Border Background="#F0FDF4" CornerRadius="12" Height="90" Margin="0,0,0,14" BorderBrush="#DCFCE7" BorderThickness="1" 
                                Cursor="Hand" MouseLeftButtonUp="BtnXemTatCaTuVung_Click" ToolTip="Nhấp vào để ôn tập Flashcard ngay">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌱" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Cây tri thức tăng trưởng • Ôn tập Flashcard" FontSize="10.5" Foreground="#15803D" FontWeight="Medium" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                FontWeight="SemiBold" FontSize="13" Padding="12,9" Cursor="Hand" BorderThickness="0" Click="BtnTaoFlashcard_Click" ToolTip="Mở giao diện tạo Flashcard mới">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <local:LucideIcon Kind="Plus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tạo Flashcard" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card: Tài nguyên Học liệu -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Tài nguyên Học liệu" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            <TextBlock Text="Quản lý" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource AdminDarkGreen}" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonUp="BtnQuanLyTaiNguyen_Click" ToolTip="Mở danh mục quản lý học liệu"/>
                        </Grid>

                        <ItemsControl x:Name="icTaiNguyenHocLieu">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ItemTaiNguyen_Click" ToolTip="{Binding ToolTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding BadgeBrush}" Width="14" Height="14" CornerRadius="3" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding TenHienThi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="🔖" Foreground="{StaticResource TextGray}" FontSize="12" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= CỘT 2: NỘI DUNG & ĐỀ THI ================= -->
            <StackPanel Grid.Column="2">

                <!-- Section Header with Search -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Nội dung &amp; Đề thi" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>

                    <!-- Search Input -->
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Width="220" Height="34" Margin="0,0,10,0">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:LucideIcon Grid.Column="0" Kind="Search" Size="13" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtSearchNoiDung" Grid.Column="1" Text="Tìm kiếm bài học, đề thi..." Foreground="{StaticResource TextGray}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="12"
                                     GotFocus="TxtSearchNoiDung_GotFocus" LostFocus="TxtSearchNoiDung_LostFocus" KeyDown="TxtSearchNoiDung_KeyDown"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="3" Text="Xem tất cả" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AdminDarkGreen}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="BtnXemTatCaNoiDung_Click"/>
                </Grid>

                <!-- Card: Biểu đồ xu hướng học tập (US-GV02) -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <!-- Header with clean 2 columns to prevent overlap -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <local:LucideIcon Kind="TrendingUp" Size="16" Foreground="{StaticResource AdminDarkGreen}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Xu hướng học tập tuần qua" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#ECFDF5" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtTongLuotTuanQua" Text="Tổng: 0 lượt" FontSize="11" FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="7 ngày qua" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Biểu đồ cột 7 ngày -->
                        <ItemsControl x:Name="icBieuDoXuHuong" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="120" Margin="4,0" ToolTip="{Binding ToolTipText}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding SoLuotLamBai}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Border Grid.Row="1" Width="26" Height="{Binding CotHeight}" VerticalAlignment="Bottom" CornerRadius="6,6,0,0" Background="{Binding CotColor}"/>
                                        <TextBlock Grid.Row="2" Text="{Binding NgayTrongTuan}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,6,0,1"/>
                                        <TextBlock Grid.Row="3" Text="{Binding NgayThang}" FontSize="9.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Lesson Card 1: Dynamic -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <!-- Top Meta -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtLoaiBaiHoc1" Text="Ngữ pháp" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1">
                                    <TextBlock x:Name="txtTrinhDoBaiHoc1" Text="B1" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="txtMaCodeBaiHoc1" Text="BH-003" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </Grid>

                        <!-- Title -->
                        <TextBlock x:Name="txtTieuDeBaiHoc1" Text="Thì Hiện Tại Hoàn Thành — Cấu trúc &amp; Cách dùng" 
                                   FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" 
                                   TextWrapping="Wrap" LineHeight="20" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6"/>
                        <!-- Subtitle -->
                        <TextBlock x:Name="txtTomTatBaiHoc1" Text="Bài học trình bày chi tiết cấu trúc thì hiện tại hoàn thành, các trạng từ đi kèm (already, yet, ever, never, just) và cách phân biệt với thì quá khứ đơn trong tiếng Anh." 
                                   FontSize="12.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"/>

                        <!-- Action Footer -->
                        <Grid>
                            <Border HorizontalAlignment="Left" Background="#DCFCE7" CornerRadius="6" Padding="10,3">
                                <TextBlock x:Name="txtTrangThaiBaiHoc1" Text="Đã xuất bản" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                            </Border>

                            <Button Content="Chỉnh sửa" Style="{StaticResource OutlineEditButton}" HorizontalAlignment="Right" Click="BtnChinhSuaBaiHoc1_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mock Test Card 2: Dynamic with Right Play Banner -->
                <Border Style="{StaticResource AdminCardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Text Content -->
                        <Border Grid.Column="0" Padding="18">
                            <StackPanel>
                                <!-- Top Meta -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                            <Ellipse Width="6" Height="6" Fill="#8B5CF6" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="txtLoaiDeThi" Text="Thi thử" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                        </StackPanel>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1">
                                            <TextBlock x:Name="txtTrinhDoDeThi" Text="B2" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="txtMaCodeDeThi" Text="DE-001" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </Grid>

                                <TextBlock x:Name="txtTieuDeDeThi" Text="IELTS Mock Test #1 — Academic Reading &amp; Listening" 
                                           FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" 
                                           TextWrapping="Wrap" LineHeight="20" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="txtMoTaDeThi" Text="Đề thi thử IELTS Academic dạng đầy đủ, gồm 4 phần Reading (40 câu) và Listening (40 câu). Tự động chấm điểm và phân tích điểm yếu sau khi nộp bài." 
                                           FontSize="12.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"/>

                                <Grid>
                                    <Border HorizontalAlignment="Left" Background="#DCFCE7" CornerRadius="6" Padding="10,3">
                                        <TextBlock x:Name="txtTrangThaiDeThi" Text="Đã xuất bản" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>

                                    <Button Content="Chỉnh sửa" Style="{StaticResource OutlineEditButton}" HorizontalAlignment="Right" Click="BtnChinhSuaDeThi_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right Banner Dark Green with Play Icon -->
                        <Border Grid.Column="1" Background="{StaticResource AdminDarkGreen}" Cursor="Hand" MouseLeftButtonUp="BtnPlayDeThi_Click" ToolTip="Vào làm bài thi / luyện tập ngay">
                            <Border Width="44" Height="44" CornerRadius="22" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="▶" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- Lesson Card 3: Dynamic -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <!-- Top Meta -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Ellipse Width="6" Height="6" Fill="#0284C7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtLoaiBaiHoc2" Text="Từ vựng" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1">
                                    <TextBlock x:Name="txtTrinhDoBaiHoc2" Text="B2" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="txtMaCodeBaiHoc2" Text="BH-006" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </Grid>

                        <TextBlock x:Name="txtTieuDeBaiHoc2" Text="Từ vựng Kinh tế — Business English cho người đi làm" 
                                   FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" 
                                   TextWrapping="Wrap" LineHeight="20" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtTomTatBaiHoc2" Text="Tổng hợp 120 từ vựng kinh tế thường gặp trong môi trường công sở, hội thảo và email công việc. Kèm flashcard ôn tập và câu ví dụ thực tế." 
                                   FontSize="12.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"/>

                        <Grid>
                            <Border HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="10,3">
                                <TextBlock x:Name="txtTrangThaiBaiHoc2" Text="Bản nháp" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                            </Border>

                            <Button Content="Chỉnh sửa" Style="{StaticResource OutlineEditButton}" HorizontalAlignment="Right" Click="BtnChinhSuaBaiHoc2_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= CỘT 3: THỐNG KÊ, SUBMISSION, NHÓM, THAO TÁC ================= -->
            <StackPanel Grid.Column="4">

                <!-- Card: Thống kê nhanh -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Thống kê" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Hôm nay ▼" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource TextGray}" Cursor="Hand" MouseLeftButtonUp="BtnLocThoiGian_Click" ToolTip="Nhấp để chuyển đổi chu kỳ thống kê"/>
                        </Grid>

                        <!-- 4 THẺ KPI TỔNG QUAN HỆ THỐNG (US-GV02) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thẻ KPI 1: Học viên -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="6,7" Margin="0,0,3,6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <local:LucideIcon Kind="Users" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiHocVien" Text="0" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Học viên" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTrendHocVien" Text="+12.5%" FontSize="9" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Thẻ KPI 2: Bài học -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="6,7" Margin="3,0,0,6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <local:LucideIcon Kind="BookOpen" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiBaiHoc" Text="0" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Bài học" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTrendBaiHoc" Text="+8.3%" FontSize="9" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Thẻ KPI 3: Câu hỏi -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="6,7" Margin="0,3,3,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <local:LucideIcon Kind="HelpCircle" Size="14" Foreground="#2563EB" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiCauHoi" Text="0" FontWeight="Bold" FontSize="17" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Câu hỏi" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTrendCauHoi" Text="+15.0%" FontSize="9" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Thẻ KPI 4: Lượt thi -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="6,7" Margin="3,3,0,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <local:LucideIcon Kind="CheckCircle2" Size="14" Foreground="#0F766E" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiLuotThi" Text="0" FontWeight="Bold" FontSize="17" Foreground="#0F766E" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Lượt thi" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTrendLuotThi" Text="+24.8%" FontSize="9" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Phụ trợ: Đề thi, Luyện tập & Chờ duyệt -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Đề thi: " FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <TextBlock x:Name="txtKpiDeThi" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="  •  Luyện tập: " FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <TextBlock x:Name="txtKpiLuyenTap" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="  •  Câu hỏi chờ duyệt: " FontSize="11" Foreground="{StaticResource TextGray}"/>
                            <TextBlock x:Name="txtKpiChoDuyet" Text="0" FontSize="11" FontWeight="Bold" Foreground="#EA580C" Cursor="Hand" ToolTip="Nhấn để duyệt 5 câu hỏi AI sinh" MouseLeftButtonUp="TxtKpiChoDuyet_Click"/>
                        </StackPanel>

                        <Button Content="Xem phân tích học viên" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                FontWeight="SemiBold" FontSize="12.5" Padding="12,8" Cursor="Hand" BorderThickness="0" Click="BtnPhanTich_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card: Vừa nộp bài (Live feed) -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Vừa nộp bài" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="8" Padding="6,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Live" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Live Feed ItemsControl -->
                        <ItemsControl x:Name="icVuaNopBai">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ItemVuaNopBai_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding AvatarBg}" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding AvatarInitials}" FontSize="11" FontWeight="Bold" Foreground="{Binding AvatarFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding HoTen}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TieuDe}" FontSize="10.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" LineHeight="15" ToolTip="{Binding TieuDe}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{Binding TrangThaiBg}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="4,2,0,0">
                                                <TextBlock Text="{Binding TrangThai}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding TrangThaiFg}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>


                <!-- Card: Thao tác nhanh -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Thao tác nhanh" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                        <!-- Action 1: Tạo câu hỏi mới -->
                        <Button Background="#E6F4EA" Foreground="#166534" BorderBrush="#BBF7D0" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,8" Margin="0,0,0,8" Cursor="Hand" Click="BtnQuickTaoCauHoi_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Plus" Size="13" Foreground="#166534" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tạo câu hỏi mới" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Action 2: Tạo đề thi / luyện tập -->
                        <Button Background="#F3E8FF" Foreground="#6B21A8" BorderBrush="#E9D5FF" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,8" Margin="0,0,0,8" Cursor="Hand" Click="BtnQuickTaoDeThi_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="FileText" Size="13" Foreground="#6B21A8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tạo đề thi / luyện tập" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Action 3: AI sinh câu hỏi -->
                        <Button Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,8" Margin="0,0,0,8" Cursor="Hand" Click="BtnQuickAISinh_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Sparkles" Size="13" Foreground="#B45309" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="AI sinh câu hỏi" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Action 4: Xem giám sát API -->
                        <Button Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,8" Cursor="Hand" Click="BtnQuickGiamSat_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Zap" Size="13" Foreground="#1E40AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Xem giám sát API" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
