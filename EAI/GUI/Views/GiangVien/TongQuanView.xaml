<Page x:Class="GUI.Views.GiangVien.TongQuanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Tổng quan - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="AdminCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineEditButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AdminDarkGreen}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <Grid MaxWidth="1300">
            <Grid.ColumnDefinitions>
                <!-- Column 1: Từ vựng & Tài nguyên -->
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="20"/>
                <!-- Column 2: Nội dung & Đề thi -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <!-- Column 3: Thống kê & Thao tác nhanh -->
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT 1: TỪ VỰNG & TÀI NGUYÊN ================= -->
            <StackPanel Grid.Column="0">

                <!-- Card: Từ vựng hôm nay -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="TỪ VỰNG HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Text="Xem tất cả" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource AdminDarkGreen}" FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="perseverance" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="/ˌpɜː.sɪˈvɪə.rəns/" Foreground="{StaticResource TextGray}" FontSize="12.5" Margin="0,0,8,0"/>
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="danh từ" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Sự kiên trì, bền chí trong việc thực hiện mục tiêu dù gặp nhiều khó khăn và thử thách trên đường đi." 
                                   Foreground="{StaticResource TextDark}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"/>

                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <TextBlock Text="&quot;Learning English requires perseverance and daily practice.&quot;" 
                                       FontStyle="Italic" FontSize="12" Foreground="{StaticResource TextGray}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Plant graphic illustration -->
                        <Border Background="#F0FDF4" CornerRadius="12" Height="90" Margin="0,0,0,14" BorderBrush="#DCFCE7" BorderThickness="1">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌱" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Cây tri thức tăng trưởng" FontSize="10.5" Foreground="#15803D" FontWeight="Medium" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                FontWeight="SemiBold" FontSize="13" Padding="12,9" Cursor="Hand" BorderThickness="0" Click="BtnTaoFlashcard_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <local:LucideIcon Kind="Plus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tạo Flashcard" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card: Tài nguyên Học liệu -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Tài nguyên Học liệu" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,14"/>

                        <!-- Item 1: Grammar A1-B1 -->
                        <Grid Margin="0,0,0,12" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#22C55E" Width="14" Height="14" CornerRadius="3" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ngữ pháp tiếng Anh cơ bản — A1 đến B1" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="🔖" Foreground="{StaticResource TextGray}" FontSize="12" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Item 2: IELTS 2024 -->
                        <Grid Margin="0,0,0,12" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#3B82F6" Width="14" Height="14" CornerRadius="3" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Bộ đề IELTS 2024 — Academic &amp; General" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="🔖" Foreground="{StaticResource TextGray}" FontSize="12" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Item 3: TOEIC 1000 -->
                        <Grid Margin="0,0,0,12" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F97316" Width="14" Height="14" CornerRadius="3" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="1000 từ vựng TOEIC thông dụng nhất" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="🔖" Foreground="{StaticResource TextGray}" FontSize="12" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Item 4: IPA Pronunciation -->
                        <Grid Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#A855F7" Width="14" Height="14" CornerRadius="3" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Phát âm IPA — Bảng ký hiệu và ví dụ âm" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="🔖" Foreground="{StaticResource TextGray}" FontSize="12" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= CỘT 2: NỘI DUNG & ĐỀ THI ================= -->
            <StackPanel Grid.Column="2">

                <!-- Section Header with Search -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Nội dung &amp; Đề thi" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>

                    <!-- Search Input -->
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Width="220" Height="34" Margin="0,0,10,0">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:LucideIcon Grid.Column="0" Kind="Search" Size="13" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="Tìm kiếm bài học, đề thi..." Foreground="{StaticResource TextGray}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="12"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="3" Text="Xem tất cả" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AdminDarkGreen}" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>

                <!-- Lesson Card 1: Present Perfect -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <!-- Top Meta -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Ngữ pháp" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="B1" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="BH-003" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </Grid>

                        <!-- Title -->
                        <TextBlock Text="Thì Hiện Tại Hoàn Thành — Cấu trúc &amp; Cách dùng" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                        <!-- Subtitle -->
                        <TextBlock Text="Bài học trình bày chi tiết cấu trúc thì hiện tại hoàn thành, các trạng từ đi kèm (already, yet, ever, never, just) và cách phân biệt với thì quá khứ đơn trong tiếng Anh." 
                                   FontSize="12.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"/>

                        <!-- Action Footer -->
                        <Grid>
                            <Border HorizontalAlignment="Left" Background="#DCFCE7" CornerRadius="6" Padding="10,3">
                                <TextBlock Text="Đã xuất bản" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                            </Border>

                            <Button Content="Chỉnh sửa" Style="{StaticResource OutlineEditButton}" HorizontalAlignment="Right" Click="BtnChinhSua_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mock Test Card 2: IELTS Mock Test #1 with Right Play Banner -->
                <Border Style="{StaticResource AdminCardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Text Content -->
                        <Border Grid.Column="0" Padding="18">
                            <StackPanel>
                                <!-- Top Meta -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                            <Ellipse Width="6" Height="6" Fill="#8B5CF6" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Thi thử" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                        </StackPanel>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="B2" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="DE-001" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </Grid>

                                <TextBlock Text="IELTS Mock Test #1 — Academic Reading &amp; Listening" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                <TextBlock Text="Đề thi thử IELTS Academic dạng đầy đủ, gồm 4 phần Reading (40 câu) và Listening (40 câu). Tự động chấm điểm và phân tích điểm yếu sau khi nộp bài." 
                                           FontSize="12.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"/>

                                <Grid>
                                    <Border HorizontalAlignment="Left" Background="#DCFCE7" CornerRadius="6" Padding="10,3">
                                        <TextBlock Text="Đã xuất bản" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>

                                    <Button Content="Chỉnh sửa" Style="{StaticResource OutlineEditButton}" HorizontalAlignment="Right" Click="BtnChinhSua_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right Banner Dark Green with Play Icon -->
                        <Border Grid.Column="1" Background="{StaticResource AdminDarkGreen}" Cursor="Hand">
                            <Border Width="44" Height="44" CornerRadius="22" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="▶" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- Lesson Card 3: Business English -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <!-- Top Meta -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Ellipse Width="6" Height="6" Fill="#0284C7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Từ vựng" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="B2" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="BH-006" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </Grid>

                        <TextBlock Text="Từ vựng Kinh tế — Business English cho người đi làm" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                        <TextBlock Text="Tổng hợp 120 từ vựng kinh tế thường gặp trong môi trường công sở, hội thảo và email công việc. Kèm flashcard ôn tập và câu ví dụ thực tế." 
                                   FontSize="12.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"/>

                        <Grid>
                            <Border HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="10,3">
                                <TextBlock Text="Bản nháp" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                            </Border>

                            <Button Content="Chỉnh sửa" Style="{StaticResource OutlineEditButton}" HorizontalAlignment="Right" Click="BtnChinhSua_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= CỘT 3: THỐNG KÊ, SUBMISSION, NHÓM, THAO TÁC ================= -->
            <StackPanel Grid.Column="4">

                <!-- Card: Thống kê nhanh -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Thống kê" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Hôm nay ▼" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource TextGray}" Cursor="Hand"/>
                        </Grid>

                        <!-- 4 THẺ KPI TỔNG QUAN HỆ THỐNG -->
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thẻ KPI 1: Học viên -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="6,10" Margin="0,0,3,6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <local:LucideIcon Kind="Users" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiHocVien" Text="0" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Học viên" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Thẻ KPI 2: Bài học -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="6,10" Margin="3,0,0,6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <local:LucideIcon Kind="BookOpen" Size="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiBaiHoc" Text="0" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Bài học" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Thẻ KPI 3: Đề thi & Luyện tập -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="6,10" Margin="0,3,3,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <local:LucideIcon Kind="Clock" Size="14" Foreground="#2563EB" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiDeThi" Text="0" FontWeight="Bold" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Đề thi" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Thẻ KPI 4: Chờ duyệt AI -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="6,10" Margin="3,3,0,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <local:LucideIcon Kind="Sparkles" Size="14" Foreground="#EA580C" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtKpiChoDuyet" Text="0" FontWeight="Bold" FontSize="18" Foreground="#EA580C" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Chờ duyệt" FontSize="10.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button Content="Xem phân tích học viên" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                FontWeight="SemiBold" FontSize="12.5" Padding="12,8" Cursor="Hand" BorderThickness="0" Click="BtnPhanTich_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card: Vừa nộp bài (Live feed) -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Vừa nộp bài" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="8" Padding="6,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Live" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Student 1 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#DCFCE7" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                                <TextBlock Text="TL" FontSize="11" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Nguyễn Thị..." FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="IELTS Mock T..." FontSize="10.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Đã nộp" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                            </Border>
                        </Grid>

                        <!-- Student 2 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#DBEAFE" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                                <TextBlock Text="MK" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Trần Min..." FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Bài tập Ng..." FontSize="10.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Đang làm" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"/>
                            </Border>
                        </Grid>

                        <!-- Student 3 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F3E8FF" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                                <TextBlock Text="TH" FontSize="11" FontWeight="Bold" Foreground="#6B21A8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Lê Thu Hươ..." FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Luyện nghe l..." FontSize="10.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Đã nộp" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                            </Border>
                        </Grid>

                        <!-- Student 4 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#E0E7FF" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                                <TextBlock Text="HN" FontSize="11" FontWeight="Bold" Foreground="#3730A3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Vũ Hoàn..." FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="TOEIC Prac..." FontSize="10.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Đang làm" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"/>
                            </Border>
                        </Grid>

                        <!-- Student 5 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FEE2E2" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                                <TextBlock Text="TM" FontSize="11" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Đặng Thị Mai" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Từ vựng Mới t..." FontSize="10.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Đã nộp" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card: Nhóm học -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Nhóm học" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                        <!-- Group A1 -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F1F5F9" Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0">
                                    <local:LucideIcon Kind="Users" Size="12" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Nhóm A1 — Cơ bản" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="12" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Group B1 -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F1F5F9" Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0">
                                    <local:LucideIcon Kind="Users" Size="12" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Nhóm B1 — Trung cấp" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="31" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Group B2 -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F1F5F9" Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0">
                                    <local:LucideIcon Kind="Users" Size="12" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Nhóm B2 — Trên trung cấp" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="28" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Group C1 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F1F5F9" Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0">
                                    <local:LucideIcon Kind="Users" Size="12" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Nhóm C1 — Nâng cao" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="23" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card: Thao tác nhanh -->
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Thao tác nhanh" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                        <!-- Action 1: Tạo câu hỏi mới -->
                        <Button Background="#E6F4EA" Foreground="#166534" BorderBrush="#BBF7D0" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,8" Margin="0,0,0,8" Cursor="Hand" Click="BtnQuickTaoCauHoi_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Plus" Size="13" Foreground="#166534" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tạo câu hỏi mới" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Action 2: Tạo đề thi / luyện tập -->
                        <Button Background="#F3E8FF" Foreground="#6B21A8" BorderBrush="#E9D5FF" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,8" Margin="0,0,0,8" Cursor="Hand" Click="BtnQuickTaoDeThi_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="FileText" Size="13" Foreground="#6B21A8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tạo đề thi / luyện tập" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Action 3: AI sinh câu hỏi -->
                        <Button Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,8" Margin="0,0,0,8" Cursor="Hand" Click="BtnQuickAISinh_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Sparkles" Size="13" Foreground="#B45309" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="AI sinh câu hỏi" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Action 4: Xem giám sát API -->
                        <Button Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,8" Cursor="Hand" Click="BtnQuickGiamSat_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Zap" Size="13" Foreground="#1E40AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Xem giám sát API" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
