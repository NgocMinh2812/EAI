<Window x:Class="GUI.Views.GiangVien.NguoiDungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin Tài khoản" 
        Height="540" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI"
        Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="txtDialogTitle" Text="Tạo mới Tài khoản Người dùng" FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>
            <TextBlock Text="Nhập đầy đủ thông tin bên dưới để lưu vào cơ sở dữ liệu hệ thống" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <!-- Họ và tên -->
                <TextBlock Text="Họ và tên *" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,5"/>
                <TextBox x:Name="txtHoTen" Height="36" Padding="8,6" FontSize="13" Margin="0,0,0,14" BorderBrush="#CBD5E1"/>

                <!-- Tên đăng nhập -->
                <TextBlock Text="Tên đăng nhập *" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTenDangNhap" Height="36" Padding="8,6" FontSize="13" Margin="0,0,0,14" BorderBrush="#CBD5E1"/>

                <!-- Email -->
                <TextBlock Text="Địa chỉ Email *" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="36" Padding="8,6" FontSize="13" Margin="0,0,0,14" BorderBrush="#CBD5E1"/>

                <!-- Số điện thoại -->
                <TextBlock Text="Số điện thoại" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,5"/>
                <TextBox x:Name="txtSoDienThoai" Height="36" Padding="8,6" FontSize="13" Margin="0,0,0,14" BorderBrush="#CBD5E1"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vai trò -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vai trò" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cboVaiTro" Height="36" SelectedIndex="0">
                            <ComboBoxItem Content="Học viên" Tag="2"/>
                            <ComboBoxItem Content="Giảng viên" Tag="1"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Trình độ mục tiêu -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Trình độ mục tiêu" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cboTrinhDo" Height="36" SelectedIndex="2">
                            <ComboBoxItem Content="A1 — Beginner"/>
                            <ComboBoxItem Content="A2 — Elementary"/>
                            <ComboBoxItem Content="B1 — Intermediate"/>
                            <ComboBoxItem Content="B2 — Upper-Inter"/>
                            <ComboBoxItem Content="C1 — Advanced"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Trạng thái -->
                <CheckBox x:Name="chkHoatDong" Content="Kích hoạt tài khoản ngay (Trạng thái hoạt động)" 
                          IsChecked="True" FontSize="12.5" FontWeight="Medium" Margin="0,4,0,10" Foreground="#0F172A"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" 
                        FontSize="13" FontWeight="Medium" Padding="16,8" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Lưu dữ liệu" Background="#0F4C3A" Foreground="White" BorderThickness="0" 
                        FontSize="13" FontWeight="SemiBold" Padding="20,8" Cursor="Hand" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
