<Window x:Class="GUI.Views.GiangVien.NguoiDungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Thông tin Tài khoản" 
        Icon="pack://application:,,,/GUI;component/Assets/app_icon.ico"
        Height="685" Width="516"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Custom Rounded TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F766E"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F766E"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B5B55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <!-- Lớp đổ bóng độc lập phía sau -->
        <Border CornerRadius="18" Background="#042F2E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#042F2E"/>
            </Border.Effect>
        </Border>

        <!-- Khung nội dung hộp thoại (Không có Effect -> Render Vector & ClearType sắc nét 100%) -->
        <Border CornerRadius="18" BorderBrush="#5EEAD4" BorderThickness="1.5" Background="#F2F9F7" ClipToBounds="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Emerald Header Banner -->
                <RowDefinition Height="*"/>    <!-- Row 1: Soft Mint Form Body -->
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: EMERALD TEAL HEADER BANNER ================= -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="22,18,20,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#042F2E" Offset="0.0"/>
                        <GradientStop Color="#0F4C3A" Offset="0.45"/>
                        <GradientStop Color="#0F766E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Badge with translucent ring -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#26FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                        <local:LucideIcon Kind="User" Size="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="txtDialogTitle" Text="Tạo mới Tài khoản Người dùng" FontWeight="Bold" FontSize="17.5" Foreground="White"/>
                        <TextBlock Text="Nhập đầy đủ thông tin bên dưới để lưu vào cơ sở dữ liệu hệ thống" FontSize="12" Foreground="#CCFBF1" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Width="28" Height="28" Background="Transparent" BorderThickness="0" 
                            Cursor="Hand" VerticalAlignment="Center" ToolTip="Đóng cửa sổ" Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#FEE2E2" CornerRadius="14" BorderBrush="#FECACA" BorderThickness="1">
                                    <TextBlock x:Name="t" Text="✕" FontSize="13" FontWeight="Bold" Foreground="#DC2626" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#DC2626"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#B91C1C"/>
                                        <Setter TargetName="t" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ================= ROW 1: SOFT MINT FORM BODY ================= -->
            <Border Grid.Row="1" Background="#F2F9F7" CornerRadius="0,0,16,16" Padding="24,18,24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Inputs -->
                    <StackPanel Grid.Row="0">
                        <!-- Họ và tên -->
                        <TextBlock Text="Họ và tên *" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtHoTen" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <!-- Tên đăng nhập -->
                        <TextBlock Text="Tên đăng nhập *" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTenDangNhap" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <!-- Email -->
                        <TextBlock Text="Địa chỉ Email *" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <!-- Số điện thoại -->
                        <TextBlock Text="Số điện thoại" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSoDienThoai" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <!-- Vai trò & Trình độ (2 cột song song) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vai trò -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Vai trò" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cboVaiTro" Height="38" SelectedIndex="0">
                                    <ComboBoxItem Content="Học viên" Tag="1"/>
                                    <ComboBoxItem Content="Giảng viên" Tag="0"/>
                                    <ComboBoxItem Content="Quản trị viên" Tag="2"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Trình độ mục tiêu -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Trình độ mục tiêu" FontWeight="SemiBold" FontSize="12.5" Foreground="#064E3B" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cboTrinhDo" Height="38" SelectedIndex="2">
                                    <ComboBoxItem Content="A1 — Beginner"/>
                                    <ComboBoxItem Content="A2 — Elementary"/>
                                    <ComboBoxItem Content="B1 — Intermediate"/>
                                    <ComboBoxItem Content="B2 — Upper-Inter"/>
                                    <ComboBoxItem Content="C1 — Advanced"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Checkbox Trạng thái -->
                        <CheckBox x:Name="chkHoatDong" Content="Kích hoạt tài khoản ngay (Trạng thái hoạt động)" 
                                  IsChecked="True" FontSize="12.5" FontWeight="Medium" Margin="0,2,0,0" Foreground="#064E3B" Cursor="Hand"/>

                        <!-- Thông báo mật khẩu khởi tạo mặc định (khi thêm mới) -->
                        <Border x:Name="pnlDefaultPasswordNote" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:LucideIcon Kind="Key" Size="17" Foreground="#0F766E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#064E3B">
                                        Mật khẩu khởi tạo mặc định: <Run Text="123456" FontWeight="Bold" Foreground="#0F766E"/>
                                    </TextBlock>
                                    <TextBlock Text="Người dùng có thể đổi mật khẩu bất kỳ lúc nào sau khi đăng nhập." FontSize="11" Foreground="#047857" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Border Grid.Row="1" BorderBrush="#D1E7DD" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy bỏ" Style="{StaticResource CancelBtnStyle}" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                            <Button Content="Lưu dữ liệu" Style="{StaticResource SaveBtnStyle}" Click="BtnSave_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
