<Window x:Class="GUI.Views.GiangVien.CapNhatKhaoSatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Soạn thảo &amp; Cấu hình Bộ đề Khảo sát Năng lực"
        Height="840" Width="1300"
        MinWidth="1150" MinHeight="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A"/>
        <SolidColorBrush x:Key="AdminTeal" Color="#0D9488"/>
        <SolidColorBrush x:Key="AdminMint" Color="#10B981"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextGray" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>

        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Margin="14" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.30" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Header Bar -->
                <RowDefinition Height="*"/>    <!-- 1. Main 2-Column Split -->
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- 0. TOP HEADER BAR                                                         -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Nút Quay lại / Đóng -->
                <Button Grid.Column="0" Click="BtnDong_Click" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                        Width="38" Height="38" Cursor="Hand" Margin="0,0,14,0" ToolTip="Đóng cửa sổ">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="19"/>
                        </Style>
                    </Button.Resources>
                    <local:LucideIcon Kind="ArrowLeft" Size="18" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Tiêu đề & Mô tả -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                        <local:LucideIcon Kind="Compass" Size="20" Foreground="{StaticResource AdminDarkGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Soạn thảo &amp; Cấu hình Bộ đề Khảo sát Năng lực" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Chuẩn CEFR &amp; Đa kỹ năng" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Cấu hình thông số bài khảo sát, phân tầng kỹ năng và chọn lọc câu hỏi chuẩn hóa từ Ngân hàng đề thi" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <!-- Actions bên phải -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dropdown chọn bộ đề -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Bộ đề:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cboChonBoDe" Height="36" Width="260" FontSize="12" SelectionChanged="CboChonBoDe_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>

                    <!-- Nút Xem trước đề -->
                    <Button Click="BtnXemTruoc_Click" Background="White" Foreground="{StaticResource TextDark}" 
                            BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="12,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="Xem trước giao diện làm bài của học viên">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="Eye" Size="13" Foreground="#0284C7" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xem trước đề" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Tự động chọn 20 câu -->
                    <Button Click="BtnTuDongChon_Click" Background="{StaticResource AdminTeal}" Foreground="White" BorderThickness="0" 
                            Padding="12,8" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0"
                            ToolTip="Tự động lọc và nạp đúng 20 câu hỏi đa kỹ năng khớp chuẩn cấp độ">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="Zap" Size="13" Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tự động chọn 20 câu" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Lưu bộ đề -->
                    <Button Click="BtnLuu_Click" Background="{StaticResource AdminDarkGreen}" Foreground="White" BorderThickness="0" 
                            Padding="16,8" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="Check" Size="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu bộ đề khảo sát" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 1. MAIN 2-COLUMN SPLIT (Left: Config & Blueprint | Right: Question Bank)  -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===================================================================== -->
                <!-- CỘT TRÁI: FORM CẤU HÌNH THÔNG SỐ & TIẾN ĐỘ CHUẨN                      -->
                <!-- ===================================================================== -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <!-- Card 1: Thông số bộ đề khảo sát -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="THÔNG SỐ BỘ ĐỀ KHẢO SÁT" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource AdminDarkGreen}" Margin="0,0,0,10"/>

                                    <!-- Tiêu đề bài khảo sát -->
                                    <TextBlock Text="TIÊU ĐỀ BÀI KHẢO SÁT *" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtTenBaiKhaoSat" Height="36" VerticalContentAlignment="Center" Padding="10,0" FontSize="12.5" MaxLength="200"
                                             Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="0,0,0,12">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <!-- Cấp độ & Thời lượng -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cấp độ -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CẤP ĐỘ MỤC TIÊU" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="cboCapDoSurvey" Height="36" FontSize="12" SelectionChanged="CboCapDoSurvey_SelectionChanged">
                                                <ComboBox.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                    </Style>
                                                </ComboBox.Resources>
                                                <ComboBoxItem Content="Cấp độ A1" Tag="A1"/>
                                                <ComboBoxItem Content="Cấp độ A2" Tag="A2"/>
                                                <ComboBoxItem Content="Cấp độ B1" Tag="B1"/>
                                                <ComboBoxItem Content="Cấp độ B2" Tag="B2"/>
                                                <ComboBoxItem Content="Cấp độ C1" Tag="C1"/>
                                                <ComboBoxItem Content="Cấp độ C2" Tag="C2"/>
                                                <ComboBoxItem Content="🌟 Tổng hợp (A1 - C2)" Tag="TongHop"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Thời lượng -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="THỜI GIAN (PHÚT)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtThoiGianPhut" Text="30" Height="36" VerticalContentAlignment="Center" Padding="10,0" FontSize="12.5"
                                                     PreviewTextInput="NumberOnly_PreviewTextInput" MaxLength="3"
                                                     Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                                <TextBox.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mô tả chi tiết & Hướng dẫn -->
                                    <TextBlock Text="MÔ TẢ CHI TIẾT &amp; HƯỚNG DẪN KHẢO SÁT" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtMoTa" Height="68" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" FontSize="12" MaxLength="1000"
                                             Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Margin="0,0,0,12">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <!-- Kích hoạt -->
                                    <CheckBox x:Name="chkDangHoatDong" Content="Đang kích hoạt bộ đề này trên hệ thống" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Tiến độ câu hỏi & Cấu trúc phân bổ kỹ năng chuẩn -->
                            <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="TIẾN ĐỘ &amp; PHÂN BỔ KỸ NĂNG" FontWeight="Bold" FontSize="11.5" Foreground="#0F766E" VerticalAlignment="Center"/>
                                        <Border x:Name="badgeCountSelected" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="txtCountSelected" Text="20 / 20 câu" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Phân bổ số lượng câu hỏi hiện tại trong bộ đề:" FontSize="11.5" Foreground="#334155" Margin="0,0,0,8"/>

                                    <!-- Grid phân bổ kỹ năng -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#CCFBF1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,4,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📖 Ngữ pháp: " FontSize="11" Foreground="#475569"/>
                                                <TextBlock x:Name="txtSkillNguPhap" Text="0 câu" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="0" Grid.Column="1" Background="White" BorderBrush="#CCFBF1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔤 Từ vựng: " FontSize="11" Foreground="#475569"/>
                                                <TextBlock x:Name="txtSkillTuVung" Text="0 câu" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#CCFBF1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📑 Đọc hiểu: " FontSize="11" Foreground="#475569"/>
                                                <TextBlock x:Name="txtSkillDoc" Text="0 câu" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#CCFBF1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎧 Nghe / Khác: " FontSize="11" Foreground="#475569"/>
                                                <TextBlock x:Name="txtSkillNghe" Text="0 câu" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Thông báo chuẩn -->
                                    <Border Background="White" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <TextBlock x:Name="lblStatusSummary" 
                                                   Text="Khuyến nghị chuẩn CEFR: Bộ đề khảo sát năng lực nên có chính xác 20 câu hỏi đa kỹ năng để phân loại chuẩn xác." 
                                                   FontSize="11" Foreground="#0F766E" TextWrapping="Wrap" LineHeight="16"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Trạng thái Snapshot -->
                            <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="• Tự động đánh số thứ tự câu hỏi từ 1 đến 20 khi lưu." FontSize="11" Foreground="#15803D" Margin="0,0,0,2"/>
                                    <TextBlock Text="• Bảo toàn nguyên vẹn liên kết câu hỏi và đáp án." FontSize="11" Foreground="#15803D"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===================================================================== -->
                <!-- CỘT PHẢI: CHỌN CÂU HỎI TỪ NGÂN HÀNG ĐỀ (CARD-BASED UI)               -->
                <!-- ===================================================================== -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 0. Header Picker & Checkbox xem câu đã chọn -->
                            <RowDefinition Height="Auto"/> <!-- 1. Filters (Search with Watermark & Dropdowns) -->
                            <RowDefinition Height="*"/>    <!-- 2. Question Cards List -->
                        </Grid.RowDefinitions>

                        <!-- 0. Header Picker -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CHỌN CÂU HỎI TỪ NGÂN HÀNG ĐỀ THI" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Nhấn '+ Thêm vào bộ đề' hoặc dùng các nút ▲ / ▼ để sắp xếp thứ tự câu hỏi" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Checkbox / Toggle xem câu đã chọn -->
                                <CheckBox x:Name="chkOnlySelected" Checked="ChkOnlySelected_Changed" Unchecked="ChkOnlySelected_Changed"
                                          VerticalAlignment="Center" Cursor="Hand" Margin="0,0,12,0">
                                    <CheckBox.Content>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Chỉ hiện câu trong bộ đề" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="9" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtSelectedFilterCount" Text="20 câu" FontSize="10.5" FontWeight="Bold" Foreground="#065F46"/>
                                            </Border>
                                        </StackPanel>
                                    </CheckBox.Content>
                                </CheckBox>

                                <Button Content="Bỏ chọn tất cả" Click="BtnBoChonTatCa_Click" Background="Transparent" Foreground="#DC2626" BorderThickness="0" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- 1. Filters Row -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Hàng 1: Ô tìm kiếm câu hỏi có placeholder & Lọc Cấp độ -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ô tìm kiếm câu hỏi có Placeholder Text -->
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="txtSearchBank" Height="36" Padding="32,6,10,6" VerticalContentAlignment="Center" FontSize="12"
                                             BorderBrush="{StaticResource BorderLight}" TextChanged="TxtSearchBank_TextChanged">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <local:LucideIcon Kind="Search" Size="14" Foreground="{StaticResource TextGray}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtSearchPlaceholder" Text="Tìm kiếm câu hỏi theo từ khóa, nội dung..." VerticalAlignment="Center" Margin="32,0,10,0"
                                               Foreground="{StaticResource TextGray}" FontSize="12" IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Lọc Cấp độ -->
                                <ComboBox Grid.Column="2" x:Name="cboBankLevel" Height="36" SelectedIndex="0" FontSize="11.5" SelectionChanged="CboBankLevel_SelectionChanged">
                                    <ComboBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Tất cả cấp độ" Tag="TatCa"/>
                                    <ComboBoxItem Content="Cấp độ A1" Tag="A1"/>
                                    <ComboBoxItem Content="Cấp độ A2" Tag="A2"/>
                                    <ComboBoxItem Content="Cấp độ B1" Tag="B1"/>
                                    <ComboBoxItem Content="Cấp độ B2" Tag="B2"/>
                                    <ComboBoxItem Content="Cấp độ C1" Tag="C1"/>
                                    <ComboBoxItem Content="Cấp độ C2" Tag="C2"/>
                                </ComboBox>
                            </Grid>

                            <!-- Hàng 2: Kỹ năng & Độ khó & Counter -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Kỹ năng -->
                                <ComboBox Grid.Column="0" x:Name="cboBankSkill" Height="32" SelectedIndex="0" FontSize="11.5" SelectionChanged="CboBankSkill_SelectionChanged">
                                    <ComboBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Tất cả kỹ năng" Tag="TatCa"/>
                                    <ComboBoxItem Content="Ngữ pháp" Tag="NguPhap"/>
                                    <ComboBoxItem Content="Từ vựng" Tag="TuVung"/>
                                    <ComboBoxItem Content="Đọc hiểu" Tag="Doc"/>
                                    <ComboBoxItem Content="Nghe hiểu" Tag="Nghe"/>
                                    <ComboBoxItem Content="Viết" Tag="Viet"/>
                                    <ComboBoxItem Content="Nói" Tag="Noi"/>
                                </ComboBox>

                                <!-- Độ khó -->
                                <ComboBox Grid.Column="2" x:Name="cboBankDifficulty" Height="32" SelectedIndex="0" FontSize="11.5" SelectionChanged="CboBankDifficulty_SelectionChanged">
                                    <ComboBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Tất cả độ khó" Tag="TatCa"/>
                                    <ComboBoxItem Content="Dễ" Tag="De"/>
                                    <ComboBoxItem Content="Trung bình" Tag="TrungBinh"/>
                                    <ComboBoxItem Content="Khó" Tag="Kho"/>
                                </ComboBox>

                                <!-- Counter -->
                                <TextBlock Grid.Column="3" x:Name="txtBankCount" Text="0 câu khả dụng" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- 2. Question Cards List (No text truncated, clean modern card design) -->
                        <Grid Grid.Row="2">
                            <!-- Empty State -->
                            <StackPanel x:Name="pnlEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,30">
                                <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Không tìm thấy câu hỏi phù hợp với bộ lọc" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Vui lòng thử tìm từ khóa khác hoặc nới lỏng bộ lọc." FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- ListBox chứa các thẻ câu hỏi (Cuộn mượt mà theo Pixel, scrollbar lùi ra ngoài có khoảng đệm thẩm mỹ) -->
                            <ListBox x:Name="lstQuestions" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="False"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     Margin="0,0,-6,0"
                                     Padding="0,0,20,6">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Thẻ câu hỏi -->
                                        <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInCurrentSurvey}" Value="True">
                                                            <Setter Property="Background" Value="#F0FDF4"/>
                                                            <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Top row: Badges & Action Buttons -->
                                                    <RowDefinition Height="Auto"/> <!-- Question text -->
                                                    <RowDefinition Height="Auto"/> <!-- Reading passage if any -->
                                                    <RowDefinition Height="Auto"/> <!-- Answer choices / Explanation if expanded -->
                                                </Grid.RowDefinitions>

                                                <!-- Top row: Badges & Buttons -->
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Badges -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Badge STT trong bộ đề nếu đã được chọn -->
                                                        <Border Background="#065F46" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                                Visibility="{Binding IsInCurrentSurvey, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="{Binding ThuTuTrongBo, StringFormat='#Câu {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                                        </Border>

                                                        <!-- Badge Kỹ năng -->
                                                        <Border Background="{Binding SkillBadgeBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding KyNangHienThi}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding SkillBadgeFg}"/>
                                                        </Border>

                                                        <!-- Badge Cấp độ -->
                                                        <Border Background="{Binding LevelBadgeBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding MaTrinhDo}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding LevelBadgeFg}"/>
                                                        </Border>

                                                        <!-- Badge Độ khó -->
                                                        <Border Background="{Binding DifficultyBadgeBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding DoKhoHienThi}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DifficultyBadgeFg}"/>
                                                        </Border>

                                                        <!-- Badge Audio nếu có -->
                                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                                Visibility="{Binding HasAudio, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="🎧 Audio" FontSize="9.5" FontWeight="Bold" Foreground="#047857"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Right: Buttons -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Nút xem đáp án -->
                                                        <Button Click="BtnToggleDapAn_Click" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" 
                                                                Padding="8,3" Cursor="Hand" Margin="0,0,6,0">
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="CornerRadius" Value="5"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="👁️" FontSize="10" Margin="0,0,3,0"/>
                                                                <TextBlock Text="Đáp án" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Nút điều hướng thứ tự nếu trong bộ đề -->
                                                        <Button Click="BtnLen_Click" Content="▲ Lên" Background="#F1F5F9" Foreground="#334155" 
                                                                FontWeight="SemiBold" FontSize="10.5" Padding="7,3" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                                Visibility="{Binding IsInCurrentSurvey, Converter={StaticResource BoolToVisConverter}}">
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="5"/></Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <Button Click="BtnXuong_Click" Content="▼ Xuống" Background="#F1F5F9" Foreground="#334155" 
                                                                FontWeight="SemiBold" FontSize="10.5" Padding="7,3" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"
                                                                Visibility="{Binding IsInCurrentSurvey, Converter={StaticResource BoolToVisConverter}}">
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="5"/></Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <!-- Nút Gỡ bỏ nếu trong bộ đề -->
                                                        <Button Click="BtnXoa_Click" Content="✕ Gỡ bỏ" Background="#FEE2E2" Foreground="#DC2626" 
                                                                FontWeight="Bold" FontSize="11" Padding="10,3.5" BorderThickness="0" Cursor="Hand"
                                                                Visibility="{Binding IsInCurrentSurvey, Converter={StaticResource BoolToVisConverter}}">
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="5"/></Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <!-- Nút Thêm vào bộ đề nếu chưa có -->
                                                        <Button Click="BtnThemCauHoi_Click" Content="+ Thêm vào bộ đề" Background="#E0F2FE" Foreground="#0284C7" 
                                                                FontWeight="Bold" FontSize="11" Padding="10,3.5" BorderThickness="0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}"><Setter Property="CornerRadius" Value="5"/></Style>
                                                            </Button.Resources>
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInCurrentSurvey}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 1: Full Question Content (NO text cut off) -->
                                                <TextBlock Grid.Row="1" Text="{Binding NoiDungCauHoi}" FontSize="13" FontWeight="SemiBold" 
                                                           Foreground="{StaticResource TextDark}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,4"/>

                                                <!-- Row 2: Reading passage / Context preview if available -->
                                                <Border Grid.Row="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,2,0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DoanVanDoc}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DoanVanDoc}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DoanVanDoc, StringFormat='📖 Đoạn trích: {0}'}" FontSize="11.5" Foreground="#92400E" 
                                                               TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                                                </Border>

                                                <!-- Row 3: Answer Choices & Explanation (Expanded View) -->
                                                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                                                        Visibility="{Binding IsAnswersExpanded, Converter={StaticResource BoolToVisConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Các lựa chọn đáp án:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                                        <ItemsControl ItemsSource="{Binding DanhSachLuaChon}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="22"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding KyHieuLuaChon, StringFormat='{}{0}.'}" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding NoiDungLuaChon}" FontSize="11.5" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                                        <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                                                Visibility="{Binding LaDapAnDung, Converter={StaticResource BoolToVisConverter}}">
                                                                            <TextBlock Text="✓ Đáp án đúng" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Giải thích đáp án nếu có -->
                                                        <TextBlock Text="{Binding GiaiThichDapAn, StringFormat='💡 Giải thích: {0}'}" FontSize="11" Foreground="#0F766E" 
                                                                   FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding GiaiThichDapAn}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding GiaiThichDapAn}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
