<Window x:Class="GUI.Views.GiangVien.CapNhatKhaoSatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Cập nhật Bộ Đề Khảo Sát Đầu Vào"
        Height="680" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextGray" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
    </Window.Resources>

    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Margin="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.25" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <local:LucideIcon Kind="Settings" Size="18" Foreground="#0F4C3A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cập nhật Bộ đề Khảo sát Năng lực Đầu vào" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    </StackPanel>
                    <TextBlock Text="Điều chỉnh tiêu đề bài khảo sát, thay đổi thứ tự và bổ sung/loại bớt câu hỏi từ Ngân hàng đề thi" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnDong_Click" Background="#F1F5F9" BorderThickness="0" Width="30" Height="30" Cursor="Hand" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <local:LucideIcon Kind="X" Size="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Thông tin chung bài khảo sát -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TIÊU ĐỀ BÀI KHẢO SÁT *" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTenBaiKhaoSat" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MÔ TẢ CHI TIẾT" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtMoTa" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,14,0,0">
                        <CheckBox x:Name="chkDangHoatDong" Content="Đang kích hoạt" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Khu vực Quản lý Câu hỏi (Split Left: Câu hỏi hiện tại, Right: Thêm câu hỏi từ Ngân hàng) -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Danh sách câu hỏi trong bộ đề -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Câu hỏi trong bộ đề" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}"/>
                                <Border Background="#ECFDF5" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                    <TextBlock x:Name="txtCountSelected" Text="0 câu" FontSize="11.5" FontWeight="Bold" Foreground="#065F46"/>
                                </Border>
                            </StackPanel>

                            <!-- Nút điều hướng thứ tự -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="▲ Lên" Click="BtnLen_Click" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                                        FontWeight="SemiBold" FontSize="11.5" Padding="10,4" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Content="▼ Xuống" Click="BtnXuong_Click" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                                        FontWeight="SemiBold" FontSize="11.5" Padding="10,4" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Content="Xóa bỏ" Click="BtnXoa_Click" Background="#FEE2E2" Foreground="#DC2626" 
                                        FontWeight="SemiBold" FontSize="11.5" Padding="10,4" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="dgQuestionsInSurvey" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding ThuTuCauHoi}" Width="45" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Cấp độ" Binding="{Binding MaTrinhDo}" Width="65" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Kỹ năng" Binding="{Binding KyNang}" Width="75" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Dạng" Binding="{Binding LoaiCauHoi}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nội dung câu hỏi" Binding="{Binding NoiDungCauHoi}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Cột phải: Thêm câu hỏi từ Ngân hàng -->
                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Thêm từ Ngân hàng câu hỏi" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>

                        <!-- Filters -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSearchBank" Height="30" VerticalContentAlignment="Center" Padding="6,0" TextChanged="TxtSearchBank_TextChanged" ToolTip="Tìm kiếm nội dung..."/>
                            <ComboBox Grid.Column="2" x:Name="cboBankLevel" Height="30" SelectedIndex="0" SelectionChanged="CboBankLevel_SelectionChanged">
                                <ComboBoxItem Content="Tất cả" Tag="TatCa"/>
                                <ComboBoxItem Content="A1" Tag="A1"/>
                                <ComboBoxItem Content="A2" Tag="A2"/>
                                <ComboBoxItem Content="B1" Tag="B1"/>
                                <ComboBoxItem Content="B2" Tag="B2"/>
                                <ComboBoxItem Content="C1" Tag="C1"/>
                            </ComboBox>
                        </Grid>

                        <!-- Available Questions DataGrid -->
                        <DataGrid Grid.Row="2" x:Name="dgAvailableBank" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cấp độ" Binding="{Binding MaTrinhDo}" Width="55" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nội dung" Binding="{Binding NoiDungCauHoi}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="+ Thêm" Click="BtnThemCauHoi_Click" Background="#E0F2FE" Foreground="#0369A1" 
                                                    FontWeight="Bold" FontSize="11" Padding="6,2" BorderThickness="0" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. Footer Buttons -->
            <Grid Grid.Row="3">
                <TextBlock x:Name="lblStatusSummary" Text="Khuyến nghị: Bộ đề khảo sát chuẩn nên gồm 15 đến 20 câu hỏi bao phủ từ A1 đến C1." 
                           VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextGray}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" Click="BtnDong_Click" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                            FontWeight="SemiBold" FontSize="13" Padding="18,9" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Lưu bộ đề khảo sát" Click="BtnLuu_Click" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                            FontWeight="Bold" FontSize="13" Padding="20,9" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
