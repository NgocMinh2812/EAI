<Page x:Class="GUI.Views.GiangVien.DanhMucView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Danh mục &amp; Cấu trúc Học liệu - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="CategoryItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveCategoryItemButton" TargetType="Button" BasedOn="{StaticResource CategoryItemButton}">
            <Setter Property="Background" Value="#E6F4EA"/>
            <Setter Property="Foreground" Value="{StaticResource AdminDarkGreen}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#E6F4EA" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Vàng Cam Rực Rỡ - Mở Thư Mục (Amber/Orange) -->
        <Style x:Key="AmberHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#EA580C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C2410C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#EA580C"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C2410C"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9A3412"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9A3412"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Tím Xanh Hoàng Gia - Đồng Bộ Kho (Royal Indigo) -->
        <Style x:Key="IndigoHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#4F46E5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Xanh Dương Đại Dương - Tải Lên Tệp (Sky/Ocean Blue) -->
        <Style x:Key="TealHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0369A1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#0284C7"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Ngọc Lục Bảo Tươi - Thư Mục Mới (Fresh Emerald Green) -->
        <Style x:Key="EmeraldHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.3" Color="#059669"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#065F46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#065F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER (KHÔNG BỊ CHE - RESPONSIVE CHỐNG ĐÈ CHỮ) ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tiêu đề trang gọn gàng & thanh lịch -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kho Học Liệu &amp; Đề Thi" FontWeight="Bold" FontSize="19" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Cấu trúc thư mục &amp; kho tệp (.docx, .pdf) theo chuyên mục" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Cụm nút bấm màu sắc sinh động, tự rớt dòng mềm mại nếu màn hình hẹp -->
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="📂 Mở Thư Mục" Style="{StaticResource AmberHeaderBtn}" Click="BtnOpenFolderExplorer_Click" ToolTip="Mở thư mục KhoHocLieu trên Windows Explorer"/>
                <Button Content="🔄 Đồng Bộ Kho" Style="{StaticResource IndigoHeaderBtn}" Click="BtnSyncKhoHocLieu_Click" ToolTip="Tự động đồng bộ toàn bộ cây danh mục CSDL ra thư mục trên đĩa"/>
                <Button Content="📥 Tải Lên Tệp" Style="{StaticResource TealHeaderBtn}" Click="BtnUploadFile_Click" ToolTip="Tải lên tệp đề thi hoặc tài liệu học liệu mới (.docx, .pdf)"/>
                <Button Content="➕ Thư Mục Mới" Style="{StaticResource EmeraldHeaderBtn}" Click="BtnNewFolder_Click" ToolTip="Tạo danh mục chủ đề mới"/>
            </WrapPanel>
        </Grid>

        <!-- ================= 3-COLUMN EXPLORER & PREVIEWER ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột 1: Cây thư mục (Default 270px, Min 180, Max 450) -->
                <ColumnDefinition Width="270" MinWidth="180" MaxWidth="450"/>
                <!-- Splitter 1 -->
                <ColumnDefinition Width="10"/>
                <!-- Cột 2: Danh sách file / bài học (Flexible, Min 220) -->
                <ColumnDefinition Width="330" MinWidth="220"/>
                <!-- Splitter 2 -->
                <ColumnDefinition Width="10"/>
                <!-- Cột 3: Live Document Preview Pane (Flexible, Min 300) -->
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT 1: CÂY DANH MỤC ĐỘNG ================= -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CÂY PHÂN CẤP CHỦ ĐỀ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="4,4,4,8"/>

                    <!-- Toolbar Thêm / Sửa / Xóa Chủ đề với màu sắc phân biệt -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="4" Margin="0,0,0,10" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="➕ Thêm" Background="#ECFDF5" Foreground="#047857" BorderBrush="#10B981" BorderThickness="1.5"
                                    FontSize="11.5" FontWeight="SemiBold" Padding="4,6" Margin="2,0" Cursor="Hand" Click="BtnThemChuDe_Click" ToolTip="Thêm chủ đề mới">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tb1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb1" Property="Background" Value="#A7F3D0"/>
                                                <Setter TargetName="tb1" Property="BorderBrush" Value="#059669"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="1" Content="✏️ Sửa" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#3B82F6" BorderThickness="1.5"
                                    FontSize="11.5" FontWeight="SemiBold" Padding="4,6" Margin="2,0" Cursor="Hand" Click="BtnSuaChuDe_Click" ToolTip="Sửa chủ đề đang chọn">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tb2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb2" Property="Background" Value="#BFDBFE"/>
                                                <Setter TargetName="tb2" Property="BorderBrush" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Content="🗑️ Xóa" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#EF4444" BorderThickness="1.5"
                                    FontSize="11.5" FontWeight="SemiBold" Padding="4,6" Margin="2,0" Cursor="Hand" Click="BtnXoaChuDe_Click" ToolTip="Xóa chủ đề đang chọn">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tb3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb3" Property="Background" Value="#FECACA"/>
                                                <Setter TargetName="tb3" Property="BorderBrush" Value="#B91C1C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- WPF TreeView Động liên kết CSDL -->
                    <TreeView x:Name="tvDanhMuc" Grid.Row="2" BorderThickness="0" Background="Transparent" 
                              SelectedItemChanged="TvDanhMuc_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="2,3"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextDark}" 
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding BadgeText}" FontSize="11" Foreground="{StaticResource TextGray}" 
                                               Margin="6,0,4,0" VerticalAlignment="Center" FontWeight="Normal"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ================= THANH KÉO GIÃN 1 (GIỮA CỘT 1 VÀ 2) ================= -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Width="10">
                            <Border x:Name="splBorder" Width="2" HorizontalAlignment="Center" Background="#CBD5E1" CornerRadius="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="splBorder" Property="Background" Value="{StaticResource AdminDarkGreen}"/>
                                <Setter TargetName="splBorder" Property="Width" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================= CỘT 2: DANH SÁCH FILE ĐỀ THI ================= -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter & Search in File List -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSearchFile" Text="🔍 Tìm bài học / đề thi..." BorderThickness="0" Background="Transparent" 
                                     FontSize="12.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"
                                     GotFocus="TxtSearchFile_GotFocus" LostFocus="TxtSearchFile_LostFocus" TextChanged="TxtSearchFile_TextChanged"/>
                            <TextBlock x:Name="txtLessonCounter" Grid.Column="1" Text="4 bài học" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Lessons / Materials Items from Database -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty State Notice -->
                            <TextBlock x:Name="txtEmptyNotice" Text="Chưa có bài học nào trong chủ đề này." 
                                       FontStyle="Italic" Foreground="{StaticResource TextGray}" Margin="20" HorizontalAlignment="Center" Visibility="Collapsed"/>

                            <!-- Real Lessons List -->
                            <ItemsControl x:Name="icLessonList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,12" Background="White" Cursor="Hand" MouseDown="LessonItem_Click" Tag="{Binding MaBaiHoc}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Skill Icon Badge -->
                                                <Border Grid.Column="0" Background="{Binding BadgeBackground}" Width="38" Height="38" CornerRadius="8" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding IconSkill}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TieuDe}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TomTat}" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,3"/>
                                                    
                                                    <!-- Meta Info: Format Badge (.docx, .pdf) & Size -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{Binding BadgeDinhDangBg}" BorderBrush="{Binding BadgeDinhDangBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding DinhDangTep}" Foreground="{Binding BadgeDinhDangFg}" FontSize="9.5" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding DungLuongHienThi}" FontSize="10.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" • " FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ThoiGianUocTinhPhut, StringFormat='{}{0} phút'}" FontSize="10.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="6" Padding="7,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TrangThai}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= THANH KÉO GIÃN 2 (GIỮA CỘT 2 VÀ 3) ================= -->
            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Width="10">
                            <Border x:Name="splBorder" Width="2" HorizontalAlignment="Center" Background="#CBD5E1" CornerRadius="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="splBorder" Property="Background" Value="{StaticResource AdminDarkGreen}"/>
                                <Setter TargetName="splBorder" Property="Width" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================= CỘT 3: TRÌNH XEM TRƯỚC ĐỀ THI / TÀI LIỆU (PREVIEW PANE) ================= -->
            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="txtPreviewDocTitle" Text="IELTS_Reading_Cam18_Test01.pdf" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtPreviewDocMeta" Text="Định dạng: Adobe PDF • Dung lượng: 1.8 MB • Cập nhật: Hôm nay 10:30" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📥 Tải về" Background="#EFF6FF" BorderBrush="#3B82F6" Foreground="#1D4ED8" BorderThickness="1.5" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnDownloadCurrent_Click" ToolTip="Tải xuống tệp học liệu">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnB" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnB" Property="Background" Value="#DBEAFE"/>
                                                    <Setter TargetName="btnB" Property="BorderBrush" Value="#2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="🖨️ In ấn" Background="#FAF5FF" BorderBrush="#A855F7" Foreground="#7E22CE" BorderThickness="1.5" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" Click="BtnPrintCurrent_Click" ToolTip="In đề thi / học liệu">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnB2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnB2" Property="Background" Value="#EDE9FE"/>
                                                    <Setter TargetName="btnB2" Property="BorderBrush" Value="#9333EA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Document Content Viewer Simulation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel x:Name="pnlDocViewerContent">

                            <!-- Paper Simulation Header -->
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtSimulationModule" Text="ACADEMIC READING MODULE — PRACTICE TEST #01" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource AdminDarkGreen}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="txtSimulationPassage" Text="Reading Passage 1: You should spend about 20 minutes on Questions 1–13." FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Document Heading -->
                            <TextBlock x:Name="txtPassageTitle" Text="The Secrets of Ancient Roman Concrete &amp; Architectural Acoustics" 
                                       FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" TextAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <!-- Reading Text Content -->
                            <TextBlock x:Name="txtPassageBody" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,16">
                                For centuries, researchers have puzzled over how ancient Roman concrete structures such as the Colosseum and the Pantheon have remained structurally sound for over two millennia, often under harsh marine conditions. While modern concrete degrades within decades, Roman pozzolanic concrete demonstrated self-healing properties...
                                <LineBreak/><LineBreak/>
                                In a groundbreaking 2023 study published by MIT and Harvard researchers, analytical electron microscopy revealed that lime clasts within the concrete matrix acted as an active calcium reservoir. When microcracks formed and rainwater infiltrated, the calcium dissolved and recrystallized as calcite, sealing the fractures autonomously.
                            </TextBlock>

                            <!-- Questions Extracted from Document via Gemini AI -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🤖" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Câu hỏi trắc nghiệm đã bóc tách từ tài liệu" FontWeight="Bold" FontSize="13" Foreground="#15803D" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Nút Bóc tách lại bằng Gemini 3.8 Flash -->
                                        <Button x:Name="btnReExtractAI" Grid.Column="1" Content="✨ Bóc tách lại bằng AI" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" BorderThickness="1"
                                                FontSize="11" FontWeight="SemiBold" Padding="10,4" Cursor="Hand" Click="BtnReExtractAI_Click" ToolTip="Kích hoạt Gemini AI (User Secret) phân tích văn bản và sinh câu hỏi mới">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdBtn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bdBtn" Property="Background" Value="#BBF7D0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Loading Progress Bar -->
                                    <ProgressBar x:Name="pbAILoading" Height="3" IsIndeterminate="True" Margin="0,0,0,8" Visibility="Collapsed" Foreground="#10B981" Background="#DCFCE7"/>

                                    <!-- Dynamic Questions List -->
                                    <ItemsControl x:Name="icExtractedQuestions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding NoiDungCauHoi}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                                        <ItemsControl ItemsSource="{Binding DanhSachLuaChon}" Margin="0,6,0,6">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#334155" Margin="4,2,0,2" TextWrapping="Wrap"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border Background="#F0FDF4" CornerRadius="6" Padding="8,5" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding GiaiThichChiTiet}" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Preview Footer Action -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Dynamic Status Badge & Info -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border x:Name="bdPreviewStatusIcon" Background="#DCFCE7" Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtPreviewStatusIcon" Text="✓" Foreground="#15803D" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="bdPreviewStatusPill" Background="#DCFCE7" CornerRadius="6" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtPreviewStatusPill" Text="Đã xuất bản" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                </Border>
                                <TextBlock x:Name="txtPreviewStatusSub" Text="Sẵn sàng giảng dạy" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Quick Action Button -->
                            <Button Grid.Column="1" Content="➕ Đưa vào Đề thi thử" Background="#059669" Foreground="White" 
                                    FontWeight="Bold" FontSize="12" Padding="14,8" BorderThickness="0" Cursor="Hand" Click="BtnAddToExam_Click"
                                    ToolTip="Tạo đề thi thử tự động từ bài học này">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#059669"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBd" Property="Background" Value="#047857"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBd" Property="Background" Value="#065F46"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
