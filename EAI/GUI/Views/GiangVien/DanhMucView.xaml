<Page x:Class="GUI.Views.GiangVien.DanhMucView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Danh mục &amp; Cấu trúc Học liệu - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="CategoryItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveCategoryItemButton" TargetType="Button" BasedOn="{StaticResource CategoryItemButton}">
            <Setter Property="Background" Value="#E6F4EA"/>
            <Setter Property="Foreground" Value="{StaticResource AdminDarkGreen}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#E6F4EA" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Cấu trúc Thư mục Đề thi &amp; Kho Tệp Học liệu" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                <TextBlock Text="Quản lý tập trung các tệp đề thi (.pdf, .docx, .xlsx, .mp3), phân cấp chuyên mục và xem trước nội dung trực tiếp" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📥 Tải lên tệp mới (.pdf, .docx)" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                        FontWeight="SemiBold" FontSize="12.5" Padding="14,9" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnUploadFile_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="➕ Thư mục mới" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                        FontWeight="SemiBold" FontSize="12.5" Padding="16,9" BorderThickness="0" Cursor="Hand" Click="BtnNewFolder_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 3-COLUMN EXPLORER & PREVIEWER ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 1: Tree / Folder list (220px) -->
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="14"/>
                <!-- Column 2: File Grid / List (Flexible) -->
                <ColumnDefinition Width="1.1*" MinWidth="260"/>
                <ColumnDefinition Width="14"/>
                <!-- Column 3: Live Document Preview Pane (Flexible) -->
                <ColumnDefinition Width="1.5*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT 1: CÂY DANH MỤC ================= -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CÂY PHÂN CẤP CHỦ ĐỀ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="4,4,4,10"/>

                        <Button x:Name="btnCatAll" Style="{StaticResource ActiveCategoryItemButton}" Click="BtnCategory_Click" Tag="All">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tất cả tài liệu (18)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCatIELTS" Style="{StaticResource CategoryItemButton}" Click="BtnCategory_Click" Tag="IELTS">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇬🇧" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="IELTS Academic (6)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCatTOEIC" Style="{StaticResource CategoryItemButton}" Click="BtnCategory_Click" Tag="TOEIC">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="TOEIC Test Bank (4)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCatVSTEP" Style="{StaticResource CategoryItemButton}" Click="BtnCategory_Click" Tag="VSTEP">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎓" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="VSTEP B1 - B2 (3)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCatGrammar" Style="{StaticResource CategoryItemButton}" Click="BtnCategory_Click" Tag="Grammar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📘" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ngữ pháp cốt lõi (3)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCatVocab" Style="{StaticResource CategoryItemButton}" Click="BtnCategory_Click" Tag="Vocab">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Từ vựng chuyên ngành (2)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="4,16,4,14"/>

                        <TextBlock Text="ĐỊNH DẠNG TỆP" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="4,0,4,8"/>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="📕 PDF Document: 8 tệp" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                            <TextBlock Text="📝 Word (.docx): 5 tệp" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                            <TextBlock Text="📊 Excel (.xlsx): 3 tệp" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                            <TextBlock Text="🎧 Audio (.mp3): 2 tệp" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= CỘT 2: DANH SÁCH FILE ĐỀ THI ================= -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter & Search in File List -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSearchFile" Text="🔍 Tìm file đề thi..." BorderThickness="0" Background="Transparent" 
                                     FontSize="12.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Đã chọn: 1 file" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Files Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pnlFileList">

                            <!-- File 1: PDF IELTS -->
                            <Border x:Name="itemFile1" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,12" Background="#F0FDF4" Cursor="Hand" MouseDown="FileItem1_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- PDF Icon -->
                                    <Border Grid.Column="0" Background="#FEE2E2" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Text="PDF" FontWeight="Bold" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="IELTS_Reading_Cam18_Test01.pdf" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="1.8 MB • 3 bài đọc • 40 câu hỏi • IELTS 6.5+" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border x:Name="badgeViewing1" Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="7,3" VerticalAlignment="Center">
                                        <TextBlock Text="Đang xem" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- File 2: DOCX TOEIC -->
                            <Border x:Name="itemFile2" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,12" Background="White" Cursor="Hand" MouseDown="FileItem2_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#DBEAFE" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Text="DOC" FontWeight="Bold" FontSize="11" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="TOEIC_Part7_Reading_Drills_2026.docx" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="920 KB • 12 đoạn văn kép • 48 câu hỏi • ETS Format" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border x:Name="badgeViewing2" Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="7,3" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="Đang xem" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- File 3: PDF VSTEP -->
                            <Border x:Name="itemFile3" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,12" Background="White" Cursor="Hand" MouseDown="FileItem3_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#FEE2E2" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Text="PDF" FontWeight="Bold" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="VSTEP_B2_Full_Mock_Test_BộGDĐT.pdf" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="2.4 MB • 4 kỹ năng Nghe-Đọc-Viết-Nói • Format chuẩn" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border x:Name="badgeViewing3" Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="7,3" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="Đang xem" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- File 4: XLSX Flashcard AWL -->
                            <Border x:Name="itemFile4" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,12" Background="White" Cursor="Hand" MouseDown="FileItem4_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#DCFCE7" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Text="XLS" FontWeight="Bold" FontSize="11" Foreground="#166534" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Academic_Vocabulary_AWL_570Words.xlsx" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="620 KB • 570 thẻ Flashcard • Có phiên âm IPA &amp; Ví dụ" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border x:Name="badgeViewing4" Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="7,3" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="Đang xem" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- File 5: MP3 Audio -->
                            <Border x:Name="itemFile5" Padding="14,12" Background="White" Cursor="Hand" MouseDown="FileItem5_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F3E8FF" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Text="MP3" FontWeight="Bold" FontSize="11" Foreground="#7E22CE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="IELTS_Section3_Audio_Transcript.mp3" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="8.4 MB • 12 phút 40 giây • Giọng đọc bản ngữ Anh - Úc" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border x:Name="badgeViewing5" Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="7,3" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="Đang xem" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= CỘT 3: TRÌNH XEM TRƯỚC ĐỀ THI / TÀI LIỆU (PREVIEW PANE) ================= -->
            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="txtPreviewDocTitle" Text="IELTS_Reading_Cam18_Test01.pdf" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtPreviewDocMeta" Text="Định dạng: Adobe PDF • Dung lượng: 1.8 MB • Cập nhật: Hôm nay 10:30" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📥 Tải về" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" Click="BtnDownloadCurrent_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnB" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnB" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="🖨️ In ấn" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="10,6" Cursor="Hand" Click="BtnPrintCurrent_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnB2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnB2" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Document Content Viewer Simulation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel x:Name="pnlDocViewerContent">

                            <!-- Paper Simulation Header -->
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtSimulationModule" Text="ACADEMIC READING MODULE — PRACTICE TEST #01" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource AdminDarkGreen}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="txtSimulationPassage" Text="Reading Passage 1: You should spend about 20 minutes on Questions 1–13." FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Document Heading -->
                            <TextBlock x:Name="txtPassageTitle" Text="The Secrets of Ancient Roman Concrete &amp; Architectural Acoustics" 
                                       FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" TextAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <!-- Reading Text Content -->
                            <TextBlock x:Name="txtPassageBody" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,16">
                                For centuries, researchers have puzzled over how ancient Roman concrete structures such as the Colosseum and the Pantheon have remained structurally sound for over two millennia, often under harsh marine conditions. While modern concrete degrades within decades, Roman pozzolanic concrete demonstrated self-healing properties...
                                <LineBreak/><LineBreak/>
                                In a groundbreaking 2023 study published by MIT and Harvard researchers, analytical electron microscopy revealed that lime clasts within the concrete matrix acted as an active calcium reservoir. When microcracks formed and rainwater infiltrated, the calcium dissolved and recrystallized as calcite, sealing the fractures autonomously.
                            </TextBlock>

                            <!-- Questions Extracted from Document -->
                            <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="📋 Câu hỏi trắc nghiệm đã bóc tách từ tài liệu:" FontWeight="Bold" FontSize="13" Foreground="#166534" Margin="0,0,0,10"/>

                                    <TextBlock Text="Question 1 (True / False / Not Given):" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Roman concrete degrades at the same rate as 20th-century Portland cement." FontSize="12" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="➔ Đáp án chuẩn: FALSE. (Dẫn chứng: 'While modern concrete degrades within decades, Roman concrete demonstrated self-healing properties...')" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <TextBlock Text="Question 2 (Multiple Choice):" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="What chemical element triggers the self-healing process when water enters microcracks?" FontSize="12" Margin="0,2,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="A. Silica  •  B. Calcium (Đúng ✓)  •  C. Magnesium  •  D. Sodium" FontSize="11.5" Foreground="{StaticResource TextDark}" FontWeight="Medium" Margin="0,0,0,4"/>
                                    <TextBlock Text="➔ Giải thích AI: Canxi trong lime clasts hòa tan và kết tinh lại thành canxit (calcite) lấp đầy các vết nứt." FontSize="11" Foreground="#15803D" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Preview Footer Action -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border Background="#DCFCE7" Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="✓" Foreground="#166534" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Trạng thái: Đã kiểm duyệt và sẵn sàng sử dụng" FontSize="12" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="➕ Đưa toàn bộ vào Đề thi thử (Mock Test)" Background="{StaticResource AdminDarkGreen}" Foreground="White" 
                                    FontWeight="SemiBold" FontSize="12" Padding="14,8" BorderThickness="0" Cursor="Hand" Click="BtnAddToExam_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBd" Property="Background" Value="#135E48"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
