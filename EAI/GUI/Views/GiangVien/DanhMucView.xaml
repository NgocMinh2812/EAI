<Page x:Class="GUI.Views.GiangVien.DanhMucView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Danh mục &amp; Cấu trúc Học liệu - Admin Dashboard"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A" />
        <SolidColorBrush x:Key="AdminMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="CategoryItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveCategoryItemButton" TargetType="Button" BasedOn="{StaticResource CategoryItemButton}">
            <Setter Property="Background" Value="#E6F4EA"/>
            <Setter Property="Foreground" Value="{StaticResource AdminDarkGreen}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#E6F4EA" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Vàng Cam Rực Rỡ - Mở Thư Mục (Amber/Orange) -->
        <Style x:Key="AmberHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#EA580C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C2410C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#EA580C"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C2410C"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9A3412"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9A3412"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Tím Xanh Hoàng Gia - Đồng Bộ Kho (Royal Indigo) -->
        <Style x:Key="IndigoHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#4F46E5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Xanh Dương Đại Dương - Tải Lên Tệp (Sky/Ocean Blue) -->
        <Style x:Key="TealHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0369A1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#0284C7"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Ngọc Lục Bảo Tươi - Thư Mục Mới (Fresh Emerald Green) -->
        <Style x:Key="EmeraldHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.3" Color="#059669"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#065F46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#065F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Tím Hoàng Gia Rực Rỡ - Danh Mục Trình Độ (Royal Purple) -->
        <Style x:Key="PurpleHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6D28D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#7C3AED"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5B21B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5B21B6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút Outline Sửa Trình Độ & Bài Học -->
        <Style x:Key="OutlineEditButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AdminDarkGreen}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER (NAV TABS + ACTIONS) ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tiêu đề trang -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <local:LucideIcon Kind="Folder" Size="18" Foreground="{StaticResource AdminDarkGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kho Học Liệu &amp; Danh Mục" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Quản lý cấu trúc cây chủ đề &amp; danh mục trình độ (A1 - C1)" FontSize="11.5" Foreground="{StaticResource TextGray}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Action Buttons for ChuDe -->
            <WrapPanel x:Name="wrapChuDeActions" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource EmeraldHeaderBtn}" Click="BtnNewFolder_Click" Margin="0,0,10,0" ToolTip="Tạo danh mục thư mục bài học mới trong cây phân cấp">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:LucideIcon Kind="FolderPlus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Thư Mục Mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TealHeaderBtn}" Click="BtnUploadFile_Click" Margin="0,0,10,0" ToolTip="Tải lên tệp đề thi hoặc tài liệu học liệu vào thư mục đang chọn (.docx, .pdf, .txt)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:LucideIcon Kind="Upload" Size="14" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Tải Lên Tệp" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnTabTrinhDo" Style="{StaticResource PurpleHeaderBtn}" Click="BtnTabTrinhDo_Click" ToolTip="Quản lý danh mục khung năng lực trình độ chuẩn CEFR (A1 - C1)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:LucideIcon Kind="Tag" Size="14" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Danh Mục Trình Độ (A1 - C1)" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Action Buttons for TrinhDo (US-GV04) -->
            <WrapPanel x:Name="wrapTrinhDoActions" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                <Button Style="{StaticResource TealHeaderBtn}" Click="BtnTabCayChuDe_Click" Margin="0,0,10,0" ToolTip="Quay lại cây cấu trúc chủ đề học liệu">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:LucideIcon Kind="ArrowLeft" Size="14" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Cây Cấu Trúc Chủ Đề" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EmeraldHeaderBtn}" Click="BtnThemTrinhDo_Click" ToolTip="Tạo trình độ chuẩn CEFR mới">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:LucideIcon Kind="Plus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Thêm Trình Độ" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- ================= TAB 1: 3-COLUMN EXPLORER & PREVIEWER ================= -->
        <Grid x:Name="pnlTabCayChuDe" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột 1: Cây thư mục (Default 270px, Min 180, Max 450) -->
                <ColumnDefinition Width="270" MinWidth="180" MaxWidth="450"/>
                <!-- Splitter 1 -->
                <ColumnDefinition Width="10"/>
                <!-- Cột 2: Danh sách file / bài học (Flexible, Min 220) -->
                <ColumnDefinition Width="330" MinWidth="220"/>
                <!-- Splitter 2 -->
                <ColumnDefinition Width="10"/>
                <!-- Cột 3: Live Document Preview Pane (Flexible, Min 300) -->
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT 1: CÂY DANH MỤC ĐỘNG ================= -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CÂY PHÂN CẤP CHỦ ĐỀ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" Margin="4,4,4,8"/>

                    <!-- Toolbar Thêm / Sửa / Xóa Chủ đề với màu sắc phân biệt -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="4" Margin="0,0,0,10" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Background="#ECFDF5" Foreground="#047857" BorderBrush="#10B981" BorderThickness="1.5"
                                    FontSize="11.5" FontWeight="SemiBold" Padding="4,6" Margin="2,0" Cursor="Hand" Click="BtnThemChuDe_Click" ToolTip="Thêm chủ đề mới">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tb1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Plus" Size="12" Foreground="#047857" Margin="0,0,4,0"/>
                                                <TextBlock Text="Thêm"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb1" Property="Background" Value="#A7F3D0"/>
                                                <Setter TargetName="tb1" Property="BorderBrush" Value="#059669"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="1" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#3B82F6" BorderThickness="1.5"
                                    FontSize="11.5" FontWeight="SemiBold" Padding="4,6" Margin="2,0" Cursor="Hand" Click="BtnSuaChuDe_Click" ToolTip="Sửa chủ đề đang chọn">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tb2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Pencil" Size="12" Foreground="#1D4ED8" Margin="0,0,4,0"/>
                                                <TextBlock Text="Sửa"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb2" Property="Background" Value="#BFDBFE"/>
                                                <Setter TargetName="tb2" Property="BorderBrush" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#EF4444" BorderThickness="1.5"
                                    FontSize="11.5" FontWeight="SemiBold" Padding="4,6" Margin="2,0" Cursor="Hand" Click="BtnXoaChuDe_Click" ToolTip="Xóa chủ đề đang chọn">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tb3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Trash2" Size="12" Foreground="#DC2626" Margin="0,0,4,0"/>
                                                <TextBlock Text="Xóa"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb3" Property="Background" Value="#FECACA"/>
                                                <Setter TargetName="tb3" Property="BorderBrush" Value="#B91C1C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- WPF TreeView Động liên kết CSDL -->
                    <TreeView x:Name="tvDanhMuc" Grid.Row="2" BorderThickness="0" Background="Transparent" 
                              SelectedItemChanged="TvDanhMuc_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="2,3"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextDark}" 
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding BadgeText}" FontSize="11" Foreground="{StaticResource TextGray}" 
                                               Margin="6,0,4,0" VerticalAlignment="Center" FontWeight="Normal"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ================= THANH KÉO GIÃN 1 (GIỮA CỘT 1 VÀ 2) ================= -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Width="10">
                            <Border x:Name="splBorder" Width="2" HorizontalAlignment="Center" Background="#CBD5E1" CornerRadius="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="splBorder" Property="Background" Value="{StaticResource AdminDarkGreen}"/>
                                <Setter TargetName="splBorder" Property="Width" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================= CỘT 2: DANH SÁCH FILE ĐỀ THI ================= -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter & Search in File List -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:LucideIcon Grid.Column="0" Kind="Search" Size="14" Foreground="{StaticResource TextGray}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSearchFile" Grid.Column="1" Text="Tìm bài học / đề thi..." BorderThickness="0" Background="Transparent" 
                                     FontSize="12.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"
                                     GotFocus="TxtSearchFile_GotFocus" LostFocus="TxtSearchFile_LostFocus" 
                                     TextChanged="TxtSearchFile_TextChanged" KeyDown="TxtSearchFile_KeyDown"/>
                            <TextBlock x:Name="txtLessonCounter" Grid.Column="2" Text="4 bài học" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Toolbar 2 Nút: Di Chuyển & Xóa Tệp Trong Cột Bài Học / Đề Thi -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nút Di Chuyển Thư Mục -->
                            <Button Grid.Column="0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#3B82F6" BorderThickness="1.5"
                                    FontSize="11.5" FontWeight="SemiBold" Padding="4,6" Cursor="Hand" Click="BtnMoveSelectedLesson_Click" ToolTip="Di chuyển bài học / đề thi đang chọn sang thư mục khác">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdMove" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="FolderOpen" Size="12" Foreground="#1D4ED8" Margin="0,0,4,0"/>
                                                <TextBlock Text="Di chuyển"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdMove" Property="Background" Value="#DBEAFE"/>
                                                <Setter TargetName="bdMove" Property="BorderBrush" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nút Xóa File -->
                            <Button Grid.Column="2" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#EF4444" BorderThickness="1.5"
                                    FontSize="11.5" FontWeight="SemiBold" Padding="4,6" Cursor="Hand" Click="BtnDeleteSelectedLesson_Click" ToolTip="Xóa vĩnh viễn bài học / tệp học liệu đang chọn">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdDel" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Trash2" Size="12" Foreground="#DC2626" Margin="0,0,4,0"/>
                                                <TextBlock Text="Xóa file"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdDel" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="bdDel" Property="BorderBrush" Value="#B91C1C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Lessons / Materials Items from Database -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty State Notice -->
                            <TextBlock x:Name="txtEmptyNotice" Text="Chưa có bài học nào trong chủ đề này." 
                                       FontStyle="Italic" Foreground="{StaticResource TextGray}" Margin="20" HorizontalAlignment="Center" Visibility="Collapsed"/>

                            <!-- Real Lessons List -->
                            <ItemsControl x:Name="icLessonList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,3" Padding="12,10" CornerRadius="8" Cursor="Hand" MouseDown="LessonItem_Click" Tag="{Binding MaBaiHoc}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#F0FDF9"/>
                                                            <Setter Property="BorderBrush" Value="#0F766E"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Skill Icon Badge -->
                                                <Border Grid.Column="0" Background="{Binding BadgeBackground}" Width="38" Height="38" CornerRadius="8" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding IconSkill}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TieuDe}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TomTat}" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,3"/>
                                                    
                                                    <!-- Meta Info: Format Badge (.docx, .pdf) & Size -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{Binding BadgeDinhDangBg}" BorderBrush="{Binding BadgeDinhDangBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding DinhDangTep}" Foreground="{Binding BadgeDinhDangFg}" FontSize="9.5" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding DungLuongHienThi}" FontSize="10.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" • " FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ThoiGianUocTinhPhut, StringFormat='{}{0} phút'}" FontSize="10.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right Badges & Direct Action Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Border Background="{Binding StatusBackground}" CornerRadius="6" Padding="7,3" HorizontalAlignment="Right" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding TrangThai}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Width="24" Height="24" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" 
                                                                Margin="0,0,4,0" Cursor="Hand" ToolTip="Di chuyển bài học này sang thư mục khác" 
                                                                Tag="{Binding MaBaiHoc}" Click="BtnItemMove_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                                        <local:LucideIcon Kind="FolderOpen" Size="12" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Background" Value="#DBEAFE"/>
                                                                            <Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <Button Width="24" Height="24" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                                                                Cursor="Hand" ToolTip="Xóa bài học này" 
                                                                Tag="{Binding MaBaiHoc}" Click="BtnItemDelete_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                                        <local:LucideIcon Kind="Trash2" Size="12" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="Background" Value="#FEE2E2"/>
                                                                            <Setter TargetName="b" Property="BorderBrush" Value="#B91C1C"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= THANH KÉO GIÃN 2 (GIỮA CỘT 2 VÀ 3) ================= -->
            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Width="10">
                            <Border x:Name="splBorder" Width="2" HorizontalAlignment="Center" Background="#CBD5E1" CornerRadius="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="splBorder" Property="Background" Value="{StaticResource AdminDarkGreen}"/>
                                <Setter TargetName="splBorder" Property="Width" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================= CỘT 3: TRÌNH XEM TRƯỚC ĐỀ THI / TÀI LIỆU (PREVIEW PANE) ================= -->
            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="txtPreviewDocTitle" Text="IELTS_Reading_Cam18_Test01.pdf" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtPreviewDocMeta" Text="Định dạng: Adobe PDF • Dung lượng: 1.8 MB • Cập nhật: Hôm nay 10:30" FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Background="#EFF6FF" BorderBrush="#3B82F6" Foreground="#1D4ED8" BorderThickness="1.5" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnDownloadCurrent_Click" ToolTip="Tải xuống tệp học liệu về máy">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnB" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Download" Size="13" Foreground="#1D4ED8" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Tải về"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnB" Property="Background" Value="#DBEAFE"/>
                                                    <Setter TargetName="btnB" Property="BorderBrush" Value="#2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#334155" BorderThickness="1.5" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnOpenFileExternal_Click" ToolTip="Mở trực tiếp bằng phần mềm mặc định (Word, Adobe Reader, v.v.)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnExt" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="ExternalLink" Size="13" Foreground="#334155" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Mở tệp"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnExt" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Background="#FAF5FF" BorderBrush="#A855F7" Foreground="#7E22CE" BorderThickness="1.5" 
                                        FontSize="11.5" FontWeight="SemiBold" Padding="10,6" Cursor="Hand" Click="BtnPrintCurrent_Click" ToolTip="In đề thi / học liệu">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnB2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Printer" Size="13" Foreground="#7E22CE" Margin="0,0,5,0"/>
                                                    <TextBlock Text="In ấn"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnB2" Property="Background" Value="#EDE9FE"/>
                                                    <Setter TargetName="btnB2" Property="BorderBrush" Value="#9333EA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Document Content Viewer (Trình xem trước tệp tài liệu chuẩn File Explorer) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
                        <StackPanel x:Name="pnlDocViewerContent">

                            <!-- Paper Simulation Document Card -->
                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="26,24" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.05" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Document Meta Pill -->
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,14" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="FileText" Size="13" Foreground="{StaticResource AdminDarkGreen}" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="txtSimulationModule" Text="HỌC LIỆU — TRÌNH ĐỘ B1" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AdminDarkGreen}"/>
                                            <TextBlock Text=" • " Foreground="#94A3B8" Margin="4,0"/>
                                            <TextBlock x:Name="txtSimulationPassage" Text="Xem trước nội dung tệp" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Document Heading -->
                                    <TextBlock x:Name="txtPassageTitle" Text="Tiêu đề học liệu" 
                                               FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <Border Height="1" Background="#E2E8F0" Margin="0,0,0,14"/>

                                    <!-- Reading Text Content from File -->
                                    <TextBlock x:Name="txtPassageBody" TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="#1E293B">
                                        Nội dung tệp văn bản sẽ được hiển thị tại đây...
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ================= PHẦN CÂU HỎI TRẮC NGHIỆM AI ================= -->
                            
                            <!-- Trạng thái 1: Chưa bấm tạo câu hỏi -> Hiển thị hộp mời bấm tạo gọn gàng -->
                            <Border x:Name="pnlAIGeneratePrompt" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.2" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#DCFCE7" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="Sparkles" Size="16" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="Tạo câu hỏi trắc nghiệm bằng AI từ tài liệu" FontWeight="SemiBold" FontSize="12.5" Foreground="#15803D"/>
                                        <TextBlock Text="Google Gemini sẽ phân tích nội dung tệp văn bản để tự động tạo câu hỏi trắc nghiệm." 
                                                   FontSize="11" Foreground="#166534" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button x:Name="btnGenerateAIQuestions" Grid.Column="2" Background="#059669" Foreground="White" BorderThickness="0"
                                            Padding="12,6" Cursor="Hand" Click="BtnReExtractAI_Click" ToolTip="Phân tích văn bản và tạo câu hỏi trắc nghiệm" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bgen" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Color="#059669"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <local:LucideIcon Kind="Sparkles" Size="13" Foreground="White" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Tạo câu hỏi AI" FontWeight="SemiBold" FontSize="11.5"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bgen" Property="Background" Value="#047857"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Loading Progress Bar -->
                            <ProgressBar x:Name="pbAILoading" Height="4" IsIndeterminate="True" Margin="0,0,0,12" Visibility="Collapsed" Foreground="#10B981" Background="#DCFCE7"/>

                            <!-- Trạng thái 2: Đã tạo câu hỏi -> Hiển thị danh sách câu hỏi trắc nghiệm -->
                            <Border x:Name="pnlExtractedQuestionsBox" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="10" Padding="16,14" Margin="0,0,0,16" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Bot" Size="17" Foreground="#15803D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Câu hỏi trắc nghiệm đã bóc tách từ tài liệu" FontWeight="Bold" FontSize="13" Foreground="#15803D" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Nút Bóc tách lại bằng Gemini 3.8 Flash -->
                                        <Button x:Name="btnReExtractAI" Grid.Column="1" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" BorderThickness="1"
                                                FontSize="11" FontWeight="SemiBold" Padding="10,5" Cursor="Hand" Click="BtnReExtractAI_Click" ToolTip="Kích hoạt Gemini AI phân tích lại văn bản và sinh câu hỏi mới">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdBtn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <local:LucideIcon Kind="Sparkles" Size="12" Foreground="#166534" Margin="0,0,5,0"/>
                                                            <TextBlock Text="Bóc tách lại bằng AI"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bdBtn" Property="Background" Value="#BBF7D0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Dynamic Questions List -->
                                    <ItemsControl x:Name="icExtractedQuestions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding NoiDungCauHoi}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                                        <ItemsControl ItemsSource="{Binding DanhSachLuaChon}" Margin="0,6,0,6">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#334155" Margin="4,2,0,2" TextWrapping="Wrap"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border Background="#F0FDF4" CornerRadius="6" Padding="8,5" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding GiaiThichChiTiet}" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Preview Footer Action -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Dynamic Status Badge & Info -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border x:Name="bdPreviewStatusIcon" Background="#DCFCE7" Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <local:LucideIcon x:Name="icoPreviewStatus" Kind="Check" Size="11" StrokeThickness="2.5" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="bdPreviewStatusPill" Background="#DCFCE7" CornerRadius="6" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtPreviewStatusPill" Text="Đã xuất bản" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                </Border>
                            </StackPanel>

                            <!-- Quick Action Button -->
                            <Button Grid.Column="1" Background="#059669" Foreground="White" 
                                    FontWeight="Bold" FontSize="12" Padding="14,8" BorderThickness="0" Cursor="Hand" Click="BtnAddToExam_Click"
                                    ToolTip="Tạo đề thi thử tự động từ bài học này">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.25" Color="#059669"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Plus" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                                <TextBlock Text="Đưa vào Đề thi thử" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBd" Property="Background" Value="#047857"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBd" Property="Background" Value="#065F46"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- ================= TAB 2: DANH MỤC TRÌNH ĐỘ (A1 - C1) - US-GV04 ================= -->
        <Grid x:Name="pnlTabTrinhDo" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Info Banner -->
            <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="KHUNG NĂNG LỰC NGOẠI NGỮ CHUẨN QUỐC TẾ (CEFR A1 - C1)" FontWeight="Bold" FontSize="14" Foreground="#166534"/>
                        <TextBlock Text="Hệ thống quy chuẩn cấp độ tiếng Anh theo khung tham chiếu châu Âu CEFR và quy đổi điểm tương đương TOEIC, IELTS." FontSize="12" Foreground="#15803D" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="White" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock x:Name="txtTongSoTrinhDo" Text="6 Cấp độ tiêu chuẩn" FontWeight="Bold" FontSize="12.5" Foreground="#166534"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Cards Container for Levels -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icTrinhDoList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" 
                                    Width="360" Margin="0,0,16,16" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="Black"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Level Badge & Code -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding BadgeBg}" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding MaCapDo}" FontWeight="Bold" FontSize="16" Foreground="{Binding BadgeFg}"/>
                                            </Border>
                                            <TextBlock Text="{Binding TenTrinhDo}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding MoTa}" FontSize="12.5" Foreground="{StaticResource TextGray}" 
                                               TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18" MinHeight="40"/>

                                    <!-- Equivalents and Stats -->
                                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,0,0,14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="IELTS tương đương:" FontSize="10.5" Foreground="{StaticResource TextGray}"/>
                                                <TextBlock Text="{Binding IeltsTuongDuong}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                                                <TextBlock Text="{Binding SoLuongBaiHoc, StringFormat='📚 {0} bài học'}" FontSize="11" Foreground="#059669" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="TOEIC tương đương:" FontSize="10.5" Foreground="{StaticResource TextGray}"/>
                                                <TextBlock Text="{Binding ToeicTuongDuong}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                                                <TextBlock Text="{Binding SoLuongCauHoi, StringFormat='❓ {0} câu hỏi'}" FontSize="11" Foreground="#2563EB" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Actions: Edit / Delete -->
                                    <Grid Grid.Row="3">
                                        <Button Content="✏️ Chỉnh sửa" Style="{StaticResource OutlineEditButton}" HorizontalAlignment="Left" Click="BtnSuaTrinhDo_Click" Tag="{Binding MaTrinhDo}"/>
                                        <Button Content="🗑️ Xóa" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1"
                                                FontSize="11.5" FontWeight="SemiBold" Padding="10,5" Cursor="Hand" HorizontalAlignment="Right" Click="BtnXoaTrinhDo_Click" Tag="{Binding MaTrinhDo}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
