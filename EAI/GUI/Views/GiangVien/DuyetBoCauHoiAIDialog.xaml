<Window x:Class="GUI.Views.GiangVien.DuyetBoCauHoiAIDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        xmlns:vm="clr-namespace:GUI.ViewModels.GiangVien"
        xmlns:conv="clr-namespace:GUI.ViewModels.Common"
        Title="Xem &amp; Duyệt Bộ Câu Hỏi AI"
        Icon="pack://application:,,,/GUI;component/Assets/app_icon.ico"
        Height="700" Width="1020"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConverter"/>
        <conv:InverseBooleanConverter x:Key="InvBoolConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVisConverter"/>
        <conv:BooleanToSuccessErrorForegroundConverter x:Key="BoolToSuccessErrorFgConverter"/>

        <SolidColorBrush x:Key="AdminDarkGreen" Color="#0F4C3A"/>
        <SolidColorBrush x:Key="AdminMint" Color="#10B981"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextGray" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>

        <!-- Style Thanh trượt tua Audio Timeline -->
        <Style x:Key="ModernAudioSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <!-- Đường ray nền -->
                            <Border Height="4" Background="#E2E8F0" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#10B981" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="12" Height="12" Background="#10B981" BorderBrush="White" BorderThickness="2" CornerRadius="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#0F172A"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <!-- Lớp đổ bóng độc lập phía sau -->
        <Border CornerRadius="16" Background="#0F172A">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#0F172A"/>
            </Border.Effect>
        </Border>

        <!-- Khung nội dung hộp thoại (Không có Effect -> Render Vector & ClearType sắc nét 100%) -->
        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16">
            <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#EEF2FF" CornerRadius="8" Padding="7,7" Margin="0,0,10,0">
                            <local:LucideIcon Kind="Sparkles" Size="18" Foreground="#6366F1"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Xem &amp; Quản Lý Bộ Câu Hỏi AI" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Kiểm tra, chỉnh sửa và chọn lọc câu hỏi trước khi lưu thành bộ trong Ngân hàng câu hỏi" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnDong_Click" Background="#F1F5F9" BorderThickness="0" Width="32" Height="32" Cursor="Hand" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                <local:LucideIcon Kind="X" Size="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Set Metadata Bar -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Tên bộ câu hỏi:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1" Text="{Binding TenBoCauHoi, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"
                             Padding="10,6" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderLight}">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Kind="BookOpen" Size="12" Foreground="#2563EB" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TenNguon}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="{Binding NguonTao}" FontSize="11.5" FontWeight="Bold" Foreground="#15803D"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main Split View: Left List, Right Inspector -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: QUESTIONS LIST -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="12,12,3,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Selection actions -->
                        <Grid Grid.Row="0" Margin="0,0,9,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Chọn tất cả" Command="{Binding ChonTatCaCommand}" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBlock Text="•" Foreground="{StaticResource TextGray}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button Content="Bỏ chọn" Command="{Binding BoChonTatCaCommand}" Background="Transparent" Foreground="{StaticResource TextGray}" BorderThickness="0" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ThongKeChonText}" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button Command="{Binding ThemCauHoiCommand}" Background="#DCFCE7" Foreground="#15803D" BorderThickness="0" Padding="8,4" Cursor="Hand" ToolTip="Thêm câu hỏi mới vào bộ nháp">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:LucideIcon Kind="Plus" Size="11" Foreground="#15803D" Margin="0,0,3,0"/>
                                                    <TextBlock Text="Thêm" FontSize="11.5" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- List of Questions -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding DanhSachCauHoi}" SelectedItem="{Binding SelectedCauHoi, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 Padding="0,0,8,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="1,1,2,11"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bdItem" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10"
                                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bdItem" Property="Background" Value="#F0FDF4"/>
                                                        <Setter TargetName="bdItem" Property="BorderBrush" Value="#10B981"/>
                                                        <Setter TargetName="bdItem" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdItem" Property="BorderBrush" Value="#94A3B8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                  Click="ChkBaiHoc_Click"/>

                                        <!-- Question summary -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding ThuTuCauHoi, StringFormat='Câu {0}'}" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                                </Border>
                                                <Border Background="#EFF6FF" CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding KyNangHienThi}" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                                </Border>
                                                <Border Background="#F3E8FF" CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding LoaiCauHoiHienThi}" FontSize="10.5" FontWeight="SemiBold" Foreground="#7E22CE"/>
                                                </Border>
                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1.5">
                                                    <TextBlock Text="{Binding DoKhoHienThi}" FontSize="10.5" FontWeight="SemiBold" Foreground="#D97706"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding NoiDungCauHoi}" FontSize="12.5" Foreground="{StaticResource TextDark}" 
                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding DanhSachLuaChon.Count, StringFormat='{}{0} lựa chọn'}" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Delete draft button -->
                                        <Button Grid.Column="2" Command="{Binding DataContext.XoaCauHoiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="4,0,0,0" ToolTip="Xóa câu hỏi khỏi bản nháp">
                                            <local:LucideIcon Kind="Trash2" Size="13" Foreground="#94A3B8"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- RIGHT PANE: QUESTION INSPECTOR & EDITOR -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid>
                        <!-- No selection empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelectedCauHoi, Converter={StaticResource InvBoolToVisConverter}}">
                            <local:LucideIcon Kind="HelpCircle" Size="42" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Vui lòng chọn một câu hỏi ở danh sách bên trái để xem và chỉnh sửa" FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Selected question editor -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0"
                                      Visibility="{Binding HasSelectedCauHoi, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="CHI TIẾT CÂU HỎI #" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="{Binding SelectedCauHoi.ThuTuCauHoi}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AdminMint}"/>
                                    </StackPanel>

                                    <CheckBox Grid.Column="1" Content="Bao gồm câu hỏi này trong bộ" IsChecked="{Binding SelectedCauHoi.IsSelected, Mode=TwoWay}"
                                              FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"
                                              Click="ChkBaiHoc_Click"/>
                                </Grid>

                                <!-- Question Content -->
                                <TextBlock Text="Nội dung câu hỏi:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedCauHoi.NoiDungCauHoi, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                                         Padding="10,8" FontSize="12.5" BorderBrush="{StaticResource BorderLight}" Margin="0,0,0,12">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <!-- Attributes Row -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Kỹ năng:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding SelectedCauHoi.KyNang, Mode=TwoWay}" SelectedValuePath="Tag" Padding="6,6">
                                            <ComboBoxItem Content="Đọc hiểu" Tag="Doc"/>
                                            <ComboBoxItem Content="Nghe hiểu" Tag="Nghe"/>
                                            <ComboBoxItem Content="Ngữ pháp" Tag="NguPhap"/>
                                            <ComboBoxItem Content="Từ vựng" Tag="TuVung"/>
                                            <ComboBoxItem Content="Viết" Tag="Viet"/>
                                            <ComboBoxItem Content="Nói" Tag="Noi"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Dạng câu hỏi:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding SelectedCauHoi.LoaiCauHoi, Mode=TwoWay}" SelectedValuePath="Tag" Padding="6,6">
                                            <ComboBoxItem Content="Trắc nghiệm" Tag="TracNghiem"/>
                                            <ComboBoxItem Content="Đúng / Sai" Tag="DungSai"/>
                                            <ComboBoxItem Content="True / False / Not Given" Tag="TrueFalseNotGiven"/>
                                            <ComboBoxItem Content="Điền khuyết" Tag="DienKhuyet"/>
                                            <ComboBoxItem Content="Trả lời ngắn" Tag="TraLoiNgan"/>
                                            <ComboBoxItem Content="Nối cặp" Tag="NoiCap"/>
                                            <ComboBoxItem Content="Sắp xếp" Tag="SapXep"/>
                                            <ComboBoxItem Content="Sửa lỗi sai" Tag="SuaLoiSai"/>
                                            <ComboBoxItem Content="Viết lại câu" Tag="VietLaiCau"/>
                                            <ComboBoxItem Content="Viết tự luận" Tag="TuLuan"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Độ khó:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding SelectedCauHoi.DoKho, Mode=TwoWay}" SelectedValuePath="Tag" Padding="6,6">
                                            <ComboBoxItem Content="Dễ" Tag="De"/>
                                            <ComboBoxItem Content="Trung bình" Tag="TrungBinh"/>
                                            <ComboBoxItem Content="Khó" Tag="Kho"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Trình độ:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding SelectedCauHoi.MaTrinhDo, Mode=TwoWay}" SelectedValuePath="Tag" Padding="6,6">
                                            <ComboBoxItem Content="A1" Tag="A1"/>
                                            <ComboBoxItem Content="A2" Tag="A2"/>
                                            <ComboBoxItem Content="B1" Tag="B1"/>
                                            <ComboBoxItem Content="B2" Tag="B2"/>
                                            <ComboBoxItem Content="C1" Tag="C1"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Audio Player cho câu hỏi kỹ năng Nghe -->
                                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.2" CornerRadius="10" Padding="12,10" Margin="0,0,0,14"
                                        Visibility="{Binding SelectedCauHoi.IsKyNangNghe, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header audio -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Headphones" Size="15" Foreground="#15803D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ÂM THANH BÀI NGHE (AUDIO)" FontWeight="Bold" FontSize="11.5" Foreground="#15803D" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Command="{Binding ChonAudioCommand}" Background="White" BorderBrush="#86EFAC" BorderThickness="1" Padding="10,4" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="Upload" Size="12" Foreground="#15803D" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Đổi file Audio" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- Audio controls & path info -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Play / Pause Button -->
                                            <Button Grid.Column="0" Command="{Binding TogglePlayAudioCommand}"
                                                    Background="#15803D" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand" Margin="0,0,10,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon x:Name="icoAudioPlay" Kind="Play" Size="13" Foreground="White" Margin="0,0,5,0"/>
                                                                <TextBlock x:Name="txtAudioPlay" Text="Nghe thử" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                <Setter TargetName="icoAudioPlay" Property="Kind" Value="Pause"/>
                                                                <Setter TargetName="txtAudioPlay" Property="Text" Value="Tạm dừng"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Thanh tiến trình Audio nhỏ gọn (Compact Seekable Audio Timeline) -->
                                            <Border Grid.Column="1" Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                                                    ToolTip="{Binding SelectedCauHoi.AudioPath, TargetNullValue='Chưa gán tệp âm thanh cho câu hỏi này'}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Thời gian đã phát -->
                                                    <TextBlock Grid.Column="0" Text="{Binding AudioCurrentTimeText}" 
                                                               FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" 
                                                               VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Thời gian đã phát"/>

                                                    <!-- Thanh kéo tua timeline audio -->
                                                    <Slider x:Name="sldAudioTimeline" Grid.Column="1" 
                                                            Style="{StaticResource ModernAudioSliderStyle}"
                                                            Minimum="0" Maximum="{Binding AudioTotalSeconds}"
                                                            Value="{Binding AudioCurrentSeconds, Mode=TwoWay}"
                                                            IsMoveToPointEnabled="True"
                                                            VerticalAlignment="Center"
                                                            PreviewMouseDown="SldAudioTimeline_PreviewMouseDown"
                                                            PreviewMouseUp="SldAudioTimeline_PreviewMouseUp"
                                                            ToolTip="Kéo hoặc bấm vào thanh để tua audio"/>

                                                    <!-- Tổng thời lượng -->
                                                    <TextBlock Grid.Column="2" Text="{Binding AudioTotalTimeText}" 
                                                               FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" 
                                                               VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Tổng thời lượng audio"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Đoạn văn đọc hiểu / Ngữ cảnh (chỉ hiện khi không phải kỹ năng nghe) -->
                                <StackPanel Visibility="{Binding SelectedCauHoi.IsKyNangNghe, Converter={StaticResource InvBoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <local:LucideIcon Kind="BookOpen" Size="13" Foreground="#2563EB" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đoạn văn đọc hiểu / Ngữ cảnh:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding SelectedCauHoi.DoanVanDoc, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                                             Padding="8,6" FontSize="12" BorderBrush="{StaticResource BorderLight}" Margin="0,0,0,12">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>

                                <!-- Options Header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Các phương án trả lời (chọn nút tròn để đánh dấu đáp án đúng):" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding ThemDapAnCommand}" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Padding="8,4" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:LucideIcon Kind="Plus" Size="11" Foreground="#334155" Margin="0,0,3,0"/>
                                                        <TextBlock Text="Thêm phương án" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Options List -->
                                <ItemsControl ItemsSource="{Binding SelectedCauHoi.DanhSachLuaChon}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Radio correct answer -->
                                                    <RadioButton Grid.Column="0" IsChecked="{Binding LaDapAnDung, Mode=TwoWay}"
                                                                 Command="{Binding DataContext.ChonDapAnDungCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 CommandParameter="{Binding}"
                                                                 GroupName="DapAnDungGroup" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                 ToolTip="Đánh dấu đây là đáp án đúng"/>

                                                    <!-- Key badge (A, B, C, D) -->
                                                    <Border Grid.Column="1" Background="#0F4C3A" CornerRadius="4" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KyHieuLuaChon}" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Option Content TextBox -->
                                                    <TextBox Grid.Column="2" Text="{Binding NoiDungLuaChon, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12.5" Padding="6,4" VerticalAlignment="Center" BorderBrush="#CBD5E1">
                                                        <TextBox.Resources>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </TextBox.Resources>
                                                    </TextBox>

                                                    <!-- Delete option button -->
                                                    <Button Grid.Column="3" Command="{Binding DataContext.XoaDapAnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <local:LucideIcon Kind="X" Size="13" Foreground="#94A3B8"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Explanation -->
                                <TextBlock Text="Lời giải thích chi tiết &amp; dẫn chứng:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedCauHoi.GiaiThichDapAn, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto"
                                         Padding="8,6" FontSize="12" BorderBrush="{StaticResource BorderLight}">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. Footer & Actions -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status message -->
                <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                        Visibility="{Binding ThongBao, Converter={StaticResource StrNotEmptyToVisConverter}}">
                    <TextBlock Text="{Binding ThongBao}" FontSize="12.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="{Binding IsSuccess, Converter={StaticResource BoolToSuccessErrorFgConverter}}"/>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Đóng" Click="BtnDong_Click" Background="#F1F5F9" Foreground="{StaticResource TextDark}"
                            Padding="18,9" FontWeight="SemiBold" FontSize="12.5" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding LuuVaoNganHangCommand}"
                            IsEnabled="{Binding DaLuuThanhCong, Converter={StaticResource InvBoolConverter}}"
                            Background="{StaticResource AdminDarkGreen}" Foreground="White"
                            Padding="20,9" FontWeight="Bold" FontSize="12.5" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="Check" Size="14" Foreground="White" Margin="0,0,6,0"/>
                                        <TextBlock Text="Lưu vào Ngân hàng câu hỏi" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
