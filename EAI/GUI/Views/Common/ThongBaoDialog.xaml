<Window x:Class="GUI.Views.Common.ThongBaoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Thông báo"
        Icon="/Assets/app_icon.ico"
        Width="448" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Nút bấm phẳng hiện đại -->
        <Style x:Key="DialogBtnBase" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <!-- Khối thẻ nổi xanh ngọc dịu đổ bóng viền ngọc bích -->
    <Border Background="#F2F9F7" CornerRadius="18" BorderBrush="#5EEAD4" BorderThickness="1.5" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.25" Color="#042F2E"/>
        </Border.Effect>

        <Grid Margin="24,18,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Close Icon Button -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="14">
                            <local:LucideIcon Kind="X" Size="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Icon Header + Badge -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,14">
                <Border x:Name="borderIconBadge" Width="64" Height="64" CornerRadius="32" Background="#FEF3C7" HorizontalAlignment="Center">
                    <local:LucideIcon x:Name="icoSymbol" Kind="AlertTriangle" Size="30" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Title & Message Text -->
            <StackPanel Grid.Row="2" Margin="0,0,0,22">
                <TextBlock x:Name="txtTitle" Text="Xác nhận thao tác" FontWeight="Bold" FontSize="17.5" 
                           Foreground="#064E3B" TextAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtMessage" Text="Bạn có chắc chắn muốn thực hiện hành động này?" 
                           FontSize="13.5" Foreground="#334155" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>

            <!-- Bottom Actions Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nút Hủy (Hiện khi Confirm) -->
                <Button x:Name="btnCancel" Grid.Column="0" Content="Hủy bỏ" Style="{StaticResource DialogBtnBase}" 
                        Background="White" Foreground="#475569" Margin="0,0,8,0" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Nút Đồng ý / Xác nhận / OK -->
                <Button x:Name="btnConfirm" Grid.Column="2" Content="Xác nhận" Style="{StaticResource DialogBtnBase}" 
                        Background="#0F766E" Foreground="White" Margin="8,0,0,0" Click="BtnConfirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
