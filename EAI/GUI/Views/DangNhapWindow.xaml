<Window x:Class="GUI.Views.DangNhapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GUI"
        Title="Đăng nhập - EnglishAI" 
        Icon="/Assets/app_icon.ico"
        Height="670" Width="1050"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Color Palette (Nâng cao độ tương phản & độ sắc nét hiển thị) -->
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="BrandMintSoft" Color="#A7F3D0" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#475569" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#CBD5E1" />

        <!-- Nút Chính Gradient với Bóng Đổ Tách Rời (Không làm mờ Text) -->
        <Style x:Key="PrimaryGradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Lớp bóng đổ độc lập phía sau -->
                            <Border CornerRadius="10" Background="#0F766E">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.32" Color="#042F2E"/>
                                </Border.Effect>
                            </Border>
                            <!-- Lớp nội dung nút (không có Effect -> Text sắc nét 100%) -->
                            <Border x:Name="btnBorder" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0D9488" Offset="0"/>
                                        <GradientStop Color="#0F766E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.93"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- LỚP ĐỔ BÓNG CỬA SỔ ĐỘC LẬP (Tách rời khỏi cây hiển thị để KHÔNG làm mờ hay rasterize text) -->
        <Border Margin="22" CornerRadius="24" Background="#064E3B">
            <Border.Effect>
                <DropShadowEffect BlurRadius="38" ShadowDepth="10" Opacity="0.45" Color="#021C1B"/>
            </Border.Effect>
        </Border>

        <!-- CONTAINER NỘI DUNG CHÍNH (KHÔNG CÓ Effect -> Render ClearType sắc nét) -->
        <Border Margin="22" CornerRadius="24" BorderBrush="#35A7F3D0" BorderThickness="1" ClipToBounds="True">
            <!-- Nền Gradient Aurora với chiều sâu -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#064E3B" Offset="0"/>
                    <GradientStop Color="#0F766E" Offset="0.5"/>
                    <GradientStop Color="#042F2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid ClipToBounds="True">
                <!-- Hiệu ứng Glow Circles tạo chiều sâu không gian (Ambient Glow Orbs) -->
                <Ellipse Width="340" Height="340" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-120" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2510B981" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.85"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-80,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2014B8A6" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.85"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- ================= NÚT ĐIỀU KHIỂN CỬA SỔ (WINDOW CONTROLS GÓC PHẢI TRÊN) ================= -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0" Panel.ZIndex="100">
                    <!-- Nút Thu Nhỏ (-) -->
                    <Button x:Name="btnMinimize" Width="30" Height="30" Cursor="Hand" Click="MinimizeButton_Click" ToolTip="Thu nhỏ" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#20FFFFFF" CornerRadius="15" BorderBrush="#35FFFFFF" BorderThickness="1">
                                    <TextBlock Text="—" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Nút Đóng (✕) Sắc Nét Chuẩn Typography -->
                    <Button x:Name="btnClose" Width="30" Height="30" Cursor="Hand" Click="CloseButton_Click" ToolTip="Đóng">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#20FFFFFF" CornerRadius="15" BorderBrush="#35FFFFFF" BorderThickness="1">
                                    <TextBlock Text="✕" FontSize="12.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#DC2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- ================= BỐ CỤC 2 CỘT: BRANDING (TRÁI) & FLOATING CARD (PHẢI) ================= -->
                <Grid Margin="48,32,48,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= CỘT TRÁI: BRANDING, VALUE PROPOSITION & STATS ================= -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="6,0,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo & Brand Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                            <Image Source="/Assets/logo_icon.png" Width="44" Height="44" 
                                   RenderOptions.BitmapScalingMode="HighQuality" 
                                   VerticalAlignment="Center"/>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EnglishAI" FontWeight="Bold" FontSize="18" Foreground="White"/>
                                    <Border Background="#10B981" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="AI POWERED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Học tiếng Anh thông minh cùng Trợ lý AI" Foreground="{StaticResource BrandMintSoft}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Slogan & Heading Nghệ Thuật -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock FontFamily="Georgia" FontSize="32" FontWeight="Bold" Foreground="White" LineHeight="40">
                                Chinh phục tiếng Anh<LineBreak/>
                                <Run Foreground="{StaticResource BrandMint}" FontStyle="Italic">cùng trí tuệ nhân tạo</Run>
                            </TextBlock>

                            <TextBlock Text="Hệ thống học tập cá nhân hóa — từ chẩn đoán năng lực, luyện đọc hiểu, ngữ pháp đến lộ trình bứt phá band điểm mục tiêu."
                                       FontSize="13.5" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="21" Margin="0,14,18,0"/>
                        </StackPanel>

                        <!-- Danh Sách 5 Tính Năng Nổi Bật -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,26">
                            <!-- Feature 1 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#10B981" Width="20" Height="20" CornerRadius="10" Margin="0,0,11,0">
                                    <local:LucideIcon Kind="Check" Size="12" StrokeThickness="2.6" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Bài kiểm tra chẩn đoán năng lực CEFR/IELTS/TOEIC" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Feature 2 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#10B981" Width="20" Height="20" CornerRadius="10" Margin="0,0,11,0">
                                    <local:LucideIcon Kind="Check" Size="12" StrokeThickness="2.6" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Kho tài liệu chuẩn hóa DOCX/PDF xem trước như File Explorer" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Feature 3 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#10B981" Width="20" Height="20" CornerRadius="10" Margin="0,0,11,0">
                                    <local:LucideIcon Kind="Check" Size="12" StrokeThickness="2.6" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Trợ lý AI tạo câu hỏi trắc nghiệm tự động từ tài liệu" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Feature 4 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#10B981" Width="20" Height="20" CornerRadius="10" Margin="0,0,11,0">
                                    <local:LucideIcon Kind="Check" Size="12" StrokeThickness="2.6" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Luyện tập &amp; thi thử bấm giờ mô phỏng đề thi thực tế" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Feature 5 -->
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#10B981" Width="20" Height="20" CornerRadius="10" Margin="0,0,11,0">
                                    <local:LucideIcon Kind="Check" Size="12" StrokeThickness="2.6" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Dashboard phân tích tiến độ, độ hoàn thành &amp; điểm mạnh yếu" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dải Glass Stats Banner (3 Cụm Thống Kê) -->
                        <Border Grid.Row="3" Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="14" Padding="18,12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="12,000+" FontWeight="Bold" FontSize="19" Foreground="White"/>
                                    <TextBlock Text="Học viên" Foreground="{StaticResource BrandMintSoft}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Rectangle Width="1" Fill="#28FFFFFF" Margin="0,2,28,2"/>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="500+" FontWeight="Bold" FontSize="19" Foreground="White"/>
                                    <TextBlock Text="Bài học &amp; đề" Foreground="{StaticResource BrandMintSoft}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Rectangle Width="1" Fill="#28FFFFFF" Margin="0,2,28,2"/>
                                <StackPanel>
                                    <TextBlock Text="6.8" FontWeight="Bold" FontSize="19" Foreground="White"/>
                                    <TextBlock Text="Band điểm TB" Foreground="{StaticResource BrandMintSoft}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ================= CỘT PHẢI: FLOATING AUTH CARD NỔI BẬT ================= -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="375">
                        <!-- Floating White Card (Sử dụng Grid xếp tầng để cách ly bóng đổ, tránh mờ văn bản) -->
                        <Grid>
                            <!-- Lớp Đổ bóng Card độc lập (không bọc text/input -> không bị mờ) -->
                            <Border Background="White" CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.16" Color="#000000"/>
                                </Border.Effect>
                            </Border>

                            <!-- Lớp Nội dung Card sắc nét tuyệt đối -->
                            <Border Background="White" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24"
                                    RenderOptions.ClearTypeHint="Enabled">
                                <StackPanel>
                                    <!-- Switch Tabs (Đăng nhập / Đăng ký) Dạng Pill Control -->
                                    <Border Background="#F1F5F9" CornerRadius="10" Padding="4" Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Tab Đăng nhập -->
                                            <Grid Grid.Column="0" Cursor="Hand" MouseDown="TabLogin_Click">
                                                <Border x:Name="tabLoginBorder" Background="White" CornerRadius="7">
                                                    <Border.Effect>
                                                        <DropShadowEffect x:Name="tabLoginShadow" BlurRadius="4" ShadowDepth="1" Opacity="0.08"/>
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock x:Name="tabLoginText" Text="Đăng nhập" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,7" IsHitTestVisible="False"/>
                                            </Grid>

                                            <!-- Tab Đăng ký -->
                                            <Grid Grid.Column="1" Cursor="Hand" MouseDown="TabRegister_Click">
                                                <Border x:Name="tabRegisterBorder" Background="Transparent" CornerRadius="7">
                                                    <Border.Effect>
                                                        <DropShadowEffect x:Name="tabRegisterShadow" BlurRadius="4" ShadowDepth="1" Opacity="0"/>
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock x:Name="tabRegisterText" Text="Đăng ký" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextGray}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,7" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- ================= FORM: ĐĂNG NHẬP ================= -->
                                    <StackPanel x:Name="pnlLogin" Visibility="Visible">
                                        <!-- Email Input -->
                                        <TextBlock Text="Email hoặc Tài khoản" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.2" CornerRadius="9" Height="42" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <local:LucideIcon Kind="Mail" Size="16" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtEmail" Grid.Column="1" Text="ten@email.com" BorderThickness="0" Background="Transparent" 
                                                         FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                         GotFocus="TxtEmail_GotFocus" LostFocus="TxtEmail_LostFocus"/>
                                            </Grid>
                                        </Border>

                                        <!-- Password Input với Nút Hiện/Ẩn Mắt -->
                                        <TextBlock Text="Mật khẩu" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.2" CornerRadius="9" Height="42" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <local:LucideIcon Kind="Lock" Size="16" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <!-- Ô mật khẩu che dấu sao -->
                                                <PasswordBox x:Name="txtPassword" Grid.Column="1" Password="password" BorderThickness="0" Background="Transparent" 
                                                             FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                                             GotFocus="TxtPassword_GotFocus" LostFocus="TxtPassword_LostFocus" KeyDown="TxtPassword_KeyDown"/>

                                                <!-- Ô mật khẩu hiện văn bản rõ khi bấm mắt -->
                                                <TextBox x:Name="txtPasswordVisible" Grid.Column="1" Text="" BorderThickness="0" Background="Transparent" 
                                                         FontSize="13" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" Visibility="Collapsed"
                                                         KeyDown="TxtPasswordVisible_KeyDown"/>

                                                <!-- Nút Toggle Eye -->
                                                <Button x:Name="btnTogglePassword" Grid.Column="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTogglePassword_Click" ToolTip="Hiện/Ẩn mật khẩu">
                                                    <local:LucideIcon x:Name="icoTogglePassword" Kind="Eye" Size="16" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Nút Đăng Nhập kèm Hiệu ứng Loading Spinner -->
                                        <Button x:Name="btnLogin" IsDefault="True" Style="{StaticResource PrimaryGradientButton}" Click="LoginButton_Click" Margin="0,0,0,12">
                                            <Grid>
                                                <StackPanel x:Name="pnlLoginNormal" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Đăng nhập ngay" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    <local:LucideIcon Kind="ArrowRight" Size="15" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel x:Name="pnlLoginLoading" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <local:LucideIcon Kind="LoaderCircle" Size="15" Foreground="White" Spin="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Đang xác thực &amp; khởi tạo..." FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Quên Mật Khẩu -->
                                        <TextBlock Text="Quên mật khẩu?" Foreground="{StaticResource BrandTeal}" FontSize="12.5" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center" Cursor="Hand" MouseDown="ForgotPassword_Click" Margin="0,0,0,4"/>
                                    </StackPanel>

                                    <!-- ================= FORM: ĐĂNG KÝ TÀI KHOẢN MỚI ================= -->
                                    <StackPanel x:Name="pnlRegister" Visibility="Collapsed">
                                        <!-- Full Name Input -->
                                        <TextBlock Text="Họ và tên" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.2" CornerRadius="9" Height="40" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <local:LucideIcon Kind="User" Size="16" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtRegName" Grid.Column="1" Text="Nguyễn Văn A" BorderThickness="0" Background="Transparent" 
                                                         FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         GotFocus="TxtRegName_GotFocus" LostFocus="TxtRegName_LostFocus"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="txtRegNameError" Foreground="#EF4444" FontSize="11" FontWeight="Medium" Margin="0,0,0,6" Visibility="Collapsed" TextWrapping="Wrap">
                                            <InlineUIContainer BaselineAlignment="Center">
                                                <local:LucideIcon Kind="AlertTriangle" Size="12" Foreground="#EF4444" Margin="0,0,4,0"/>
                                            </InlineUIContainer>
                                            <Run Text="Họ và tên phải viết hoa chữ cái đầu (Ví dụ: Nguyễn Văn A), không chứa số hay ký tự đặc biệt!"/>
                                        </TextBlock>

                                        <!-- Email Input -->
                                        <TextBlock Text="Email" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.2" CornerRadius="9" Height="40" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <local:LucideIcon Kind="Mail" Size="16" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtRegEmail" Grid.Column="1" Text="ten@email.com" BorderThickness="0" Background="Transparent" 
                                                         FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         GotFocus="TxtRegEmail_GotFocus" LostFocus="TxtRegEmail_LostFocus"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="txtRegEmailError" Foreground="#EF4444" FontSize="11" FontWeight="Medium" Margin="0,0,0,6" Visibility="Collapsed">
                                            <InlineUIContainer BaselineAlignment="Center">
                                                <local:LucideIcon Kind="AlertTriangle" Size="12" Foreground="#EF4444" Margin="0,0,4,0"/>
                                            </InlineUIContainer>
                                            <Run Text="Email này đã được đăng ký trên hệ thống!"/>
                                        </TextBlock>

                                        <!-- Password Input -->
                                        <TextBlock Text="Mật khẩu" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.2" CornerRadius="9" Height="40" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <local:LucideIcon Kind="Lock" Size="16" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <PasswordBox x:Name="txtRegPassword" Grid.Column="1" Password="password" BorderThickness="0" Background="Transparent" 
                                                             FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                             GotFocus="TxtRegPassword_GotFocus" LostFocus="TxtRegPassword_LostFocus"/>
                                            </Grid>
                                        </Border>

                                        <!-- Confirm Password Input -->
                                        <TextBlock Text="Xác nhận mật khẩu" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.2" CornerRadius="9" Height="40" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <local:LucideIcon Kind="ShieldCheck" Size="16" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <PasswordBox x:Name="txtRegConfirmPassword" Grid.Column="1" Password="password" BorderThickness="0" Background="Transparent" 
                                                             FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                             GotFocus="TxtRegConfirmPassword_GotFocus" LostFocus="TxtRegConfirmPassword_LostFocus" KeyDown="TxtRegConfirmPassword_KeyDown"/>
                                            </Grid>
                                        </Border>

                                        <!-- Register Button kèm Hiệu ứng Loading Spinner -->
                                        <Button x:Name="btnRegister" Style="{StaticResource PrimaryGradientButton}" Click="RegisterButton_Click" Margin="0,0,0,4">
                                            <Grid>
                                                <StackPanel x:Name="pnlRegisterNormal" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Tạo tài khoản học viên" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    <local:LucideIcon Kind="Check" Size="15" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel x:Name="pnlRegisterLoading" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <local:LucideIcon Kind="LoaderCircle" Size="15" Foreground="White" Spin="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Đang khởi tạo tài khoản..." FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Footer: Switch to Register -->
                        <TextBlock x:Name="footerLogin" HorizontalAlignment="Center" FontSize="13" Foreground="#E2E8F0" Margin="0,16,0,0" Visibility="Visible">
                            <Run Text="Chưa có tài khoản? "/>
                            <Run Text="Đăng ký ngay" Foreground="White" FontWeight="Bold" Cursor="Hand" MouseDown="TabRegister_Click"/>
                        </TextBlock>

                        <!-- Footer: Switch to Login -->
                        <TextBlock x:Name="footerRegister" HorizontalAlignment="Center" FontSize="13" Foreground="#E2E8F0" Margin="0,16,0,0" Visibility="Collapsed">
                            <Run Text="Đã có tài khoản? "/>
                            <Run Text="Đăng nhập ngay" Foreground="White" FontWeight="Bold" Cursor="Hand" MouseDown="TabLogin_Click"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
