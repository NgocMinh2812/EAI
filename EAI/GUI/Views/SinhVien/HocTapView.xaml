<Page x:Class="GUI.Views.HocTapView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Học tập - EnglishAI"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <!-- Colors matching Brand Palette & Floating Panel Theme -->
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="BrandMintSoft" Color="#CCFBF1" />
        <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="AppBg" Color="#F4F7F6" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>

        <!-- Sidebar item styles -->
        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveSidebarItemStyle" TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
            <Setter Property="Background" Value="{StaticResource BrandTealLight}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandTeal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="TealActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Skill Filter Chip Button -->
        <Style x:Key="FilterChipButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="btnBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <!-- Custom sleek chevron arrow -->
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="#64748B" StrokeThickness="1.6" 
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                    <Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBoxItem Style -->
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BrandTealLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandTeal}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Template="{StaticResource ModernComboBoxToggleButton}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   VerticalOffset="4">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.12" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TreeView and TreeViewItem Style -->
        <Style x:Key="ModernTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0" Width="16" Height="16" VerticalAlignment="Center">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="16">
                                                    <Path x:Name="ExpandPath" Data="M 1 1 L 5 5 L 9 1" Stroke="#94A3B8" StrokeThickness="1.5"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ExpandPath" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="14,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandTealLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandTeal}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- ================= RIGHT MAIN AREA ================= -->
    <Grid Background="{StaticResource AppBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="EnglishAI / " Foreground="{StaticResource TextGray}" FontSize="13"/>
                        <TextBlock Text="Kho bài học &amp; Lộ trình" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <!-- Search Input -->
                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Width="320" HorizontalAlignment="Left" Margin="25,0,0,0" Height="36">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtTimKiem" Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" 
                                     VerticalAlignment="Center" Foreground="{StaticResource TextDark}" FontSize="13"
                                     GotFocus="TxtTimKiem_GotFocus" LostFocus="TxtTimKiem_LostFocus"
                                     TextChanged="TxtTimKiem_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Header Quick Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,125,0">
                        <Button Background="Transparent" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand" ToolTip="Thông báo">
                            <TextBlock Text="🔔" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource TealActionButton}" Click="NavAIChat_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨" Margin="0,0,6,0"/>
                                <TextBlock Text="AI Chat Gia Sư"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Container with 2 Views: (1) List of Lessons, (2) Detailed Lesson Study -->
            <Grid Grid.Row="1">
                
                <!-- ================= VIEW 1: DANH SÁCH BÀI HỌC ================= -->
                <ScrollViewer x:Name="pnlDanhSachBaiHoc" VerticalScrollBarVisibility="Auto" Padding="25,20,25,30" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: CÂY DANH MỤC LỘ TRÌNH (KỸ NĂNG & CHỦ ĐỀ) - TASK-202 -->
                        <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="16,16" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Background="{StaticResource BrandTealLight}" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                            <TextBlock Text="🧭" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CÂY DANH MỤC LỘ TRÌNH" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrandTealDark}"/>
                                            <TextBlock Text="Kỹ năng &amp; Chủ đề học tập" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Quick Refresh Button -->
                                    <Button x:Name="btnRefreshTree" Content="🔄" ToolTip="Đồng bộ lại Cây danh mục từ Cơ sở dữ liệu" 
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnRefreshTree_Click"
                                            FontSize="12" Foreground="{StaticResource TextGray}"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,0,0,10"/>

                                <!-- Quick Reset Button -->
                                <Button x:Name="btnTreeReset" Content="🌐 Xem toàn bộ bài học" Style="{StaticResource FilterChipButton}" 
                                        HorizontalAlignment="Stretch" Margin="0,0,0,10" Background="{StaticResource BrandTealLight}" 
                                        Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" Click="BtnTreeReset_Click"/>

                                <!-- Interactive TreeView (Nạp động 100% từ Cơ sở dữ liệu) -->
                                <TreeView x:Name="trvDanhMuc" BorderThickness="0" Background="Transparent" 
                                          ItemContainerStyle="{StaticResource ModernTreeViewItem}"
                                          SelectedItemChanged="TrvDanhMuc_SelectedItemChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- CỘT PHẢI: BANNER, THANH LỌC VÀ DANH SÁCH BÀI HỌC -->
                        <StackPanel Grid.Column="2">
                            <!-- Top Banner -->
                            <Border Background="{StaticResource BrandTeal}" CornerRadius="14" Padding="22,18" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="{StaticResource BrandMintSoft}" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock x:Name="txtCurrentNavCategory" Text="LỘ TRÌNH TẤT CẢ BÀI HỌC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTealDark}"/>
                                            </Border>
                                            <TextBlock Text="Đồng bộ cơ sở dữ liệu" FontSize="12" Foreground="{StaticResource BrandMintSoft}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtBannerTitle" Text="Kho Bài Học Tương Tác &amp; Cá Nhân Hóa" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="txtBannerSubtitle" Text="Luyện tập đa kỹ năng: Từ vựng, Ngữ pháp, Đọc hiểu, Nghe và Viết luận có AI hướng dẫn chi tiết từng câu."
                                                   Foreground="#E6F7F3" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Stats Box -->
                                        <Border Background="#134E4A" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="txtTongSoBai" Text="0" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Tổng bài học" FontSize="11" Foreground="{StaticResource BrandMintSoft}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#134E4A" CornerRadius="10" Padding="14,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock x:Name="txtSoBaiHoanThanh" Text="0 (0%)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandMint}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Đã hoàn thành" FontSize="11" Foreground="{StaticResource BrandMintSoft}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Filter Bar -->
                            <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Skill Filter Tabs -->
                                    <StackPanel x:Name="pnlSkillChips" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="btnFilterAll" Content="Tất cả" Style="{StaticResource FilterChipButton}" 
                                                Background="{StaticResource BrandTealLight}" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" 
                                                BorderBrush="{StaticResource BrandTeal}" Click="FilterSkill_Click" Tag="All"/>
                                        <Button x:Name="btnFilterTuVung" Content="📖 Từ vựng" Style="{StaticResource FilterChipButton}" Click="FilterSkill_Click" Tag="TuVung"/>
                                        <Button x:Name="btnFilterNguPhap" Content="📝 Ngữ pháp" Style="{StaticResource FilterChipButton}" Click="FilterSkill_Click" Tag="NguPhap"/>
                                        <Button x:Name="btnFilterDoc" Content="📚 Đọc hiểu" Style="{StaticResource FilterChipButton}" Click="FilterSkill_Click" Tag="Doc"/>
                                        <Button x:Name="btnFilterNghe" Content="🎧 Nghe hiểu" Style="{StaticResource FilterChipButton}" Click="FilterSkill_Click" Tag="Nghe"/>
                                        <Button x:Name="btnFilterViet" Content="✍️ Viết luận" Style="{StaticResource FilterChipButton}" Click="FilterSkill_Click" Tag="Viet"/>
                                    </StackPanel>

                                    <!-- Level and Status Dropdowns -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Trình độ: " VerticalAlignment="Center" Foreground="{StaticResource TextGray}" FontSize="12" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="cboTrinhDo" Style="{StaticResource ModernComboBox}" Width="110" SelectionChanged="CboFilter_SelectionChanged">
                                            <ComboBoxItem Content="Tất cả"/>
                                            <ComboBoxItem Content="A1"/>
                                            <ComboBoxItem Content="A2"/>
                                            <ComboBoxItem Content="B1"/>
                                            <ComboBoxItem Content="B2"/>
                                            <ComboBoxItem Content="C1"/>
                                        </ComboBox>

                                        <TextBlock Text="Trạng thái: " VerticalAlignment="Center" Foreground="{StaticResource TextGray}" FontSize="12" Margin="10,0,4,0"/>
                                        <ComboBox x:Name="cboTrangThai" Style="{StaticResource ModernComboBox}" Width="125" SelectionChanged="CboFilter_SelectionChanged">
                                            <ComboBoxItem Content="Tất cả"/>
                                            <ComboBoxItem Content="Chưa học"/>
                                            <ComboBoxItem Content="Đang học"/>
                                            <ComboBoxItem Content="Hoàn thành"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lessons Grid / Cards List -->
                            <ItemsControl x:Name="icDanhSachBaiHoc">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" 
                                                BorderThickness="1" Padding="20,18" Margin="0,0,0,14">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.04" Color="Black"/>
                                            </Border.Effect>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="190"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Details -->
                                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                    <!-- Badges Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Border Background="{Binding BadgeBackground}" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconSkill}" Margin="0,0,4,0" FontSize="11"/>
                                                                <TextBlock Text="{Binding TenLoaiHienThi}" Foreground="{Binding BadgeForeground}" FontSize="11.5" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding MaTrinhDo, StringFormat='Trình độ {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                        </Border>

                                                        <Border Background="{Binding StatusBackground}" CornerRadius="6" Padding="8,3">
                                                            <TextBlock Text="{Binding TrangThai}" Foreground="{Binding StatusColor}" FontSize="11.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Lesson Title -->
                                                    <TextBlock Text="{Binding TieuDe}" FontSize="16.5" FontWeight="Bold" Margin="0,0,0,6"/>

                                                    <!-- Summary Text -->
                                                    <TextBlock Text="{Binding TomTat}" FontSize="13" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,12"/>

                                                    <!-- Metadata Row -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⏱️ " FontSize="12"/>
                                                        <TextBlock Text="{Binding ThoiGianUocTinhPhut, StringFormat='{}{0} phút'}" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,16,0"/>

                                                        <TextBlock Text="🏷️ " FontSize="12"/>
                                                        <TextBlock Text="{Binding TenChuDe, StringFormat='Chủ đề: {0}'}" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,16,0"/>

                                                        <TextBlock Text="⭐ " FontSize="12"/>
                                                        <TextBlock Text="{Binding DiemSo, StringFormat='Điểm: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right Progress & Action Button -->
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Progress Bar -->
                                                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                                        <Grid Margin="0,0,0,5">
                                                            <TextBlock Text="Tiến độ" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                                                            <TextBlock Text="{Binding PhanTramTienDo, StringFormat='{}{0:0}%'}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Value="{Binding PhanTramTienDo}" Maximum="100" Height="7" 
                                                                     Background="#E2E8F0" Foreground="{StaticResource BrandTeal}" BorderThickness="0"/>
                                                    </StackPanel>

                                                    <!-- Start / Continue Study Button -->
                                                    <Button Grid.Row="1" Content="{Binding ButtonActionText}" 
                                                            Style="{StaticResource TealActionButton}" 
                                                            Tag="{Binding MaBaiHoc}" Click="BtnVaoHoc_Click"
                                                            HorizontalAlignment="Stretch" Height="38"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State Notification -->
                            <Border x:Name="pnlEmptyLessons" Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" 
                                    BorderThickness="1" Padding="40,50" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="{StaticResource BrandTealLight}" Width="56" Height="56" CornerRadius="28" Margin="0,0,0,14" HorizontalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Không tìm thấy bài học nào phù hợp" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandTealDark}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtEmptyReason" Text="Không có bài học nào trong danh mục hoặc bộ lọc hiện tại." FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <Button Content="🌐 Xem toàn bộ bài học" Style="{StaticResource TealActionButton}" Width="190" Height="38" Click="BtnTreeReset_Click" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ================= VIEW 2: CHI TIẾT BÀI HỌC (TIẾN HÀNH HỌC) ================= -->
                <ScrollViewer x:Name="pnlChiTietBaiHoc" VerticalScrollBarVisibility="Auto" Padding="25,20,25,30" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Back Button & Breadcrumb Navigation -->
                        <Grid Margin="0,0,0,16">
                            <Button Style="{StaticResource FilterChipButton}" Background="White" HorizontalAlignment="Left" Click="BtnQuayLai_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❮" Margin="0,0,6,0" FontWeight="Bold"/>
                                    <TextBlock Text="Quay lại danh sách bài học" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Lesson Header Card -->
                        <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="24,20" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border x:Name="badgeChiTietLoai" Background="{StaticResource BrandTealLight}" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="txtChiTietLoai" Text="Ngữ pháp" Foreground="{StaticResource BrandTeal}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="txtChiTietTrinhDo" Text="Trình độ B2" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>
                                        <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="txtChiTietChuDe" Text="Chủ đề: Học thuật" FontSize="12" FontWeight="SemiBold" Foreground="#B45309"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock x:Name="txtChiTietTieuDe" Text="Grammar B2 - Conditional Sentences" FontSize="21" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtChiTietTomTat" Text="Tóm tắt nội dung bài học..." FontSize="13.5" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Tiến độ bài học" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtChiTietTienDo" Text="80%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                                            <TextBlock x:Name="txtChiTietTrangThai" Text="Đang học" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtStudyTimeElapsed" Text="⏱️ Đã học: 00:00" FontSize="11" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tab Selection: 1. Lý thuyết & 2. Bài tập trắc nghiệm -->
                        <Border Background="#E2E8F0" CornerRadius="8" Padding="3" Margin="0,0,0,18" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnTabLyThuyet" Content="📖 1. Lý thuyết &amp; Bài giảng" 
                                        Background="White" Foreground="{StaticResource TextDark}" FontWeight="SemiBold"
                                        Padding="16,8" BorderThickness="0" Cursor="Hand" Click="TabLyThuyet_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnTabBaiTap" Content="✍️ 2. Bài tập thực hành &amp; Trắc nghiệm" 
                                        Background="Transparent" Foreground="{StaticResource TextGray}" FontWeight="Medium"
                                        Padding="16,8" BorderThickness="0" Cursor="Hand" Click="TabBaiTap_Click" Margin="4,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- TAB CONTENT 1: LÝ THUYẾT & NỘI DUNG BÀI HỌC -->
                        <StackPanel x:Name="pnlTabLyThuyet" Visibility="Visible">
                            <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="26,24">
                                <StackPanel>
                                    <!-- Modern Audio Player Controller (TASK-203) - CHỈ HIỂN THỊ KHI HỌC NGHE HIỂU -->
                                    <Border x:Name="pnlAudioPlayerController" Background="#F0FDFA" CornerRadius="12" BorderBrush="{StaticResource BrandMintSoft}" BorderThickness="1.5" Padding="18,14" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Play/Pause & Rewind/Forward Controls (TASK-203) -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="btnAudioPlayPause" Content="▶️ Nghe bài giảng" 
                                                            Style="{StaticResource TealActionButton}" Padding="15,7" FontSize="12.5" Click="BtnAudioPlayPause_Click"/>
                                                    <Button x:Name="btnAudioStop" Content="⏹️" 
                                                            Style="{StaticResource FilterChipButton}" Margin="6,0,0,0" Padding="10,6" Click="BtnAudioStop_Click" ToolTip="Dừng phát"/>
                                                    <Button x:Name="btnAudioRewind" Content="⏪ -5s" 
                                                            Style="{StaticResource FilterChipButton}" Margin="6,0,0,0" Padding="8,6" Click="BtnAudioRewind_Click" ToolTip="Tua lại 5 giây"/>
                                                    <Button x:Name="btnAudioForward" Content="⏩ +5s" 
                                                            Style="{StaticResource FilterChipButton}" Margin="6,0,0,0" Padding="8,6" Click="BtnAudioForward_Click" ToolTip="Tua tới 5 giây"/>
                                                </StackPanel>

                                                <!-- Status and Audio info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                                    <TextBlock x:Name="txtAudioStatus" Text="Bộ phát âm thanh bài học (Audio Tutor • MediaPlayer)" 
                                                               FontWeight="SemiBold" Foreground="{StaticResource BrandTealDark}" FontSize="13"/>
                                                    <TextBlock x:Name="txtAudioSubtitle" Text="Giọng đọc tiếng Anh bản xứ chuẩn IPA, hỗ trợ nghe đoạn hội thoại, tạm dừng và tua lại." 
                                                               Foreground="{StaticResource TextGray}" FontSize="11.5" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Speed & Volume Controls -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Slider x:Name="sldAudioVolume" Minimum="0" Maximum="1" Value="0.8" Width="65" VerticalAlignment="Center" 
                                                            ValueChanged="SldAudioVolume_ValueChanged" Margin="0,0,10,0"/>
                                                    <Button x:Name="btnAudioSpeed" Content="1.0x" Style="{StaticResource FilterChipButton}" 
                                                            Padding="8,4" FontSize="11.5" Click="BtnAudioSpeed_Click" ToolTip="Tốc độ đọc"/>
                                                    <Button Content="🤖 Đọc mẫu" Style="{StaticResource FilterChipButton}" Background="White" 
                                                            BorderBrush="{StaticResource BrandTeal}" Foreground="{StaticResource BrandTeal}" 
                                                            Padding="10,4" FontSize="11.5" Click="BtnSpeakFullText_Click" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Progress Timeline & Seek Slider -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="txtAudioCurrentTime" Grid.Column="0" Text="00:00" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Slider x:Name="sldAudioProgress" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" 
                                                        PreviewMouseDown="SldAudioProgress_PreviewMouseDown" PreviewMouseUp="SldAudioProgress_PreviewMouseUp" ValueChanged="SldAudioProgress_ValueChanged"/>
                                                <TextBlock x:Name="txtAudioTotalTime" Grid.Column="2" Text="01:30" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Formatted Theory Reader (TASK-202) -->
                                    <StackPanel x:Name="pnlFormattedLecture">
                                        <!-- Objectives Card -->
                                        <Border Background="#F0FDF4" CornerRadius="10" BorderBrush="#BBF7D0" BorderThickness="1" Padding="16,14" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="🎯 MỤC TIÊU BÀI HỌC" FontWeight="Bold" FontSize="12" Foreground="#166534" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="txtLectureObjective" Text="Nắm vững bản chất, quy tắc và phản xạ áp dụng vào bài thi chuẩn hóa." FontSize="13.5" LineHeight="20" Foreground="#14532D" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Reading Passage Card (CHUYÊN BIỆT CHO BÀI ĐỌC HIỂU) -->
                                        <Border x:Name="bdrReadingPassage" Background="#F8FAFC" CornerRadius="12" BorderBrush="{StaticResource BrandTeal}" BorderThickness="1.5" Padding="20,18" Margin="0,0,0,16" Visibility="Collapsed">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Border Background="{StaticResource BrandTeal}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                        <TextBlock Text="📰 ĐOẠN VĂN ĐỌC HIỂU TIẾNG ANH (READING PASSAGE)" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock x:Name="txtReadingPassageTopic" Text="IELTS / Academic Reading Context" FontSize="12" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="txtReadingPassageTitle" Text="Passage Title" FontWeight="Bold" FontSize="15.5" Foreground="#0F172A" Margin="0,0,0,10"/>
                                                <Border Background="White" CornerRadius="8" Padding="16,14" BorderBrush="#CBD5E1" BorderThickness="1">
                                                    <TextBlock x:Name="txtReadingPassageContent" Text="Reading passage content..." FontSize="13.5" LineHeight="24" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Core Structure Card -->
                                        <Border Background="#F8FAFC" CornerRadius="10" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock x:Name="txtLectureFormulaTitle" Text="📖 CẤU TRÚC &amp; QUY TẮC CỐT LÕI (CORE RULES)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandTeal}" Margin="0,0,0,10"/>
                                                <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <TextBlock x:Name="txtLectureFormula" Text="Cấu trúc ngữ pháp / quy tắc trọng tâm..." FontFamily="Segoe UI Semibold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Real-world Examples Card -->
                                        <Border Background="#EFF6FF" CornerRadius="10" BorderBrush="#BFDBFE" BorderThickness="1" Padding="16,14" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock x:Name="txtLectureExampleTitle" Text="💡 VÍ DỤ MINH HỌA NGỮ CẢNH THỰC TẾ (IELTS / TOEIC)" FontWeight="Bold" FontSize="12" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="txtLectureExample" Text="Ví dụ ứng dụng thực tế trong bài thi..." FontStyle="Italic" FontSize="13.5" LineHeight="22" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Common Pitfalls Card -->
                                        <Border Background="#FEF3C7" CornerRadius="10" BorderBrush="#FDE68A" BorderThickness="1" Padding="16,14" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock x:Name="txtLectureTipsTitle" Text="⚠️ BẪY THƯỜNG GẶP &amp; LƯU Ý QUAN TRỌNG (EXAM TIPS)" FontWeight="Bold" FontSize="12" Foreground="#92400E" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="txtLectureTips" Text="Lưu ý các trường hợp ngoại lệ và bẫy thường gặp." FontSize="13" LineHeight="20" Foreground="#78350F" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Full Lecture Text (collapsible or detailed) -->
                                        <TextBlock Text="Chi tiết nội dung bài giảng:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="txtChiTietNoiDung" Text="Nội dung bài học..." FontSize="13.5" LineHeight="23" TextWrapping="Wrap" Foreground="#1E293B"/>
                                    </StackPanel>

                                    <!-- Next step button -->
                                    <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,24,0,20"/>
                                    <Grid>
                                        <Button Content="Tiến hành làm bài tập củng cố ❯" Style="{StaticResource TealActionButton}" 
                                                HorizontalAlignment="Right" Padding="20,10" FontSize="13.5" Click="BtnChuyenSangBaiTap_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB CONTENT 2: BÀI TẬP THỰC HÀNH & TRẮC NGHIỆM -->
                        <StackPanel x:Name="pnlTabBaiTap" Visibility="Collapsed">
                            <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="26,24">
                                <StackPanel>
                                    <TextBlock Text="✍️ Bài tập thực hành kiến thức" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Chọn đáp án đúng nhất cho từng câu hỏi bên dưới để củng cố kiến thức và tích lũy điểm năng lực." 
                                               FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,20"/>

                                    <!-- Interactive Questions Container -->
                                    <StackPanel x:Name="pnlDanhSachCauHoi"/>

                                    <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,20,0,20"/>

                                    <!-- Action Buttons Footer -->
                                    <Grid>
                                        <Button Content="❮ Quay lại đọc lý thuyết" Style="{StaticResource FilterChipButton}" 
                                                HorizontalAlignment="Left" Padding="16,9" Click="TabLyThuyet_Click"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="btnNopBai" Content="🎯 Nộp bài &amp; Hoàn thành 100%" Style="{StaticResource TealActionButton}" 
                                                    Padding="22,10" FontSize="14" Click="BtnHoanThanhBaiHoc_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
</Page>
