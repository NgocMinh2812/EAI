                                                </StackPanel>

                                                <!-- Status and Audio info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                                    <TextBlock x:Name="txtAudioStatusQuiz" Text="🎧 Audio bài nghe — Học viên vừa nghe vừa chọn đáp án bên dưới" 
                                                               FontWeight="SemiBold" Foreground="{StaticResource BrandTealDark}" FontSize="13"/>
                                                    <TextBlock x:Name="txtAudioSubtitleQuiz" Text="Có thể bấm nghe lại, tua nhanh chậm hoặc điều chỉnh âm lượng để hoàn thành tốt bài làm." 
                                                               Foreground="{StaticResource TextGray}" FontSize="11.5" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Speed & Volume Controls -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Slider x:Name="sldAudioVolumeQuiz" Minimum="0" Maximum="1" Value="0.8" Width="65" VerticalAlignment="Center" 
                                                            ValueChanged="SldAudioVolumeQuiz_ValueChanged" Margin="0,0,10,0"/>
                                                    <Button x:Name="btnAudioSpeedQuiz" Content="1.0x" Style="{StaticResource FilterChipButton}" 
                                                            Padding="8,4" FontSize="11.5" Click="BtnAudioSpeed_Click" ToolTip="Tốc độ đọc"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Progress Timeline & Seek Slider -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="txtAudioCurrentTimeQuiz" Grid.Column="0" Text="00:00" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Slider x:Name="sldAudioProgressQuiz" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" 
                                                        PreviewMouseDown="SldAudioProgress_PreviewMouseDown" PreviewMouseUp="SldAudioProgress_PreviewMouseUp" ValueChanged="SldAudioProgressQuiz_ValueChanged"/>
                                                <TextBlock x:Name="txtAudioTotalTimeQuiz" Grid.Column="2" Text="01:30" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- AI Quiz Generating / Loading State -->
                                    <Border x:Name="pnlQuizLoading" Background="#F0FDFA" CornerRadius="12" BorderBrush="#99F6E4" BorderThickness="1.5" 
                                            Padding="24,20" Margin="0,0,0,20" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtQuizLoadingTitle" Text="🤖 AI đang biên soạn 10 câu hỏi trắc nghiệm chất lượng cao..." 
                                                       FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource BrandTealDark}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="txtQuizLoadingSub" Text="Đang kiểm tra kết quả trong CSDL / Trợ lý AI đang xử lý..." 
                                                       FontSize="13" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <ProgressBar Width="280" Height="5" IsIndeterminate="True" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quiz Error State -->
                                    <Border x:Name="pnlQuizError" Background="#FEF2F2" CornerRadius="12" BorderBrush="#FECACA" BorderThickness="1.5" 
                                            Padding="20,16" Margin="0,0,0,20" Visibility="Collapsed">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="⚠️ Không thể tải hoặc tạo bộ câu hỏi" FontWeight="Bold" FontSize="14" Foreground="#991B1B" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="txtQuizErrorMsg" Text="Đã xảy ra lỗi trong quá trình chuẩn bị câu hỏi." FontSize="13" Foreground="#B91C1C" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Content="🔄 Thử lại" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                    Style="{StaticResource TealActionButton}" Padding="16,8" Click="BtnRetryQuiz_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Quiz Result Summary Banner (Shown after submission) -->
                                    <Border x:Name="pnlQuizResultSummary" Background="#ECFDF5" CornerRadius="12" BorderBrush="#A7F3D0" BorderThickness="1.5" 
                                            Padding="20,16" Margin="0,0,0,20" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#10B981" CornerRadius="10" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtQuizResultScore" Text="10.0" FontWeight="Bold" FontSize="20" Foreground="White" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="🎉 KẾT QUẢ BÀI TẬP:" FontWeight="Bold" FontSize="14.5" Foreground="#065F46" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="txtQuizResultDetails" Text="10/10 câu đúng (100%)" FontWeight="SemiBold" FontSize="14.5" Foreground="#047857"/>
                                                </StackPanel>
                                                <TextBlock x:Name="txtQuizResultFeedback" Text="Xuất sắc! Bạn đã nắm vững toàn bộ kiến thức trọng tâm của bài học." 
                                                           FontSize="13" Foreground="#047857" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="🔄 Làm lại bộ này" Style="{StaticResource FilterChipButton}" 
                                                    Padding="14,8" VerticalAlignment="Center" Click="BtnLamLaiQuiz_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Interactive Questions Container -->
                                    <StackPanel x:Name="pnlDanhSachCauHoi"/>

                                    <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,20,0,20"/>

                                    <!-- Action Buttons Footer -->
                                    <Grid>
                                        <Button Content="❮ Quay lại đọc lý thuyết" Style="{StaticResource FilterChipButton}" 
                                                HorizontalAlignment="Left" Padding="16,9" Click="TabLyThuyet_Click"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="btnLamLaiFooter" Content="🔄 Làm lại bài tập" Style="{StaticResource FilterChipButton}" 
                                                    Margin="0,0,10,0" Padding="18,10" FontSize="13.5" Visibility="Collapsed"
                                                    Click="BtnLamLaiQuiz_Click"/>

                                            <Button x:Name="btnNopBai" Content="🎯 Nộp bài &amp; Xem kết quả" Style="{StaticResource TealActionButton}" 
                                                    Padding="22,10" FontSize="14" Click="BtnHoanThanhBaiHoc_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
</Page>
