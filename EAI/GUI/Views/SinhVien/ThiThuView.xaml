<Page x:Class="GUI.Views.ThiThuView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Thi thử mô phỏng - EnglishAI"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Background="#F4F7F6">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="BrandMintSoft" Color="#CCFBF1" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#475569" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="ModernAudioSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#E2E8F0" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#0F766E" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="12" Height="12" Background="#0F766E" BorderBrush="White" BorderThickness="2" CornerRadius="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#0F172A"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernExamFilterChipButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#0F766E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TestCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0D9488"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.08" Color="#0F766E"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartTestButton" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18" Color="#0F766E"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBdr" Property="Background" Value="#115E59"/>
                                <Setter TargetName="btnBdr" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#0F766E"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBdr" Property="Background" Value="#042F2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBdr" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerSubmitButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExamOptionRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.5" 
                                CornerRadius="10" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotOuter" Grid.Column="0" Width="20" Height="20" Stroke="{StaticResource BorderLight}" StrokeThickness="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="Transparent"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse x:Name="dotInner" Grid.Column="0" Width="10" Height="10" Fill="{StaticResource BrandTeal}" Visibility="Collapsed" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource BrandTealLight}"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                                <Setter TargetName="dotOuter" Property="Stroke" Value="{StaticResource BrandTeal}"/>
                                <Setter TargetName="dotInner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F4F7F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" x:Name="rowHeader"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER ================= -->
        <Border x:Name="pnlTopHeader" Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EnglishAI / " Foreground="{StaticResource TextGray}" FontSize="13"/>
                    <TextBlock x:Name="txtHeaderBreadcrumb" Text="Phòng thi thử &amp; Khảo thí chuẩn hóa" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,125,0">
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock x:Name="txtTotalExamsTaken" Text="Đã thi: 0 bài" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDark}"/>
                    </Border>
                    <Border Background="{StaticResource BrandTealLight}" CornerRadius="8" Padding="12,6">
                        <TextBlock x:Name="txtHighestScore" Text="Điểm cao nhất: --" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrandTeal}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= VIEW 1: DANH SÁCH ĐỀ THI ================= -->
        <ScrollViewer x:Name="pnlDanhSachDeThi" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25" Visibility="Visible">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- Hero Banner -->
                <Border CornerRadius="18" Padding="28,24" Margin="0,0,0,22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#091E1C" Offset="0.0"/>
                            <GradientStop Color="#0F766E" Offset="0.65"/>
                            <GradientStop Color="#115E59" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Background="#134E4A" BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="20" Padding="12,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Award" Size="12" Foreground="#5EEAD4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MÔ PHỎNG PHÒNG THI THỰC TẾ • KHẢO THÍ CHUẨN QUỐC TẾ" Foreground="#CCFBF1" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Phòng Thi Thử Chuẩn Hóa Quốc Tế (IELTS • TOEIC • VSTEP • THPT)" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="Làm quen áp lực thời gian với đồng hồ đếm ngược, tự động chấm điểm và xem lời giải phân tích chi tiết ngay sau khi nộp bài."
                                       Foreground="#CCFBF1" FontSize="13.5" Margin="0,0,0,14"/>

                            <!-- Highlights Micro-Row -->
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#134E4A" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="FileCheck" Size="13" Foreground="#99F6E4" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="20+ Đề chuẩn hóa" FontSize="11.5" FontWeight="SemiBold" Foreground="#E6F7F3"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#134E4A" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="CheckCircle2" Size="13" Foreground="#86EFAC" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="100% Chấm tự động &amp; AI giải thích" FontSize="11.5" FontWeight="SemiBold" Foreground="#E6F7F3"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#134E4A" CornerRadius="8" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="History" Size="13" Foreground="#FDE047" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Lưu snapshot &amp; Xem lại lịch sử" FontSize="11.5" FontWeight="SemiBold" Foreground="#E6F7F3"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource StartTestButton}" 
                                Background="{StaticResource BrandMint}" Padding="20,12" Click="BtnQuickTest_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:LucideIcon Kind="Zap" Size="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đánh giá nhanh (10p)" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Section Title & Filter Bar -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Kho đề thi thử chuẩn hóa quốc tế:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                    <TextBlock Text="Làm quen định dạng đề thi thực tế với áp lực thời gian, tự động chấm điểm và xem lời giải chi tiết." FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,0,0,12"/>

                    <!-- Modern Two-Row Filter Card -->
                    <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.03" Color="#0F172A"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Row 1: Exam Format Category Filter Pills -->
                            <WrapPanel x:Name="pnlExamFormatChips" Margin="0,0,0,14">
                                <Button x:Name="btnFilterAll" Content="Tất cả" Style="{StaticResource ModernExamFilterChipButton}" Background="{StaticResource BrandTeal}" Foreground="White" BorderThickness="0" Click="BtnFilter_Click" Tag="All"/>
                                <Button x:Name="btnFilterIelts" Content="IELTS" Style="{StaticResource ModernExamFilterChipButton}" Click="BtnFilter_Click" Tag="IELTS"/>
                                <Button x:Name="btnFilterToeic" Content="TOEIC" Style="{StaticResource ModernExamFilterChipButton}" Click="BtnFilter_Click" Tag="TOEIC"/>
                                <Button x:Name="btnFilterVstep" Content="VSTEP" Style="{StaticResource ModernExamFilterChipButton}" Click="BtnFilter_Click" Tag="VSTEP"/>
                                <Button x:Name="btnFilterCambridge" Content="Cambridge" Style="{StaticResource ModernExamFilterChipButton}" Click="BtnFilter_Click" Tag="Cambridge"/>
                                <Button x:Name="btnFilterTHPT" Content="THPT Quốc Gia" Style="{StaticResource ModernExamFilterChipButton}" Click="BtnFilter_Click" Tag="THPT"/>
                                <Button x:Name="btnFilterGrammar" Content="Chuyên đề khác" Style="{StaticResource ModernExamFilterChipButton}" Click="BtnFilter_Click" Tag="Ngữ pháp"/>
                            </WrapPanel>

                            <!-- Row 2: Search, Level, Status & Reset (Straight Horizontal Baseline) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Modern Search Box with Watermark Placeholder -->
                                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.2" Height="38" Padding="10,0" Margin="0,0,16,0" MaxWidth="400" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <local:LucideIcon Grid.Column="0" Kind="Search" Size="14" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Tìm kiếm đề thi, mã chuẩn hóa, từ khóa..." 
                                                       Foreground="#94A3B8" FontSize="12.5" 
                                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearchExam}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="txtSearchExam" Background="Transparent" BorderThickness="0" 
                                                     VerticalAlignment="Center" Foreground="{StaticResource TextDark}" FontSize="12.5"
                                                     TextChanged="TxtSearchExam_TextChanged"/>
                                        </Grid>
                                        <Button Grid.Column="2" x:Name="btnClearSearchExam" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"
                                                Click="BtnClearSearchExam_Click" Visibility="Collapsed" ToolTip="Xóa tìm kiếm">
                                            <local:LucideIcon Kind="X" Size="13" Foreground="#94A3B8"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Level, Status & Reset (Straight Alignment) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Level -->
                                    <TextBlock Text="Trình độ:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="cboExamTrinhDo" Width="100" Height="38" Margin="0,0,12,0" SelectionChanged="CboExamFilter_SelectionChanged">
                                        <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                        <ComboBoxItem Content="A1"/>
                                        <ComboBoxItem Content="A2"/>
                                        <ComboBoxItem Content="B1"/>
                                        <ComboBoxItem Content="B2"/>
                                        <ComboBoxItem Content="C1"/>
                                    </ComboBox>

                                    <!-- Status -->
                                    <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="cboExamTrangThai" Width="120" Height="38" Margin="0,0,12,0" SelectionChanged="CboExamFilter_SelectionChanged">
                                        <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                        <ComboBoxItem Content="Chưa thi"/>
                                        <ComboBoxItem Content="Đã thi"/>
                                        <ComboBoxItem Content="Còn lượt thi"/>
                                    </ComboBox>

                                    <!-- Reset Button -->
                                    <Button x:Name="btnResetExamFilter" Click="BtnResetExamFilter_Click" Cursor="Hand" Height="38" Padding="14,0" ToolTip="Xóa tất cả bộ lọc về mặc định">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bdrReset" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <local:LucideIcon Kind="RotateCcw" Size="13" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Đặt lại" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdrReset" Property="Background" Value="#E2E8F0"/>
                                                        <Setter TargetName="bdrReset" Property="BorderBrush" Value="#94A3B8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Dynamic ItemsControl for Exams from Database -->
                <ItemsControl x:Name="icDanhSachDeThi" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TestCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Accent Color Indicator -->
                                    <Border Grid.Column="0" Width="4.5" CornerRadius="4" Background="{Binding AccentBrush}" Margin="0,2,16,2" VerticalAlignment="Stretch"/>

                                    <!-- Format Icon Badge -->
                                    <Border Grid.Column="1" Background="{Binding FormatBadgeBg}" Width="50" Height="50" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="{Binding FormatIconKind}" Size="22" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Exam Info -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <!-- Badges Row -->
                                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                            <Border Background="{Binding FormatTagBg}" CornerRadius="6" Padding="9,3" Margin="0,0,8,4">
                                                <TextBlock Text="{Binding FormatTag}" FontSize="11" FontWeight="Bold" Foreground="{Binding FormatTagFg}"/>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                <TextBlock Text="{Binding LevelTag}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                            </Border>
                                            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4" Visibility="{Binding HasBlueprintVisibility}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:LucideIcon Kind="Compass" Size="11" Foreground="#15803D" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding BlueprintBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3" Margin="0,0,8,4" Visibility="{Binding MaxAttemptsVisibility}">
                                                <TextBlock Text="{Binding LuotLamBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                            </Border>
                                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4" Visibility="{Binding PassMarkVisibility}">
                                                <TextBlock Text="{Binding PassMarkBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Title -->
                                        <TextBlock Text="{Binding TenBaiTapDeThi}" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,5" TextWrapping="Wrap"/>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding CleanMoTa}" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,9" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>

                                        <!-- Metadata Micro-Pills -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Clock" Size="12" Foreground="#0F766E" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DurationPill}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="FileText" Size="12" Foreground="#475569" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding QuestionCountPill}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="ShieldCheck" Size="12" Foreground="#15803D" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Mô phỏng thi tính giờ" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <Button Grid.Column="3" 
                                            IsEnabled="{Binding CanTakeExam}"
                                            Style="{StaticResource StartTestButton}" VerticalAlignment="Center" 
                                            Tag="{Binding MaBaiTapDeThi}" Click="BtnStartExam_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActionButtonText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <local:LucideIcon Kind="ArrowRight" Size="14" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Empty State for Exams -->
                <Border x:Name="pnlEmptyExams" Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" 
                        BorderThickness="1" Padding="40,36" Margin="0,10,0,24" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="{StaticResource BrandTealLight}" Width="52" Height="52" CornerRadius="26" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Không tìm thấy đề thi nào phù hợp" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Không có đề thi nào khớp với bộ lọc và từ khóa hiện tại. Thử chọn loại đề khác hoặc bấm Đặt lại." FontSize="12.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <Button Content="🔄 Đặt lại bộ lọc" Padding="16,7" Background="{StaticResource BrandTealLight}" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Click="BtnResetExamFilter_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= VIEW 2: ĐỘNG CƠ THI THỬ (TASK-206: EXAM ENGINE) ================= -->
        <Grid x:Name="pnlLamBaiThi" Grid.Row="1" Visibility="Collapsed" Background="#F4F7F6">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Exam Header Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtExamTitle" Text="Đề thi: IELTS Reading Mini Mock Test" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextDark}"/>
                        <Border Background="{StaticResource BrandTealLight}" CornerRadius="6" Padding="8,2" Margin="12,0,0,0">
                            <TextBlock x:Name="txtExamProgressCount" Text="Câu 1 / 10" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandTeal}"/>
                        </Border>
                    </StackPanel>

                    <!-- Countdown Timer, Test Mode & Submit (TASK-206 & TASK-209) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,110,0">
                        <Button x:Name="btnTestTimeout" Content="Test hết giờ (5s)" Visibility="Collapsed"
                                Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FCD34D" BorderThickness="1" 
                                Padding="10,6" FontWeight="SemiBold" FontSize="12" Margin="0,0,12,0" Cursor="Hand" 
                                Click="BtnTestTimeout_Click" ToolTip="TASK-209: Kiểm thử tự động nộp bài khi hết giờ"/>
                        
                        <Border Background="#FEF2F2" CornerRadius="8" Padding="14,6" Margin="0,0,12,0" BorderBrush="#FCA5A5" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:LucideIcon Kind="Clock" Size="14" Foreground="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Còn lại: " FontWeight="SemiBold" FontSize="12.5" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtCountdownTimer" Text="25:00" FontWeight="Bold" FontSize="15" Foreground="#DC2626" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Nộp bài thi" Style="{StaticResource DangerSubmitButton}" Click="BtnSubmitExam_Click" Margin="0,0,10,0"/>
                        <Button x:Name="btnExitExam" Content="✕ Thoát bài" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,8" FontWeight="SemiBold" FontSize="12.5" Cursor="Hand" Click="BtnExitExam_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#FEE2E2"/>
                                            <Setter TargetName="bdr" Property="BorderBrush" Value="#FCA5A5"/>
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Exam Work Area -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Reading Passage & Question Choices -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                    <StackPanel>
                        <!-- Reading Passage Box (if any) -->
                        <Border x:Name="pnlExamPassage" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                Padding="20" Margin="0,0,0,18" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <local:LucideIcon Kind="BookOpen" Size="13" Foreground="{StaticResource TextGray}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đoạn văn tham chiếu (Reading Passage):" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="txtExamPassage" Text="" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>

                        <!-- Question Prompt Box -->
                        <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="25">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="txtQuestionSkill" Text="KỸ NĂNG: ĐỌC" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </Border>
                                        <Border Background="#F3E8FF" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="txtQuestionType" Text="DẠNG: TRẮC NGHIỆM" FontSize="11" FontWeight="Bold" Foreground="#7E22CE"/>
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="txtQuestionLevel" Text="TRÌNH ĐỘ B2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Gắn cờ câu hỏi (TASK-206: Flag question) -->
                                    <Button x:Name="btnFlagQuestion" Content="🚩 Đặt cờ xem lại" HorizontalAlignment="Right" 
                                            Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FCD34D" BorderThickness="1" 
                                            Padding="10,4" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="BtnFlagQuestion_Click"/>
                                </Grid>

                                <!-- Listening Audio Box (Hỗ trợ phát file audio bài thi & đính kèm câu hỏi - Quy chế thi chuẩn) -->
                                <Border x:Name="pnlExamAudio" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="14,12" Margin="0,0,0,18" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Hàng 1: Nút Phát liên tục, Trạng thái, Badge số lượt nghe, Badge quy chế thi -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="btnPlayExamAudio" Grid.Column="0" Content="▶ Bắt đầu nghe bài thi" 
                                                    Background="{StaticResource BrandTeal}" Foreground="White" FontWeight="Bold" FontSize="12.5" Padding="16,8" Cursor="Hand" BorderThickness="0"
                                                    Click="BtnPlayExamAudio_Click">
                                                <Button.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <TextBlock x:Name="txtAudioStatus" Grid.Column="1" Text="🎧 Bấm để nghe • Quy chế thi: Phát một mạch, không tạm dừng/tua lại" 
                                                       VerticalAlignment="Center" Margin="12,0,8,0" FontSize="12" Foreground="#047857" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                            <!-- Badge quy chế số lượt nghe bài thi -->
                                            <Border x:Name="bdrAudioPlayCount" Grid.Column="2" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtAudioPlayCount" Text="⏱️ Lượt nghe: 0/2" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                            </Border>

                                            <Border Grid.Column="3" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="🔒 Quy chế: Không dừng / Không tua" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/>
                                            </Border>
                                        </Grid>

                                        <!-- Hàng 2: Tiến trình bài nghe (Chỉ đọc - không cho kéo tua) & Âm lượng -->
                                        <Grid x:Name="pnlAudioTimelineRow" Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="txtAudioCurrentTime" Grid.Column="0" Text="00:00" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <ProgressBar x:Name="pbAudioProgress" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="0"
                                                         Foreground="#0F766E" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center">
                                                <ProgressBar.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                </ProgressBar.Resources>
                                            </ProgressBar>

                                            <TextBlock x:Name="txtAudioTotalTime" Grid.Column="2" Text="00:00" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,14,0"/>

                                            <!-- Điều chỉnh âm lượng (Thí sinh được phép chỉnh to nhỏ cho vừa tai) -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔊" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Slider x:Name="sldAudioVolume" Width="65" Minimum="0" Maximum="1" Value="0.9" VerticalAlignment="Center" ValueChanged="SldAudioVolume_ValueChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="txtExamQuestionPrompt" Text="Câu 1: What is the main reason for renewable energy transition?" 
                                           FontSize="16.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,22"/>

                                <!-- DẠNG 1: TRẮC NGHIỆM / ĐÚNG SAI / TRUE-FALSE-NOT GIVEN -->
                                <StackPanel x:Name="pnlChoiceOptions" Visibility="Visible">
                                    <RadioButton x:Name="rbOptA" Style="{StaticResource ExamOptionRadio}" Checked="ExamOption_Checked">
                                        <TextBlock x:Name="txtOptA" Text="A. Option A" FontSize="14" TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <RadioButton x:Name="rbOptB" Style="{StaticResource ExamOptionRadio}" Checked="ExamOption_Checked">
                                        <TextBlock x:Name="txtOptB" Text="B. Option B" FontSize="14" TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <RadioButton x:Name="rbOptC" Style="{StaticResource ExamOptionRadio}" Checked="ExamOption_Checked">
                                        <TextBlock x:Name="txtOptC" Text="C. Option C" FontSize="14" TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <RadioButton x:Name="rbOptD" Style="{StaticResource ExamOptionRadio}" Checked="ExamOption_Checked">
                                        <TextBlock x:Name="txtOptD" Text="D. Option D" FontSize="14" TextWrapping="Wrap"/>
                                    </RadioButton>
                                </StackPanel>

                                <!-- DẠNG 2: ĐIỀN KHUYẾT / TRẢ LỜI NGẮN / VIẾT LẠI CÂU / SỬA LỖI / SẮP XẾP -->
                                <StackPanel x:Name="pnlTextInputAnswer" Visibility="Collapsed" Margin="0,0,0,16">
                                    <TextBlock x:Name="lblTextInputGuide" Text="✍️ Nhập câu trả lời của bạn vào ô bên dưới:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>
                                    <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.5" CornerRadius="10" Padding="12">
                                        <TextBox x:Name="txtStudentTextAnswer" FontSize="14" Foreground="{StaticResource TextDark}" BorderThickness="0" Background="Transparent"
                                                 Padding="4" TextChanged="TxtStudentTextAnswer_TextChanged"/>
                                    </Border>
                                    <TextBlock Text="💡 Bạn có thể nhập từ hoặc cụm từ còn thiếu theo yêu cầu đề bài." FontSize="11.5" Foreground="{StaticResource TextGray}" Margin="4,6,0,0"/>
                                </StackPanel>

                                <!-- DẠNG 3: VIẾT TỰ LUẬN / ĐOẠN VĂN / BÀI LUẬN (WRITING) -->
                                <StackPanel x:Name="pnlEssayAnswer" Visibility="Collapsed" Margin="0,0,0,16">
                                    <Border Background="#F0FDF4" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="📋 Tiêu chí chấm điểm (AI Grading Rubric):" FontWeight="Bold" FontSize="12" Foreground="#047857" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="txtEssayRubric" Text="Chấm theo mức độ hoàn thành nhiệm vụ, tính mạch lạc, vốn từ vựng và độ chính xác ngữ pháp." FontSize="12" TextWrapping="Wrap" Foreground="#065F46"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="📝 Bài làm của bạn:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="txtEssayWordCount" Text="Số từ: 0 từ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                        </Border>
                                    </Grid>

                                    <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.5" CornerRadius="10" Padding="12">
                                        <TextBox x:Name="txtStudentEssayAnswer" MinHeight="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 FontSize="14" Foreground="{StaticResource TextDark}" BorderThickness="0" Background="Transparent"
                                                 TextChanged="TxtStudentEssayAnswer_TextChanged"/>
                                    </Border>
                                </StackPanel>

                                <!-- Navigation Buttons -->
                                <Grid Margin="0,15,0,0">
                                    <Button x:Name="btnPrevQuestion" Content="⬅ Câu trước" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnPrevQuestion_Click"/>
                                    <Button x:Name="btnNextQuestion" Content="Câu tiếp theo ➔" Style="{StaticResource StartTestButton}" HorizontalAlignment="Right" Click="BtnNextQuestion_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Question Navigation Matrix -->
                <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Bảng câu hỏi làm bài" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                        
                        <!-- Legend (TASK-206: Answered, Flagged, Unanswered) -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock x:Name="txtNavProgress" Text="Đã làm: 0 / 10 câu" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource BrandTeal}" Width="12" Height="12" CornerRadius="3" Margin="0,0,5,0"/>
                                <TextBlock Text="Đã làm" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,10,0"/>
                                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Width="12" Height="12" CornerRadius="3" Margin="0,0,5,0"/>
                                <TextBlock Text="Cờ 🚩" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,0,10,0"/>
                                <Border Background="#F1F5F9" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Width="12" Height="12" CornerRadius="3" Margin="0,0,5,0"/>
                                <TextBlock Text="Chưa làm" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- WrapPanel for Question Number Buttons -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="pnlQuestionNavButtons" HorizontalAlignment="Left"/>
                        </ScrollViewer>

                        <!-- Bottom Warning -->
                        <Border Grid.Row="3" Background="#FEF3C7" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                            <TextBlock Text="💡 Bạn có thể bấm vào số câu bất kỳ để nhảy thẳng tới câu hỏi đó." 
                                       FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= VIEW 3: MÀN HÌNH XEM LẠI BÀI THI (TASK-208: REVIEW MODE) ================= -->
        <ScrollViewer x:Name="pnlXemLaiBaiThi" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25" Visibility="Collapsed">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- Scoreboard Summary Card -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="30,24" Margin="0,0,0,24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Big Score Badge -->
                        <Border Grid.Column="0" Background="{StaticResource BrandTealLight}" CornerRadius="16" Width="110" Height="110" Margin="0,0,25,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtReviewScore" Text="8.5" FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center"/>
                                <TextBlock Text="/ 10.0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Details & AI Comment -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="{StaticResource BrandMintSoft}" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtReviewVerdict" Text="KẾT QUẢ: ĐẠT CHUẨN TỐT" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                </Border>
                                <TextBlock x:Name="txtReviewTestTitle" Text="IELTS Reading Mini Mock Test #05" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Mini Metrics -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="txtReviewCorrectCount" Text="✅ Đúng: 8/10 câu" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrandMint}" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtReviewWrongCount" Text="❌ Sai: 2/10 câu" FontWeight="SemiBold" FontSize="13" Foreground="#EF4444" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtReviewTimeSpent" Text="⏱️ Thời gian: 14:20" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>

                            <TextBlock x:Name="txtReviewAiFeedback" 
                                       Text="AI Nhận xét: Bạn nắm rất chắc kỹ năng Skimming và nhận diện từ đồng nghĩa. Cần cải thiện kỹ năng suy luận các câu hỏi suy diễn ngữ nghĩa phức tạp." 
                                       FontSize="13.5" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="🔄 Làm lại bài thi này" Style="{StaticResource StartTestButton}" Margin="0,0,0,10" Click="BtnRetakeExam_Click"/>
                            <Button Content="📋 Về danh sách đề" Style="{StaticResource SecondaryButton}" Click="BtnBackToExamList_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section Title -->
                <TextBlock Text="ĐỐI CHIẾU CHI TIẾT ĐÁP ÁN &amp; LỜI GIẢI CHI TIẾT"
                           FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" Margin="0,0,0,16"/>

                <!-- Detailed Review ItemsControl -->
                <ItemsControl x:Name="icReviewQuestions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                    Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Question Status Header -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding StatusBadgeBg}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding StatusBadgeFg}"/>
                                            </Border>
                                            <TextBlock Text="{Binding QuestionNumberText}" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextDark}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding KyNangTag}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Passage if any -->
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding PassageVisibility}">
                                        <TextBlock Text="{Binding DoanVanDoc}" FontStyle="Italic" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextDark}"/>
                                    </Border>

                                    <!-- Question Prompt -->
                                    <TextBlock Text="{Binding NoiDungCauHoi}" FontSize="15.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <!-- Comparison: Student vs Correct -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Student choice -->
                                        <Border Grid.Column="0" Background="{Binding StudentChoiceBg}" BorderBrush="{Binding StudentChoiceBorder}" 
                                                BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Câu trả lời của bạn:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                                                <TextBlock Text="{Binding StudentChoiceText}" FontWeight="Bold" FontSize="13.5" Foreground="{Binding StudentChoiceFg}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Correct choice -->
                                        <Border Grid.Column="1" Background="{StaticResource BrandMintSoft}" BorderBrush="{StaticResource BrandMint}" 
                                                BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Đáp án chính xác:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}"/>
                                                <TextBlock Text="{Binding CorrectChoiceText}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrandTeal}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Detailed Explanation Box -->
                                    <Border Background="{StaticResource BrandTealLight}" CornerRadius="8" Padding="14" BorderBrush="#99F6E4" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="💡 Giải thích đáp án &amp; Điểm ngữ pháp:" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrandTeal}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ExplanationText}" FontSize="13.5" TextWrapping="Wrap" Foreground="{StaticResource TextDark}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
