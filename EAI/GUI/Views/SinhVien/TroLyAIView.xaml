<Page x:Class="GUI.Views.TroLyAIView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Trợ lý AI - EnglishAI"
      FontFamily="Segoe UI"
      Background="#F4F7F6">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="PromptChipButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandTealLight}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrandTeal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TealActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#F4F7F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EnglishAI / " Foreground="{StaticResource TextGray}" FontSize="13"/>
                    <TextBlock Text="Gia sư Trợ lý AI Thông Minh 24/7" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,125,0">
                    <Border Background="#DCFCE7" CornerRadius="12" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0"/>
                            <TextBlock Text="AI Online • Sẵn sàng giải đáp 24/7" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Conversation Messages Area -->
        <ScrollViewer x:Name="chatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20">
            <StackPanel x:Name="pnlChatMessages" MaxWidth="950" HorizontalAlignment="Stretch">

                <!-- Welcome Bot Message -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrandTealLight}" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top">
                        <TextBlock Text="🤖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                            Padding="18,14" Margin="10,0,80,0" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="EnglishAI Tutor" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrandTeal}" Margin="0,0,0,6"/>
                            <TextBlock Text="Xin chào bạn! Mình là Gia sư AI thông minh đồng hành cùng bạn trên lộ trình học tiếng Anh. Bạn có thể hỏi mình bất kỳ thắc mắc nào về ngữ pháp, tra từ vựng, sửa lỗi phát âm, hoặc yêu cầu bài tập mẫu bất cứ lúc nào nhé!" 
                                       FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{StaticResource TextDark}"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Input & Quick Suggestions Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="25,15,25,18">
            <StackPanel MaxWidth="950" HorizontalAlignment="Stretch">

                <!-- Quick Prompts Chips -->
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="💡 Phân biệt Present Perfect vs Past Simple" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                    <Button Content="📝 Sửa lỗi ngữ pháp câu này" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                    <Button Content="📚 5 Collocations hay chủ đề Environment" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                    <Button Content="🗣️ Mẫu câu luyện nói phỏng vấn xin việc" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                </WrapPanel>

                <!-- Input Box & Send Button -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.5">
                        <TextBox x:Name="txtChatInput" Height="42" Padding="12,8" FontSize="14" 
                                 BorderThickness="0" Background="Transparent" 
                                 KeyDown="TxtChatInput_KeyDown"/>
                    </Border>

                    <Button Grid.Column="1" Content="🚀 Gửi tin nhắn" Style="{StaticResource TealActionButton}" 
                            Margin="12,0,0,0" Click="BtnSendMessage_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
