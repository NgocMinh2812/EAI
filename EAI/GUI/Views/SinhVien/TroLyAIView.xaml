<Page x:Class="GUI.Views.TroLyAIView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Trợ lý Gia sư AI - EnglishAI"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <!-- Brand Colors -->
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandTealBorder" Color="#99F6E4" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="BrandMintSoft" Color="#DCFCE7" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMuted" Color="#475569" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#CBD5E1" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PageBg" Color="#F8FAFC" />

        <!-- Button: New Chat -->
        <Style x:Key="NewChatButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F766E" Offset="0"/>
                        <GradientStop Color="#0D9488" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#0F766E"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Prompt Chip Style -->
        <Style x:Key="PromptChipButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrandTealLight}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandTeal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Tab Pill Style -->
        <Style x:Key="FilterTabPill" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Filter Tab Pill -->
        <Style x:Key="ActiveFilterTabPill" TargetType="Button" BasedOn="{StaticResource FilterTabPill}">
            <Setter Property="Background" Value="{StaticResource BrandTealLight}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandTeal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Modern Primary Action Button -->
        <Style x:Key="TealActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Ghost Button -->
        <Style x:Key="GhostIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Hero Card Style -->
        <Style x:Key="SuggestionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrandTealBorder}"/>
                    <Setter Property="Background" Value="#F0FDFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <!-- Cot trai: Lich su hoi thoai -->
            <ColumnDefinition Width="280" x:Name="colHistorySidebar"/>
            <!-- Cot phai: Khu vuc Chatbot chinh -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- COT TRAI: LICH SU HOI THOAI -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Sidebar & Nut tao cuoc hoi thoai moi -->
                <StackPanel Grid.Row="0" Margin="16,16,16,12">
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="History" Size="18" Foreground="{StaticResource BrandTeal}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lịch sử trò chuyện" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Huy hieu dem so cuoc tro chuyen -->
                        <Border HorizontalAlignment="Right" Background="{StaticResource BrandTealLight}" CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="txtHistoryCountBadge" Text="0 đoạn chat" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}"/>
                        </Border>
                    </Grid>

                    <!-- NUT TAO CUOC HOI THOAI MOI -->
                    <Button x:Name="btnNewChat" Style="{StaticResource NewChatButtonStyle}" Click="BtnNewChat_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="Plus" Size="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cuộc hội thoại mới" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 2. O tim kiem lich su tro chuyen -->
                <Border Grid.Row="1" Margin="16,0,16,10" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:LucideIcon Grid.Column="0" Kind="Search" Size="14" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="txtSearchHistory" BorderThickness="0" Background="Transparent" 
                                 FontSize="12" Padding="4,2" VerticalAlignment="Center" 
                                 TextChanged="TxtSearchHistory_TextChanged"/>
                        <TextBlock Grid.Column="1" x:Name="txtSearchPlaceholder" Text="Tìm kiếm đoạn chat..." 
                                   Foreground="{StaticResource TextGray}" FontSize="12" Padding="4,2" 
                                   IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Visible"/>
                    </Grid>
                </Border>

                <!-- 3. Bo loc phan loai nhanh -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,0,16,8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnFilterAll" Content="Tất cả" Style="{StaticResource ActiveFilterTabPill}" Tag="All" Click="BtnFilterCategory_Click"/>
                        <Button x:Name="btnFilterGrammar" Content="Ngữ pháp" Style="{StaticResource FilterTabPill}" Tag="Grammar" Click="BtnFilterCategory_Click"/>
                        <Button x:Name="btnFilterVocab" Content="Từ vựng" Style="{StaticResource FilterTabPill}" Tag="Vocab" Click="BtnFilterCategory_Click"/>
                        <Button x:Name="btnFilterComm" Content="Giao tiếp" Style="{StaticResource FilterTabPill}" Tag="Comm" Click="BtnFilterCategory_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. Danh sach cac cuoc tro chuyen -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="8,0,8,6">
                    <StackPanel x:Name="pnlHistoryList">
                        <!-- Items populated from code-behind -->
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. Footer thong tin dong bo -->
                <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="ShieldCheck" Size="14" Foreground="{StaticResource BrandTeal}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Đã liên kết tài khoản học viên" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <TextBlock Text="Lịch sử được lưu trữ tự động theo UserId" FontSize="10.5" Foreground="{StaticResource TextGray}" Margin="20,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- COT PHAI: KHU VUC CHATBOT CHINH -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: TOP HEADER BAR -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bot Info Header -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Margin="0,0,12,0">
                            <Border Width="38" Height="38" CornerRadius="19">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0F766E" Offset="0"/>
                                        <GradientStop Color="#14B8A6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <local:LucideIcon Kind="Bot" Size="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Ellipse Width="10" Height="10" Fill="#16A34A" Stroke="White" StrokeThickness="1.8" 
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        </Grid>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Gia sư AI Tiếng Anh" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource TextDark}" Margin="0,0,8,0"/>
                                <Border Background="{StaticResource BrandMintSoft}" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="AI Online 24/7" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                    <TextBlock x:Name="txtActiveModelBadge" Text="🤖 AI Service" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Giải đáp ngữ pháp, tra từ vựng, hướng dẫn đáp án &amp; luyện giao tiếp song ngữ" 
                                       FontSize="11.5" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Controls: Nut thao tac (Chua le 125px cho nut thu nho/phong to/dong cua so) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,125,0">
                        <!-- Nut Xoa cuoc tro chuyen hien tai -->
                        <Button x:Name="btnClearCurrentChat" Style="{StaticResource GhostIconButtonStyle}" Margin="0,0,8,0" 
                                ToolTip="Xóa nội dung cuộc trò chuyện hiện tại" Click="BtnClearCurrentChat_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Kind="Trash2" Size="15" Foreground="{StaticResource TextGray}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Xóa chat" FontSize="12" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Nut Tro giup -->
                        <Button x:Name="btnHelp" Style="{StaticResource GhostIconButtonStyle}" ToolTip="Hướng dẫn sử dụng Gia sư AI" Click="BtnHelp_Click">
                            <local:LucideIcon Kind="HelpCircle" Size="17" Foreground="{StaticResource TextGray}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: THANH BO LOC CHU DE & CHE DO HOC TAP -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="20,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <local:LucideIcon Kind="Sliders" Size="14" Foreground="{StaticResource BrandTeal}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Chế độ học:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnModeAll" Content="🌟 Tất cả" Style="{StaticResource ActiveFilterTabPill}" Tag="All" Click="BtnMode_Click"/>
                                <Button x:Name="btnModeGrammar" Content="💡 Ngữ pháp" Style="{StaticResource FilterTabPill}" Tag="Grammar" Click="BtnMode_Click"/>
                                <Button x:Name="btnModeVocab" Content="📚 Từ vựng" Style="{StaticResource FilterTabPill}" Tag="Vocab" Click="BtnMode_Click"/>
                                <Button x:Name="btnModeExplain" Content="🎯 Giải đáp" Style="{StaticResource FilterTabPill}" Tag="Explain" Click="BtnMode_Click"/>
                                <Button x:Name="btnModeSpeaking" Content="🗣️ Giao tiếp" Style="{StaticResource FilterTabPill}" Tag="Speaking" Click="BtnMode_Click"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ROW 2: KHU VUC TIN NHAN -->
            <ScrollViewer x:Name="chatScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel x:Name="pnlChatContent" MaxWidth="920" HorizontalAlignment="Stretch">

                    <!-- TRANG CHAO DON THAN THIEN & GOI Y CHU DE BAN DAU -->
                    <Border x:Name="pnlWelcomeHero" Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" 
                            BorderThickness="1" Padding="28,24" Margin="0,10,0,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.04" Color="Black"/>
                        </Border.Effect>

                        <StackPanel>
                            <!-- Mascot Banner Chao don -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Margin="0,0,18,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#CCFBF1" Offset="0"/>
                                            <GradientStop Color="#99F6E4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <local:LucideIcon Kind="Sparkles" Size="32" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Chào bạn! Mình là Gia sư AI Tiếng Anh đồng hành cùng bạn 👋" 
                                               FontWeight="Bold" FontSize="18" Foreground="{StaticResource BrandTeal}"/>
                                    <TextBlock Text="Bạn có thể đặt câu hỏi bằng tiếng Việt hoặc gõ trực tiếp bằng tiếng Anh. Mình sẵn sàng giải thích chi tiết cấu trúc ngữ pháp, từ vựng, mẹo giải bài thi và cùng bạn trò chuyện luyện phản xạ giao tiếp 24/7!" 
                                               FontSize="13.5" LineHeight="22" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="{StaticResource BorderLight}" Margin="0,4,0,18"/>

                            <!-- Tieu de Goi y -->
                            <TextBlock Text="💡 BẠN MUỐN BẮT ĐẦU VỚI CHỦ ĐỀ NÀO? (Nhấn để hỏi ngay):" 
                                       FontSize="11.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,12"/>

                            <!-- Grid 4 The Goi y Noi bat -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Ngu phap -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SuggestionCardStyle}" Margin="0,0,8,12" 
                                        Tag="Phân biệt thì Present Perfect và Past Simple" MouseLeftButtonDown="BtnSuggestionCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#FEF3C7" VerticalAlignment="Top">
                                            <local:LucideIcon Kind="Lightbulb" Size="18" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Ngữ pháp &amp; Cấu trúc câu" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                            <TextBlock Text="Phân biệt thì Present Perfect vs Past Simple kèm ví dụ trực quan dễ hiểu." 
                                                       FontSize="12" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Tu vung -->
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SuggestionCardStyle}" Margin="8,0,0,12"
                                        Tag="5 Collocations học thuật chủ đề Môi trường và Biến đổi khí hậu" MouseLeftButtonDown="BtnSuggestionCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#DBEAFE" VerticalAlignment="Top">
                                            <local:LucideIcon Kind="BookOpen" Size="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Từ vựng &amp; Collocations" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                            <TextBlock Text="5 Collocations học thuật ăn điểm chủ đề Môi trường &amp; Công nghệ (IELTS 7.0+)." 
                                                       FontSize="12" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 3: Giai thich dap an -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SuggestionCardStyle}" Margin="0,0,8,0"
                                        Tag="Tại sao câu điều kiện loại 2 lại dùng were thay vì was cho tất cả các ngôi?" MouseLeftButtonDown="BtnSuggestionCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#DCFCE7" VerticalAlignment="Top">
                                            <local:LucideIcon Kind="Target" Size="18" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Giải thích đáp án &amp; Mẹo học" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                            <TextBlock Text="Vì sao câu: 'If I were you...' dùng were thay vì was? Phân tích quy tắc giả định." 
                                                       FontSize="12" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 4: Luyen giao tiep phan xa -->
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SuggestionCardStyle}" Margin="8,0,0,0"
                                        Tag="Let's practice a real-life English conversation about ordering food at a restaurant" MouseLeftButtonDown="BtnSuggestionCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#F3E8FF" VerticalAlignment="Top">
                                            <local:LucideIcon Kind="MessageSquare" Size="18" Foreground="#7E22CE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Luyện giao tiếp phản xạ" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                            <TextBlock Text="Roleplay: Luyện hội thoại tiếng Anh tình huống thực tế (gọi món, phỏng vấn, du lịch)." 
                                                       FontSize="12" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- VUNG HIEN THI DONG TIN NHAN DONG -->
                    <StackPanel x:Name="pnlChatMessages">
                        <!-- Tin nhan se duoc add vao day -->
                    </StackPanel>

                    <!-- TRANG THAI LOADING KHI AI DANG PHAN HOI -->
                    <Border x:Name="pnlLoadingIndicator" Visibility="Collapsed" Margin="0,4,0,16" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource BrandTealLight}" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top">
                                <local:LucideIcon Kind="Bot" Size="18" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                    Padding="16,12" Margin="10,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="Black"/>
                                </Border.Effect>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Kind="Loader2" Size="18" Foreground="{StaticResource BrandTeal}" Spin="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Gia sư AI đang phân tích và soạn phản hồi" FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrandTeal}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtLoadingDots" Text=" . . ." FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- XU LY LOI KHI AI API KHONG PHAN HOI -->
                    <Border x:Name="pnlErrorMessage" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,4,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <local:LucideIcon Grid.Column="0" Kind="AlertCircle" Size="20" Foreground="#DC2626" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Không thể kết nối đến AI Service hoặc dịch vụ đang bận" FontWeight="SemiBold" FontSize="13" Foreground="#991B1B"/>
                                <TextBlock x:Name="txtErrorDetail" Text="Vui lòng kiểm tra lại kết nối mạng hoặc nhấn nút Thử lại bên cạnh." FontSize="12" Foreground="#B91C1C" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="🔄 Thử lại" Style="{StaticResource TealActionButton}" Background="#DC2626" Padding="12,6" FontSize="12" Click="BtnRetry_Click"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ROW 3: THANH SOAN THAO VA GUI CAU HOI -->
            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="24,12,24,16">
                <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">

                    <!-- Hang Chip goi y cau hoi nhanh -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="💡 Phân biệt Thì Present Perfect vs Past Simple" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                            <Button Content="📝 Sửa lỗi ngữ pháp &amp; viết lại câu" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                            <Button Content="📚 5 Collocations hay chủ đề Environment" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                            <Button Content="🎯 Giải thích đáp án câu hỏi trắc nghiệm" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                            <Button Content="🗣️ Mẫu câu giao tiếp phỏng vấn xin việc" Style="{StaticResource PromptChipButton}" Click="BtnPrompt_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Khung Nhap Lieu Da Dong Hien Dai -->
                    <Border Background="White" CornerRadius="14" BorderBrush="#CBD5E1" BorderThickness="1.5" Padding="14,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- O nhap tin nhan da dong -->
                            <TextBox Grid.Row="0" x:Name="txtChatInput" MinHeight="44" MaxHeight="120" 
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                     FontSize="13.5" Padding="2,4" BorderThickness="0" Background="Transparent" 
                                     KeyDown="TxtChatInput_KeyDown" TextChanged="TxtChatInput_TextChanged"/>

                            <!-- Placeholder cho o nhap tin nhan -->
                            <TextBlock Grid.Row="0" x:Name="txtInputPlaceholder" 
                                       Text="Hỏi bất kỳ điều gì bằng tiếng Việt hoặc tiếng Anh... (Nhấn Enter để gửi, Shift+Enter xuống dòng)" 
                                       Foreground="{StaticResource TextGray}" FontSize="13.5" Padding="2,6" 
                                       IsHitTestVisible="False" VerticalAlignment="Top" Visibility="Visible"/>

                            <!-- Thanh cong cu phia duoi o nhap -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Huy hieu chi bao che do song ngu -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#E2E8F0" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="🌐 Song ngữ Anh - Việt" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextDark}"/>
                                    </Border>
                                    <TextBlock x:Name="txtCurrentModeIndicator" Text="Chế độ: Gia sư thông minh" FontSize="11" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Nut Xoa nhanh noi dung & Nut Gui tin nhan -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="btnClearInput" Style="{StaticResource GhostIconButtonStyle}" Margin="0,0,8,0" 
                                            Visibility="Collapsed" ToolTip="Xóa văn bản đang nhập" Click="BtnClearInput_Click">
                                        <local:LucideIcon Kind="X" Size="14" Foreground="{StaticResource TextGray}"/>
                                    </Button>

                                    <Button x:Name="btnVoiceInput" Style="{StaticResource GhostIconButtonStyle}" Margin="0,0,8,0" 
                                            ToolTip="Mẹo phát âm &amp; Mẫu câu giao tiếp" Click="BtnVoiceInput_Click">
                                        <local:LucideIcon Kind="Mic" Size="16" Foreground="{StaticResource BrandTeal}"/>
                                    </Button>

                                    <Button x:Name="btnSendMessage" Style="{StaticResource TealActionButton}" Click="BtnSendMessage_Click" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:LucideIcon Kind="Send" Size="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Gửi câu hỏi" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
