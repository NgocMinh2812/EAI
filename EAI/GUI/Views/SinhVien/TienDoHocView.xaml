<Page x:Class="GUI.Views.TienDoHocView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tiến độ học - EnglishAI"
      FontFamily="Segoe UI"
      Background="#F4F7F6">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="BrandMintSoft" Color="#CCFBF1" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.04" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F4F7F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EnglishAI / " Foreground="{StaticResource TextGray}" FontSize="13"/>
                    <TextBlock Text="Báo cáo &amp; Phân tích tiến độ học tập chi tiết" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,125,0">
                    <Button Content="📥 Xuất báo cáo PDF" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                            FontWeight="Medium" Padding="12,6" BorderThickness="0" Cursor="Hand" Click="BtnExportReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- 4 KPI Summary Cards -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1 -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="⏱️ THỜI GIAN HỌC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Text="48h 30m" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,6,0,4"/>
                            <TextBlock Text="↑ +15% so với tháng trước" FontSize="12" Foreground="{StaticResource BrandMint}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2 -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="📚 BÀI HỌC HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Text="42 bài" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,6,0,4"/>
                            <TextBlock Text="Tỷ lệ hoàn thành: 84%" FontSize="12" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3 -->
                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="💡 TỪ VỰNG ĐÃ THUỘC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Text="485 từ" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,6,0,4"/>
                            <TextBlock Text="Band B2 - C1 Academic" FontSize="12" Foreground="#8B5CF6" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4 -->
                    <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="🎯 ĐIỂM BÌNH QUÂN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                            <TextBlock Text="8.2 / 10" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,6,0,4"/>
                            <TextBlock Text="Tương đương IELTS 6.5" FontSize="12" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Detailed Skill Breakdown & Streak -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Skills Proficiency -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Phân tích độ thuần thục theo từng kỹ năng" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,16"/>

                            <!-- Skill 1 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="📖 Từ vựng (Vocabulary)" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="85% • Rất tốt" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="85" Maximum="100" Height="8" Foreground="{StaticResource BrandTeal}" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,14"/>

                            <!-- Skill 2 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="📝 Ngữ pháp (Grammar)" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="78% • Khá tốt" FontSize="13" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="78" Maximum="100" Height="8" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,14"/>

                            <!-- Skill 3 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="📚 Đọc hiểu (Reading)" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="82% • Rất tốt" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="82" Maximum="100" Height="8" Foreground="#7C3AED" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,14"/>

                            <!-- Skill 4 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="🎧 Nghe hiểu (Listening)" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="68% • Cần rèn thêm" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="68" Maximum="100" Height="8" Foreground="#D97706" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,14"/>

                            <!-- Skill 5 -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="✍️ Viết luận (Writing Task 2)" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="72% • Khá" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandMint}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="72" Maximum="100" Height="8" Foreground="{StaticResource BrandMint}" Background="#E2E8F0" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Study Streak Calendar & Habit -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Chuỗi ngày học liên tục (Streak)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>
                            
                            <Border Background="#FEF3C7" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔥" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="12 ngày liên tiếp" FontWeight="Bold" FontSize="16" Foreground="#B45309"/>
                                        <TextBlock Text="Chỉ còn 2 ngày nữa để đạt huy hiệu 2 tuần!" FontSize="11.5" Foreground="#92400E"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Lịch hoạt động tuần này:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <UniformGrid Columns="7" Margin="0,0,0,15">
                                <TextBlock Text="T2" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="T3" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="T4" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="T5" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="T6" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="T7" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Text="CN" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                            </UniformGrid>

                            <UniformGrid Columns="7">
                                <Border Background="{StaticResource BrandMintSoft}" Width="28" Height="28" CornerRadius="14" Margin="2">
                                    <TextBlock Text="✓" Foreground="{StaticResource BrandTeal}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{StaticResource BrandMintSoft}" Width="28" Height="28" CornerRadius="14" Margin="2">
                                    <TextBlock Text="✓" Foreground="{StaticResource BrandTeal}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{StaticResource BrandMintSoft}" Width="28" Height="28" CornerRadius="14" Margin="2">
                                    <TextBlock Text="✓" Foreground="{StaticResource BrandTeal}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{StaticResource BrandMintSoft}" Width="28" Height="28" CornerRadius="14" Margin="2">
                                    <TextBlock Text="✓" Foreground="{StaticResource BrandTeal}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{StaticResource BrandMintSoft}" Width="28" Height="28" CornerRadius="14" Margin="2">
                                    <TextBlock Text="✓" Foreground="{StaticResource BrandTeal}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{StaticResource BrandMintSoft}" Width="28" Height="28" CornerRadius="14" Margin="2">
                                    <TextBlock Text="✓" Foreground="{StaticResource BrandTeal}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{StaticResource BrandTeal}" Width="28" Height="28" CornerRadius="14" Margin="2">
                                    <TextBlock Text="Hôm" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Badges / Achievements -->
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="🏆 Huy hiệu thành tích đã mở khóa" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,16"/>
                        <WrapPanel>
                            <Border Background="#FEF3C7" CornerRadius="10" Padding="14,10" Margin="0,0,14,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔥" FontSize="20" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Chiến binh Chăm chỉ" FontWeight="Bold" FontSize="13" Foreground="#B45309"/>
                                        <TextBlock Text="Học liên tiếp 7 ngày" FontSize="11" Foreground="#92400E"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BrandTealLight}" CornerRadius="10" Padding="14,10" Margin="0,0,14,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📚" FontSize="20" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Bậc thầy Từ vựng" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandTeal}"/>
                                        <TextBlock Text="Thuộc 300+ từ AWL" FontSize="11" Foreground="{StaticResource BrandTealDark}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF6FF" CornerRadius="10" Padding="14,10" Margin="0,0,14,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" FontSize="20" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Kỷ lục Gia sư AI" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
                                        <TextBlock Text="Hoàn thành 30 câu hỏi quiz" FontSize="11" Foreground="#1E40AF"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
