<Page x:Class="GUI.Views.TienDoHocView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Title="Tiến độ học - EnglishAI"
      FontFamily="Segoe UI"
      Background="#F8FAFC"
      Loaded="Page_Loaded">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="BrandMintSoft" Color="#CCFBF1" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.05" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Filter Tab Button Style -->
        <Style x:Key="FilterTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandTeal}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation & Action Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EnglishAI / " Foreground="{StaticResource TextGray}" FontSize="13"/>
                    <TextBlock Text="Bảng tiến độ học tập &amp; Phân tích năng lực" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                </StackPanel>

                <!-- Time Filter Tabs + Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,125,0">
                    <!-- Segmented Filter Tabs -->
                    <Border Background="#F1F5F9" CornerRadius="10" Padding="3" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbFilterTuan" Content="Tuần này" GroupName="TienDoFilter" 
                                         Style="{StaticResource FilterTabButtonStyle}" Checked="Filter_Checked"/>
                            <RadioButton x:Name="rbFilterThang" Content="Tháng này" GroupName="TienDoFilter" 
                                         Style="{StaticResource FilterTabButtonStyle}" Checked="Filter_Checked"/>
                            <RadioButton x:Name="rbFilterTatCa" Content="Toàn thời gian" GroupName="TienDoFilter" IsChecked="True" 
                                         Style="{StaticResource FilterTabButtonStyle}" Checked="Filter_Checked"/>
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <Button x:Name="btnRefresh" Content="🔄 Làm mới" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                            FontWeight="Medium" Padding="12,6" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnRefresh_Click"/>

                    <!-- Export Report PDF Button -->
                    <Button Content="📥 Xuất báo cáo" Background="{StaticResource BrandTeal}" Foreground="White" 
                            FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Cursor="Hand" Click="BtnExportReport_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Dashboard Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20,25,30">
            <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch">

                <!-- 4 KPI Summary Cards -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Tổng giờ học tích lũy -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="⏱️ TỔNG GIỜ HỌC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                                <Border Background="{StaticResource BrandMintSoft}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="Tích lũy" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="txtTongGioHoc" Text="0 phút" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,4"/>
                            <TextBlock x:Name="txtSubGioHoc" Text="Ghi nhận trên toàn hệ thống" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Tổng bài thi hoàn thành -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="📝 BÀI THI HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                                <Border Background="#EEF2FF" CornerRadius="10" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="txtBadgeTyLeDat" Text="0% Đạt" FontSize="10.5" FontWeight="Bold" Foreground="#4F46E5"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="txtTongBaiThi" Text="0 bài" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,4"/>
                            <TextBlock x:Name="txtSubBaiThi" Text="Đã nộp và chấm điểm" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Điểm trung bình các lần thi -->
                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="🎯 ĐIỂM TRUNG BÌNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                                <Border Background="{StaticResource BrandTealLight}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="txtXepLoaiBadge" Text="Chưa có" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="txtDiemTB" Text="-- / 10" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,4"/>
                            <TextBlock x:Name="txtSubDiemTB" Text="Điểm trung bình các bài thi" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Tiến độ hoàn thành mục tiêu -->
                    <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="🏆 TIẾN ĐỘ MỤC TIÊU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                                <TextBlock x:Name="txtPhanTramMucTieu" Text="0%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="txtMucTieuTitle" Text="IELTS Target" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="pbTienDoMucTieu" Value="0" Maximum="100" Height="7" Foreground="{StaticResource BrandTeal}" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtMoTaMucTieu" Text="Theo dõi mục tiêu học tập cá nhân" FontSize="11.5" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SECTION 1: 2 CHARTS SIDE-BY-SIDE (Line Chart & Pie Chart) -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Biểu đồ đường (LineChart): Diễn biến điểm số qua từng lần thi -->
                    <Border Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="260"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="📈 Diễn biến điểm số qua các lần thi" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                                        <Border Background="{StaticResource BrandTealLight}" CornerRadius="8" Padding="7,2" Margin="10,0,0,0">
                                            <TextBlock Text="Biểu đồ đường" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Theo dõi phong độ và mức độ tiến bộ qua từng bài thi đã hoàn thành" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </Grid>

                            <!-- LiveCharts CartesianChart (LineSeries) -->
                            <lvc:CartesianChart x:Name="chartDiemSo" Grid.Row="1" LegendLocation="None" Hoverable="True" DisableAnimations="False">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis x:Name="axisXDiemSo" Title="Lần làm bài" Foreground="#64748B" FontSize="11">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Step="1" Stroke="#F1F5F9" StrokeThickness="1"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Thang điểm (0 - 10)" MinValue="0" MaxValue="10" Foreground="#64748B" FontSize="11">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Step="2" Stroke="#F1F5F9" StrokeThickness="1"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>

                            <!-- Overlay Empty State for Line Chart -->
                            <StackPanel x:Name="pnlEmptyLineChart" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="📉" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Chưa có dữ liệu điểm thi" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Hãy làm bài thi thử để xem biểu đồ phong độ điểm số của bạn" FontSize="12" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Biểu đồ tròn (PieChart): Tỷ lệ bài thi Đạt và Chưa đạt -->
                    <Border Grid.Column="2" Style="{StaticResource ChartCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="210"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🥧 Tỷ lệ Đạt &amp; Chưa đạt" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                                        <Border Background="{StaticResource BrandMintSoft}" CornerRadius="8" Padding="7,2" Margin="10,0,0,0">
                                            <TextBlock Text="Biểu đồ tròn" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandMint}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Dựa trên ngưỡng điểm đạt (DiemDat >= 5.0)" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </Grid>

                            <!-- LiveCharts PieChart -->
                            <lvc:PieChart x:Name="chartTyLe" Grid.Row="1" LegendLocation="Bottom" Hoverable="True" InnerRadius="42">
                                <lvc:PieChart.ChartLegend>
                                    <lvc:DefaultLegend BulletSize="12" FontSize="11" Foreground="#475569" Margin="0,8,0,0"/>
                                </lvc:PieChart.ChartLegend>
                            </lvc:PieChart>

                            <!-- Pie Chart Summary Row -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="8" Padding="10,6" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✓ Đạt: " FontWeight="Bold" Foreground="#166534" FontSize="12"/>
                                        <TextBlock x:Name="txtSoBaiDat" Text="0 bài (0%)" FontWeight="SemiBold" Foreground="#166534" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="8" Padding="10,6" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✕ Chưa đạt: " FontWeight="Bold" Foreground="#991B1B" FontSize="12"/>
                                        <TextBlock x:Name="txtSoBaiChuaDat" Text="0 bài (0%)" FontWeight="SemiBold" Foreground="#991B1B" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Overlay Empty State for Pie Chart -->
                            <StackPanel x:Name="pnlEmptyPieChart" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="🎯" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Chưa có tỷ lệ kết quả" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Hoàn thành bài thi đầu tiên để ghi nhận" FontSize="12" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SECTION 2: COLUMN CHART (Biểu đồ cột: Thống kê số giờ học theo ngày/tuần) -->
                <Border Style="{StaticResource ChartCardStyle}" Margin="0,0,0,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="📊 Thống kê thời gian học tích lũy theo ngày" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                                    <Border Background="{StaticResource BrandTealLight}" CornerRadius="8" Padding="7,2" Margin="10,0,0,0">
                                        <TextBlock Text="Biểu đồ cột" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Phân bổ thời gian học bài và thi thử (đơn vị: phút)" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tổng thời gian giai đoạn này: " FontSize="12" Foreground="{StaticResource TextGray}"/>
                                    <TextBlock x:Name="txtTongPhutGiaiDoan" Text="0 phút" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandTeal}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- LiveCharts ColumnChart -->
                        <lvc:CartesianChart x:Name="chartThoiGian" Grid.Row="1" LegendLocation="None" Hoverable="True" DisableAnimations="False">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis x:Name="axisXThoiGian" Title="Ngày trong giai đoạn" Foreground="#64748B" FontSize="11">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" Stroke="#F1F5F9" StrokeThickness="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis x:Name="axisYThoiGian" Title="Thời gian học (phút)" MinValue="0" Foreground="#64748B" FontSize="11">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="15" Stroke="#F1F5F9" StrokeThickness="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <!-- SECTION 3: DETAILED TEST HISTORY TABLE -->
                <Border Style="{StaticResource ChartCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📋 Lịch sử chi tiết các lần làm bài gần nhất" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Bảng dữ liệu thực tế từ hệ thống đánh giá &amp; thi thử" FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="txtTongSoLanLam" Text="Tổng cộng: 0 lượt làm" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>

                        <!-- Table Header -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="LẦN THI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Grid.Column="1" Text="TÊN ĐỀ THI / BÀI TẬP" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Grid.Column="2" Text="THỜI ĐIỂM NỘP" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                <TextBlock Grid.Column="3" Text="THỜI GIAN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="SỐ CÂU ĐÚNG" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="ĐIỂM SỐ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="KẾT QUẢ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Empty State Container when no tests exist -->
                        <Border x:Name="pnlEmptyState" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="30" Margin="0,4,0,0" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✨ 📊 📝" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Bạn chưa có dữ liệu bài thi nào trong khoảng thời gian này" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Hãy tham gia các bài thi thử hoặc bài luyện tập chuyên đề để hệ thống tự động ghi nhận điểm số và cập nhật tiến độ học tập của bạn!" 
                                           FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="560" Margin="0,6,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="📝 Tham gia Thi thử ngay" Background="{StaticResource BrandTeal}" Foreground="White" FontWeight="SemiBold" 
                                            Padding="16,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnGoToThiThu_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="🎯 Luyện tập theo chủ đề" Background="#F1F5F9" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" 
                                            Padding="16,8" BorderThickness="0" Cursor="Hand" Click="BtnGoToLuyenTap_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ItemsControl for Test History Rows -->
                        <ItemsControl x:Name="icLichSuThi">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Lần thi # -->
                                            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LanThiLabel}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextDark}"/>
                                            </Border>

                                            <!-- Tên đề thi & loại hình -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding TenDeThi}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding HinhThucLam}" FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Thời điểm nộp -->
                                            <TextBlock Grid.Column="2" Text="{Binding NgayNopText}" FontSize="12" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>

                                            <!-- Thời gian làm bài -->
                                            <TextBlock Grid.Column="3" Text="{Binding ThoiGianHienThi}" FontSize="12" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Số câu đúng -->
                                            <TextBlock Grid.Column="4" Text="{Binding SoCauDungText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Điểm số -->
                                            <TextBlock Grid.Column="5" Text="{Binding DiemHienThi}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Badge Kết quả ĐẠT / CHƯA ĐẠT -->
                                            <Border Grid.Column="6" Background="{Binding TrangThaiBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrangThaiText}" FontWeight="Bold" FontSize="11" Foreground="{Binding TrangThaiFg}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
