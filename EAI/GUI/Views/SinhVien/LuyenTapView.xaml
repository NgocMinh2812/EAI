<Page x:Class="GUI.Views.LuyenTapView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GUI"
      Title="Trung tâm luyện tập phản xạ &amp; Kỹ năng - EnglishAI"
      FontFamily="Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Background="#F4F7F6">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="BrandMintSoft" Color="#CCFBF1" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#475569" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="TabHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TealActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernFilterChipButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#0F766E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PracticeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0D9488"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.08" Color="#0F766E"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartPracticeCardButton" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18" Color="#0F766E"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBdr" Property="Background" Value="#115E59"/>
                                <Setter TargetName="btnBdr" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#0F766E"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBdr" Property="Background" Value="#042F2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OptionAnswerButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="optBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#F4F7F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" x:Name="rowTopHeader"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER ================= -->
        <Border x:Name="pnlTopHeader" Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EnglishAI / " Foreground="{StaticResource TextGray}" FontSize="13"/>
                    <TextBlock x:Name="txtHeaderTitle" Text="Trung tâm luyện tập linh hoạt &amp; Kỹ năng" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                </StackPanel>

                <!-- Status Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,125,0">
                    <Border Background="#FEF3C7" CornerRadius="16" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="Flame" Size="13" Foreground="#B45309" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtStreakText" Text="Streak: 7 ngày" FontWeight="SemiBold" FontSize="12.5" Foreground="#B45309" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrandTealLight}" CornerRadius="16" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:LucideIcon Kind="Zap" Size="13" Foreground="{StaticResource BrandTeal}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtUserScore" Text="Điểm tích lũy: 150 pts" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrandTeal}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY ================= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" x:Name="rowModeTabs"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Mode Switch Tabs -->
            <Border x:Name="pnlModeTabs" Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,6,25,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="tabHub" Content="Luyện tập theo kỹ năng &amp; chủ đề" Style="{StaticResource TabHeaderButton}" 
                            BorderBrush="{StaticResource BrandTeal}" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" Click="TabHub_Click"/>
                    <Button x:Name="tabWrongQuestions" Content="Ôn tập câu đã sai" Style="{StaticResource TabHeaderButton}" Margin="15,0,0,0" Click="TabWrongQuestions_Click"/>
                    <Button x:Name="tabHistory" Content="Lịch sử luyện tập" Style="{StaticResource TabHeaderButton}" Margin="15,0,0,0" Click="TabHistory_Click"/>
                    <Button x:Name="tabFlashcard" Content="Flashcard từ vựng (Sắp ra mắt)" Style="{StaticResource TabHeaderButton}" Margin="15,0,0,0" Click="TabFlashcard_Click"/>
                    <Button x:Name="tabDictation" Content="Nghe chép chính tả (Sắp ra mắt)" Style="{StaticResource TabHeaderButton}" Margin="15,0,0,0" Click="TabDictation_Click"/>
                </StackPanel>
            </Border>

            <!-- Scrollable Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                    <!-- ========================================================================= -->
                    <!-- TAB 1: ADAPTIVE PRACTICE HUB (LUYỆN TẬP THÍCH ỨNG THEO YÊU CẦU 4) -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="pnlHub" Visibility="Visible">

                        <!-- SUB-VIEW 1A: SETUP FORM -->
                        <StackPanel x:Name="pnlHubSetup" Visibility="Visible">
                            <!-- Hero Banner -->
                            <Border CornerRadius="18" Padding="28,24" Margin="0,0,0,22">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#042F2E" Offset="0.0"/>
                                        <GradientStop Color="#0F766E" Offset="0.65"/>
                                        <GradientStop Color="#115E59" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Border Background="#134E4A" BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="20" Padding="12,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <local:LucideIcon Kind="Sparkles" Size="12" Foreground="#5EEAD4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="LUYỆN TẬP THÍCH ỨNG • KHÔNG ÁP LỰC THỜI GIAN" Foreground="#CCFBF1" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Trung Tâm Luyện Tập Linh Hoạt &amp; Kỹ Năng" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="Tùy chọn kỹ năng, cấp độ CEFR A1-C1 và độ khó theo mục tiêu. Rèn luyện phản xạ ngôn ngữ không giới hạn với AI giải thích chi tiết." 
                                                   Foreground="#CCFBF1" FontSize="13.5" Margin="0,0,0,14"/>

                                        <!-- Highlights Micro-Row -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#134E4A" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Layers" Size="13" Foreground="#99F6E4" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="15+ Gói chuyên đề" FontSize="11.5" FontWeight="SemiBold" Foreground="#E6F7F3"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#134E4A" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="CheckCircle2" Size="13" Foreground="#86EFAC" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="AI giải thích tức thì" FontSize="11.5" FontWeight="SemiBold" Foreground="#E6F7F3"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#134E4A" CornerRadius="8" Padding="10,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="Clock" Size="13" Foreground="#FDE047" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Tự do tốc độ làm bài" FontSize="11.5" FontWeight="SemiBold" Foreground="#E6F7F3"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ================= DANH SÁCH BÀI TẬP THEO CHUYÊN ĐỀ ================= -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Kho bài tập rèn luyện theo chuyên đề:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Được thiết kế linh hoạt cho học viên tự ôn luyện theo từng chuyên đề, không chịu áp lực thời gian." FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,0,0,12"/>

                                <!-- Modern Two-Row Filter Card -->
                                <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.03" Color="#0F172A"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Row 1: Skill Category Filter Pills -->
                                        <WrapPanel x:Name="pnlPkgSkillChips" Margin="0,0,0,14">
                                            <Button x:Name="btnPkgFilterAll" Content="Tất cả" Style="{StaticResource ModernFilterChipButton}" Background="{StaticResource BrandTeal}" Foreground="White" BorderThickness="0" Click="BtnPkgFilter_Click" Tag="All"/>
                                            <Button x:Name="btnPkgFilterGrammar" Content="Ngữ pháp" Style="{StaticResource ModernFilterChipButton}" Click="BtnPkgFilter_Click" Tag="Ngữ Pháp"/>
                                            <Button x:Name="btnPkgFilterVocab" Content="Từ vựng" Style="{StaticResource ModernFilterChipButton}" Click="BtnPkgFilter_Click" Tag="Từ Vựng"/>
                                            <Button x:Name="btnPkgFilterReading" Content="Đọc hiểu" Style="{StaticResource ModernFilterChipButton}" Click="BtnPkgFilter_Click" Tag="Đọc Hiểu"/>
                                            <Button x:Name="btnPkgFilterWriting" Content="Viết &amp; Sửa lỗi" Style="{StaticResource ModernFilterChipButton}" Click="BtnPkgFilter_Click" Tag="Viết"/>
                                            <Button x:Name="btnPkgFilterSpeaking" Content="Luyện nói" Style="{StaticResource ModernFilterChipButton}" Click="BtnPkgFilter_Click" Tag="Nói"/>
                                            <Button x:Name="btnPkgFilterReflex" Content="Phản xạ nhanh" Style="{StaticResource ModernFilterChipButton}" Click="BtnPkgFilter_Click" Tag="Phản Xạ"/>
                                        </WrapPanel>

                                        <!-- Row 2: Search, Level Dropdown & Reset (Perfect Horizontal Alignment) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Modern Search Box with Watermark Placeholder -->
                                            <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.2" Height="38" Padding="10,0" Margin="0,0,16,0" MaxWidth="440" HorizontalAlignment="Left">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <local:LucideIcon Grid.Column="0" Kind="Search" Size="14" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <Grid Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Tìm kiếm chuyên đề, kỹ năng, từ khóa..." 
                                                                   Foreground="#94A3B8" FontSize="12.5" 
                                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearchPkg}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox x:Name="txtSearchPkg" Background="Transparent" BorderThickness="0" 
                                                                 VerticalAlignment="Center" Foreground="{StaticResource TextDark}" FontSize="12.5"
                                                                 TextChanged="TxtSearchPkg_TextChanged"/>
                                                    </Grid>
                                                    <Button Grid.Column="2" x:Name="btnClearSearchPkg" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"
                                                            Click="BtnClearSearchPkg_Click" Visibility="Collapsed" ToolTip="Xóa tìm kiếm">
                                                        <local:LucideIcon Kind="X" Size="13" Foreground="#94A3B8"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Level Dropdown & Reset Button (Straight baseline) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Trình độ:" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="cboPkgTrinhDo" Width="105" Height="38" SelectionChanged="CboPkgFilter_SelectionChanged">
                                                    <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                                    <ComboBoxItem Content="A1"/>
                                                    <ComboBoxItem Content="A2"/>
                                                    <ComboBoxItem Content="B1"/>
                                                    <ComboBoxItem Content="B2"/>
                                                    <ComboBoxItem Content="C1"/>
                                                </ComboBox>

                                                <!-- Reset Button -->
                                                <Button x:Name="btnResetPkgFilter" Click="BtnResetPkgFilter_Click" Cursor="Hand" Height="38" Padding="14,0" Margin="10,0,0,0" ToolTip="Xóa tất cả bộ lọc về mặc định">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bdrReset" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <local:LucideIcon Kind="RotateCcw" Size="13" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Đặt lại" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bdrReset" Property="Background" Value="#E2E8F0"/>
                                                                    <Setter TargetName="bdrReset" Property="BorderBrush" Value="#94A3B8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Dynamic ItemsControl for Practice Packages from Database -->
                            <ItemsControl x:Name="icDanhSachGoiLuyenTap" Margin="0,0,0,24">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PracticeCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Accent Color Indicator -->
                                                <Border Grid.Column="0" Width="4.5" CornerRadius="4" Background="{Binding AccentBrush}" Margin="0,2,16,2" VerticalAlignment="Stretch"/>

                                                <!-- Format Icon Badge -->
                                                <Border Grid.Column="1" Background="{Binding FormatBadgeBg}" Width="50" Height="50" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <local:LucideIcon Kind="{Binding FormatIconKind}" Size="22" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <!-- Badges Row -->
                                                    <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                                        <Border Background="{Binding FormatTagBg}" CornerRadius="6" Padding="9,3" Margin="0,0,8,4">
                                                            <TextBlock Text="{Binding FormatTag}" FontSize="11" FontWeight="Bold" Foreground="{Binding FormatTagFg}"/>
                                                        </Border>
                                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                            <TextBlock Text="{Binding LevelTag}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                                        </Border>
                                                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4" Visibility="{Binding HasBlueprintVisibility}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <local:LucideIcon Kind="Compass" Size="11" Foreground="#15803D" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding BlueprintBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,4">
                                                            <TextBlock Text="Luyện tập tự do" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- Title -->
                                                    <TextBlock Text="{Binding TenBaiTapDeThi}" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,5" TextWrapping="Wrap"/>

                                                    <!-- Description -->
                                                    <TextBlock Text="{Binding CleanMoTa}" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,9" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>

                                                    <!-- Metadata Micro-Pills -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="Clock" Size="12" Foreground="#0F766E" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DurationPill}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="FileText" Size="12" Foreground="#475569" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding QuestionCountPill}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <local:LucideIcon Kind="CheckCircle2" Size="12" Foreground="#15803D" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Chấm tức thì &amp; Lời giải AI" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Button -->
                                                <Button Grid.Column="3" 
                                                        Style="{StaticResource StartPracticeCardButton}" VerticalAlignment="Center" 
                                                        Tag="{Binding MaBaiTapDeThi}" Click="BtnStartPracticePackage_Click">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Bắt đầu luyện tập" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <local:LucideIcon Kind="ArrowRight" Size="14" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Empty State for Practice Packages -->
                            <Border x:Name="pnlEmptyPracticePackages" Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" 
                                    BorderThickness="1" Padding="40,36" Margin="0,0,0,24" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="{StaticResource BrandTealLight}" Width="52" Height="52" CornerRadius="26" Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Không tìm thấy bài tập nào phù hợp" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Không có chuyên đề nào khớp với từ khóa và bộ lọc hiện tại. Thử chọn trình độ khác hoặc bấm Đặt lại." FontSize="12.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                    <Button Content="🔄 Đặt lại bộ lọc" Padding="16,7" Background="{StaticResource BrandTealLight}" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Click="BtnResetPkgFilter_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Filter & Setup Card -->
                            <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="25" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="HOẶC TỰ TẠO PHIÊN LUYỆN TẬP TÙY CHỌN THEO KỸ NĂNG &amp; TRÌNH ĐỘ" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cột 1: Kỹ năng & Trình độ & Hình thức -->
                                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                            <TextBlock Text="Kỹ năng luyện tập:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="cboPracticeSkill" Height="38" Padding="10,6" Margin="0,0,0,16" SelectionChanged="PracticeFilter_Changed">
                                                <ComboBoxItem Content="-- Tất cả kỹ năng --" IsSelected="True"/>
                                                <ComboBoxItem Content="Đọc hiểu (Reading)"/>
                                                <ComboBoxItem Content="Nghe hiểu (Listening)"/>
                                                <ComboBoxItem Content="Ngữ pháp (Grammar)"/>
                                                <ComboBoxItem Content="Từ vựng (Vocabulary)"/>
                                                <ComboBoxItem Content="Viết (Writing)"/>
                                                <ComboBoxItem Content="Nói (Speaking)"/>
                                            </ComboBox>

                                            <TextBlock Text="Trình độ (CEFR Level):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="cboPracticeLevel" Height="38" Padding="10,6" Margin="0,0,0,16" SelectionChanged="PracticeFilter_Changed">
                                                <ComboBoxItem Content="-- Tất cả trình độ --" IsSelected="True"/>
                                                <ComboBoxItem Content="A1 - Căn bản"/>
                                                <ComboBoxItem Content="A2 - Sơ cấp"/>
                                                <ComboBoxItem Content="B1 - Trung cấp"/>
                                                <ComboBoxItem Content="B2 - Trung cao cấp"/>
                                                <ComboBoxItem Content="C1 - Nâng cao"/>
                                            </ComboBox>

                                            <TextBlock Text="Hình thức phiên luyện tập:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="cboPracticeType" Height="38" Padding="10,6">
                                                <ComboBoxItem Content="🎯 Luyện tập củng cố theo kỹ năng" IsSelected="True"/>
                                                <ComboBoxItem Content="⚡ Thử thách phản xạ nhanh"/>
                                                <ComboBoxItem Content="🧠 Luyện tập chuyên sâu &amp; Lời giải chi tiết"/>
                                                <ComboBoxItem Content="🔄 Ôn tập khắc phục điểm yếu"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Cột 2: Độ khó, Số lượng & Phản hồi -->
                                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                            <TextBlock Text="Độ khó câu hỏi:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="cboPracticeDifficulty" Height="38" Padding="10,6" Margin="0,0,0,16" SelectionChanged="PracticeFilter_Changed">
                                                <ComboBoxItem Content="-- Tất cả độ khó --" IsSelected="True"/>
                                                <ComboBoxItem Content="Dễ (Easy)"/>
                                                <ComboBoxItem Content="Trung bình (Medium)"/>
                                                <ComboBoxItem Content="Khó (Hard)"/>
                                            </ComboBox>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Số lượng câu hỏi:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="cboPracticeCount" Height="38" Padding="10,6">
                                                        <ComboBoxItem Content="5 câu"/>
                                                        <ComboBoxItem Content="10 câu" IsSelected="True"/>
                                                        <ComboBoxItem Content="15 câu"/>
                                                        <ComboBoxItem Content="20 câu"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="Chế độ phản hồi:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="cboPracticeFeedbackMode" Height="38" Padding="10,6">
                                                        <ComboBoxItem Content="Phản hồi ngay sau mỗi câu" IsSelected="True"/>
                                                        <ComboBoxItem Content="Tổng kết ở cuối phiên"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live Availability Indicator -->
                                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="16,14" Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtLiveAvailableCount" Text="Đang kiểm tra câu hỏi khả dụng..." FontWeight="Bold" FontSize="13.5" Foreground="#166534"/>
                                                <TextBlock Text="Hệ thống tự động chọn lọc từ Ngân hàng câu hỏi chuẩn, bảo đảm đầy đủ đáp án và giải thích chi tiết." FontSize="11.5" Foreground="#15803D"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="🚀 Bắt đầu phiên luyện tập" 
                                                    Style="{StaticResource TealActionButton}" Padding="22,12" Click="BtnStartPracticeSession_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SUB-VIEW 1B: PRACTICE SESSION IN PROGRESS (VERTICAL ALL-QUESTIONS VIEW) -->
                        <StackPanel x:Name="pnlHubSession" Visibility="Collapsed" Margin="0,0,0,20">
                            <!-- Session Header Bar -->
                            <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                    Padding="24,16" Margin="0,0,0,18">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource BrandTealLight}" CornerRadius="8" Padding="12,5" Margin="0,0,12,0">
                                            <TextBlock x:Name="txtSessionProgress" Text="ĐÃ TRẢ LỜI: 0 / 10 CÂU" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandTeal}"/>
                                        </Border>
                                        <TextBlock Text="Lướt từ trên xuống dưới để làm toàn bộ câu hỏi và bấm nộp bài khi hoàn tất." 
                                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <local:LucideIcon Kind="Clock" Size="14" Foreground="{StaticResource TextGray}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtSessionDuration" Text="00:00" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Button Content="✕ Dừng phiên" Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" BorderThickness="0" Padding="14,7" Cursor="Hand" Click="BtnStopPracticeSession_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#FECACA"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Vertical Questions Container (Rendered dynamically) -->
                            <StackPanel x:Name="pnlQuestionsContainer"/>

                            <!-- Bottom Completion Action Bar -->
                            <Border x:Name="pnlSessionBottomAction" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.5" CornerRadius="14" Padding="24,18" Margin="0,10,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtBottomProgressText" Text="Đã trả lời: 0 / 10 câu hỏi" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrandTeal}"/>
                                        <TextBlock Text="Hãy rà soát kỹ các câu hỏi trước khi nộp bài để xem phân tích đáp án chi tiết." FontSize="12.5" Foreground="{StaticResource TextGray}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="btnSubmitPracticeSession" Grid.Column="1" Content="Hoàn thành &amp; Xem kết quả" Style="{StaticResource TealActionButton}" Padding="26,13" FontSize="14" Click="BtnSubmitPracticeSession_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- SUB-VIEW 1C: PRACTICE RESULT SUMMARY -->
                        <Border x:Name="pnlHubResult" Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                Padding="30,25" Visibility="Collapsed" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Score Circle/Badge -->
                                    <Border Grid.Column="0" Background="{StaticResource BrandTealLight}" CornerRadius="16" Width="100" Height="100" Margin="0,0,22,0">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtResultAccuracyPct" Text="80%" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Chính xác" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtResultSummaryTitle" Text="TỔNG KẾT PHIÊN LUYỆN TẬP PHẢN XẠ" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock x:Name="txtResultCorrectText" Text="✅ Đúng: 8 câu" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrandMint}" Margin="0,0,18,0"/>
                                            <TextBlock x:Name="txtResultWrongText" Text="❌ Sai: 2 câu" FontWeight="SemiBold" FontSize="13" Foreground="#EF4444" Margin="0,0,18,0"/>
                                            <TextBlock x:Name="txtResultTimeSpent" Text="⏱️ Thời gian: 05:20" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextGray}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtResultAiComment" Text="AI Nhận xét: Bạn xử lý các câu hỏi rất tốt. Hãy chú ý luyện thêm các câu sai bên dưới để khắc sâu kiến thức!" FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button x:Name="btnRePracticeWrongInSession" Content="🎯 Luyện lại các câu sai" 
                                                Style="{StaticResource TealActionButton}" Background="#DC2626" Margin="0,0,0,10" Click="BtnRePracticeWrongInSession_Click"/>
                                        <Button Content="🔄 Tạo phiên mới" Style="{StaticResource SecondaryButton}" Click="BtnNewPracticeSession_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="CHI TIẾT CÁC CÂU HỎI TRONG PHIÊN LUYỆN TẬP:" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,0,0,14"/>

                                <ItemsControl x:Name="icSessionQuestionResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{Binding StatusBadgeBg}" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeFg}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding QuestionNumberText}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding KyNangTag}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding NoiDungCauHoi}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="White" BorderBrush="{Binding StudentChoiceBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                                            <StackPanel>
                                                                <TextBlock Text="Bạn đã chọn:" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                                                <TextBlock Text="{Binding StudentChoiceText}" FontWeight="SemiBold" FontSize="12.5" Foreground="{Binding StudentChoiceFg}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="1" Background="{StaticResource BrandMintSoft}" BorderBrush="{StaticResource BrandMint}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="6,0,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="Đáp án đúng:" FontSize="11" Foreground="{StaticResource BrandTeal}"/>
                                                                <TextBlock Text="{Binding CorrectChoiceText}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrandTeal}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                        <TextBlock Text="{Binding ExplanationText}" FontSize="12" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- TAB 2: REVIEW WRONG QUESTIONS (ÔN TẬP CÂU ĐÃ SAI - TASK 4.5) -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="pnlWrongQuestions" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="25" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="KHO ÔN TẬP CÂU HỎI ĐÃ SAI" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock Text="Tập hợp những câu hỏi bạn đã từng trả lời sai trong các bài thi và phiên luyện tập trước đây." 
                                                   FontSize="12.5" Foreground="{StaticResource TextGray}"/>
                                    </StackPanel>
                                    <Button x:Name="btnDrillAllWrong" Content="⚡ Luyện tập lại tất cả câu sai này" 
                                            Style="{StaticResource TealActionButton}" Background="#DC2626" HorizontalAlignment="Right" Click="BtnDrillAllWrong_Click"/>
                                </Grid>

                                <Border x:Name="pnlNoWrongQuestions" Background="#F0FDF4" CornerRadius="10" Padding="20" Visibility="Collapsed">
                                    <TextBlock Text="🎉 Tuyệt vời! Bạn không có câu hỏi nào bị sai cần ôn tập lại." FontWeight="SemiBold" FontSize="14" Foreground="#15803D" HorizontalAlignment="Center"/>
                                </Border>

                                <ItemsControl x:Name="icWrongQuestionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <Border Background="#FED7AA" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding KyNangTag}" FontSize="11" FontWeight="Bold" Foreground="#9A3412"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding ThoiGianSaiText}" FontSize="11.5" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding NoiDungCauHoi}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding GiaiThichText}" FontSize="12.5" Foreground="#7C2D12" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Content="Luyện lại câu này" Style="{StaticResource SecondaryButton}" 
                                                            VerticalAlignment="Center" Tag="{Binding MaCauHoi}" Click="BtnDrillSingleWrong_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- TAB 3: PRACTICE HISTORY (LỊCH SỬ LUYỆN TẬP) -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="pnlHistory" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="25" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="LỊCH SỬ CÁC PHIÊN LUYỆN TẬP GẦN ĐÂY" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,16"/>

                                <Border x:Name="pnlNoHistory" Background="#F8FAFC" CornerRadius="10" Padding="20" Visibility="Collapsed">
                                    <TextBlock Text="Chưa có lịch sử phiên luyện tập nào được lưu." FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center"/>
                                </Border>

                                <ItemsControl x:Name="icPracticeHistory">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{StaticResource BrandTealLight}" Width="48" Height="48" CornerRadius="10" Margin="0,0,16,0">
                                                        <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TenBaiTap}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ThoiGianNopFormat}" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,16,0"/>
                                                            <TextBlock Text="{Binding ThoiLuongFormat}" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,16,0"/>
                                                            <TextBlock Text="{Binding KetQuaSoCau}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="{StaticResource BrandMintSoft}" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TyLeDungText}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandTeal}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- TAB 4: FLASHCARD VOCABULARY (ĐANG PHÁT TRIỂN) -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="pnlFlashcard" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="45,40" Margin="0,10,0,20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="{StaticResource BrandTealLight}" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <TextBlock Text="🗂️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tính Năng Flashcard Từ Vựng Đang Phát Triển" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Hệ thống học từ vựng thông minh theo thuật toán lặp lại ngắt quãng (Spaced Repetition) đang được hoàn thiện và sẽ ra mắt trong bản cập nhật kế tiếp." 
                                           FontSize="13.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="540" TextAlignment="Center" Margin="0,0,0,22" LineHeight="22"/>
                                <Button Content="🎯 Quay lại Luyện tập kỹ năng &amp; chủ đề" Style="{StaticResource TealActionButton}" Padding="22,11" HorizontalAlignment="Center" Click="TabHub_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- TAB 5: DICTATION - NGHE CHÉP CHÍNH TẢ (ĐANG PHÁT TRIỂN) -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="pnlDictation" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="45,40" Margin="0,10,0,20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="{StaticResource BrandMintSoft}" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <TextBlock Text="🎧" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tính Năng Nghe Chép Chính Tả Đang Phát Triển" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Module luyện phản xạ nhận diện âm vị bản xứ và gõ câu chính tả tự động chấm điểm với AI đang được tối ưu hóa chất lượng." 
                                           FontSize="13.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="540" TextAlignment="Center" Margin="0,0,0,22" LineHeight="22"/>
                                <Button Content="🎯 Quay lại Luyện tập kỹ năng &amp; chủ đề" Style="{StaticResource TealActionButton}" Padding="22,11" HorizontalAlignment="Center" Click="TabHub_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
