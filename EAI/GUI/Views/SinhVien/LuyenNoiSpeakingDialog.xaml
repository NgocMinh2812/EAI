<Window x:Class="GUI.Views.SinhVien.LuyenNoiSpeakingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luyện phát âm &amp; Phản xạ Nói — EnglishAI"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#115E59"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Target Sentence Card -->
            <RowDefinition Height="Auto"/>
            <!-- Recording Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Results & Feedback -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E6F7F3" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                    <TextBlock Text="🗣️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Thực hành Luyện Nói &amp; Nhận diện Giọng đọc" FontSize="16.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Học viên nói vào microphone, AI sẽ chuyển lời nói thành văn bản và đối chiếu với câu mẫu." FontSize="12.5" Foreground="#475569" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Target Sentence Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" BorderBrush="#0F766E" BorderThickness="1.5" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🎯 CÂU MẪU CẦN ĐỌC:" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F766E"/>
                    <Button x:Name="btnListenSample" Grid.Column="1" Content="🔊 Nghe mẫu" Background="#F0FDFA" Foreground="#0F766E" 
                            BorderBrush="#99F6E4" BorderThickness="1" Padding="12,5" Cursor="Hand" Click="BtnListenSample_Click" FontWeight="SemiBold" FontSize="12"/>
                </Grid>
                <TextBlock x:Name="txtTargetSentence" Text="I would like to book a flight ticket to London." FontSize="16.5" FontWeight="SemiBold" Foreground="#0F172A" LineHeight="24" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtTranslation" Text="Tôi muốn đặt một vé máy bay đi Luân Đôn." FontSize="13" Foreground="#475569" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Recording Controls Area -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtRecordStatus" Text="Nhấn 'Bắt đầu ghi âm' và đọc rõ ràng từng từ." FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock x:Name="txtRecordHint" Text="Hệ thống chỉ ghi âm khi bạn đồng ý; file ghi âm tạm sẽ được xóa tự động sau khi đối chiếu." FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Recording buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRecord" Content="🎙️ Bắt đầu ghi âm" Style="{StaticResource RoundedButton}" Click="BtnRecord_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnPlayOwnRecording" Content="▶ Nghe lại bản ghi" Background="#FFFFFF" Foreground="#1E293B" 
                            BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,8" Cursor="Hand" Click="BtnPlayOwnRecording_Click" IsEnabled="False" FontWeight="Medium" FontSize="12.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Evaluation Results Area -->
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Score Banner -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📊 KẾT QUẢ ĐỐI CHIẾU PHÁT ÂM:" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock x:Name="txtEvaluationComment" Text="Chưa có dữ liệu ghi âm." FontSize="13.5" FontWeight="Medium" Foreground="#0F766E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border x:Name="bdrAccuracyScore" Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="14,7" VerticalAlignment="Center">
                        <TextBlock x:Name="txtAccuracyScore" Text="-- %" FontSize="19" FontWeight="Bold" Foreground="#334155"/>
                    </Border>
                </Grid>

                <!-- Word-by-Word Colored Feedback -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Chi tiết từng từ đã nhận dạng:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="pnlWordChips" Margin="0,0,0,10"/>

                        <!-- Raw Spoken Transcript -->
                        <TextBlock Text="Văn bản AI nghe được từ giọng bạn:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,8,0,4"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,9">
                            <TextBlock x:Name="txtRecognizedSpeech" Text="(Chưa có)" FontSize="13" Foreground="#1E293B" TextWrapping="Wrap" FontStyle="Italic"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Disclaimer note -->
                <TextBlock Grid.Row="2" Text="💡 Lưu ý: Phân tích dựa trên Speech-to-Text để nhận dạng từ vựng đã đọc; không phải chứng chỉ chấm âm vị/ngữ điệu bản ngữ." 
                           FontSize="11.5" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Margin="0,16,0,0">
            <Button Content="Hoàn thành &amp; Đóng" Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0" 
                    Padding="20,9" FontWeight="Medium" FontSize="13" HorizontalAlignment="Right" Cursor="Hand" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>

