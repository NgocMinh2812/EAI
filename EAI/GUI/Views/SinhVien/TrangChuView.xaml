<Page x:Class="GUI.Views.TrangChuView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Trang chủ - EnglishAI"
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryGreen" Color="#0F766E" />
        <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
        <SolidColorBrush x:Key="AppBg" Color="#F4F7F6" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        </Style>

        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="10,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ActiveSidebarItemStyle" TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
            <Setter Property="Background" Value="#E6F7F3"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- ================= MAIN CONTENT ================= -->
    <Grid Background="{StaticResource AppBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Dashboards / " Foreground="{StaticResource TextGray}"/>
                        <TextBlock Text="Trang chủ" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <!-- Khung Tìm Kiếm với Gợi ý trực tiếp (Live Autocomplete) -->
                    <Grid Grid.Column="1" HorizontalAlignment="Left" Margin="30,0,0,0">
                        <Border x:Name="borderStudentSearch" Background="#F1F5F9" CornerRadius="8" Width="330" Height="36" Padding="10,0" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Foreground="{StaticResource TextGray}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox x:Name="txtStudentSearch" Background="Transparent" BorderThickness="0" 
                                             Foreground="{StaticResource TextDark}" FontSize="13" VerticalAlignment="Center"
                                             TextChanged="TxtStudentSearch_TextChanged" PreviewKeyDown="TxtStudentSearch_PreviewKeyDown"/>
                                    <TextBlock x:Name="txtStudentSearchPlaceholder" Text="Tìm kiếm bài học, kỹ năng, chức năng..." 
                                               Foreground="{StaticResource TextGray}" FontSize="13" VerticalAlignment="Center" 
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <Button x:Name="btnClearStudentSearch" Grid.Column="2" Content="✕" 
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextGray}" 
                                        FontSize="11" Cursor="Hand" Visibility="Collapsed" Click="BtnClearStudentSearch_Click" 
                                        Padding="4,2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Popup Gợi ý tìm kiếm -->
                        <Popup x:Name="popStudentSuggestions" PlacementTarget="{Binding ElementName=borderStudentSearch}" 
                               Placement="Bottom" IsOpen="False" StaysOpen="False" AllowsTransparency="True" 
                               PopupAnimation="Fade" VerticalOffset="5">
                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                                    CornerRadius="10" Width="390" MaxHeight="380" Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Color="Black"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="pnlStudentSuggestions">
                                        <!-- Cac item goi y duoc them tu code-behind -->
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,125,0">
                        <Button x:Name="btnNotification" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand" ToolTip="Thông báo học tập" Click="BtnThongBao_Click">
                            <TextBlock Text="🔔" FontSize="18"/>
                        </Button>
                        <Button Style="{StaticResource RoundedButtonStyle}" Background="{StaticResource PrimaryGreen}" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="AIChatButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨" Margin="0,0,5,0"/>
                                <TextBlock Text="AI Chat" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dashboard Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
                <StackPanel>
                    
                    <!-- Welcome Section (TASK-201) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tổng quan học tập của bạn" FontSize="24" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Xin chào, " Foreground="{StaticResource TextGray}"/>
                                <TextBlock x:Name="txtWelcomeUser" Text="Học viên" Foreground="{StaticResource PrimaryGreen}" FontWeight="Bold"/>
                                <TextBlock Text=" • Trình độ hiện tại: " Foreground="{StaticResource TextGray}"/>
                                <TextBlock x:Name="txtCurrentLevel" Text="B2 Intermediate" Foreground="{StaticResource PrimaryGreen}" FontWeight="Bold"/>
                                <TextBlock Text=" • Mục tiêu: " Foreground="{StaticResource TextGray}"/>
                                <TextBlock x:Name="txtTargetLevel" Text="IELTS 6.5 (CEFR B2)" Foreground="{StaticResource PrimaryGreen}" FontWeight="Bold"/>
                                <TextBlock Text=" ✨" Foreground="{StaticResource PrimaryGreen}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Lối tắt vào học bài và thi thử (TASK-201) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource RoundedButtonStyle}" Background="{StaticResource PrimaryGreen}" Foreground="White" BorderThickness="0" Padding="15,9" Margin="0,0,10,0" Cursor="Hand" Click="BtnHocTap_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📚 "/>
                                    <TextBlock Text="Vào học ngay" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RoundedButtonStyle}" Background="#0284C7" Foreground="White" BorderThickness="0" Padding="15,9" Cursor="Hand" Click="BtnThiThu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱️ "/>
                                    <TextBlock Text="Thi thử chuẩn hóa" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Placement Test Announcement Banner -->
                    <Border x:Name="bannerAssessment" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border x:Name="iconBannerBadge" Grid.Column="0" Background="#DCFCE7" Width="42" Height="42" CornerRadius="10" Margin="0,0,15,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtBannerEmoji" Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtBannerTitle" Text="Khảo sát Đánh giá Năng lực Đầu vào (Placement Test)" FontWeight="Bold" FontSize="14" Foreground="#166534"/>
                                <TextBlock x:Name="txtBannerDesc" Text="Làm bài kiểm tra ngắn để AI xác định cấp độ CEFR và đề xuất bài học phù hợp với mức độ của bạn." FontSize="12" Foreground="#15803D" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button x:Name="btnAssessmentAction" Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Background="#16A34A" Foreground="White" BorderThickness="0" Padding="16,9" FontWeight="SemiBold" FontSize="12.5" Cursor="Hand" Click="AssessmentButton_Click">
                                <TextBlock x:Name="txtBannerBtnText" Text="Làm bài kiểm tra ngay ➔"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Stats Cards -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1 -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Điểm trung bình" Foreground="{StaticResource TextGray}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtDiemTrungBinh" Text="80.0%" FontSize="28" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock Text="Khảo thí &amp; Đánh giá năng lực" Foreground="{StaticResource PrimaryGreen}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2 -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Bài đã hoàn thành" Foreground="{StaticResource TextGray}" FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="txtSoBaiHoanThanh" Text="3" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtTongSoBai" Text=" / 29 bài" FontSize="16" Foreground="{StaticResource TextGray}" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                                </StackPanel>
                                <TextBlock Text="Tiến độ học tập theo lộ trình" Foreground="{StaticResource PrimaryGreen}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3 -->
                        <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Thời gian học tích lũy" Foreground="{StaticResource TextGray}" FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="txtThoiGianTichLuy" Text="420" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text=" phút" FontSize="16" Foreground="{StaticResource TextGray}" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                                </StackPanel>
                                <TextBlock x:Name="txtChuoiHoc" Text="Chuỗi 14 ngày chuyên cần" Foreground="{StaticResource PrimaryGreen}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Middle Charts Section -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Activity Chart -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Phân tích hoạt động học tập trong tuần" FontWeight="Bold" FontSize="16"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryGreen}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Thời lượng học tập hàng ngày" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,15,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Mục tiêu 30p/ngày" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="12,6">
                                        <TextBlock Text="7 ngày qua" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                    </Border>
                                </Grid>

                                <!-- Activity Bar Chart -->
                                <Grid Grid.Row="1" Margin="0,20,0,0" Height="150" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Rectangle x:Name="barMon" Fill="#C6E9DE" Height="60" Width="28" RadiusX="6" RadiusY="6"/>
                                        <TextBlock Text="T2" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Rectangle x:Name="barTue" Fill="#C6E9DE" Height="85" Width="28" RadiusX="6" RadiusY="6"/>
                                        <TextBlock Text="T3" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Rectangle x:Name="barWed" Fill="#C6E9DE" Height="45" Width="28" RadiusX="6" RadiusY="6"/>
                                        <TextBlock Text="T4" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Rectangle x:Name="barThu" Fill="#C6E9DE" Height="110" Width="28" RadiusX="6" RadiusY="6"/>
                                        <TextBlock Text="T5" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Rectangle x:Name="barFri" Fill="{StaticResource PrimaryGreen}" Height="130" Width="28" RadiusX="6" RadiusY="6"/>
                                        <TextBlock Text="T6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Rectangle x:Name="barSat" Fill="#C6E9DE" Height="75" Width="28" RadiusX="6" RadiusY="6"/>
                                        <TextBlock Text="T7" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Rectangle x:Name="barSun" Fill="#C6E9DE" Height="50" Width="28" RadiusX="6" RadiusY="6"/>
                                        <TextBlock Text="CN" FontSize="11" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Top Skills Mastery -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Năng lực kỹ năng" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Chi tiết" Foreground="{StaticResource PrimaryGreen}" HorizontalAlignment="Right" FontSize="12" Cursor="Hand" MouseDown="BtnLuyenTap_MouseDown"/>
                                </Grid>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock x:Name="txtTongTuVung" Text="12" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text=" từ vựng trọng tâm" Foreground="{StaticResource TextGray}" FontSize="12" VerticalAlignment="Bottom" Margin="5,0,0,4"/>
                                </StackPanel>

                                <!-- Progress Bar Breakdown -->
                                <Border Height="8" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="{StaticResource PrimaryGreen}"/>
                                        <Rectangle Grid.Column="1" Fill="#6366F1"/>
                                        <Rectangle Grid.Column="2" Fill="#F59E0B"/>
                                        <Rectangle Grid.Column="3" Fill="#EF4444"/>
                                    </Grid>
                                </Border>

                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Từ vựng (Vocabulary)"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtAccTuVung" Text="80% độ chính xác" HorizontalAlignment="Right" Foreground="{StaticResource TextGray}" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#6366F1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Ngữ pháp (Grammar)"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtAccNguPhap" Text="75% độ chính xác" HorizontalAlignment="Right" Foreground="{StaticResource TextGray}" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Đọc hiểu (Reading)"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtAccDocHieu" Text="70% độ chính xác" HorizontalAlignment="Right" Foreground="{StaticResource TextGray}" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Nghe hiểu (Listening)"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtAccNgheHieu" Text="65% độ chính xác" HorizontalAlignment="Right" Foreground="{StaticResource TextGray}" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent Lessons Section (Loaded from DB) -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Bài học gần đây" FontWeight="Bold" FontSize="16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📚 Xem tất cả bài học" Style="{StaticResource RoundedButtonStyle}" Background="{StaticResource PrimaryGreen}" BorderThickness="0" Padding="15,6" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="BtnHocTap_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bài học" Foreground="{StaticResource TextGray}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Điểm" Foreground="{StaticResource TextGray}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Tiến độ" Foreground="{StaticResource TextGray}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Truy cập" Foreground="{StaticResource TextGray}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Trạng thái" Foreground="{StaticResource TextGray}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <Rectangle Height="1" Fill="{StaticResource BorderColor}" Margin="0,0,0,8"/>

                            <!-- Dynamic ItemsControl for Recent Lessons -->
                            <ItemsControl x:Name="icRecentLessons">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8" Cursor="Hand" MouseDown="ItemRecentLesson_MouseDown" Tag="{Binding MaBaiHoc}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Tên bài học hiển thị đầy đủ, không bị chồng chéo -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding StatusBackground}" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconSkill}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding TieuDe}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" 
                                                           TextWrapping="Wrap" ToolTip="{Binding TieuDe}"/>
                                            </Grid>

                                            <TextBlock Grid.Column="1" Text="{Binding DiemSo}" FontWeight="Bold" Foreground="{StaticResource PrimaryGreen}" VerticalAlignment="Center"/>
                                            
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar Value="{Binding PhanTramTienDo}" Maximum="100" Width="90" Height="6" Background="#E2E8F0" Foreground="{StaticResource PrimaryGreen}" BorderThickness="0" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding PhanTramTienDo, StringFormat='{}{0:0}%'}" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="3" Text="{Binding NgayHocGanNhat}" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                            
                                            <Border Grid.Column="4" Background="{Binding StatusBackground}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrangThai}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Notice if no lessons yet -->
                            <TextBlock x:Name="txtNoRecentLessons" Text="Chưa có lịch sử học tập. Hãy bấm 'Vào học ngay' để bắt đầu bài học đầu tiên!" 
                                       FontStyle="Italic" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,15,0,5" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Action Cards -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Cursor="Hand" MouseDown="BtnLuyenTap_MouseDown">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#E6F7F3" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="✏️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Luyện tập" FontWeight="Bold"/>
                                    <TextBlock Text="Bài tập theo chủ đề" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Cursor="Hand" MouseDown="BtnThiThu_MouseDown">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFF4E5" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="⏱️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Thi thử" FontWeight="Bold"/>
                                    <TextBlock Text="Mô phỏng đề thật" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource CardStyle}" Cursor="Hand" MouseDown="BtnBaiVietAI_MouseDown">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FEF2F2" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="✍️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bài viết AI" FontWeight="Bold"/>
                                    <TextBlock Text="Chấm điểm tức thì" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource CardStyle}" Cursor="Hand" MouseDown="BtnAIChat_MouseDown">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F3F4F6" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="🤖" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Trợ lý AI" FontWeight="Bold"/>
                                    <TextBlock Text="Hỏi đáp mọi lúc" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
</Page>
