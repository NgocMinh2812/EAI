<Page x:Class="GUI.Views.BaiVietAIView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Luyện viết AI - EnglishAI"
      FontFamily="Segoe UI"
      Background="#F4F7F6">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TealActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#F4F7F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EnglishAI / " Foreground="{StaticResource TextGray}" FontSize="13"/>
                    <TextBlock Text="Phòng luyện viết luận &amp; AI chấm chữa chi tiết" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📑 Chọn đề bài mẫu khác" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                            FontWeight="Medium" Padding="12,6" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnChangeTopic_Click"/>
                    <Border Background="{StaticResource BrandTealLight}" CornerRadius="8" Padding="12,6">
                        <TextBlock Text="🤖 AI Grader: IELTS Band 9.0 Standard" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrandTeal}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Left Editor + Right Analysis -->
        <Grid Grid.Row="1" Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: WRITING EDITOR ================= -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Topic Prompt Card -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="16" Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#DBEAFE" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock Text="IELTS TASK 2" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </Border>
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="OPINION ESSAY" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="txtEssayTopic" Text="Some people argue that artificial intelligence and technology will completely replace human teachers in the future. To what extent do you agree or disagree?" 
                                       FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextDark}"/>
                        </StackPanel>
                    </Border>

                    <!-- Word Count & Timer Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock x:Name="txtWordCount" Text="Số từ: 254 từ • Đạt độ dài tối thiểu (>= 250 từ)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandTeal}"/>
                        <TextBlock Text="⏱️ Thời gian: 28 phút" FontSize="12.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Text Area Input -->
                    <TextBox x:Name="txtEssayInput" Grid.Row="2" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                             FontSize="14" Padding="14" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" 
                             TextChanged="TxtEssayInput_TextChanged"/>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Button Content="🗑️ Xóa trắng" Background="Transparent" Foreground="{StaticResource TextGray}" 
                                BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Click="BtnClear_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="💾 Lưu bài nháp" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                                    FontWeight="Medium" Padding="14,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnSaveDraft_Click"/>
                            <Button Content="✨ AI Chấm bài &amp; Sửa chi tiết" Style="{StaticResource TealActionButton}" Click="BtnGradeEssay_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= RIGHT: AI EVALUATION & FEEDBACK ================= -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Overall Band Score Banner -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource BrandTealLight}" Width="75" Height="75" CornerRadius="14" Margin="0,0,18,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtBandScore" Text="7.0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="OVERALL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Đánh giá tổng quan từ AI Gia Sư" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                                <TextBlock Text="Bài viết triển khai ý mạch lạc, lập luận thuyết phục. Vốn từ vựng học thuật phong phú và cấu trúc câu đa dạng." 
                                           FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4 Criteria Breakdown -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Điểm chi tiết theo 4 tiêu chí chuẩn IELTS" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,14"/>

                            <!-- Criteria 1 -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Task Achievement (Đáp ứng đề)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="7.5 / 9.0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="75" Maximum="100" Height="6" Foreground="{StaticResource BrandTeal}" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,12"/>

                            <!-- Criteria 2 -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Coherence &amp; Cohesion (Mạch lạc &amp; Liên kết)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="7.0 / 9.0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="70" Maximum="100" Height="6" Foreground="{StaticResource BrandTeal}" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,12"/>

                            <!-- Criteria 3 -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Lexical Resource (Từ vựng học thuật)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="7.0 / 9.0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="70" Maximum="100" Height="6" Foreground="{StaticResource BrandTeal}" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,12"/>

                            <!-- Criteria 4 -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Grammar Range &amp; Accuracy (Ngữ pháp &amp; Độ chuẩn xác)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="6.5 / 9.0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="65" Maximum="100" Height="6" Foreground="{StaticResource BrandTeal}" Background="#E2E8F0" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Suggestions & Rewrite -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="💡 Gợi ý nâng cấp câu văn từ AI (Band 8.0+):" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,12"/>

                            <Border Background="#FEF2F2" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#FCA5A5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Câu gốc của bạn (Có thể cải thiện):" FontSize="11.5" FontWeight="SemiBold" Foreground="#991B1B"/>
                                    <TextBlock Text="&quot;AI is very good and it can help students study anytime.&quot;" FontStyle="Italic" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F0FDF4" CornerRadius="8" Padding="12" BorderBrush="#86EFAC" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Gợi ý viết lại chuẩn học thuật Band 8.0:" FontSize="11.5" FontWeight="SemiBold" Foreground="#166534"/>
                                    <TextBlock Text="&quot;Artificial intelligence plays an instrumental role in facilitating round-the-clock, autonomous learning for students.&quot;" 
                                               FontWeight="SemiBold" FontSize="13" Foreground="#14532D" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
