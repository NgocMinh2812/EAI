<Page x:Class="GUI.Views.HoSoCaNhanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Hồ sơ cá nhân - EnglishAI"
      FontFamily="Segoe UI"
      Background="#F4F7F6">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealDark" Color="#042F2E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.04" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TealActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="btnBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <!-- Custom sleek chevron arrow -->
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="#64748B" StrokeThickness="1.6" 
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                    <Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBoxItem Style -->
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BrandTealLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandTeal}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Template="{StaticResource ModernComboBoxToggleButton}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   VerticalOffset="4">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.12" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F4F7F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EnglishAI / " Foreground="{StaticResource TextGray}" FontSize="13"/>
                    <TextBlock Text="Hồ sơ học viên &amp; Cài đặt tài khoản" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrandTealLight}" CornerRadius="8" Padding="12,6">
                        <TextBlock x:Name="txtStudentId" Text="ID Học Viên: EAI-2026-0001" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrandTeal}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

                <!-- Profile Header Banner -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Circle -->
                        <Border Grid.Column="0" Background="{StaticResource BrandTealLight}" Width="75" Height="75" CornerRadius="37.5" Margin="0,0,20,0">
                            <TextBlock x:Name="txtAvatarInitials" Text="NA" FontWeight="Bold" FontSize="26" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtDisplayName" Text="Nguyễn Văn A" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextDark}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="txtSubtitleInfo" Text="nguyenvana@gmail.com • Thành viên học viên EnglishAI" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtBannerTarget" Text="IELTS Target 6.5" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                                <Border Background="{StaticResource BrandTealLight}" CornerRadius="6" Padding="8,3">
                                    <TextBlock x:Name="txtBannerLevel" Text="Trình độ CEFR: B2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Content="📷 Đổi ảnh đại diện" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                                FontWeight="Medium" Padding="14,8" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="BtnChangeAvatar_Click"/>
                    </Grid>
                </Border>

                <!-- ================= KẾT QUẢ ĐÁNH GIÁ NĂNG LỰC ĐÃ LƯU TRONG HỒ SƠ ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#ECFDF5" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                                    <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kết quả Đánh giá Năng lực Ban đầu (Lưu trong Hồ sơ)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Điểm số bài kiểm tra đầu vào và lộ trình thích ứng do AI phân loại" FontSize="12" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="btnRetakeAssessment" Content="🔄 Làm lại khảo sát" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#F1F5F9" Foreground="{StaticResource BrandTeal}" FontWeight="SemiBold"
                                    Padding="14,7" BorderThickness="0" Cursor="Hand" Click="BtnRetakeAssessment_Click"/>
                        </Grid>

                        <!-- Score Metric Cards Grid -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Metric 1: Điểm số -->
                            <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ĐIỂM ĐÁNH GIÁ ĐẦU VÀO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtProfileScore" Text="8.5 / 10" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandTeal}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtProfileCorrectCount" Text="Đúng 13 / 15 câu (87%)" FontSize="11.5" Foreground="{StaticResource TextGray}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: Trình độ CEFR -->
                            <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="10" Padding="16,14" BorderBrush="#BBF7D0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="TRÌNH ĐỘ CEFR" FontSize="11" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtProfileLevel" Text="CEFR B2" FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                                    <TextBlock x:Name="txtProfileLevelName" Text="Upper-Intermediate (Trên trung cấp)" FontSize="11.5" Foreground="#15803D" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: Quy đổi chứng chỉ -->
                            <Border Grid.Column="4" Background="#FFFBEB" CornerRadius="10" Padding="16,14" BorderBrush="#FDE68A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="QUY ĐỔI TƯƠNG ĐƯƠNG" FontSize="11" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtProfileEquivalent" Text="IELTS 6.0 - 7.0 • TOEIC 700+" FontSize="14" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                                    <TextBlock Text="Quy chuẩn quốc tế" FontSize="11.5" Foreground="#B45309" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- AI Note banner -->
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="txtProfileAiNote" Text="Hệ thống đã lưu kết quả bài test vào hồ sơ của bạn để cá nhân hóa đề xuất bài học." 
                                           FontSize="12" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Personal Information Form -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Thông tin cá nhân &amp; Mục tiêu học tập" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Name Field -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Họ và tên" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                    <TextBox x:Name="txtName" Text="Nguyễn Văn A" Height="36" Padding="10,6" FontSize="13.5" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <!-- Email Field -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Địa chỉ Email" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                    <TextBox x:Name="txtEmail" Text="nguyenvana@gmail.com" Height="36" Padding="10,6" FontSize="13.5" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Phone Field -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số điện thoại liên hệ" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                    <TextBox x:Name="txtPhone" Text="0912 345 678" Height="36" Padding="10,6" FontSize="13.5" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <!-- Target Goal Field -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mục tiêu thi chứng chỉ" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextGray}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cboTargetGoal" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="IELTS Academic Target 6.5"/>
                                    <ComboBoxItem Content="IELTS Academic Target 7.5+"/>
                                    <ComboBoxItem Content="TOEIC 4 Kỹ năng Target 800+"/>
                                    <ComboBoxItem Content="VSTEP B1 - B2 Chuẩn đầu ra"/>
                                    <ComboBoxItem Content="Tiếng Anh Giao tiếp &amp; Công sở"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Study Preferences & Notifications -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Cài đặt học tập &amp; Trợ lý AI" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextDark}" Margin="0,0,0,16"/>

                        <CheckBox x:Name="chkDailyReminder" IsChecked="True" Margin="0,0,0,14" Cursor="Hand">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Bật thông báo nhắc nhở giờ học mỗi ngày (20:00 tối)" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Giúp bạn duy trì chuỗi học tập (Streak) và rèn luyện thói quen đều đặn." FontSize="12" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="chkAutoAudio" IsChecked="True" Margin="0,0,0,14" Cursor="Hand">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Tự động phát audio phát âm chuẩn khi mở thẻ từ vựng" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Tăng cường phản xạ nghe và ghi nhớ phát âm IPA nhanh hơn." FontSize="12" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="chkAIFeedback" IsChecked="True" Cursor="Hand">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Kích hoạt phân tích chuyên sâu của Gia sư AI khi làm bài tập" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Nhận giải thích cặn kẽ vì sao đáp án đúng và gợi ý các collocation liên quan." FontSize="12" Foreground="{StaticResource TextGray}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Actions: Save & Logout -->
                <Grid Margin="0,5,0,30">
                    <Button Content="🚪 Đăng xuất tài khoản" Background="Transparent" Foreground="#EF4444" FontWeight="SemiBold" 
                            BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Click="BtnLogout_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Đổi mật khẩu" Background="#F1F5F9" Foreground="{StaticResource TextDark}" 
                                FontWeight="Medium" Padding="16,10" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0" Click="BtnChangePassword_Click"/>
                        <Button Content="💾 Lưu thay đổi thông tin" Style="{StaticResource TealActionButton}" Click="BtnSaveProfile_Click"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
