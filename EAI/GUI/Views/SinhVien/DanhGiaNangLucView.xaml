<Page x:Class="GUI.Views.DanhGiaNangLucView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Đánh giá năng lực - EnglishAI" 
      FontFamily="Segoe UI"
      Background="#F8FAFC">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandTeal" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandTealLight" Color="#E6F7F3" />
        <SolidColorBrush x:Key="BrandMint" Color="#10B981" />
        <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMedium" Color="#334155" />
        <SolidColorBrush x:Key="TextGray" Color="#64748B" />
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

        <!-- Option Card RadioButton Style -->
        <Style x:Key="OptionCardStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Option Letter Circle (A, B, C, D) -->
                                <Border x:Name="LetterCircle" Grid.Column="0" 
                                        Width="28" Height="28" CornerRadius="14" 
                                        Background="#E2E8F0" Margin="0,0,14,0" 
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="LetterText" Text="{TemplateBinding Tag}" 
                                               FontWeight="Bold" FontSize="13" Foreground="#475569" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Option Text -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F0FDFA"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrandTeal}"/>
                                <Setter TargetName="LetterCircle" Property="Background" Value="{StaticResource BrandTeal}"/>
                                <Setter TargetName="LetterText" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Outline Skip Button Style -->
        <Style x:Key="SkipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- ================= TOP HEADER BAR ================= -->
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="30,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Test Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrandTeal}" Width="32" Height="32" CornerRadius="8">
                        <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EnglishAI" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Bài kiểm tra Đánh giá Năng lực Đầu vào" FontSize="11.5" Foreground="{StaticResource TextGray}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Progress Bar & Question Counter -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Tiến độ làm bài" FontSize="12" Foreground="{StaticResource TextGray}"/>
                        <TextBlock x:Name="txtProgressCount" Text="Câu 1 / 5" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="testProgressBar" Value="20" Maximum="100" Height="6" 
                                 Background="#E2E8F0" Foreground="{StaticResource BrandTeal}" BorderThickness="0"/>
                </StackPanel>

                <!-- Right: Timer & Skip Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Timer Badge -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱️" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtTimer" Text="15:00" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDark}"/>
                        </StackPanel>
                    </Border>

                    <!-- Skip Button -->
                    <Button x:Name="btnSkip" Style="{StaticResource SkipButtonStyle}" Click="BtnSkip_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bỏ qua đánh giá"/>
                            <TextBlock Text=" ❯" FontWeight="Bold" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN TEST QUESTION AREA ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,30">
            <StackPanel HorizontalAlignment="Center" Width="820">

                <!-- Main Question Card -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="35,30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.04" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Question Category Badge & Hint -->
                        <Grid Margin="0,0,0,16">
                            <Border Background="{StaticResource BrandTealLight}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock x:Name="txtCategoryBadge" Text="NGỮ PHÁP • B2" 
                                           FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrandTeal}"/>
                            </Border>
                            <TextBlock Text="Chọn một đáp án chính xác nhất" FontSize="12.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Optional Reading Passage -->
                        <Border x:Name="passageBox" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" 
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20" Visibility="Collapsed">
                            <TextBlock x:Name="txtPassage" Text="" FontSize="13.5" LineHeight="22" 
                                       Foreground="{StaticResource TextMedium}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Question Prompt Text -->
                        <TextBlock x:Name="txtQuestionPrompt" 
                                   Text="Câu 1: If I ______ more time yesterday, I would have traveled around the city with you." 
                                   FontSize="16.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" 
                                   TextWrapping="Wrap" LineHeight="26" Margin="0,0,0,24"/>

                        <!-- 4 Options -->
                        <StackPanel Margin="0,0,0,24">
                            <RadioButton x:Name="rbOptionA" Style="{StaticResource OptionCardStyle}" GroupName="QuizOptions" Tag="A" Click="Option_Checked">
                                <TextBlock x:Name="txtOptionA" Text="have" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            </RadioButton>

                            <RadioButton x:Name="rbOptionB" Style="{StaticResource OptionCardStyle}" GroupName="QuizOptions" Tag="B" Click="Option_Checked">
                                <TextBlock x:Name="txtOptionB" Text="had had" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            </RadioButton>

                            <RadioButton x:Name="rbOptionC" Style="{StaticResource OptionCardStyle}" GroupName="QuizOptions" Tag="C" Click="Option_Checked">
                                <TextBlock x:Name="txtOptionC" Text="had" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            </RadioButton>

                            <RadioButton x:Name="rbOptionD" Style="{StaticResource OptionCardStyle}" GroupName="QuizOptions" Tag="D" Click="Option_Checked">
                                <TextBlock x:Name="txtOptionD" Text="would have" FontSize="14" Foreground="{StaticResource TextDark}"/>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Navigation Buttons Inside Card -->
                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                            <Grid>
                                <!-- Back Button -->
                                <Button x:Name="btnPrev" Style="{StaticResource SkipButtonStyle}" HorizontalAlignment="Left" 
                                        Click="BtnPrev_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="❮ " FontWeight="Bold"/>
                                        <TextBlock Text="Câu trước"/>
                                    </StackPanel>
                                </Button>

                                <!-- Next / Submit Button -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnNext" Style="{StaticResource ActionButtonStyle}" Click="BtnNext_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Câu tiếp theo"/>
                                            <TextBlock Text=" ❯" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnSubmit" Style="{StaticResource ActionButtonStyle}" Background="{StaticResource BrandMint}" 
                                            Click="BtnSubmit_Click" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Nộp bài &amp; Xem kết quả ✨"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Helpful Tip under Card -->
                <TextBlock Text="💡 Bạn có thể bấm 'Bỏ qua đánh giá' ở góc phải bất kỳ lúc nào để vào thẳng màn hình chính." 
                           Foreground="{StaticResource TextGray}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= RESULT MODAL OVERLAY ================= -->
        <Grid x:Name="ResultOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="520" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.2" Color="Black"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <!-- Celebration Emoji/Icon -->
                    <Border Background="#E6F7F3" Width="70" Height="70" CornerRadius="35" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="🎓" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Hoàn thành Đánh giá Năng lực!" FontSize="22" FontWeight="Bold" 
                               Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    
                    <TextBlock x:Name="txtResultScore" Text="Bạn đã hoàn thành 5/5 câu hỏi." 
                               FontSize="14" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Band / Level Card -->
                    <Border Background="#F0FDFA" BorderBrush="{StaticResource BrandTeal}" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="TRÌNH ĐỘ ƯỚC TÍNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtEstimatedLevel" Text="CEFR B2 • IELTS 6.5" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,8"/>
                            <TextBlock Text="Hệ thống đã tự động cá nhân hóa lộ trình học phù hợp với năng lực hiện tại của bạn." 
                                       FontSize="12.5" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Enter Dashboard Button -->
                    <Button Style="{StaticResource ActionButtonStyle}" Height="46" Click="BtnGoHome_Click">
                        <TextBlock Text="Bắt đầu học ngay ➔" FontWeight="Bold" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
