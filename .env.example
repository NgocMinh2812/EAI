# ========================================================
# EAI - Cấu hình Môi trường & API Keys Dịch vụ AI
# ========================================================
# HƯỚNG DẪN:
# 1. Khuyến nghị: Cấu hình .NET User Secrets (Visual Studio: Chuột phải GUI/BUS -> Manage User Secrets,
#    hoặc qua CLI: dotnet user-secrets set "GEMINI_API_KEY" "..." --project EAI/GUI).
# 2. Hoặc thiết lập Biến môi trường hệ thống (System Environment Variables).
# TUYỆT ĐỐI KHÔNG commit tệp chứa key thật lên Git!

# 1. Google Gemini API (Mô hình mặc định chính thức)
# Đăng ký & lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud API (Suy luận siêu tốc với Llama 3.3, Mixtral)
# Đăng ký & lấy key tại: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. xKiro AI Gateway (Cổng định tuyến API)
# Cấu hình API key và Endpoint từ nhà cung cấp xKiro (https://api.xkiro.com)
XKIO_API_KEY=your_xkio_api_key_here
XKIO_API_ENDPOINT=https://api.xkiro.com/v1
